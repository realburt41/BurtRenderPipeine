#pragma kernel SeedMasks

// Test-only producer; one unique coarse coordinate per input record.
StructuredBuffer<uint4> _Seeds;
uint _SeedCount;
uint _Resolution;
RWTexture3D<uint> _Low;
RWTexture3D<uint> _High;

[numthreads(64, 1, 1)]
void SeedMasks(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _SeedCount) return;
    uint4 seed = _Seeds[id.x];
    uint3 coord = uint3(seed.x % _Resolution,
                        (seed.x / _Resolution) % _Resolution,
                        seed.x / (_Resolution * _Resolution));
    if (any(coord >= _Resolution)) return;
    _Low[coord] = seed.y;
    _High[coord] = seed.z;
}
