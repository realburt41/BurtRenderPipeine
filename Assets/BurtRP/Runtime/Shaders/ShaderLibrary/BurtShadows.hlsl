}

// ?????? shadow map ??????? 0..1 ????
bool BurtIsInsideMainLightShadowMap(float3 projectedShadowCoord)
{
    bool outsideShadowMap = projectedShadowCoord.x <= 0.0f || projectedShadowCoord.x >= 1.0f || projectedShadowCoord.y <= 0.0f || projectedShadowCoord.y >= 1.0f || projectedShadowCoord.z <= 0.0f || projectedShadowCoord.z >= 1.0f; // ????????????????? shadow map?
    return !outsideShadowMap; // ?? true ????????? shadow map ??????
}

// ?????? receiver bias?reversed-Z ? regular-Z ????????
float BurtApplyMainLightReceiverBias(float projectedDepth)
{
    float receiverBias = max(0.0f, _BurtMainLightShadowSampleBias); // ??????????????????????
    #if defined(UNITY_REVERSED_Z)
        return saturate(projectedDepth + receiverBias); // reversed-Z ????????????????? bias?
    #else
        return saturate(projectedDepth - receiverBias); // regular-Z ????????????????? bias?
    #endif
}

// ??? shadow map ?????????????
float BurtSampleMainLightShadowCompare(float3 projectedShadowCoord)
{
    return UNITY_SAMPLE_SHADOW(_BurtMainLightShadowMap, projectedShadowCoord); // ?? Unity ???????????????????
}

// ????????????strength ? 0 ??????strength ? 1 ??????????
float BurtApplyShadowStrength(float rawShadow, float strength)
{
    return lerp(1.0f, rawShadow, saturate(strength)); // ???? BurtLit.shader ? shadow strength ???????
}

// ????????? 1 ????????? 0 ????????
float BurtSampleMainLightShadow(float4 shadowCoord)
{
    if (_BurtMainLightShadowStrength <= 0.0001f) // ?? C# ????????? 0???????????
    {
        return 1.0f; // ????????????????????? shadow map?
    }

    float3 projectedShadowCoord = shadowCoord.xyz / max(shadowCoord.w, 0.00001f); // ?????? 0..1 shadow map ???

    if (!BurtIsInsideMainLightShadowMap(projectedShadowCoord)) // ?????? shadow map ???????????????????
    {
        return 1.0f; // ??????????????? shadow map ???????
    }

    projectedShadowCoord.z = BurtApplyMainLightReceiverBias(projectedShadowCoord.z); // ?? receiver bias???????? acne?
    float rawShadow = BurtSampleMainLightShadowCompare(projectedShadowCoord); // ?? MVP ????????????? PCF ???????
    return BurtApplyShadowStrength(rawShadow, _BurtMainLightShadowStrength); // ? Light ? shadowStrength ?????????
}

