uint2 BurtGIScreenProbeGridSize()
{
    return max(uint2(1u, 1u), (uint2)_BurtGIScreenProbeGridParams.xy);
}

float3 BurtGISceneVoxelWorldToUVW(float3 worldPosition)
{
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float extent = max(centerExtent.w, 0.001);
    return (worldPosition - centerExtent.xyz) / (extent * 2.0) + 0.5;
}

float3 BurtGISceneVoxelUVWToWorld(float3 uvw)
{
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    return (uvw * 2.0 - 1.0) * centerExtent.w + centerExtent.xyz;
}

float3 BurtGISceneVoxelDebugHeatmap(float value)
{
    value = saturate(value);
    float3 blue = float3(0.0, 0.15, 1.0);
    float3 cyan = float3(0.0, 1.0, 1.0);
    float3 green = float3(0.0, 1.0, 0.15);
    float3 yellow = float3(1.0, 0.92, 0.0);
    float3 red = float3(1.0, 0.0, 0.0);
    float3 low = lerp(blue, cyan, saturate(value * 4.0));
    float3 mid = lerp(green, yellow, saturate(value * 4.0 - 2.0));
    float3 high = lerp(yellow, red, saturate(value * 4.0 - 3.0));
    return value < 0.5 ? lerp(low, mid, saturate(value * 2.0)) : lerp(mid, high, saturate(value * 2.0 - 1.0));
}

float4 BurtGISceneVoxelBuildClipPosition(float2 screenUV, float rawDepth)
{
    float2 clipXY = screenUV * 2.0 - 1.0;
#if UNITY_UV_STARTS_AT_TOP
    clipXY.y = -clipXY.y;
#endif
    return float4(clipXY, rawDepth, 1.0);
}

float3 BurtGISceneVoxelReconstructPositionWS(float2 screenUV, float rawDepth)
{
    float4 clipPosition = BurtGISceneVoxelBuildClipPosition(screenUV, rawDepth);
    float4 positionWS = mul(_BurtDeferredInverseViewProjectionMatrix, clipPosition);
    float safeW = abs(positionWS.w) > 1.0e-6 ? positionWS.w : (positionWS.w < 0.0 ? -1.0e-6 : 1.0e-6);
    return positionWS.xyz / safeW;
}

float3 BurtGISceneVoxelSafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001 ? value * rsqrt(lengthSq) : fallback;
}

groupshared uint BurtXGIOldSharedChunkValid;

uint BurtGIXGIVoxelMipSize(uint textureSize, uint mipLevel)
{
    return max(textureSize >> (mipLevel * 2u), 1u);
}

uint BurtGIXGIVoxelNodeIndex2Flat(uint3 nodeIndexWithClipmap, uint textureSize, uint clipmapCount)
{
    uint safeTextureSize = max(textureSize, 1u);
    uint safeClipmapCount = max(clipmapCount, 1u);
    uint3 volumeSizeWithClipmap = uint3(safeTextureSize, safeTextureSize, safeTextureSize * safeClipmapCount);
    return nodeIndexWithClipmap.x +
        nodeIndexWithClipmap.z * volumeSizeWithClipmap.x +
        nodeIndexWithClipmap.y * volumeSizeWithClipmap.x * volumeSizeWithClipmap.z;
}

uint3 BurtXGIOldChunkCountPerClipmapVec(uint3 textureSize, uint chunkSizeInOccupy)
{
    return max(textureSize / max(chunkSizeInOccupy, 1u), uint3(1u, 1u, 1u));
}

uint BurtXGIOldChunkCountPerClipmap(uint3 chunkCountPerClipmapVec)
{
    return chunkCountPerClipmapVec.x * chunkCountPerClipmapVec.y * chunkCountPerClipmapVec.z;
}

uint3 BurtXGIOldChunkIndex3DFromFlat(uint chunkIndexFlat, uint3 chunkCountPerClipmapVec)
{
    uint indexFlatYZ = chunkIndexFlat / chunkCountPerClipmapVec.x;
    return uint3(
        chunkIndexFlat % chunkCountPerClipmapVec.x,
        indexFlatYZ % chunkCountPerClipmapVec.y,
        indexFlatYZ / chunkCountPerClipmapVec.y);
}

uint3 BurtXGIOldChunkIndex3DWithClipmap(uint3 chunkIndex3D, uint3 chunkCountPerClipmapVec, uint clipmapIndex)
{
    return uint3(chunkIndex3D.x, chunkIndex3D.y, chunkIndex3D.z + clipmapIndex * chunkCountPerClipmapVec.z);
}

uint BurtXGIOldChunkIndex3DEncode(uint3 chunkIndex3D)
{
    return ((chunkIndex3D.x & 0x3ffu) << 22u) | ((chunkIndex3D.y & 0x3ffu) << 12u) | (chunkIndex3D.z & 0xfffu);
}

void BurtXGIOldWriteChunkIndex3DWithClipmap(RWStructuredBuffer<uint> chunkAllocator, uint chunkAllocatedIndex, uint3 chunkIndex3DWithClipmap)
{
    chunkAllocator[chunkAllocatedIndex] = BurtXGIOldChunkIndex3DEncode(chunkIndex3DWithClipmap);
}

bool BurtXGIOldReadChunkAllocatedIndex(RWTexture3D<uint> chunkData, uint3 chunkIndex3DWithClipmap, out uint chunkAllocatedIndex)
{
    chunkAllocatedIndex = chunkData[chunkIndex3DWithClipmap];
    return chunkAllocatedIndex != BURT_GI_XGI_OLD_INVALID_CHUNK_ALLOCATED_INDEX;
}

[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void AllocateChunk(uint groupIndex : SV_GroupIndex, uint3 groupId : SV_GroupID, uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (groupIndex == 0u)
    {
        BurtXGIOldSharedChunkValid = 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    uint chunkSizeInOccupy = BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE;
    uint3 textureSize = max((uint3)_XGIGenerateVoxelOccupyChunkPass_TextureSize.xyz, uint3(1u, 1u, 1u));
    uint clipmapIndex = (uint)max((int)_XGIGenerateVoxelOccupyChunkPass_ClipmapIndexAndCount.x, 0);
    uint3 chunkCountPerClipmapVec = BurtXGIOldChunkCountPerClipmapVec(textureSize, chunkSizeInOccupy);
    uint3 chunkIndex3D = groupId;
    if (any(chunkIndex3D >= chunkCountPerClipmapVec))
    {
        return;
    }

    uint3 indexInClipmap = dispatchThreadId + uint3(0u, 0u, clipmapIndex * textureSize.z);
    int3 textureCoord0 = int3((int)(indexInClipmap.x * 2u + 1u), (int)indexInClipmap.y, (int)indexInClipmap.z);
    int3 textureCoord1 = int3((int)(indexInClipmap.x * 2u), (int)indexInClipmap.y, (int)indexInClipmap.z);
    uint value0 = _XGIGenerateVoxelOccupyChunkPass_VoxelOccupy.Load(int4(textureCoord0, 0));
    uint value1 = _XGIGenerateVoxelOccupyChunkPass_VoxelOccupy.Load(int4(textureCoord1, 0));
    InterlockedOr(BurtXGIOldSharedChunkValid, value0 | value1);
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex != 0u)
    {
        return;
    }

    uint3 chunkIndex3DWithClipmap = BurtXGIOldChunkIndex3DWithClipmap(chunkIndex3D, chunkCountPerClipmapVec, clipmapIndex);
    if (BurtXGIOldSharedChunkValid == 0u)
    {
        _RW_XGIGenerateVoxelOccupyChunkPass_ChunkData[chunkIndex3DWithClipmap] = BURT_GI_XGI_OLD_INVALID_CHUNK_ALLOCATED_INDEX;
        return;
    }

    uint chunkAllocatedIndex;
    int freeIndex;
    InterlockedAdd(_RW_XGIGenerateVoxelOccupyChunkPass_ChunkFreeListAllocator[0], -1, freeIndex);
    if (freeIndex > 0)
    {
        chunkAllocatedIndex = (uint)_RW_XGIGenerateVoxelOccupyChunkPass_ChunkFreeListAllocator[(uint)freeIndex];
    }
    else
    {
        InterlockedAdd(_RW_XGIGenerateVoxelOccupyChunkPass_ChunkAllocator[0], 1u, chunkAllocatedIndex);
        chunkAllocatedIndex++;
    }

    _RW_XGIGenerateVoxelOccupyChunkPass_ChunkData[chunkIndex3DWithClipmap] = chunkAllocatedIndex;
    BurtXGIOldWriteChunkIndex3DWithClipmap(_RW_XGIGenerateVoxelOccupyChunkPass_ChunkAllocator, chunkAllocatedIndex, chunkIndex3DWithClipmap);
}

[numthreads(1, 1, 1)]
void ClearChunkFreeList(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    _RW_XGIGenerateVoxelOccupyChunkClearDataPass_ChunkFreeListAllocator[0] = max(_RW_XGIGenerateVoxelOccupyChunkClearDataPass_ChunkFreeListAllocator[0], 0);
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void ClearChunkData(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint3 textureSize = max((uint3)_XGIGenerateVoxelOccupyChunkClearDataPass_TextureSize.xyz, uint3(1u, 1u, 1u));
    uint clipmapIndex = (uint)max((int)_XGIGenerateVoxelOccupyChunkClearDataPass_ClipmapIndexAndCount.x, 0);
    uint chunkSizeInOccupy = max((uint)_XGIGenerateVoxelOccupyChunkClearDataPass_ClipmapIndexAndCount.z, 1u);
    uint threadGroupNumX = max((uint)_XGIGenerateVoxelOccupyChunkClearDataPass_ClipmapIndexAndCount.w, 1u);
    uint chunkIndexFlat = dispatchThreadId.x + dispatchThreadId.y * threadGroupNumX * BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE;
    uint3 chunkCountPerClipmapVec = BurtXGIOldChunkCountPerClipmapVec(textureSize, chunkSizeInOccupy);
    if (chunkIndexFlat >= BurtXGIOldChunkCountPerClipmap(chunkCountPerClipmapVec))
    {
        return;
    }

    uint3 chunkIndex3D = BurtXGIOldChunkIndex3DFromFlat(chunkIndexFlat, chunkCountPerClipmapVec);
    uint3 chunkIndex3DWithClipmap = BurtXGIOldChunkIndex3DWithClipmap(chunkIndex3D, chunkCountPerClipmapVec, clipmapIndex);
    uint chunkAllocatedIndex;
    if (!BurtXGIOldReadChunkAllocatedIndex(_RW_XGIGenerateVoxelOccupyChunkClearDataPass_ChunkData, chunkIndex3DWithClipmap, chunkAllocatedIndex))
    {
        return;
    }

    _RW_XGIGenerateVoxelOccupyChunkClearDataPass_ChunkData[chunkIndex3DWithClipmap] = BURT_GI_XGI_OLD_INVALID_CHUNK_ALLOCATED_INDEX;
    int freeIndex;
    InterlockedAdd(_RW_XGIGenerateVoxelOccupyChunkClearDataPass_ChunkFreeListAllocator[0], 1, freeIndex);
    freeIndex++;
    _RW_XGIGenerateVoxelOccupyChunkClearDataPass_ChunkFreeListAllocator[(uint)freeIndex] = (int)chunkAllocatedIndex;
    _RW_XGIGenerateVoxelOccupyChunkClearDataPass_ChunkAllocator[chunkAllocatedIndex] = BURT_GI_XGI_OLD_INVALID_CHUNK_INDEX;
}

bool BurtGIXGIFrustumAABBIntersect(float3 boundsMin, float3 boundsMax)
{
    [unroll]
    for (uint planeIndex = 0u; planeIndex < 6u; ++planeIndex)
    {
        float4 plane = FrustumPlanesBuffer[planeIndex];
        float3 positive = float3(
            plane.x >= 0.0 ? boundsMax.x : boundsMin.x,
            plane.y >= 0.0 ? boundsMax.y : boundsMin.y,
            plane.z >= 0.0 ? boundsMax.z : boundsMin.z);
        if (dot(plane.xyz, positive) + plane.w < 0.0)
        {
            return false;
        }
    }

    return true;
}

bool BurtGIXGISdfSeedValid(uint3 voxelIndex, uint textureSize, uint clipmapIndex, uint clipmapCount)
{
    uint occupyWidth;
    uint occupyHeight;
    uint occupyDepth;
    _XGISdfGenFillUVPass_VoxelOccupy.GetDimensions(occupyWidth, occupyHeight, occupyDepth);
    uint safeClipmapCount = max(clipmapCount, 1u);
    uint clipmapDepth = max(occupyDepth / safeClipmapCount, 1u);
    uint3 occupyLocalSize = max(uint3(occupyWidth, occupyHeight, clipmapDepth), uint3(1u, 1u, 1u));
    uint3 occupyCoord = min((voxelIndex * occupyLocalSize) / max(textureSize, 1u), occupyLocalSize - 1u);
    occupyCoord.z += min(clipmapIndex, safeClipmapCount - 1u) * clipmapDepth;
    float4 occupancy = _XGISdfGenFillUVPass_VoxelOccupy.Load(int4((int)occupyCoord.x, (int)occupyCoord.y, (int)occupyCoord.z, 0));
    return max(max(occupancy.x, occupancy.y), max(occupancy.z, occupancy.w)) > 0.0001;
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void FillUV(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint textureSize = max((uint)_XGISdfGenFillUVPass_TextureSize.x, 1u);
    uint3 voxelIndex = dispatchThreadId;
    if (any(voxelIndex >= textureSize))
    {
        return;
    }

    uint clipmapIndex = (uint)max((int)_XGISdfGenFillUVPass_ClipmapIndexAndCount.x, 0);
    uint clipmapCount = max((uint)_XGISdfGenFillUVPass_ClipmapIndexAndCount.y, 1u);
    float voxelToUVScale = _XGISdfGenFillUVPass_TextureSize.y;
    bool valid = BurtGIXGISdfSeedValid(voxelIndex, textureSize, clipmapIndex, clipmapCount);
    _RW_XGISdfGenFillUVPass_SdfTemp1[voxelIndex] = valid ? float4((float3)voxelIndex * voxelToUVScale, 1.0) : float4(0.0, 0.0, 0.0, 0.0);
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void JFA(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint textureSize = max((uint)_XGISdfGenJFAPass_TextureSize.x, 1u);
    uint3 totalIndex = dispatchThreadId;
    if (any(totalIndex >= textureSize))
    {
        return;
    }

    float4 nearest = _XGISdfGenJFAPass_SdfTemp1[totalIndex];
    if (nearest.w < 0.5)
    {
        nearest = float4(-10.0, -10.0, -10.0, 0.0);
    }

    int jumpOffset = max((int)_XGISdfGenJFAPass_TextureSize.z, 1);
    int safeTextureSize = (int)textureSize;
    [unroll]
    for (int offsetZ = -1; offsetZ <= 1; ++offsetZ)
    {
        [unroll]
        for (int offsetY = -1; offsetY <= 1; ++offsetY)
        {
            [unroll]
            for (int offsetX = -1; offsetX <= 1; ++offsetX)
            {
                int3 neighbor = int3(totalIndex) + int3(offsetX, offsetY, offsetZ) * jumpOffset;
                neighbor = (neighbor % safeTextureSize + safeTextureSize) % safeTextureSize;
                float4 candidate = _XGISdfGenJFAPass_SdfTemp1[uint3(neighbor)];
                if (candidate.w < 0.5)
                {
                    continue;
                }

                float3 uv = (float3)totalIndex / (float)textureSize;
                if (length(uv - candidate.xyz) < length(uv - nearest.xyz))
                {
                    nearest = candidate;
                }
            }
        }
    }

    _RW_XGISdfGenJFAPass_SdfTemp2[totalIndex] = nearest;
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void Finalize(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint textureSize = max((uint)_XGISdfGenFinalizePass_TextureSize.x, 1u);
    uint3 globalIndex = dispatchThreadId;
    if (any(globalIndex >= textureSize))
    {
        return;
    }

    uint clipmapIndex = (uint)max((int)_XGISdfGenFinalizePass_ClipmapIndexAndCount.x, 0);
    uint clipmapBorder = (uint)max((int)_XGISdfGenFinalizePass_ClipmapIndexAndCount.z, 0);
    uint3 resultIndex = globalIndex + uint3(0u, 0u, (textureSize + clipmapBorder) * clipmapIndex);
    float3 defaultUV = (float3)globalIndex / (float)textureSize;
    float4 nearest = _XGISdfGenFinalizePass_SdfTemp2[globalIndex];
    float distanceToSeed = nearest.w >= 0.5 ? length(nearest.xyz - defaultUV) : 1.0;
    _RW_XGISdfGenFinalizePass_SdfResult[resultIndex] = distanceToSeed;
}

float2 BurtXGIProjectOBB(XGIProbeVolumeGpuOBB obb, float3 axis)
{
    float pMin = dot(axis, obb.corner);
    float pMax = pMin;
    [unroll]
    for (int z = 0; z < 2; ++z)
    {
        [unroll]
        for (int y = 0; y < 2; ++y)
        {
            [unroll]
            for (int x = 0; x < 2; ++x)
            {
                float3 vertex = obb.corner + obb.X * x + obb.Y * y + obb.Z * z;
                float projection = dot(axis, vertex);
                pMin = min(pMin, projection);
                pMax = max(pMax, projection);
            }
        }
    }

    return float2(pMin, pMax);
}

bool BurtXGIProbeOBBAxisOverlaps(XGIProbeVolumeGpuOBB obbA, XGIProbeVolumeGpuOBB obbB, float3 axis)
{
    float axisLengthSq = dot(axis, axis);
    if (axisLengthSq <= 1.0e-8)
    {
        return true;
    }

    float3 normalizedAxis = axis * rsqrt(axisLengthSq);
    float2 projectionA = BurtXGIProjectOBB(obbA, normalizedAxis);
    float2 projectionB = BurtXGIProjectOBB(obbB, normalizedAxis);
    return !(projectionA.y < projectionB.x || projectionB.y < projectionA.x);
}

bool BurtXGIProbeOBBIntersects(XGIProbeVolumeGpuOBB obbA, XGIProbeVolumeGpuOBB obbB)
{
    return BurtXGIProbeOBBAxisOverlaps(obbA, obbB, obbA.X) &&
        BurtXGIProbeOBBAxisOverlaps(obbA, obbB, obbA.Y) &&
        BurtXGIProbeOBBAxisOverlaps(obbA, obbB, obbA.Z) &&
        BurtXGIProbeOBBAxisOverlaps(obbA, obbB, obbB.X) &&
        BurtXGIProbeOBBAxisOverlaps(obbA, obbB, obbB.Y) &&
        BurtXGIProbeOBBAxisOverlaps(obbA, obbB, obbB.Z);
}

float BurtXGISampleSdfByUVWithClipmap(float3 position01, uint clipmapIndex)
{
    uint3 textureSize = max((uint3)_XGISdfApply_TextureSize.xyz, uint3(1u, 1u, 1u));
    uint border = (uint)max((int)_XGISdfApply_TextureSize.w, 0);
    uint3 coord = min((uint3)(saturate(position01) * (float3)textureSize), textureSize - 1u);
    coord.z += clipmapIndex * (textureSize.z + border);
    return _XGISdfApply_SdfTexture.Load(int4((int)coord.x, (int)coord.y, (int)coord.z, 0));
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void ProbeVolumeCull(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint3 totalIndex = dispatchThreadId;
    uint3 maxBrickCount = max((uint3)_XGIPlacementProbeVolumeCullPass_MaxBrickCount.xyz, uint3(1u, 1u, 1u));
    if (any(totalIndex >= maxBrickCount))
    {
        _RW_XGIPlacementProbeVolumeCullPass_Result[totalIndex] = float2(0.0, 0.0);
        return;
    }

    float brickSize = max(_XGIPlacementProbeVolumeCullPass_BrickSize, 0.0001);
    XGIProbeVolumeGpuOBB brickOBB;
    brickOBB.corner = (float3)totalIndex * brickSize + _XGIPlacementProbeVolumeCullPass_VolumeOffsetWS.xyz;
    brickOBB.X = float3(brickSize, 0.0, 0.0);
    brickOBB.Y = float3(0.0, brickSize, 0.0);
    brickOBB.Z = float3(0.0, 0.0, brickSize);
    brickOBB.minControllerSubdivLevel = 0;
    brickOBB.maxControllerSubdivLevel = 0;
    brickOBB.fillEmptySpaces = 0;
    brickOBB.maxSubdivLevelInsideVolume = 0;

    bool generate = false;
    int ignoreSdf = 2147483647;
    int probeVolumeCount = max((int)_XGIPlacementProbeVolumeCullPass_ProbeVolumeCount, 0);
    int subdivLevel = (int)_XGIPlacementProbeVolumeCullPass_SubdivLevel;
    [loop]
    for (int i = 0; i < probeVolumeCount; ++i)
    {
        XGIProbeVolumeGpuOBB volumeOBB = _XGIPlacementProbeVolumeCullPass_ProbeVolumes[i];
        if (subdivLevel < volumeOBB.minControllerSubdivLevel || subdivLevel > volumeOBB.maxControllerSubdivLevel)
        {
            continue;
        }

        if (!BurtXGIProbeOBBIntersects(volumeOBB, brickOBB))
        {
            continue;
        }

        generate = true;
        if (volumeOBB.fillEmptySpaces != 0)
        {
            ignoreSdf = min(ignoreSdf, volumeOBB.maxControllerSubdivLevel);
        }
    }

    _RW_XGIPlacementProbeVolumeCullPass_Result[totalIndex] = float2(generate ? 1.0 : 0.0, (float)ignoreSdf);
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void GenBrick(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint3 totalIndex = dispatchThreadId;
    uint3 maxBrickCount = max((uint3)_XGIGenBrickPass_MaxBrickCount.xyz, uint3(1u, 1u, 1u));
    if (any(totalIndex >= maxBrickCount))
    {
        return;
    }

    uint subdivLevel = (uint)max((int)_XGIGenBrickPass_SubdivLevel, 0);
    float2 subdivisionLevelData = _XGIGenBrickPass_ProbeVolumeCullData.Load(int4((int)totalIndex.x, (int)totalIndex.y, (int)totalIndex.z, (int)subdivLevel));
    if (subdivisionLevelData.x == 0.0)
    {
        return;
    }

    bool generateBrick = subdivLevel == (uint)subdivisionLevelData.y;
    if (!generateBrick)
    {
        float3 position01 = ((float3)totalIndex + 0.5) / (float3)maxBrickCount;
        float sdfDistance = BurtXGISampleSdfByUVWithClipmap(position01, 0u);
        float voxelDetectionDistance = rcp((float)maxBrickCount.x);
        voxelDetectionDistance = sqrt(voxelDetectionDistance * voxelDetectionDistance * 3.0) * 0.5;
        generateBrick = sdfDistance <= voxelDetectionDistance;
    }

    if (!generateBrick)
    {
        return;
    }

    float3 positionInCell = _XGIGenBrickPass_VolumeOffsetInBricks.xyz + ((float3)totalIndex / (float3)maxBrickCount) * _XGIGenBrickPass_VolumeSizeInBricks.xyz;
    uint brickIndex;
    InterlockedAdd(_RW_XGIGenBrickPass_BrickCount[subdivLevel], 1u, brickIndex);
    _RW_XGIGenBrickPass_Bricks[brickIndex] = float4(positionInCell, 0.0);
}

struct BurtXGIVoxelMaterialUint
{
    uint4 albedo;
    uint opaque;
    uint3 normal;
    uint3 emissive;
};

struct BurtXGIVoxelMaterialFloat
{
    float3 albedo;
    float opaque;
    float3 normal;
    float3 emissive;
};

struct BurtXGIVoxelMaterialPendingData
{
    uint nodeIndex;
    uint albedoOpaque;
    uint normal;
    uint emissive;
};

uint BurtXGIDivRoundUp(uint x, uint y)
{
    return (x + y - 1u) / max(y, 1u);
}

uint4 BurtXGIUnpackUintToUint4(uint packedValue)
{
    return uint4(
        (packedValue >> 0u) & 0xffu,
        (packedValue >> 8u) & 0xffu,
        (packedValue >> 16u) & 0xffu,
        (packedValue >> 24u) & 0xffu);
}

float3 BurtXGIUnpackNormalOct(float2 encodedNormal)
{
    float3 normal = float3(encodedNormal.x, encodedNormal.y, 1.0 - abs(encodedNormal.x) - abs(encodedNormal.y));
    if (normal.z < 0.0)
    {
        float2 signNotZero = float2(normal.x >= 0.0 ? 1.0 : -1.0, normal.y >= 0.0 ? 1.0 : -1.0);
        normal.xy = (1.0 - abs(normal.yx)) * signNotZero;
    }

    return BurtGISceneVoxelSafeNormalize(normal, float3(0.0, 1.0, 0.0));
}

float3 BurtXGIUnpackNormalFromUInt32(uint packedNormal)
{
    uint2 quantized = uint2((packedNormal >> 16u) & 0xffffu, packedNormal & 0xffffu);
    float2 oct = ((float2)quantized / 65535.0 - 0.5) * 2.0;
    return BurtXGIUnpackNormalOct(oct);
}

uint3 BurtXGIPackNormalToUInt3(float3 normal)
{
    return (uint3)round(saturate(normal * 0.5 + 0.5) * 255.0);
}

float3 BurtXGIUnpackNormalFromUInt3(uint3 packedNormal)
{
    return BurtGISceneVoxelSafeNormalize((float3)packedNormal / 255.0 * 2.0 - 1.0, float3(0.0, 1.0, 0.0));
}

float3 BurtXGIUnpackR11G11B10Approx(uint packedValue)
{
    uint r = (packedValue >> 0u) & 0x7ffu;
    uint g = (packedValue >> 11u) & 0x7ffu;
    uint b = (packedValue >> 22u) & 0x3ffu;
    return float3((float)r / 2047.0, (float)g / 2047.0, (float)b / 1023.0);
}

uint3 BurtXGIPackEmissiveToUInt3(float3 emissive)
{
    return (uint3)round(max(emissive, 0.0) * BURT_GI_XGI_MATERIAL_EMISSIVE_QUANTIZE_VALUE);
}

float3 BurtXGIUnpackEmissiveFromUInt3(uint3 packedEmissive)
{
    return (float3)packedEmissive / BURT_GI_XGI_MATERIAL_EMISSIVE_QUANTIZE_VALUE;
}

BurtXGIVoxelMaterialUint BurtXGIReadMaterialFromBuffer(StructuredBuffer<uint> materialDataBuffer, uint materialNodeIndex, uint materialDataIndexOffset)
{
    BurtXGIVoxelMaterialUint materialData;
    uint start = materialDataIndexOffset + materialNodeIndex * BURT_GI_XGI_MATERIAL_UINT_SIZE;
    uint packData0 = materialDataBuffer[start + 0u];
    uint packData1 = materialDataBuffer[start + 1u];
    uint packData2 = materialDataBuffer[start + 2u];
    uint packData3 = materialDataBuffer[start + 3u];
    materialData.albedo.x = packData0 >> BURT_GI_XGI_MATERIAL_PENDING_LIST_HALF_BIT;
    materialData.albedo.y = packData0 & 0xffffu;
    materialData.albedo.z = packData1 >> BURT_GI_XGI_MATERIAL_PENDING_LIST_HALF_BIT;
    materialData.albedo.w = packData1 & 0xffffu;
    materialData.opaque = packData2 >> BURT_GI_XGI_MATERIAL_PENDING_LIST_HALF_BIT;
    materialData.normal.x = packData2 & 0xffffu;
    materialData.normal.y = packData3 >> BURT_GI_XGI_MATERIAL_PENDING_LIST_HALF_BIT;
    materialData.normal.z = packData3 & 0xffffu;
    materialData.emissive.x = materialDataBuffer[start + 4u];
    materialData.emissive.y = materialDataBuffer[start + 5u];
    materialData.emissive.z = materialDataBuffer[start + 6u];
    return materialData;
}

BurtXGIVoxelMaterialFloat BurtXGIMaterialUintToFloat(BurtXGIVoxelMaterialUint materialUint)
{
    BurtXGIVoxelMaterialFloat materialFloat;
    float count = max((float)materialUint.albedo.w, 1.0);
    float invCount = rcp(count);
    materialFloat.albedo = (float3)materialUint.albedo.xyz * invCount / 255.0;
    materialFloat.opaque = (float)materialUint.opaque * invCount / 255.0;
    materialFloat.normal = BurtXGIUnpackNormalFromUInt3((uint3)((float3)materialUint.normal * invCount));
    materialFloat.emissive = BurtXGIUnpackEmissiveFromUInt3((uint3)((float3)materialUint.emissive * invCount));
    return materialFloat;
}

uint2 BurtXGIMaterialAtlasUV(uint flatIndex, uint atlasSize)
{
    uint safeAtlasSize = max(atlasSize, 1u);
    return uint2(flatIndex % safeAtlasSize, flatIndex / safeAtlasSize);
}

void BurtXGIWriteMaterialToAtlas(uint atlasSize, uint flatIndex, BurtXGIVoxelMaterialFloat material)
{
    uint2 uv = BurtXGIMaterialAtlasUV(flatIndex, atlasSize);
    RWVoxelMaterialPopulateAtlasAlbedo[uv] = float4(saturate(material.albedo), saturate(material.opaque));
    RWVoxelMaterialPopulateAtlasNormal[uv] = saturate(material.normal.xy * 0.5 + 0.5);
    RWVoxelMaterialPopulateAtlasEmissive[uv] = max(material.emissive, 0.0);
}

BurtXGIVoxelMaterialPendingData BurtXGIReadMaterialFromPendingList(StructuredBuffer<uint> materialPendingList, uint materialPendingIndex)
{
    BurtXGIVoxelMaterialPendingData pendingData;
    uint start = BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_OFFSET + materialPendingIndex * BURT_GI_XGI_MATERIAL_PENDING_DATA_SIZE;
    pendingData.nodeIndex = materialPendingList[start + 0u];
    pendingData.albedoOpaque = materialPendingList[start + 1u];
    pendingData.normal = materialPendingList[start + 2u];
    pendingData.emissive = materialPendingList[start + 3u];
    return pendingData;
}

BurtXGIVoxelMaterialUint BurtXGIPendingDataToMaterialUint(BurtXGIVoxelMaterialPendingData pendingData, out uint nodeIndexFlat)
{
    BurtXGIVoxelMaterialUint materialUint;
    nodeIndexFlat = pendingData.nodeIndex;
    uint4 albedoOpaque = BurtXGIUnpackUintToUint4(pendingData.albedoOpaque);
    materialUint.albedo = uint4(albedoOpaque.xyz, 1u);
    materialUint.opaque = albedoOpaque.w;
    materialUint.normal = BurtXGIPackNormalToUInt3(BurtXGIUnpackNormalFromUInt32(pendingData.normal));
    materialUint.emissive = BurtXGIPackEmissiveToUInt3(BurtXGIUnpackR11G11B10Approx(pendingData.emissive));
    return materialUint;
}

void BurtXGIClearMaterialBufferSingleThread(RWStructuredBuffer<uint> materialDataBuffer, uint materialNodeIndex, uint materialDataIndexOffset)
{
    uint start = materialDataIndexOffset + materialNodeIndex * BURT_GI_XGI_MATERIAL_UINT_SIZE;
    [unroll]
    for (uint i = 0u; i < BURT_GI_XGI_MATERIAL_UINT_SIZE; ++i)
    {
        materialDataBuffer[start + i] = 0u;
    }
}

void BurtXGIInterlockedAddMaterialToBuffer(RWStructuredBuffer<uint> materialDataBuffer, uint materialNodeIndex, BurtXGIVoxelMaterialUint materialData, uint materialDataIndexOffset, uint maxAddCount)
{
    uint start = materialDataIndexOffset + materialNodeIndex * BURT_GI_XGI_MATERIAL_UINT_SIZE;
    uint packPrevCount;
    InterlockedAdd(materialDataBuffer[start + 1u], 0u, packPrevCount);
    uint prevCount = packPrevCount & 0xffffu;
    if (prevCount >= maxAddCount)
    {
        return;
    }

    uint packData0 = (materialData.albedo.x << BURT_GI_XGI_MATERIAL_PENDING_LIST_HALF_BIT) | materialData.albedo.y;
    uint packData1 = (materialData.albedo.z << BURT_GI_XGI_MATERIAL_PENDING_LIST_HALF_BIT) | materialData.albedo.w;
    uint packData2 = (materialData.opaque << BURT_GI_XGI_MATERIAL_PENDING_LIST_HALF_BIT) | materialData.normal.x;
    uint packData3 = (materialData.normal.y << BURT_GI_XGI_MATERIAL_PENDING_LIST_HALF_BIT) | materialData.normal.z;
    InterlockedAdd(materialDataBuffer[start + 0u], packData0);
    InterlockedAdd(materialDataBuffer[start + 1u], packData1);
    InterlockedAdd(materialDataBuffer[start + 2u], packData2);
    InterlockedAdd(materialDataBuffer[start + 3u], packData3);
    InterlockedAdd(materialDataBuffer[start + 4u], materialData.emissive.x);
    InterlockedAdd(materialDataBuffer[start + 5u], materialData.emissive.y);
    InterlockedAdd(materialDataBuffer[start + 6u], materialData.emissive.z);
}

uint3 BurtXGIVoxelNodeIndexWithClipmap(uint3 nodeIndex, uint textureSize, uint clipmapIndex)
{
    return nodeIndex + uint3(0u, 0u, clipmapIndex * textureSize);
}

uint3 BurtXGIVoxelFlat2NodeIndex(uint nodeIndexFlat, uint textureSize, uint clipmapCount)
{
    uint safeTextureSize = max(textureSize, 1u);
    uint safeClipmapCount = max(clipmapCount, 1u);
    uint3 volumeSizeWithClipmap = uint3(safeTextureSize, safeTextureSize, safeTextureSize * safeClipmapCount);
    uint indexFlatYZ = nodeIndexFlat / volumeSizeWithClipmap.x;
    return uint3(
        nodeIndexFlat % volumeSizeWithClipmap.x,
        indexFlatYZ / volumeSizeWithClipmap.z,
        indexFlatYZ % volumeSizeWithClipmap.z);
}

[numthreads(1, 1, 1)]
void PopulateGenArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint populateCount = min(VoxelMaterialPopulateArgsBufferPendingList[BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_INDEX], (uint)max(VoxelMaterialPopulateArgsBufferMaxPendingListCount, 0));
    uint populateThreadNumSqrt = (uint)ceil(sqrt((float)populateCount));
    uint groupX = BurtXGIDivRoundUp(populateThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    uint groupY = BurtXGIDivRoundUp(populateThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    RWVoxelMaterialPopulateArgsBuffer[0] = groupX;
    RWVoxelMaterialPopulateArgsBuffer[1] = groupY;
    RWVoxelMaterialPopulateArgsBuffer[2] = 1u;
    RWVoxelMaterialPopulateArgsBufferParams[0] = populateCount;
    RWVoxelMaterialPopulateArgsBufferParams[1] = groupX;
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void Populate(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint populateCount = VoxelMaterialPopulateArgsBufferParams[0];
    uint groupX = max(VoxelMaterialPopulateArgsBufferParams[1], 1u);
    uint populateThreadIndex = dispatchThreadId.x + dispatchThreadId.y * BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE * groupX;
    if (populateThreadIndex >= populateCount)
    {
        return;
    }

    BurtXGIVoxelMaterialUint materialUint = BurtXGIReadMaterialFromBuffer(VoxelMaterialPopulatePendingList, populateThreadIndex, BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_OFFSET);
    uint materialIndexInPhysicalPoolFlat = populateThreadIndex + (uint)max(VoxelMaterialPopulateIndexOffsetForClipmap, 0) * (uint)max(VoxelMaterialPopulateClipmapIndex, 0);
    BurtXGIWriteMaterialToAtlas((uint)max(VoxelMaterialPopulatePhysicalPoolSize, 1), materialIndexInPhysicalPoolFlat, BurtXGIMaterialUintToFloat(materialUint));
}

[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void FillPageTable(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint textureSize = max((uint)VoxelMaterialFillVoxelTextureSize, 1u);
    uint3 nodeIndex = dispatchThreadId;
    if (any(nodeIndex >= textureSize))
    {
        return;
    }

    uint clipmapIndex = (uint)max(VoxelMaterialFillClipmapIndex, 0);
    uint3 nodeIndexWithClipmap = BurtXGIVoxelNodeIndexWithClipmap(nodeIndex, textureSize, clipmapIndex);
    uint occupied = VoxelMaterialFillOccupyTexture.Load(int4((int)nodeIndexWithClipmap.x, (int)nodeIndexWithClipmap.y, (int)nodeIndexWithClipmap.z, 0));
    if (occupied == 0u)
    {
        return;
    }

    uint materialPendingIndex;
    InterlockedAdd(RWVoxelMaterialFillFinalPendingList[BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_INDEX], 1u, materialPendingIndex);
    materialPendingIndex++;
    RWVoxelMaterialFillPageTable[nodeIndexWithClipmap] = materialPendingIndex;
    BurtXGIClearMaterialBufferSingleThread(RWVoxelMaterialFillFinalPendingList, materialPendingIndex - 1u, BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_OFFSET);
}

[numthreads(1, 1, 1)]
void FillGenArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint fillCount = VoxelMaterialFillArgsPendingList[BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_INDEX];
    uint fillThreadNumSqrt = (uint)ceil(sqrt((float)fillCount));
    uint groupX = BurtXGIDivRoundUp(fillThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    uint groupY = BurtXGIDivRoundUp(fillThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    RWVoxelMaterialFillArgsBuffer[0] = groupX;
    RWVoxelMaterialFillArgsBuffer[1] = groupY;
    RWVoxelMaterialFillArgsBuffer[2] = 1u;
    RWVoxelMaterialFillArgsBufferParams[0] = fillCount;
    RWVoxelMaterialFillArgsBufferParams[1] = groupX;
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void Fill(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint fillCount = VoxelMaterialFillArgsBufferParams[0];
    uint groupX = max(VoxelMaterialFillArgsBufferParams[1], 1u);
    uint pendingListIndex = dispatchThreadId.x + dispatchThreadId.y * BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE * groupX;
    if (pendingListIndex >= fillCount)
    {
        return;
    }

    BurtXGIVoxelMaterialPendingData pendingData = BurtXGIReadMaterialFromPendingList(VoxelMaterialFillPendingList, pendingListIndex);
    uint nodeIndexFlat;
    BurtXGIVoxelMaterialUint materialDataUint = BurtXGIPendingDataToMaterialUint(pendingData, nodeIndexFlat);
    uint textureSize = max((uint)VoxelMaterialFillTextureSize, 1u);
    uint3 nodeIndex = BurtXGIVoxelFlat2NodeIndex(nodeIndexFlat, textureSize, 1u);
    uint3 nodeIndexWithClipmap = BurtXGIVoxelNodeIndexWithClipmap(nodeIndex, max((uint)VoxelMaterialFillVoxelTextureSize, 1u), (uint)max(VoxelMaterialFillClipmapID, 0));
    uint allocatedPhysicalIndex = VoxelMaterialFillPageTable.Load(int4((int)nodeIndexWithClipmap.x, (int)nodeIndexWithClipmap.y, (int)nodeIndexWithClipmap.z, 0));
    if (allocatedPhysicalIndex == 0u)
    {
        return;
    }

    BurtXGIInterlockedAddMaterialToBuffer(RWVoxelMaterialFillPendingList, allocatedPhysicalIndex - 1u, materialDataUint, BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_OFFSET, BURT_GI_XGI_MATERIAL_PENDING_LIST_MAX_COUNT);
}

uint2 BurtXGIMaterialTempDataIndexFlatToUV(uint materialTempDataIndexFlat, uint materialBudgetSize)
{
    uint safeMaterialBudgetSize = max(materialBudgetSize, 1u);
    return uint2(materialTempDataIndexFlat % safeMaterialBudgetSize, materialTempDataIndexFlat / safeMaterialBudgetSize);
}

void BurtXGIWriteMaterialToTempData(RWTexture2D<uint> materialTempData, uint materialTempDataIndex, uint materialBudgetSize, BurtXGIVoxelMaterialUint materialData)
{
    uint start = materialTempDataIndex * BURT_GI_XGI_MATERIAL_TEMP_DATA_SIZE;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 0u, materialBudgetSize)] = materialData.albedo.x;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 1u, materialBudgetSize)] = materialData.albedo.y;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 2u, materialBudgetSize)] = materialData.albedo.z;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 3u, materialBudgetSize)] = materialData.albedo.w;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 4u, materialBudgetSize)] = materialData.opaque;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 5u, materialBudgetSize)] = materialData.normal.x;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 6u, materialBudgetSize)] = materialData.normal.y;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 7u, materialBudgetSize)] = materialData.normal.z;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 8u, materialBudgetSize)] = materialData.emissive.x;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 9u, materialBudgetSize)] = materialData.emissive.y;
    materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 10u, materialBudgetSize)] = materialData.emissive.z;
}

BurtXGIVoxelMaterialUint BurtXGIReadMaterialFromTempData(Texture2D<uint> materialTempData, uint materialTempDataIndex, uint materialBudgetSize)
{
    BurtXGIVoxelMaterialUint materialData;
    uint start = materialTempDataIndex * BURT_GI_XGI_MATERIAL_TEMP_DATA_SIZE;
    materialData.albedo.x = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 0u, materialBudgetSize)];
    materialData.albedo.y = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 1u, materialBudgetSize)];
    materialData.albedo.z = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 2u, materialBudgetSize)];
    materialData.albedo.w = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 3u, materialBudgetSize)];
    materialData.opaque = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 4u, materialBudgetSize)];
    materialData.normal.x = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 5u, materialBudgetSize)];
    materialData.normal.y = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 6u, materialBudgetSize)];
    materialData.normal.z = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 7u, materialBudgetSize)];
    materialData.emissive.x = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 8u, materialBudgetSize)];
    materialData.emissive.y = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 9u, materialBudgetSize)];
    materialData.emissive.z = materialTempData[BurtXGIMaterialTempDataIndexFlatToUV(start + 10u, materialBudgetSize)];
    return materialData;
}

[numthreads(1, 1, 1)]
void GenMaterialArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint totalPendingCount = FillIndex == 0
        ? min(RWMaterialPendingList[BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_INDEX], (uint)max(MaxPendingListCount, 0))
        : RWTempMaterialPendingList[BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_INDEX];
    if (FillIndex == 0)
    {
        RWMaterialPendingList[BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_INDEX] = totalPendingCount;
    }

    RWTempMaterialPendingListCur[BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_INDEX] = 0u;
    RWTempMaterialPendingListNext[BURT_GI_XGI_MATERIAL_PENDING_LIST_ALLOCATOR_INDEX] = 0u;
    uint totalPendingThreadNum = BurtXGIDivRoundUp(totalPendingCount, BURT_GI_XGI_MATERIAL_PENDING_LIST_PROCESS_COUNT_PER_THREAD);
    uint totalPendingThreadNumSqrt = (uint)ceil(sqrt((float)totalPendingThreadNum));
    uint groupX = BurtXGIDivRoundUp(totalPendingThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    uint groupY = BurtXGIDivRoundUp(totalPendingThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    RWMaterialArgsBuffer[0] = groupX;
    RWMaterialArgsBuffer[1] = groupY;
    RWMaterialArgsBuffer[2] = 1u;
    RWMaterialArgsBufferParams[0] = totalPendingCount;
    RWMaterialArgsBufferParams[1] = groupX;
    if (totalPendingCount == 0u)
    {
        RWChunkUpdateArgsBuffer[0] = 0u;
        RWChunkUpdateArgsBuffer[1] = 0u;
        RWChunkUpdateArgsBuffer[2] = 0u;
    }
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void GenMaterialFillPrepare(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint totalPendingCount = _XGIGenerateVoxelOccupyMaterialFillPreparePass_ArgsBufferParams[0];
    uint groupX = max(_XGIGenerateVoxelOccupyMaterialFillPreparePass_ArgsBufferParams[1], 1u);
    uint fillIndexValue = (uint)max((int)_XGIGenerateVoxelOccupyMaterialFillPreparePass_FillIndex.x, 0);
    uint chunkCountPerTime = max((uint)_XGIGenerateVoxelOccupyMaterialFillPreparePass_FillIndex.y, 1u);

    [unroll]
    for (uint i = 0u; i < BURT_GI_XGI_MATERIAL_PENDING_LIST_PROCESS_COUNT_PER_THREAD; ++i)
    {
        uint pendingThreadIndex = dispatchThreadId.x + dispatchThreadId.y * BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE * groupX;
        pendingThreadIndex = pendingThreadIndex * BURT_GI_XGI_MATERIAL_PENDING_LIST_PROCESS_COUNT_PER_THREAD + i;
        if (pendingThreadIndex >= totalPendingCount)
        {
            break;
        }

        uint pendingListIndex = fillIndexValue == 0u
            ? pendingThreadIndex
            : _XGIGenerateVoxelOccupyMaterialFillPreparePass_TempPendingList[pendingThreadIndex + 1u];
        uint curIndex;
        InterlockedAdd(_RW_XGIGenerateVoxelOccupyMaterialFillPreparePass_TempPendingListCur[0], 1u, curIndex);
        curIndex++;
        _RW_XGIGenerateVoxelOccupyMaterialFillPreparePass_TempPendingListCur[curIndex] = pendingListIndex;
        _RW_XGIGenerateVoxelOccupyMaterialFillPreparePass_ChunkTempPendingUpdate[curIndex % chunkCountPerTime] = 1u;
    }
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void GenMaterialFillChunk(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint chunkAllocatedIndexCurTime = dispatchThreadId.x + dispatchThreadId.y * max((uint)FillChunkChunkThreadGroupNumbX, 1u) * BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE;
    if (chunkAllocatedIndexCurTime >= (uint)max(FillChunkChunkCountPerTime, 0))
    {
        return;
    }

    if (FillChunkChunkTempPendingUpdate[chunkAllocatedIndexCurTime] == 0u)
    {
        return;
    }

    uint pendingUpdateIndex;
    InterlockedAdd(RWFillChunkChunkTempPendingUpdateAllocator[0], 1u, pendingUpdateIndex);
    pendingUpdateIndex++;
    RWFillChunkChunkTempPendingUpdateAllocator[pendingUpdateIndex] = chunkAllocatedIndexCurTime;
}

[numthreads(1, 1, 1)]
void GenMaterialFillArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint chunkAllocatedIndexCount = FillArgsChunkTempPendingUpdateAllocator[0];
    uint chunkSizeInVoxel = max((uint)FillArgsChunkSizeInOccupy, 1u) * 4u;
    chunkSizeInVoxel = chunkSizeInVoxel * chunkSizeInVoxel * chunkSizeInVoxel;
    uint voxelAllocatedIndexCount = chunkAllocatedIndexCount * chunkSizeInVoxel;
    uint updateThreadNum = BurtXGIDivRoundUp(voxelAllocatedIndexCount, BURT_GI_XGI_CHUNK_UPDATE_PROCESS_COUNT_PER_THREAD);
    uint updateThreadNumSqrt = (uint)ceil(sqrt((float)updateThreadNum));
    uint updateGroupX = BurtXGIDivRoundUp(updateThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    uint updateGroupY = BurtXGIDivRoundUp(updateThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    RWFillArgsChunkUpdateArgsBuffer[0] = updateGroupX;
    RWFillArgsChunkUpdateArgsBuffer[1] = updateGroupY;
    RWFillArgsChunkUpdateArgsBuffer[2] = 1u;
    RWFillArgsChunkUpdateArgsBufferParams[0] = chunkAllocatedIndexCount;
    RWFillArgsChunkUpdateArgsBufferParams[1] = updateGroupX;

    uint clearThreadNum = voxelAllocatedIndexCount * BURT_GI_XGI_MATERIAL_TEMP_DATA_SIZE;
    uint clearThreadNumSqrt = (uint)ceil(sqrt((float)clearThreadNum));
    uint clearGroupX = BurtXGIDivRoundUp(clearThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    uint clearGroupY = BurtXGIDivRoundUp(clearThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    RWFillArgsChunkUpdateClearArgsBuffer[0] = clearGroupX;
    RWFillArgsChunkUpdateClearArgsBuffer[1] = clearGroupY;
    RWFillArgsChunkUpdateClearArgsBuffer[2] = 1u;
    RWFillArgsChunkUpdateClearArgsBufferParams[0] = chunkAllocatedIndexCount;
    RWFillArgsChunkUpdateClearArgsBufferParams[1] = clearGroupX;

    uint materialTempPendingListCount = FillArgsMaterialTempPendingListCur[0];
    uint materialThreadNum = BurtXGIDivRoundUp(materialTempPendingListCount, BURT_GI_XGI_MATERIAL_PENDING_LIST_PROCESS_COUNT_PER_THREAD);
    uint materialThreadNumSqrt = (uint)ceil(sqrt((float)materialThreadNum));
    uint materialGroupX = BurtXGIDivRoundUp(materialThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    uint materialGroupY = BurtXGIDivRoundUp(materialThreadNumSqrt, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE);
    RWFillArgsMaterialFillArgsBuffer[0] = materialGroupX;
    RWFillArgsMaterialFillArgsBuffer[1] = materialGroupY;
    RWFillArgsMaterialFillArgsBuffer[2] = 1u;
    RWFillArgsMaterialFillArgsBufferParams[0] = materialTempPendingListCount;
    RWFillArgsMaterialFillArgsBufferParams[1] = materialGroupX;
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void GenMaterialFillClear(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint groupX = max(FillClearChunkUpdateArgsBufferParams[1], 1u);
    uint clearIndex = dispatchThreadId.x + dispatchThreadId.y * groupX * BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE;
    uint materialBudgetSize = (uint)max(FillClearMaterialBudgetSize, 1);
    _RW_XGIGenerateVoxelOccupyMaterialFillPass_MaterialTempData[BurtXGIMaterialTempDataIndexFlatToUV(clearIndex, materialBudgetSize)] = 0u;
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void GenMaterialFill(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint totalPendingCount = _XGIGenerateVoxelOccupyMaterialFillPass_ArgsBufferParams[0];
    uint groupX = max(_XGIGenerateVoxelOccupyMaterialFillPass_ArgsBufferParams[1], 1u);
    uint materialBudgetSize = (uint)max((int)_XGIGenerateVoxelOccupyMaterialFillPass_MaterialBudgetSize.x, 1);
    uint fillChunkCountPerTime = max((uint)_XGIGenerateVoxelOccupyMaterialFillPass_FillIndex.y, 1u);
    uint fillIndexValue = (uint)max((int)_XGIGenerateVoxelOccupyMaterialFillPass_FillIndex.x, 0);

    [unroll]
    for (uint i = 0u; i < BURT_GI_XGI_MATERIAL_PENDING_LIST_PROCESS_COUNT_PER_THREAD; ++i)
    {
        uint pendingThreadIndex = dispatchThreadId.x + dispatchThreadId.y * BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE * groupX;
        pendingThreadIndex = pendingThreadIndex * BURT_GI_XGI_MATERIAL_PENDING_LIST_PROCESS_COUNT_PER_THREAD + i;
        if (pendingThreadIndex >= totalPendingCount)
        {
            break;
        }

        uint pendingListIndex = _XGIGenerateVoxelOccupyMaterialFillPass_TempPendingListCur[pendingThreadIndex + 1u];
        BurtXGIVoxelMaterialPendingData pendingData = BurtXGIReadMaterialFromPendingList(_XGIGenerateVoxelOccupyMaterialFillPass_PendingList, pendingListIndex);
        uint nodeIndexFlat;
        BurtXGIVoxelMaterialUint materialData = BurtXGIPendingDataToMaterialUint(pendingData, nodeIndexFlat);
        uint tempMaterialIndex = pendingThreadIndex + fillIndexValue * fillChunkCountPerTime;
        BurtXGIWriteMaterialToTempData(_RW_XGIGenerateVoxelOccupyMaterialFillPass_MaterialTempData, tempMaterialIndex, materialBudgetSize, materialData);
    }
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void GenMaterialPopulate(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint chunkAllocatedIndexCount = _XGIGenerateVoxelOccupyMaterialPopulatePass_ArgsBufferParams[0];
    uint groupX = max(_XGIGenerateVoxelOccupyMaterialPopulatePass_ArgsBufferParams[1], 1u);
    uint fillChunkCountPerTime = max((uint)_XGIGenerateVoxelOccupyMaterialPopulatePass_FillIndex.y, 1u);
    uint fillIndexValue = (uint)max((int)_XGIGenerateVoxelOccupyMaterialPopulatePass_FillIndex.x, 0);
    uint materialBudgetSize = (uint)max((int)_XGIGenerateVoxelOccupyMaterialPopulatePass_MaterialBudgetSize.x, 1);
    uint materialAtlasSize = (uint)max((int)_XGIGenerateVoxelOccupyMaterialPopulatePass_FillIndex.w, 1);
    uint chunkSizeInVoxel = max((uint)_XGIGenerateVoxelOccupyMaterialPopulatePass_FillIndex.z, 1u) * 4u;
    chunkSizeInVoxel = chunkSizeInVoxel * chunkSizeInVoxel * chunkSizeInVoxel;

    [unroll]
    for (uint i = 0u; i < BURT_GI_XGI_CHUNK_UPDATE_PROCESS_COUNT_PER_THREAD; ++i)
    {
        uint threadIndex = dispatchThreadId.x + dispatchThreadId.y * groupX * BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE;
        threadIndex = threadIndex * BURT_GI_XGI_CHUNK_UPDATE_PROCESS_COUNT_PER_THREAD + i;
        uint chunkAllocatedIndexPending = threadIndex / max(chunkSizeInVoxel, 1u);
        if (chunkAllocatedIndexPending >= chunkAllocatedIndexCount)
        {
            break;
        }

        uint chunkAllocatedIndexCurTime = _XGIGenerateVoxelOccupyMaterialPopulatePass_ChunkPendingUpdateAllocator[chunkAllocatedIndexPending + 1u];
        uint localVoxelIndexInCurChunkFlat = threadIndex % max(chunkSizeInVoxel, 1u);
        uint localVoxelIndexInTempMaterialData = localVoxelIndexInCurChunkFlat + chunkAllocatedIndexCurTime * max(chunkSizeInVoxel, 1u);
        BurtXGIVoxelMaterialUint materialUint = BurtXGIReadMaterialFromTempData(_XGIGenerateVoxelOccupyMaterialPopulatePass_TempData, localVoxelIndexInTempMaterialData, materialBudgetSize);
        uint voxelIndexInMaterialAtlasFlat = localVoxelIndexInTempMaterialData + fillIndexValue * fillChunkCountPerTime * max(chunkSizeInVoxel, 1u);
        uint2 uv = BurtXGIMaterialAtlasUV(voxelIndexInMaterialAtlasFlat, materialAtlasSize);
        BurtXGIVoxelMaterialFloat materialFloat = BurtXGIMaterialUintToFloat(materialUint);
        _RW_XGIGenerateVoxelOccupyMaterialPopulatePass_MaterialAtlasAlbedo[uv] = float4(saturate(materialFloat.albedo), saturate(materialFloat.opaque));
        _RW_XGIGenerateVoxelOccupyMaterialPopulatePass_MaterialAtlasNormal[uv] = saturate(materialFloat.normal.xy * 0.5 + 0.5);
        _RW_XGIGenerateVoxelOccupyMaterialPopulatePass_MaterialAtlasEmissive[uv] = max(materialFloat.emissive, 0.0);
    }
}

[numthreads(1, 1, 1)]
void DebugGenArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    RWDebugArgsBuffer[0] = (uint)DebugArgsData.x;
    RWDebugArgsBuffer[2] = (uint)DebugArgsData.y;
    RWDebugArgsBuffer[3] = (uint)DebugArgsData.z;
    RWDebugArgsBuffer[4] = (uint)DebugArgsData.w;

    uint totalNodeCount = VoxelNodeDataCulled[0];
    uint totalVoxelCount = totalNodeCount > (0xffffffffu / BURT_GI_XGI_OCCUPY_SIZE_CUBIC)
        ? 0xffffffffu
        : totalNodeCount * BURT_GI_XGI_OCCUPY_SIZE_CUBIC;
    RWDebugArgsBuffer[1] = totalVoxelCount;

    RWDebugProbeArgsBuffer[0] = (uint)DebugProbeArgsData.x;
    RWDebugProbeArgsBuffer[2] = (uint)DebugProbeArgsData.y;
    RWDebugProbeArgsBuffer[3] = (uint)DebugProbeArgsData.z;
    RWDebugProbeArgsBuffer[4] = (uint)DebugProbeArgsData.w;

    uint probeCount = 0u;
    int clipmapCount = max(DebugProbeArgsClipmapCount, 0);
    [loop]
    for (int i = 0; i < clipmapCount; ++i)
    {
        RWDebugProbeArgsBufferParams[i] = probeCount;
        probeCount += DebugProbePlaceProbeIndex[i];
    }

    probeCount = min(probeCount, (uint)max(DebugProbeArgsMaxCount, 0));
    [loop]
    for (int j = clipmapCount; j <= (int)BURT_GI_XGI_DEBUG_PROBE_ARGS_DATA_ALLOCATOR_OFFSET; ++j)
    {
        RWDebugProbeArgsBufferParams[j] = probeCount;
    }

    RWDebugProbeArgsBuffer[1] = probeCount;
}

[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void DebugProbeCompactFromOccupancy(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint probeNodeSize = max((uint)DebugProbeCompactParams.x, 1u);
    if (any(dispatchThreadId >= probeNodeSize))
    {
        return;
    }

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelOccupancyMipReadTexture.GetDimensions(width, height, depth);
    uint3 occupancySize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    uint3 occupancyCoord = min((dispatchThreadId * occupancySize) / probeNodeSize, occupancySize - 1u);
    float4 occupancyValue = _BurtGISceneVoxelOccupancyMipReadTexture.Load(int4((int3)occupancyCoord, 0));
    float occupancy = max(max(occupancyValue.r, occupancyValue.g), max(occupancyValue.b, occupancyValue.a));
    if (occupancy <= max(DebugProbeCompactParams.w, 0.0001))
    {
        return;
    }

    uint compactIndex = 0u;
    InterlockedAdd(RWDebugProbePlaceProbeIndex[0], 1u, compactIndex);
    uint maxCompactProbes = max((uint)DebugProbeCompactParams.y, 1u);
    if (compactIndex >= maxCompactProbes)
    {
        return;
    }

    uint indexOffset = max((uint)DebugProbeCompactParams.z, 1u);
    RWDebugProbePlaceProbeIndex[indexOffset + compactIndex] =
        dispatchThreadId.x + dispatchThreadId.z * probeNodeSize + dispatchThreadId.y * probeNodeSize * probeNodeSize;
}

[numthreads(1, 1, 1)]
void DebugProbeGenArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    RWDebugProbeArgsBuffer[0] = (uint)DebugProbeArgsData.x;
    RWDebugProbeArgsBuffer[2] = (uint)DebugProbeArgsData.y;
    RWDebugProbeArgsBuffer[3] = (uint)DebugProbeArgsData.z;
    RWDebugProbeArgsBuffer[4] = (uint)DebugProbeArgsData.w;

    uint probeCount = 0u;
    int clipmapCount = max(DebugProbeArgsClipmapCount, 0);
    [loop]
    for (int i = 0; i < clipmapCount; ++i)
    {
        RWDebugProbeArgsBufferParams[i] = probeCount;
        probeCount += DebugProbePlaceProbeIndex[i];
    }

    probeCount = min(probeCount, (uint)max(DebugProbeArgsMaxCount, 0));
    [loop]
    for (int j = clipmapCount; j <= (int)BURT_GI_XGI_DEBUG_PROBE_ARGS_DATA_ALLOCATOR_OFFSET; ++j)
    {
        RWDebugProbeArgsBufferParams[j] = probeCount;
    }

    RWDebugProbeArgsBuffer[1] = probeCount;
}

[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void DebugCulling(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint textureSize = max((uint)_XGIVoxelApply_TextureSize.x, 1u);
    uint clipmapCount = max((uint)_XGIVoxelApply_ClipmapCount.x, 1u);
    uint mipLevel = (uint)max(MipLevel, 0);
    uint textureSizeCurMip = BurtGIXGIVoxelMipSize(textureSize, mipLevel);
    uint clipmapIndex = dispatchThreadId.z / textureSizeCurMip;
    if (clipmapIndex >= clipmapCount)
    {
        return;
    }

    uint3 nodeIndex = uint3(dispatchThreadId.x, dispatchThreadId.y, dispatchThreadId.z % textureSizeCurMip);
    if (any(nodeIndex >= textureSizeCurMip))
    {
        return;
    }

    uint3 occupancyCoord = uint3(nodeIndex.xy, nodeIndex.z + clipmapIndex * textureSizeCurMip);
    uint occupancyValue = _XGIVoxelApply_VoxelOccupyTexture.Load(int4((int)occupancyCoord.x, (int)occupancyCoord.y, (int)occupancyCoord.z, 0));
    if (occupancyValue == 0u)
    {
        return;
    }

    float3 volumeOffsetWS = _XGIVoxelApply_VolumeOffsetsWS[clipmapIndex].xyz;
    float3 volumeSizeWS = _XGIVoxelApply_VolumeSizesWS[clipmapIndex].xyz;
    float3 boundsMin = ((float3)nodeIndex / (float)textureSizeCurMip) * volumeSizeWS + volumeOffsetWS;
    float3 boundsMax = ((float3)(nodeIndex + 1u) / (float)textureSizeCurMip) * volumeSizeWS + volumeOffsetWS;
    float3 boundsCenter = (boundsMin + boundsMax) * 0.5;
    if (length(boundsCenter - CameraPos.xyz) >= CullingDistance)
    {
        return;
    }

    if (!BurtGIXGIFrustumAABBIntersect(boundsMin, boundsMax))
    {
        return;
    }

    uint allocatedIndex;
    InterlockedAdd(RWVoxelNodeDataCulled[0], 1u, allocatedIndex);
    allocatedIndex++;
    uint3 nodeIndexWithClipmap = dispatchThreadId.xyz;
    RWVoxelNodeDataCulled[allocatedIndex] = BurtGIXGIVoxelNodeIndex2Flat(nodeIndexWithClipmap, textureSizeCurMip, clipmapCount);
}

[numthreads(BURT_GI_SCENE_VOXEL_OCCUPY_DEBUG_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPY_DEBUG_THREADGROUP_SIZE, 1)]
void SceneRepresentVoxelOccupyDebug(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint outputWidth;
    uint outputHeight;
    RWDebugOccupyPass_RenderTarget.GetDimensions(outputWidth, outputHeight);
    uint2 outputSize = uint2(outputWidth, outputHeight);
    uint2 pixelCoord = dispatchThreadId.xy;
    if (any(pixelCoord >= outputSize))
    {
        return;
    }

    uint volumeWidth;
    uint volumeHeight;
    uint volumeDepth;
    _BurtGISceneVoxelOccupancyMipReadTexture.GetDimensions(volumeWidth, volumeHeight, volumeDepth);
    uint3 volumeSize = max(uint3(volumeWidth, volumeHeight, volumeDepth), uint3(1u, 1u, 1u));
    float2 screenUV = ((float2)pixelCoord + 0.5) / max((float2)outputSize, 1.0);
    float3 rayOriginWS = _BurtDeferredCameraWorldPosition.xyz;
    float3 farPositionWS = BurtGISceneVoxelReconstructPositionWS(screenUV, 1.0);
    float3 rayDirectionWS = BurtGISceneVoxelSafeNormalize(farPositionWS - rayOriginWS, float3(0.0, 0.0, 1.0));
    float3 boxMinWS = BurtGISceneVoxelUVWToWorld(float3(0.0, 0.0, 0.0));
    float3 boxMaxWS = BurtGISceneVoxelUVWToWorld(float3(1.0, 1.0, 1.0));
    float3 safeDirection = float3(
        abs(rayDirectionWS.x) > 1.0e-5 ? rayDirectionWS.x : (rayDirectionWS.x < 0.0 ? -1.0e-5 : 1.0e-5),
        abs(rayDirectionWS.y) > 1.0e-5 ? rayDirectionWS.y : (rayDirectionWS.y < 0.0 ? -1.0e-5 : 1.0e-5),
        abs(rayDirectionWS.z) > 1.0e-5 ? rayDirectionWS.z : (rayDirectionWS.z < 0.0 ? -1.0e-5 : 1.0e-5));
    float3 invDirection = rcp(safeDirection);
    float3 t0 = (boxMinWS - rayOriginWS) * invDirection;
    float3 t1 = (boxMaxWS - rayOriginWS) * invDirection;
    float3 tMin3 = min(t0, t1);
    float3 tMax3 = max(t0, t1);
    float tMin = max(max(tMin3.x, tMin3.y), max(tMin3.z, 0.0));
    float tMax = min(tMax3.x, min(tMax3.y, tMax3.z));
    if (tMax <= tMin)
    {
        RWDebugOccupyPass_RenderTarget[pixelCoord] = float4(0.0, 0.0, 0.0, 0.0);
        return;
    }

    uint maxSteps = 64u;
    float traceLength = tMax - tMin;
    float bestOccupancy = 0.0;
    float3 bestUVW = 0.0;
    uint hitStep = maxSteps;
    [loop]
    for (uint stepIndex = 0u; stepIndex < maxSteps; ++stepIndex)
    {
        float stepT = ((float)stepIndex + 0.5) / (float)maxSteps;
        float3 samplePositionWS = rayOriginWS + rayDirectionWS * (tMin + traceLength * stepT);
        float3 uvw = BurtGISceneVoxelWorldToUVW(samplePositionWS);
        uint3 coord = min((uint3)(saturate(uvw) * (float3)volumeSize), volumeSize - 1u);
        float occupancy = saturate(_BurtGISceneVoxelOccupancyMipReadTexture.Load(int4(coord, 0)).a);
        if (occupancy > bestOccupancy)
        {
            bestOccupancy = occupancy;
            bestUVW = uvw;
            hitStep = stepIndex;
        }

        if (occupancy > 0.5)
        {
            break;
        }
    }

    if (bestOccupancy <= 0.0001)
    {
        RWDebugOccupyPass_RenderTarget[pixelCoord] = float4(0.0, 0.0, 0.0, 0.0);
        return;
    }

    float stepHeat = 1.0 - saturate((float)hitStep / (float)maxSteps);
    float3 color = BurtGISceneVoxelDebugHeatmap(stepHeat) * lerp(0.35, 1.0, bestOccupancy);
    if (_BurtGISceneVoxelDebugProbeParams.x > 0.5)
    {
        float extentWS = max(_BurtGISceneVoxelCenterExtent.w * 2.0, 0.001);
        float probeSizeWS = clamp(_BurtGISceneVoxelDebugProbeParams.y, 0.01, 2.0);
        float probeGridResolution = clamp(extentWS / probeSizeWS, 4.0, 128.0);
        float3 probeCell = abs(frac(bestUVW * probeGridResolution) - 0.5);
        float marker = 1.0 - smoothstep(0.11, 0.22, length(probeCell));
        color = lerp(color, float3(1.0, 0.18, 0.48), marker * 0.85);
    }
    RWDebugOccupyPass_RenderTarget[pixelCoord] = float4(color, bestOccupancy);
}

[numthreads(BURT_GI_SCENE_VOXEL_OCCUPY_DEBUG_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPY_DEBUG_THREADGROUP_SIZE, 1)]
void VoxelDebugTraceCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    SceneRepresentVoxelOccupyDebug(dispatchThreadId);
}

[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void SceneVoxelClearLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    if (dispatchThreadId.x >= width || dispatchThreadId.y >= height || dispatchThreadId.z >= depth)
    {
        return;
    }

    _BurtGISceneVoxelRadianceTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
    _BurtGISceneVoxelGeometryTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
    _BurtGISceneVoxelLightingTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
}

[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void SceneVoxelReprojectHistoryCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = uint3(width, height, depth);
    if (any(dispatchThreadId >= volumeSize))
    {
        return;
    }

    float3 currentUVW = (float3(dispatchThreadId) + 0.5) / max(float3(volumeSize), 1.0);
    float3 worldPosition = (currentUVW * 2.0 - 1.0) * _BurtGISceneVoxelHistoryCurrentCenterExtent.www + _BurtGISceneVoxelHistoryCurrentCenterExtent.xyz;
    float3 historyUVW = (worldPosition - _BurtGISceneVoxelHistoryPreviousCenterExtent.xyz) /
        max(_BurtGISceneVoxelHistoryPreviousCenterExtent.www, 0.0001) * 0.5 + 0.5;
    if (any(historyUVW < 0.0) || any(historyUVW > 1.0))
    {
        return;
    }

    float historyExposureCorrection = max(_BurtGISceneVoxelHistoryParams.x, 0.0);
    float4 historyRadiance = _BurtGISceneVoxelHistoryRadianceTexture.SampleLevel(sampler_BurtGISceneVoxelHistoryRadianceTexture, historyUVW, 0.0);
    float4 historyLighting = _BurtGISceneVoxelHistoryLightingTexture.SampleLevel(sampler_BurtGISceneVoxelHistoryLightingTexture, historyUVW, 0.0);
    historyRadiance.rgb = max(historyRadiance.rgb * historyExposureCorrection, 0.0);
    historyLighting.rgb = max(historyLighting.rgb * historyExposureCorrection, 0.0);
    _BurtGISceneVoxelRadianceTexture[dispatchThreadId] = historyRadiance;
    _BurtGISceneVoxelGeometryTexture[dispatchThreadId] = _BurtGISceneVoxelHistoryGeometryTexture.SampleLevel(sampler_BurtGISceneVoxelHistoryGeometryTexture, historyUVW, 0.0);
    _BurtGISceneVoxelLightingTexture[dispatchThreadId] = historyLighting;
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void SceneVoxelPopulateScreenProbesLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 screenProbeGridSize = BurtGIScreenProbeGridSize();
    uint2 screenProbeCoord = dispatchThreadId.xy;
    if (screenProbeCoord.x >= screenProbeGridSize.x || screenProbeCoord.y >= screenProbeGridSize.y)
    {
        return;
    }

    float4 worldPositionValue = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    if (worldPositionValue.w <= 0.0001)
    {
        return;
    }

    float4 worldNormalValue = _BurtGIScreenProbeWorldNormalTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    if (worldNormalValue.w <= 0.0001)
    {
        return;
    }

    float3 decodedWorldNormal = worldNormalValue.xyz * 2.0 - 1.0;
    float normalLengthSq = dot(decodedWorldNormal, decodedWorldNormal);
    if (normalLengthSq <= 0.0001)
    {
        return;
    }

    float3 normalWS = decodedWorldNormal * rsqrt(normalLengthSq);
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGISceneVoxelWorldToUVW(worldPositionValue.xyz);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return;
    }

    uint rawWidth;
    uint rawHeight;
    _BurtScreenSpaceGlobalIlluminationRawTexture.GetDimensions(rawWidth, rawHeight);
    uint2 rawSize = max(uint2(rawWidth, rawHeight), uint2(1u, 1u));
    float2 sourceUV = (float2(screenProbeCoord) + 0.5) / (float2)screenProbeGridSize;
    uint2 rawCoord = min((uint2)(saturate(sourceUV) * (float2)rawSize), rawSize - 1u);
    float3 radiance = max(_BurtScreenSpaceGlobalIlluminationRawTexture.Load(int3((int)rawCoord.x, (int)rawCoord.y, 0)).rgb, 0.0);
    float confidence = saturate(worldPositionValue.w * worldNormalValue.w);
    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 existingRadiance = _BurtGISceneVoxelRadianceTexture[voxelCoord];
    float4 existingGeometry = _BurtGISceneVoxelGeometryTexture[voxelCoord];
    float maxSampleCount = max(_BurtGISceneVoxelTraceControls.z, 1.0);
    float sourceConfidence = saturate(max(existingRadiance.a, existingGeometry.a));
    float sourceSampleCount = sourceConfidence * maxSampleCount;
    float screenWeight = confidence * (1.0 - sourceConfidence * 0.75);
    float totalWeight = max(sourceConfidence + screenWeight, 0.0001);
    float3 existingNormalWS = existingGeometry.xyz * 2.0 - 1.0;
    float existingNormalLengthSq = dot(existingNormalWS, existingNormalWS);
    existingNormalWS = existingNormalLengthSq > 0.0001 ? existingNormalWS * rsqrt(existingNormalLengthSq) : normalWS;
    float3 blendedNormalWS = existingNormalWS * sourceConfidence + normalWS * screenWeight;
    float blendedNormalLengthSq = dot(blendedNormalWS, blendedNormalWS);
    blendedNormalWS = blendedNormalLengthSq > 0.0001 ? blendedNormalWS * rsqrt(blendedNormalLengthSq) : normalWS;
    float3 blendedRadiance = (max(existingRadiance.rgb, 0.0) * sourceConfidence + radiance * screenWeight) / totalWeight;
    float blendedConfidence = saturate(min(sourceSampleCount + confidence, maxSampleCount) / maxSampleCount);
    _BurtGISceneVoxelRadianceTexture[voxelCoord] = float4(blendedRadiance, blendedConfidence);
    _BurtGISceneVoxelGeometryTexture[voxelCoord] = float4(blendedNormalWS * 0.5 + 0.5, blendedConfidence);
}

[numthreads(64, 1, 1)]
void SceneVoxelVoxelizeTrianglesCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint triangleIndex = dispatchThreadId.x;
    if (triangleIndex >= _BurtGISceneVoxelTriangleCount)
    {
        return;
    }

    BurtGISceneVoxelTriangle voxelTriangle = _BurtGISceneVoxelTriangleBuffer[triangleIndex];
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float voxelSizeWS = max(_BurtGISceneVoxelCenterExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float edgeLength01 = length(voxelTriangle.Position1 - voxelTriangle.Position0);
    float edgeLength12 = length(voxelTriangle.Position2 - voxelTriangle.Position1);
    float edgeLength20 = length(voxelTriangle.Position0 - voxelTriangle.Position2);
    float materialEnabled = _BurtGISceneVoxelMaterialParams.z > 0.5 ? 1.0 : 0.0;
    uint materialSampleResolutionCap = (uint)clamp(_BurtGISceneVoxelMaterialParams.w, 1.0, 16.0);
    uint sampleResolution = (uint)clamp(ceil(max(edgeLength01, max(edgeLength12, edgeLength20)) / voxelSizeWS), 1.0, (float)materialSampleResolutionCap);
    float3 normalWS = BurtGISceneVoxelSafeNormalize(voxelTriangle.Normal, float3(0.0, 1.0, 0.0));
    float3 materialAlbedo = lerp(float3(1.0, 1.0, 1.0), max(voxelTriangle.Albedo, 0.0), materialEnabled);
    float3 materialEmission = max(voxelTriangle.Emission, 0.0) * materialEnabled;
    float3 baseColorBoosted = min(saturate(pow(materialAlbedo, _BurtGISceneVoxelLightingParams.x)), 0.99);
    float3 radiance = baseColorBoosted * 0.12 + materialEmission;

    [loop]
    for (uint sampleY = 0u; sampleY <= sampleResolution; ++sampleY)
    {
        [loop]
        for (uint sampleX = 0u; sampleX <= sampleResolution - sampleY; ++sampleX)
        {
            float barycentricY = (float)sampleY / max((float)sampleResolution, 1.0);
            float barycentricX = (float)sampleX / max((float)sampleResolution, 1.0);
            float barycentricZ = 1.0 - barycentricX - barycentricY;
            float3 samplePosition = voxelTriangle.Position0 * barycentricZ + voxelTriangle.Position1 * barycentricX + voxelTriangle.Position2 * barycentricY;
            float3 uvw = BurtGISceneVoxelWorldToUVW(samplePosition);
            if (any(uvw < 0.0) || any(uvw > 1.0))
            {
                continue;
            }

            uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
            float4 previousRadiance = _BurtGISceneVoxelRadianceTexture[voxelCoord];
            float4 previousGeometry = _BurtGISceneVoxelGeometryTexture[voxelCoord];
            float previousConfidence = saturate(max(previousRadiance.a, previousGeometry.a));
            float writeWeight = 1.0 / max(1.0 + previousConfidence, 1.0);
            float3 blendedRadiance = lerp(max(previousRadiance.rgb, 0.0), radiance, writeWeight);
            float3 previousNormalWS = previousGeometry.xyz * 2.0 - 1.0;
            float previousNormalLengthSq = dot(previousNormalWS, previousNormalWS);
            previousNormalWS = previousNormalLengthSq > 0.0001 ? previousNormalWS * rsqrt(previousNormalLengthSq) : normalWS;
            float3 blendedNormalWS = BurtGISceneVoxelSafeNormalize(lerp(previousNormalWS, normalWS, writeWeight), normalWS);
            _BurtGISceneVoxelRadianceTexture[voxelCoord] = float4(blendedRadiance, 1.0);
            _BurtGISceneVoxelGeometryTexture[voxelCoord] = float4(blendedNormalWS * 0.5 + 0.5, 1.0);
        }
    }
}

void BurtGISceneVoxelBuildOccupancyMip(uint3 dispatchThreadId)
{
    uint mipWidth;
    uint mipHeight;
    uint mipDepth;
    _BurtGISceneVoxelOccupancyMipTexture.GetDimensions(mipWidth, mipHeight, mipDepth);
    if (dispatchThreadId.x >= mipWidth || dispatchThreadId.y >= mipHeight || dispatchThreadId.z >= mipDepth)
    {
        return;
    }

    uint sourceWidth;
    uint sourceHeight;
    uint sourceDepth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(sourceWidth, sourceHeight, sourceDepth);
    uint3 sourceSize = max(uint3(sourceWidth, sourceHeight, sourceDepth), uint3(1u, 1u, 1u));
    uint3 mipSize = max(uint3(mipWidth, mipHeight, mipDepth), uint3(1u, 1u, 1u));
    uint3 blockSize = max(sourceSize / mipSize, uint3(1u, 1u, 1u));
    uint3 sourceBase = dispatchThreadId * blockSize;

    float maxOccupancy = 0.0;
    float occupancySum = 0.0;
    float sampleCount = 0.0;

    [loop]
    for (uint z = 0u; z < blockSize.z; ++z)
    {
        [loop]
        for (uint y = 0u; y < blockSize.y; ++y)
        {
            [loop]
            for (uint x = 0u; x < blockSize.x; ++x)
            {
                uint3 sourceCoord = min(sourceBase + uint3(x, y, z), sourceSize - 1u);
                float occupancy = saturate(_BurtGISceneVoxelGeometryReadTexture.Load(int4((int)sourceCoord.x, (int)sourceCoord.y, (int)sourceCoord.z, 0)).a);
                maxOccupancy = max(maxOccupancy, occupancy);
                occupancySum += occupancy;
                sampleCount += 1.0;
            }
        }
    }

    float meanOccupancy = sampleCount > 0.0 ? occupancySum / sampleCount : 0.0;
    _BurtGISceneVoxelOccupancyMipTexture[dispatchThreadId] = float4(maxOccupancy, meanOccupancy, saturate(occupancySum), 1.0);
}

[numthreads(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE)]
void SceneVoxelBuildOccupancyMipLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGISceneVoxelBuildOccupancyMip(dispatchThreadId);
}

[numthreads(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE)]
void SceneRepresentVoxelOccupyBuild(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGISceneVoxelBuildOccupancyMip(dispatchThreadId);
}

void BurtGISceneVoxelDownsampleOccupancyMip(uint3 dispatchThreadId)
{
    uint targetWidth;
    uint targetHeight;
    uint targetDepth;
    _BurtGISceneVoxelOccupancyMipTexture.GetDimensions(targetWidth, targetHeight, targetDepth);
    uint3 targetSize = max(uint3(targetWidth, targetHeight, targetDepth), uint3(1u, 1u, 1u));
    if (any(dispatchThreadId >= targetSize))
    {
        return;
    }

    uint3 sourceSize = max(targetSize * 2u, uint3(1u, 1u, 1u));
    uint3 sourceBase = dispatchThreadId * 2u;
    float maxOccupancy = 0.0;
    float meanOccupancy = 0.0;
    float coverage = 0.0;

    [unroll]
    for (uint z = 0u; z < 2u; ++z)
    {
        [unroll]
        for (uint y = 0u; y < 2u; ++y)
        {
            [unroll]
            for (uint x = 0u; x < 2u; ++x)
            {
                uint3 sourceCoord = min(sourceBase + uint3(x, y, z), sourceSize - 1u);
                float4 sourceOccupancy = _BurtGISceneVoxelOccupancyMipReadTexture.Load(int4(
                    (int)sourceCoord.x,
                    (int)sourceCoord.y,
                    (int)sourceCoord.z,
                    (int)_BurtGISceneVoxelOccupancyMipSourceMip));
                maxOccupancy = max(maxOccupancy, saturate(sourceOccupancy.x));
                meanOccupancy += saturate(sourceOccupancy.y);
                coverage += saturate(sourceOccupancy.z);
            }
        }
    }

    _BurtGISceneVoxelOccupancyMipTexture[dispatchThreadId] = float4(
        maxOccupancy,
        meanOccupancy * 0.125,
        saturate(coverage * 0.125),
        1.0);
}

[numthreads(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE)]
void SceneVoxelDownsampleOccupancyMipCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGISceneVoxelDownsampleOccupancyMip(dispatchThreadId);
}

[numthreads(8, 8, 8)]
void SceneRepresentVoxelGenMipCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGISceneVoxelDownsampleOccupancyMip(dispatchThreadId);
}

[numthreads(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE)]
void VoxelGenMip(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGISceneVoxelDownsampleOccupancyMip(dispatchThreadId);
}
