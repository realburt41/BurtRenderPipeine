uint2 BurtGIScreenProbeGridSize()
{
    return max(uint2(1u, 1u), (uint2)_BurtGIScreenProbeGridParams.xy);
}
float3 BurtGISceneVoxelWorldToUVW(float3 worldPosition)
{
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float extent = max(centerExtent.w, 0.001);
    return (worldPosition - centerExtent.xyz) / (extent * 2.0) + 0.5;
}
float3 BurtGISceneVoxelSafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001 ? value * rsqrt(lengthSq) : fallback;
}
[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void SceneVoxelClearLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    if (dispatchThreadId.x >= width || dispatchThreadId.y >= height || dispatchThreadId.z >= depth)
    {
        return;
    }

    _BurtGISceneVoxelRadianceTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
    _BurtGISceneVoxelGeometryTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
    _BurtGISceneVoxelLightingTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
}
[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void SceneVoxelReprojectHistoryCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = uint3(width, height, depth);
    if (any(dispatchThreadId >= volumeSize))
    {
        return;
    }

    float3 currentUVW = (float3(dispatchThreadId) + 0.5) / max(float3(volumeSize), 1.0);
    float3 worldPosition = (currentUVW * 2.0 - 1.0) * _BurtGISceneVoxelHistoryCurrentCenterExtent.www + _BurtGISceneVoxelHistoryCurrentCenterExtent.xyz;
    float3 historyUVW = (worldPosition - _BurtGISceneVoxelHistoryPreviousCenterExtent.xyz) /
        max(_BurtGISceneVoxelHistoryPreviousCenterExtent.www, 0.0001) * 0.5 + 0.5;
    if (any(historyUVW < 0.0) || any(historyUVW > 1.0))
    {
        return;
    }

    float historyExposureCorrection = max(_BurtGISceneVoxelHistoryParams.x, 0.0);
    float4 historyRadiance = _BurtGISceneVoxelHistoryRadianceTexture.SampleLevel(sampler_BurtGISceneVoxelHistoryRadianceTexture, historyUVW, 0.0);
    float4 historyLighting = _BurtGISceneVoxelHistoryLightingTexture.SampleLevel(sampler_BurtGISceneVoxelHistoryLightingTexture, historyUVW, 0.0);
    historyRadiance.rgb = max(historyRadiance.rgb * historyExposureCorrection, 0.0);
    historyLighting.rgb = max(historyLighting.rgb * historyExposureCorrection, 0.0);
    _BurtGISceneVoxelRadianceTexture[dispatchThreadId] = historyRadiance;
    _BurtGISceneVoxelGeometryTexture[dispatchThreadId] = _BurtGISceneVoxelHistoryGeometryTexture.SampleLevel(sampler_BurtGISceneVoxelHistoryGeometryTexture, historyUVW, 0.0);
    _BurtGISceneVoxelLightingTexture[dispatchThreadId] = historyLighting;
}
[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void SceneVoxelPopulateScreenProbesLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 screenProbeGridSize = BurtGIScreenProbeGridSize();
    uint2 screenProbeCoord = dispatchThreadId.xy;
    if (screenProbeCoord.x >= screenProbeGridSize.x || screenProbeCoord.y >= screenProbeGridSize.y)
    {
        return;
    }

    float4 worldPositionValue = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    if (worldPositionValue.w <= 0.0001)
    {
        return;
    }

    float4 worldNormalValue = _BurtGIScreenProbeWorldNormalTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    if (worldNormalValue.w <= 0.0001)
    {
        return;
    }

    float3 decodedWorldNormal = worldNormalValue.xyz * 2.0 - 1.0;
    float normalLengthSq = dot(decodedWorldNormal, decodedWorldNormal);
    if (normalLengthSq <= 0.0001)
    {
        return;
    }

    float3 normalWS = decodedWorldNormal * rsqrt(normalLengthSq);
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGISceneVoxelWorldToUVW(worldPositionValue.xyz);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return;
    }

    uint rawWidth;
    uint rawHeight;
    _BurtScreenSpaceGlobalIlluminationRawTexture.GetDimensions(rawWidth, rawHeight);
    uint2 rawSize = max(uint2(rawWidth, rawHeight), uint2(1u, 1u));
    float2 sourceUV = (float2(screenProbeCoord) + 0.5) / (float2)screenProbeGridSize;
    uint2 rawCoord = min((uint2)(saturate(sourceUV) * (float2)rawSize), rawSize - 1u);
    float3 radiance = max(_BurtScreenSpaceGlobalIlluminationRawTexture.Load(int3((int)rawCoord.x, (int)rawCoord.y, 0)).rgb, 0.0);
    float confidence = saturate(worldPositionValue.w * worldNormalValue.w);
    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 existingRadiance = _BurtGISceneVoxelRadianceTexture[voxelCoord];
    float4 existingGeometry = _BurtGISceneVoxelGeometryTexture[voxelCoord];
    float maxSampleCount = max(_BurtGISceneVoxelTraceControls.z, 1.0);
    float sourceConfidence = saturate(max(existingRadiance.a, existingGeometry.a));
    float sourceSampleCount = sourceConfidence * maxSampleCount;
    float screenWeight = confidence * (1.0 - sourceConfidence * 0.75);
    float totalWeight = max(sourceConfidence + screenWeight, 0.0001);
    float3 existingNormalWS = existingGeometry.xyz * 2.0 - 1.0;
    float existingNormalLengthSq = dot(existingNormalWS, existingNormalWS);
    existingNormalWS = existingNormalLengthSq > 0.0001 ? existingNormalWS * rsqrt(existingNormalLengthSq) : normalWS;
    float3 blendedNormalWS = existingNormalWS * sourceConfidence + normalWS * screenWeight;
    float blendedNormalLengthSq = dot(blendedNormalWS, blendedNormalWS);
    blendedNormalWS = blendedNormalLengthSq > 0.0001 ? blendedNormalWS * rsqrt(blendedNormalLengthSq) : normalWS;
    float3 blendedRadiance = (max(existingRadiance.rgb, 0.0) * sourceConfidence + radiance * screenWeight) / totalWeight;
    float blendedConfidence = saturate(min(sourceSampleCount + confidence, maxSampleCount) / maxSampleCount);
    _BurtGISceneVoxelRadianceTexture[voxelCoord] = float4(blendedRadiance, blendedConfidence);
    _BurtGISceneVoxelGeometryTexture[voxelCoord] = float4(blendedNormalWS * 0.5 + 0.5, blendedConfidence);
}
[numthreads(64, 1, 1)]
void SceneVoxelVoxelizeTrianglesCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint triangleIndex = dispatchThreadId.x;
    if (triangleIndex >= _BurtGISceneVoxelTriangleCount)
    {
        return;
    }

    BurtGISceneVoxelTriangle voxelTriangle = _BurtGISceneVoxelTriangleBuffer[triangleIndex];
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float voxelSizeWS = max(_BurtGISceneVoxelCenterExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float edgeLength01 = length(voxelTriangle.Position1 - voxelTriangle.Position0);
    float edgeLength12 = length(voxelTriangle.Position2 - voxelTriangle.Position1);
    float edgeLength20 = length(voxelTriangle.Position0 - voxelTriangle.Position2);
    float materialEnabled = _BurtGISceneVoxelMaterialParams.z > 0.5 ? 1.0 : 0.0;
    uint materialSampleResolutionCap = (uint)clamp(_BurtGISceneVoxelMaterialParams.w, 1.0, 16.0);
    uint sampleResolution = (uint)clamp(ceil(max(edgeLength01, max(edgeLength12, edgeLength20)) / voxelSizeWS), 1.0, (float)materialSampleResolutionCap);
    float3 normalWS = BurtGISceneVoxelSafeNormalize(voxelTriangle.Normal, float3(0.0, 1.0, 0.0));
    float3 materialAlbedo = lerp(float3(1.0, 1.0, 1.0), max(voxelTriangle.Albedo, 0.0), materialEnabled);
    float3 materialEmission = max(voxelTriangle.Emission, 0.0) * materialEnabled;
    float3 baseColorBoosted = min(saturate(pow(materialAlbedo, _BurtGISceneVoxelLightingParams.x)), 0.99);
    float3 radiance = baseColorBoosted * 0.12 + materialEmission;

    [loop]
    for (uint sampleY = 0u; sampleY <= sampleResolution; ++sampleY)
    {
        [loop]
        for (uint sampleX = 0u; sampleX <= sampleResolution - sampleY; ++sampleX)
        {
            float barycentricY = (float)sampleY / max((float)sampleResolution, 1.0);
            float barycentricX = (float)sampleX / max((float)sampleResolution, 1.0);
            float barycentricZ = 1.0 - barycentricX - barycentricY;
            float3 samplePosition = voxelTriangle.Position0 * barycentricZ + voxelTriangle.Position1 * barycentricX + voxelTriangle.Position2 * barycentricY;
            float3 uvw = BurtGISceneVoxelWorldToUVW(samplePosition);
            if (any(uvw < 0.0) || any(uvw > 1.0))
            {
                continue;
            }

            uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
            float4 previousRadiance = _BurtGISceneVoxelRadianceTexture[voxelCoord];
            float4 previousGeometry = _BurtGISceneVoxelGeometryTexture[voxelCoord];
            float previousConfidence = saturate(max(previousRadiance.a, previousGeometry.a));
            float writeWeight = 1.0 / max(1.0 + previousConfidence, 1.0);
            float3 blendedRadiance = lerp(max(previousRadiance.rgb, 0.0), radiance, writeWeight);
            float3 previousNormalWS = previousGeometry.xyz * 2.0 - 1.0;
            float previousNormalLengthSq = dot(previousNormalWS, previousNormalWS);
            previousNormalWS = previousNormalLengthSq > 0.0001 ? previousNormalWS * rsqrt(previousNormalLengthSq) : normalWS;
            float3 blendedNormalWS = BurtGISceneVoxelSafeNormalize(lerp(previousNormalWS, normalWS, writeWeight), normalWS);
            _BurtGISceneVoxelRadianceTexture[voxelCoord] = float4(blendedRadiance, 1.0);
            _BurtGISceneVoxelGeometryTexture[voxelCoord] = float4(blendedNormalWS * 0.5 + 0.5, 1.0);
        }
    }
}
void BurtGISceneVoxelBuildOccupancyMip(uint3 dispatchThreadId)
{
    uint mipWidth;
    uint mipHeight;
    uint mipDepth;
    _BurtGISceneVoxelOccupancyMipTexture.GetDimensions(mipWidth, mipHeight, mipDepth);
    if (dispatchThreadId.x >= mipWidth || dispatchThreadId.y >= mipHeight || dispatchThreadId.z >= mipDepth)
    {
        return;
    }

    uint sourceWidth;
    uint sourceHeight;
    uint sourceDepth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(sourceWidth, sourceHeight, sourceDepth);
    uint3 sourceSize = max(uint3(sourceWidth, sourceHeight, sourceDepth), uint3(1u, 1u, 1u));
    uint3 mipSize = max(uint3(mipWidth, mipHeight, mipDepth), uint3(1u, 1u, 1u));
    uint3 blockSize = max(sourceSize / mipSize, uint3(1u, 1u, 1u));
    uint3 sourceBase = dispatchThreadId * blockSize;

    float maxOccupancy = 0.0;
    float occupancySum = 0.0;
    float sampleCount = 0.0;

    [loop]
    for (uint z = 0u; z < blockSize.z; ++z)
    {
        [loop]
        for (uint y = 0u; y < blockSize.y; ++y)
        {
            [loop]
            for (uint x = 0u; x < blockSize.x; ++x)
            {
                uint3 sourceCoord = min(sourceBase + uint3(x, y, z), sourceSize - 1u);
                float occupancy = saturate(_BurtGISceneVoxelGeometryReadTexture.Load(int4((int)sourceCoord.x, (int)sourceCoord.y, (int)sourceCoord.z, 0)).a);
                maxOccupancy = max(maxOccupancy, occupancy);
                occupancySum += occupancy;
                sampleCount += 1.0;
            }
        }
    }

    float meanOccupancy = sampleCount > 0.0 ? occupancySum / sampleCount : 0.0;
    _BurtGISceneVoxelOccupancyMipTexture[dispatchThreadId] = float4(maxOccupancy, meanOccupancy, saturate(occupancySum), 1.0);
}
[numthreads(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE)]
void SceneVoxelBuildOccupancyMipLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGISceneVoxelBuildOccupancyMip(dispatchThreadId);
}
void BurtGISceneVoxelDownsampleOccupancyMip(uint3 dispatchThreadId)
{
    uint targetWidth;
    uint targetHeight;
    uint targetDepth;
    _BurtGISceneVoxelOccupancyMipTexture.GetDimensions(targetWidth, targetHeight, targetDepth);
    uint3 targetSize = max(uint3(targetWidth, targetHeight, targetDepth), uint3(1u, 1u, 1u));
    if (any(dispatchThreadId >= targetSize))
    {
        return;
    }

    uint3 sourceSize = max(targetSize * 2u, uint3(1u, 1u, 1u));
    uint3 sourceBase = dispatchThreadId * 2u;
    float maxOccupancy = 0.0;
    float meanOccupancy = 0.0;
    float coverage = 0.0;

    [unroll]
    for (uint z = 0u; z < 2u; ++z)
    {
        [unroll]
        for (uint y = 0u; y < 2u; ++y)
        {
            [unroll]
            for (uint x = 0u; x < 2u; ++x)
            {
                uint3 sourceCoord = min(sourceBase + uint3(x, y, z), sourceSize - 1u);
                float4 sourceOccupancy = _BurtGISceneVoxelOccupancyMipReadTexture.Load(int4(
                    (int)sourceCoord.x,
                    (int)sourceCoord.y,
                    (int)sourceCoord.z,
                    (int)_BurtGISceneVoxelOccupancyMipSourceMip));
                maxOccupancy = max(maxOccupancy, saturate(sourceOccupancy.x));
                meanOccupancy += saturate(sourceOccupancy.y);
                coverage += saturate(sourceOccupancy.z);
            }
        }
    }

    _BurtGISceneVoxelOccupancyMipTexture[dispatchThreadId] = float4(
        maxOccupancy,
        meanOccupancy * 0.125,
        saturate(coverage * 0.125),
        1.0);
}
[numthreads(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE)]
void SceneVoxelDownsampleOccupancyMipCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGISceneVoxelDownsampleOccupancyMip(dispatchThreadId);
}
