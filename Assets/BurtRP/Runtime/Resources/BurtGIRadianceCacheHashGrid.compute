groupshared uint2 BurtGIRadianceCacheHashGridUpdateTilesLDS[BURT_GI_HASH_GRID_UPDATE_TILE_THREADGROUP_SIZE][BURT_GI_HASH_GRID_UPDATE_TILE_THREADGROUP_SIZE];

uint BurtGIRadianceCacheHashGridTileCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.x);
}

uint BurtGIRadianceCacheHashGridCellCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.y);
}

#define BURT_GI_SURFACE_CACHE_EXTERNAL_RESOURCE
#define _BurtGISurfaceCacheTable _BurtGIRadianceCacheHashGridValueBuffer
#define _BurtGISurfaceCacheSlotCount (BurtGIRadianceCacheHashGridCellCount() / 2u)
#define _BurtGISurfaceCacheProbeCount 64u
#include "BurtGIHashSurfaceTable.hlsl"

uint BurtGIRadianceCacheHashGridCellsPerTile()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.z);
}

uint BurtGIRadianceCacheHashGridBucketCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.z);
}

uint BurtGIRadianceCacheHashGridTilesPerBucket()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.w);
}

uint BurtGIRadianceCacheHashGridTraceTexelCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.w);
}

uint BurtGIHashQueryCapacity()
{
    return BurtGIRadianceCacheHashGridTraceTexelCount() *
        (_BurtGIRadianceCacheHashGridAddressParams.w > 0.5 ? 4u : 1u);
}

uint BurtGIRadianceCacheHashGridPingPong()
{
    return _BurtGIRadianceCacheHashGridPingPongIndex & 1u;
}

uint BurtGIRadianceCacheHashGridPackedTileCountIndex()
{
    return 2u + BurtGIRadianceCacheHashGridPingPong();
}

uint BurtGIRadianceCacheHashGridPackedTileCountPrevIndex()
{
    return 3u - BurtGIRadianceCacheHashGridPingPong();
}

uint BurtGIRadianceCacheHashGridHash(uint3 value)
{
    uint h = value.x * 0x8da6b343u;
    h ^= value.y * 0xd8163841u;
    h ^= value.z * 0xcb1ab31fu;
    h ^= h >> 16;
    h *= 0x7feb352du;
    h ^= h >> 15;
    h *= 0x846ca68bu;
    h ^= h >> 16;
    return h;
}

float3 BurtGIRadianceCacheHashGridSafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001 ? value * rsqrt(lengthSq) : fallback;
}

float3 BurtGIEquiAreaSphericalMapping(float2 uv)
{
    uv = 2.0 * uv - 1.0;
    float d = 1.0 - (abs(uv.x) + abs(uv.y));
    float r = 1.0 - abs(d);
    float phi = r == 0.0 ? 0.0 : 0.7853981633974483 * ((abs(uv.y) - abs(uv.x)) / r + 1.0);
    float f = r * sqrt(max(2.0 - r * r, 0.0));
    return BurtGIRadianceCacheHashGridSafeNormalize(float3(
        f * sign(uv.y) * abs(sin(phi)),
        sign(d) * (1.0 - r * r),
        f * sign(uv.x) * abs(cos(phi))),
        float3(0.0, 1.0, 0.0));
}

void BurtGIUnpackScreenProbeImportanceRayInfo(uint rayInfo, out uint2 texelCoord, out uint level)
{
    texelCoord.x = rayInfo & 0x3fu;
    texelCoord.y = (rayInfo >> 6) & 0x3fu;
    level = (rayInfo >> 12) & 0xfu;
}

uint BurtGIRadianceCacheHashGridTileHash(float3 worldPosition, float3 rayDirection)
{
    float cellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    float tileCellRatio = max(1.0, _BurtGIRadianceCacheHashGridParams0.y);
    float tileSize = cellSize * tileCellRatio;
    int3 signedTileCoord = (int3)floor(worldPosition / tileSize);
    int3 signedDirectionCoord = (int3)floor(0.5 + (0.5 * rayDirection + 0.5) * 4.0);
    uint3 tileKey = uint3((uint)signedTileCoord.x, (uint)signedTileCoord.y, (uint)signedTileCoord.z);
    uint3 directionKey = uint3((uint)signedDirectionCoord.x, (uint)signedDirectionCoord.y, (uint)signedDirectionCoord.z);
    uint hash = BurtGIRadianceCacheHashGridHash(tileKey ^ (directionKey * 0x9e3779b9u));
    return hash == 0xffffffffu ? 0xfffffffeu : max(1u, hash);
}

uint BurtGIRadianceCacheHashGridLocalCell(float3 worldPosition, float3 rayDirection)
{
    float cellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    uint tileCellRatio = max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.y);
    float tileSize = cellSize * (float)tileCellRatio;
    int3 signedTileCoord = (int3)floor(worldPosition / tileSize);
    int3 signedCellCoord = (int3)floor(worldPosition / cellSize) - signedTileCoord * (int)tileCellRatio;
    uint3 maxCellCoord = uint3(tileCellRatio - 1u, tileCellRatio - 1u, tileCellRatio - 1u);
    uint3 cellCoord = min(uint3((uint)signedCellCoord.x, (uint)signedCellCoord.y, (uint)signedCellCoord.z), maxCellCoord);
    float3 absDirection = abs(rayDirection);
    float maxDirection = max(max(absDirection.x, absDirection.y), absDirection.z);
    uint2 cellOffset = absDirection.x == maxDirection
        ? uint2(cellCoord.y, cellCoord.z)
        : (absDirection.y == maxDirection ? uint2(cellCoord.x, cellCoord.z) : uint2(cellCoord.x, cellCoord.y));
    uint mip0CellCount = tileCellRatio * tileCellRatio;
    return min(cellOffset.x + cellOffset.y * tileCellRatio, min(BurtGIRadianceCacheHashGridCellsPerTile() - 1u, mip0CellCount - 1u));
}

uint BurtGIRadianceCacheHashGridCellIndexFromTile(uint tileIndex, uint localCellIndex)
{
    return min(tileIndex * BurtGIRadianceCacheHashGridCellsPerTile() + localCellIndex, BurtGIRadianceCacheHashGridCellCount() - 1u);
}

float3 BurtGIRadianceCacheHashGridDebugCellCenter(float3 worldPosition)
{
    float cellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    uint tileCellRatio = max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.y);
    float tileSize = cellSize * (float)tileCellRatio;
    int3 signedTileCoord = (int3)floor(worldPosition / tileSize);
    int3 signedCellCoord = (int3)floor(worldPosition / cellSize) - signedTileCoord * (int)tileCellRatio;
    uint3 maxCellCoord = uint3(tileCellRatio - 1u, tileCellRatio - 1u, tileCellRatio - 1u);
    uint3 cellCoord = min(uint3((uint)signedCellCoord.x, (uint)signedCellCoord.y, (uint)signedCellCoord.z), maxCellCoord);
    return (float3)signedTileCoord * tileSize + ((float3)cellCoord + 0.5) * cellSize;
}

float4 BurtGIRadianceCacheHashGridPackDebugCell(float3 positionWS, float3 directionWS, float cellSize, float confidence)
{
    uint4 centerAndSize = f32tof16(float4(positionWS, cellSize));
    uint4 directionAndConfidence = f32tof16(float4(
        BurtGIRadianceCacheHashGridSafeNormalize(directionWS, float3(0.0, 1.0, 0.0)),
        saturate(confidence)));
    return asfloat((centerAndSize << 16) | directionAndConfidence);
}

float4 BurtGIRadianceCacheHashGridUpdateDebugCellConfidence(float4 packedCell, float confidence)
{
    uint4 rawCell = asuint(packedCell);
    if (!any(rawCell != 0u))
    {
        return packedCell;
    }

    rawCell.w = (rawCell.w & 0xffff0000u) | f32tof16(saturate(confidence));
    return asfloat(rawCell);
}

uint BurtGIRadianceCacheHashGridMipLocalCellIndex(uint2 cellCoord, uint mipLevel)
{
    if (mipLevel == 1u)
    {
        return BURT_GI_HASH_GRID_TILE_MIP1_OFFSET + min(cellCoord.x, 3u) + min(cellCoord.y, 3u) * 4u;
    }

    if (mipLevel == 2u)
    {
        return BURT_GI_HASH_GRID_TILE_MIP2_OFFSET + min(cellCoord.x, 1u) + min(cellCoord.y, 1u) * 2u;
    }

    if (mipLevel == 3u)
    {
        return BURT_GI_HASH_GRID_TILE_MIP3_OFFSET;
    }

    return BURT_GI_HASH_GRID_TILE_MIP0_OFFSET + min(cellCoord.x, 7u) + min(cellCoord.y, 7u) * 8u;
}

void BurtGIRadianceCacheHashGridAppendPackedTile(uint tileIndex)
{
    uint packedTileIndex;
    InterlockedAdd(_BurtGIRadianceCacheHashGridCountBuffer[BurtGIRadianceCacheHashGridPackedTileCountIndex()], 1u, packedTileIndex);
    if (packedTileIndex >= BurtGIRadianceCacheHashGridTileCount())
    {
        return;
    }

    if (BurtGIRadianceCacheHashGridPingPong() == 0u)
    {
        _BurtGIRadianceCacheHashGridTileBuffer[packedTileIndex].z = tileIndex;
    }
    else
    {
        _BurtGIRadianceCacheHashGridTileBuffer[packedTileIndex].w = tileIndex;
    }
}

uint BurtGIRadianceCacheHashGridPackedTilePrev(uint packedTileIndex)
{
    uint4 packedTile = _BurtGIRadianceCacheHashGridTileBuffer[packedTileIndex];
    return BurtGIRadianceCacheHashGridPingPong() == 0u ? packedTile.w : packedTile.z;
}

void BurtGIRadianceCacheHashGridClearTileCells(uint tileIndex)
{
    uint cellsPerTile = BurtGIRadianceCacheHashGridCellsPerTile();

    [loop]
    for (uint localCellIndex = 0u; localCellIndex < cellsPerTile; ++localCellIndex)
    {
        uint cellIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(tileIndex, localCellIndex);
        _BurtGIRadianceCacheHashGridValueBuffer[cellIndex] = uint4(0u, 0u, 0xffffffffu, 0u);
        uint updateCellBase = cellIndex * 5u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 0u] = 0u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 1u] = 0u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 2u] = 0u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 3u] = 0u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 4u] = 0u;
        _BurtGIRadianceCacheHashGridDebugCellBuffer[cellIndex + 1u] = 0.0;
    }
}

bool BurtGIRadianceCacheHashGridFindOrInsertTile(uint tileHash, out uint tileIndex, out bool isNewTile)
{
    uint bucketIndex = BurtGIRadianceCacheHashGridHash(uint3(tileHash, tileHash >> 7, tileHash >> 17)) % BurtGIRadianceCacheHashGridBucketCount();
    uint tilesPerBucket = BurtGIRadianceCacheHashGridTilesPerBucket();
    uint tileCount = BurtGIRadianceCacheHashGridTileCount();
    uint probeCount = BurtGIHashGridProbeCount(tileCount, tilesPerBucket);
    tileIndex = 0xffffffffu;
    isNewTile = false;
    // Search through purge holes before claiming any empty slot.
    [loop] for (uint searchOffset = 0u; searchOffset < probeCount; ++searchOffset) {
        uint index = (bucketIndex * tilesPerBucket + searchOffset) % tileCount;
        if (_BurtGIRadianceCacheHashGridTileBuffer[index].x == tileHash) {
            tileIndex = index; return true;
        }
    }
    [loop] for (uint i = 0u; i < probeCount; ++i) {
        uint index = (bucketIndex * tilesPerBucket + i) % tileCount;
        uint previousHash;
        InterlockedCompareExchange(_BurtGIRadianceCacheHashGridTileBuffer[index].x, 0xffffffffu, tileHash, previousHash);
        if (previousHash == 0xffffffffu || previousHash == tileHash) {
            tileIndex = index; isNewTile = previousHash == 0xffffffffu; return true;
        }
    }
    return false;
}

#include "BurtGIRadianceCacheHashGridPacking.hlsl"

uint2 BurtGIRadianceCacheHashGridPackRadiance(float3 radiance, float confidence)
{
    return BurtGIHashGridPackPersistentRadiance(radiance, confidence);
}

uint4 BurtGIRadianceCacheHashGridQuantizeRadiance(float3 radiance, float sampleWeight)
{
    // UpdateTiles divides the accumulated numerator by the accumulated weight.
    // Weight RGB as well, otherwise low-confidence samples gain energy by 1/weight.
    float weight = saturate(sampleWeight);
    float3 weightedRadiance = saturate(radiance / 8.0) * weight;
    return uint4(
        (uint)round(weightedRadiance.x * 65535.0),
        (uint)round(weightedRadiance.y * 65535.0),
        (uint)round(weightedRadiance.z * 65535.0),
        (uint)round(weight * 65535.0));
}

float4 BurtGIRadianceCacheHashGridRecoverRadiance(uint4 quantized)
{
    return float4(
        (float)quantized.x / 65535.0 * 8.0,
        (float)quantized.y / 65535.0 * 8.0,
        (float)quantized.z / 65535.0 * 8.0,
        (float)quantized.w / 65535.0);
}

float4 BurtGIRadianceCacheHashGridUnpackPackedRadiance(uint2 packedRadiance)
{
    return BurtGIHashGridUnpackPersistentRadiance(packedRadiance);
}

float4 BurtGIRadianceCacheHashGridUnpackRadiance(uint4 packedValue)
{
    return BurtGIRadianceCacheHashGridUnpackPackedRadiance(packedValue.xy);
}

uint BurtGIRadianceCacheHashGridFrameDelta(uint frameIndex, uint lastUpdateFrame)
{
    if (lastUpdateFrame == 0xffffffffu)
    {
        return BURT_GI_HASH_GRID_TILE_DECAY_MAX;
    }

    return frameIndex >= lastUpdateFrame
        ? frameIndex - lastUpdateFrame
        : (0xffffffffu - lastUpdateFrame) + frameIndex + 1u;
}

float BurtGIRadianceCacheHashGridAgeConfidenceScale(uint4 packedValue)
{
    uint frameDelta = BurtGIRadianceCacheHashGridFrameDelta(_BurtGIRadianceCacheHashGridFrameIndex, packedValue.z);
    return 1.0 - saturate((float)frameDelta / (float)BURT_GI_HASH_GRID_TILE_DECAY_MAX);
}

float4 BurtGIRadianceCacheHashGridCombineMipRadiance(float4 radiance00, float4 radiance10, float4 radiance01, float4 radiance11)
{
    float totalWeight = radiance00.a + radiance10.a + radiance01.a + radiance11.a;
    float3 weightedRadiance =
        radiance00.rgb * radiance00.a +
        radiance10.rgb * radiance10.a +
        radiance01.rgb * radiance01.a +
        radiance11.rgb * radiance11.a;

    return totalWeight > 0.0001
        ? float4(weightedRadiance / totalWeight, saturate(totalWeight))
        : float4(0.0, 0.0, 0.0, 0.0);
}

void BurtGIRadianceCacheHashGridPrepare(uint3 dispatchThreadId)
{
    // CPU caps X at the D3D11 dispatch limit and spills larger clears into Y.
    uint linearIndex = dispatchThreadId.x + dispatchThreadId.y *
        (65535u * BURT_GI_HASH_GRID_PREPARE_THREADGROUP_SIZE);
    uint cellCount = BurtGIRadianceCacheHashGridCellCount();
    uint tileCount = BurtGIRadianceCacheHashGridTileCount();
    uint traceTexelCount = BurtGIHashQueryCapacity();
    uint updateCellValueCount = cellCount * 5u;

    // The sparse surface layout is independent of the legacy spatial tiles.
    // Expire entries by their own last observation, before any publication.
    // The payload's redundant fourth word elects a deterministic current owner.
    if (_BurtGIRadianceCacheHashGridAddressParams.w > 0.5 && linearIndex < cellCount / 2u)
    {
        uint metadata = linearIndex * 2u;
        uint payload = metadata + 1u;
        if (_BurtGIRadianceCacheHashGridValueBuffer[metadata].x != 0u &&
            BurtGIRadianceCacheHashGridFrameDelta(_BurtGIRadianceCacheHashGridFrameIndex,
                _BurtGIRadianceCacheHashGridValueBuffer[payload].z) >= BURT_GI_HASH_GRID_TILE_DECAY_MAX)
        {
            _BurtGIRadianceCacheHashGridValueBuffer[metadata] = 0u;
            _BurtGIRadianceCacheHashGridValueBuffer[payload] = uint4(0u, 0u, 0xffffffffu, 0u);
        }
        _BurtGIRadianceCacheHashGridValueBuffer[payload].w = 0xffffffffu;
    }

    if (linearIndex < 2u)
    {
        _BurtGIRadianceCacheHashGridCountBuffer[linearIndex] = 0u;
    }

    if (linearIndex == 0u)
    {
        _BurtGIRadianceCacheHashGridCountBuffer[BurtGIRadianceCacheHashGridPackedTileCountIndex()] = 0u;
    }

    if (linearIndex < cellCount)
    {
        _BurtGIRadianceCacheHashGridDebugCellBuffer[linearIndex + 1u] = 0.0;
    }

    if (linearIndex < traceTexelCount)
    {
        _BurtGIRadianceCacheHashGridVisibilityCellQueryBuffer[linearIndex] = uint2(0xffffffffu, 0xffffffffu);
    }

    if (linearIndex < updateCellValueCount)
    {
        uint field = linearIndex % 10u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[linearIndex] =
            _BurtGIRadianceCacheHashGridAddressParams.w > 0.5 && field >= 4u && field <= 6u
            ? 0x7f800000u : 0u;
    }

    if (linearIndex < min(traceTexelCount, tileCount))
    {
        _BurtGIRadianceCacheHashGridUpdateTileBuffer[linearIndex] = 0xffffffffu;
    }

    if (linearIndex == 0u)
    {
        _BurtGIRadianceCacheHashGridDebugCellBuffer[0] = float4(cellCount, tileCount, traceTexelCount, 3.0);
        _BurtGIRadianceCacheHashGridDebugDrawArgsBuffer[0] = uint4(0u, 1u, 0u, 0u);
    }
}

[numthreads(BURT_GI_HASH_GRID_PREPARE_THREADGROUP_SIZE, 1, 1)]
void HashGridClearCountCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIRadianceCacheHashGridPrepare(dispatchThreadId);
}

[numthreads(BURT_GI_HASH_GRID_PREPARE_THREADGROUP_SIZE, 1, 1)]
void RadianceCacheHashGridPrepareLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIRadianceCacheHashGridPrepare(dispatchThreadId);
}

// Match XRender's close-hit cache bypass. Filtering directions whose first
// surface is less than 0.5 world units away mixes nearby visibility boundaries.
// Preserve their current trace rather than clearing/reconstructing it. A valid
// finite-range miss has a negative distance and must still publish darkness.
bool BurtGIRadianceCacheHashGridPreserveCloseTrace(uint2 traceCoord)
{
    if (_BurtGIHashGridFreshTraceStateAvailable == 0u)
    {
        return false;
    }
    float distance = _BurtGIScreenProbeTraceGeometryDistanceTexture.Load(int3(traceCoord, 0)).x;
    return distance >= 0.0 && distance < 0.5;
}

void BurtGIRadianceCacheHashGridPopulateCells(uint3 dispatchThreadId)
{
    uint linearIndex = dispatchThreadId.x;
    uint traceTexelCount = BurtGIRadianceCacheHashGridTraceTexelCount();
    if (linearIndex >= traceTexelCount)
    {
        return;
    }

    uint2 traceSize = max(uint2(1u, 1u), (uint2)_BurtGIScreenProbeTraceParams.yz);
    uint traceX = linearIndex % traceSize.x;
    uint traceY = linearIndex / traceSize.x;
    if (traceY >= traceSize.y)
    {
        return;
    }

    if (BurtGIRadianceCacheHashGridPreserveCloseTrace(uint2(traceX, traceY)))
    {
        return;
    }
    float hitConfidence = _BurtGIScreenProbeTraceHitTexture.Load(int3((int)traceX, (int)traceY, 0));
    // A fully covered finite-range miss is a fresh observation of darkness,
    // not a missing sample. Publish it so old emissive cells can converge to zero.
    // Unknown/partial coverage and paths without fresh-state provenance retain
    // the existing confidence contract (and cannot erase cached light).
    if (hitConfidence <= 0.0001 && _BurtGIHashGridFreshTraceStateAvailable != 0u &&
        _BurtGIScreenProbeTraceGeometryDistanceTexture.Load(int3((int)traceX, (int)traceY, 0)).w >= 1.0)
    {
        hitConfidence = 1.0;
    }
    if (hitConfidence <= 0.0001)
    {
        return;
    }

    uint octResolution = max(1u, (uint)_BurtGIScreenProbeTraceParams.x);
    uint2 atlasProbeCoord = uint2(traceX / octResolution, traceY / octResolution);
    uint2 uniformSize = max(uint2(1u, 1u), (uint2)_BurtGIScreenProbeGridParams.xy);
    uint screenProbeIndex = atlasProbeCoord.y * uniformSize.x + atlasProbeCoord.x;
    uint uniformCount = uniformSize.x * uniformSize.y;
    bool isAdaptiveProbe = screenProbeIndex >= uniformCount;
    float3 sourcePositionWS;
    uint2 adaptiveSourcePixel = uint2(0u, 0u);
    if (isAdaptiveProbe)
    {
        uint adaptiveIndex = screenProbeIndex - uniformCount;
        uint adaptiveCount = min(_BurtGIScreenProbeAdaptiveProbeNumBuffer[0],
            (uint)max(0.0, _BurtGIScreenProbeAdaptiveParams.w));
        if (adaptiveIndex >= adaptiveCount) return;
        BurtGIAdaptiveProbeData probe = _BurtGIScreenProbeAdaptiveProbeDataBuffer[adaptiveIndex];
        if (probe.valid <= 0.5) return;
        sourcePositionWS = probe.positionWS;
        adaptiveSourcePixel = probe.sourcePixel;
        // The uniform parent can be a different surface; its hit-distance
        // classification must not discard this adaptive probe's fresh trace.
    }
    else
    {
        float4 placement = _BurtGIScreenProbeWorldPositionTexture.Load(int3(atlasProbeCoord, 0));
        if (placement.w <= 0.0001) return;
        sourcePositionWS = placement.xyz;
        float4 probeHitDistance = _BurtGIScreenProbeHitDistanceTexture.Load(int3(atlasProbeCoord, 0));
        if (max(probeHitDistance.z, probeHitDistance.w) > 0.0001 && probeHitDistance.y < 0.5) return;
    }
    if (!all(isfinite(sourcePositionWS))) return;
    uint2 traceTexelCoord = uint2(traceX % octResolution, traceY % octResolution);
    uint packedRayInfo = isAdaptiveProbe ? 0u
        : _BurtGIScreenProbeImportanceRayInfoTexture.Load(int3((int)traceX, (int)traceY, 0));
    uint2 sourceTraceTexelCoord;
    uint sourceTraceLevel, sourceMipSize;
    float2 octUV;
    BurtGIResolveScreenProbeRayLayout(traceTexelCoord, octResolution, isAdaptiveProbe,
        packedRayInfo, atlasProbeCoord, adaptiveSourcePixel, _BurtGIScreenProbeRayFrameIndex,
        sourceTraceTexelCoord, sourceTraceLevel, sourceMipSize, octUV);
    float3 rayDirection = BurtGIEquiAreaSphericalMapping(octUV);
    uint tileHash = BurtGIRadianceCacheHashGridTileHash(sourcePositionWS, rayDirection);
    uint tileIndex;
    bool isNewTile;
    if (!BurtGIRadianceCacheHashGridFindOrInsertTile(tileHash, tileIndex, isNewTile))
    {
        return;
    }

    uint previousTileFrame;
    InterlockedExchange(_BurtGIRadianceCacheHashGridTileBuffer[tileIndex].y, _BurtGIRadianceCacheHashGridFrameIndex, previousTileFrame);
    if (isNewTile)
    {
        BurtGIRadianceCacheHashGridAppendPackedTile(tileIndex);
        // Allocation/purge clears resident values before a tile can be claimed;
        // Prepare clears scratch accumulation before this dispatch. Clearing here
        // races other threads that already found the newly published tile hash.
    }

    uint localCellIndex = BurtGIRadianceCacheHashGridLocalCell(sourcePositionWS, rayDirection);
    uint cellIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(tileIndex, localCellIndex);
    uint tileCount = BurtGIRadianceCacheHashGridTileCount();
    uint updateTileCapacity = min(traceTexelCount, tileCount);
    uint2 traceRadianceCoord = uint2(traceX, traceY);
    // Populate consumes and clears this texel. Reading through the same UAV
    // avoids binding this resource simultaneously as SRV and UAV on D3D11.
    float4 sourceTraceRadiance = _BurtGIScreenProbeTraceRadianceRWTexture[traceRadianceCoord];
    uint4 quantizedRadiance = BurtGIRadianceCacheHashGridQuantizeRadiance(sourceTraceRadiance.rgb, hitConfidence);

    uint visibilityIndex;
    InterlockedAdd(_BurtGIRadianceCacheHashGridCountBuffer[0], 1u, visibilityIndex);
    if (visibilityIndex < traceTexelCount)
    {
        _BurtGIRadianceCacheHashGridVisibilityCellQueryBuffer[visibilityIndex] = uint2(cellIndex, linearIndex);
    }

    // The hash-insertion winner need not be the first thread touching the stamp.
    // Only the stamp exchange elects one update group; including isNewTile can
    // enqueue the same tile twice and race UpdateTiles' read/clear operations.
    if (previousTileFrame != _BurtGIRadianceCacheHashGridFrameIndex)
    {
        uint updateTileIndex;
        InterlockedAdd(_BurtGIRadianceCacheHashGridCountBuffer[1], 1u, updateTileIndex);
        if (updateTileIndex < updateTileCapacity)
        {
            _BurtGIRadianceCacheHashGridUpdateTileBuffer[updateTileIndex] = tileIndex;
        }
    }

    _BurtGIScreenProbeTraceRadianceRWTexture[traceRadianceCoord] = 0.0;

    uint updateCellBase = cellIndex * 5u;
    InterlockedAdd(_BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 0u], quantizedRadiance.x);
    InterlockedAdd(_BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 1u], quantizedRadiance.y);
    InterlockedAdd(_BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 2u], quantizedRadiance.z);
    InterlockedAdd(_BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 3u], quantizedRadiance.w);
    _BurtGIRadianceCacheHashGridDebugCellBuffer[cellIndex + 1u] = BurtGIRadianceCacheHashGridPackDebugCell(
        BurtGIRadianceCacheHashGridDebugCellCenter(sourcePositionWS),
        rayDirection,
        max(0.001, _BurtGIRadianceCacheHashGridParams0.x),
        hitConfidence);
}

[numthreads(BURT_GI_HASH_GRID_POPULATE_THREADGROUP_SIZE, 1, 1)]
void HashGridPopulateCellsCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIRadianceCacheHashGridPopulateCells(dispatchThreadId);
}

