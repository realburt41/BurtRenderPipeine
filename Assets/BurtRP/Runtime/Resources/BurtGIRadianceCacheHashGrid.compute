Texture2D<uint> _BurtGIScreenProbeImportanceRayInfoTexture;
RWTexture2D<float4> _BurtGIScreenProbeTraceRadianceRWTexture;

RWStructuredBuffer<uint4> _BurtGIRadianceCacheHashGridValueBuffer;
RWStructuredBuffer<uint4> _BurtGIRadianceCacheHashGridTileBuffer;
RWStructuredBuffer<uint> _BurtGIRadianceCacheHashGridCountBuffer;
RWStructuredBuffer<uint2> _BurtGIRadianceCacheHashGridVisibilityCellQueryBuffer;
RWStructuredBuffer<uint> _BurtGIRadianceCacheHashGridUpdateCellValueBuffer;
RWStructuredBuffer<uint> _BurtGIRadianceCacheHashGridUpdateTileBuffer;
RWStructuredBuffer<uint3> _BurtGIRadianceCacheHashGridUpdateTilesIndirectArgsBuffer;
