#pragma kernel MergeSurfaceNormal
#include "Assets/BurtRP/Runtime/Shaders/ShaderLibrary/Material/BurtShadingModelIds.hlsl"

Texture2D<float4> _BurtGBuffer0;
Texture2D<float4> _BurtGBuffer2;
RWTexture2D<float4> _BurtGISurfaceNormalTexture;
float4 _BurtGISurfaceNormalSize;

[numthreads(8, 8, 1)]
void MergeSurfaceNormal(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_BurtGISurfaceNormalSize.xy)) return;
    float packedModel = saturate(_BurtGBuffer2.Load(int3(id.xy, 0)).r) * BURT_GBUFFER_SHADING_MODEL_PACK_COUNT;
    uint model = (uint)floor(min(packedModel, BURT_GBUFFER_SHADING_MODEL_PACK_COUNT - 0.0001f));
    // Keep Hair's true material normal from DepthNormals. Other models use the
    // final GBuffer normal, preserving any post-prepass material/decal changes.
    // No typed UAV loads are required (D3D11 RGBA8 store-only compatibility).
    if (model != (uint)BURT_SHADING_MODEL_HAIR)
        _BurtGISurfaceNormalTexture[id.xy] = _BurtGBuffer0.Load(int3(id.xy, 0));
}
