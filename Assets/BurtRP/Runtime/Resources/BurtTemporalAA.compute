RWTexture2D<float> _BurtTAAHistoryRejectionOutputTexture;
RWTexture2D<float> _BurtTAADilatedHistoryRejectionOutputTexture;
RWTexture2D<float4> _BurtTAAUReprojectedGuideOutputTexture;
RWTexture2D<float4> _BurtTAAUHistoryGuideOutputTexture;
RWTexture2D<float4> _BurtTAAUShadingRejectionOutputTexture;
RWTexture2D<float4> _BurtTAAUDilatedShadingRejectionOutputTexture;
RWTexture2D<float3> _BurtTAAUUpdatedHistoryOutputTexture;
#if defined(BURT_TAAU_FINAL_BLEND_DEBUG)
RWTexture2D<float4> _BurtTAAUFinalBlendDebugOutputTexture;
#endif

float4x4 _BurtTAAInverseCurrentNonJitteredViewProjection;
float4x4 _BurtTAAPreviousNonJitteredViewProjection;
float4x4 _BurtTAAClipToPreviousClip;
float4 _BurtTAAJitter;
float4 _BurtTAATexelSize;
float4 _BurtTAAHistoryTexelSize;
float4 _BurtTAADepthHistoryTexelSize;
float4 _BurtTAAStencilTexelSize;
float4 _BurtTAAUGuideTexelSize;
float4 _BurtTAAUInputTexelSize;
float4 _BurtTAAUOutputTexelSize;
float4 _BurtTAAUHistoryParams;
float4 _BurtTAAParams;
float4 _BurtTAADepthParams;
float _BurtTAADecimateMode;
float _BurtTAADilateMode;
float4 _BurtTAACurrentSampleWeights0;
float4 _BurtTAACurrentSampleWeights1;
float4 _BurtTAACurrentSampleWeights2;
float4 _ZBufferParams;
float _BurtTAAHistoryExposureCorrection;

bool BurtTaaAnyNonFinite(float3 value)
{
    return any((asuint(value) & 0x7F800000u) == 0x7F800000u);
}

float3 BurtTaaSanitizeRawColor(float3 color, float3 fallback)
{
    float3 safeFallback = BurtTaaAnyNonFinite(fallback) ? float3(0.0, 0.0, 0.0) : clamp(fallback, 0.0, 65504.0);
    return BurtTaaAnyNonFinite(color) ? safeFallback : clamp(color, 0.0, 65504.0);
}

float3 BurtTaaSanitizeRawColor(float3 color)
{
    return BurtTaaSanitizeRawColor(color, float3(0.0, 0.0, 0.0));
}

float3 BurtTaaToWorkingSpace(float3 rgb)
{
    return float3(
        dot(rgb, float3(0.25, 0.5, 0.25)),
        dot(rgb, float3(0.5, 0.0, -0.5)) + (128.0 / 255.0),
        dot(rgb, float3(-0.25, 0.5, -0.25)) + (128.0 / 255.0));
}

float3 BurtTaaFromWorkingSpace(float3 ycocg)
{
    float y = ycocg.x;
    float co = ycocg.y - (128.0 / 255.0);
    float cg = ycocg.z - (128.0 / 255.0);
    return float3(y + co - cg, y + cg, y - co - cg);
}

float3 BurtTaaToPerceptualSpace(float3 color)
{
    return color * rcp(color.x + 1.0);
}

float3 BurtTaaFromPerceptualSpace(float3 color)
{
    // Match XRender TSRCommon exactly. The native TAA history filter clamps
    // its raw Catmull-Rom result before entering this space, so adding another
    // luma clamp here changes bright-edge convergence and chroma reconstruction.
    return color * rcp(max(1.0 - color.x, 6.103515625e-5));
}

float3 BurtTaaToWorkingPerceptualSpace(float3 color)
{
    return BurtTaaToPerceptualSpace(BurtTaaToWorkingSpace(color));
}

float3 BurtTaaFromWorkingPerceptualSpace(float3 color)
{
    return BurtTaaFromWorkingSpace(BurtTaaFromPerceptualSpace(color));
}

float BurtTaaShadingRejection(float3 currentWorking, float3 historyWorking)
{
    float3 colorDelta = abs(currentWorking - historyWorking);
    float lumaScale = max(max(abs(currentWorking.x), abs(historyWorking.x)), 0.04);
    float relativeLumaDelta = colorDelta.x / lumaScale;
    float relativeChromaDelta = length(colorDelta.yz) / max(lumaScale, 0.1);
    float vectorDelta = length(colorDelta) /
        max(length(currentWorking) + length(historyWorking), 0.15);

    // Keep small exposure/noise changes stable, but make genuine shading or
    // material changes converge to a full history reset instead of retaining
    // most of the old color for several frames.
    float lumaRejection = smoothstep(0.04, 0.28, relativeLumaDelta);
    float chromaRejection = smoothstep(0.05, 0.30, relativeChromaDelta);
    float vectorRejection = smoothstep(0.08, 0.35, vectorDelta);
    return saturate(max(vectorRejection, max(lumaRejection, chromaRejection)));
}

int2 BurtTaaTextureSize()
{
    return max(int2((int)_BurtTAATexelSize.z, (int)_BurtTAATexelSize.w), int2(1, 1));
}

int2 BurtTaaHistoryTextureSize()
{
    return max(int2((int)_BurtTAAHistoryTexelSize.z, (int)_BurtTAAHistoryTexelSize.w), int2(1, 1));
}

int2 BurtTaaDepthHistoryTextureSize()
{
    return max(int2((int)_BurtTAADepthHistoryTexelSize.z, (int)_BurtTAADepthHistoryTexelSize.w), int2(1, 1));
}

int2 BurtTaaClampPixel(int2 pixel)
{
    return clamp(pixel, int2(0, 0), BurtTaaTextureSize() - 1);
}

int2 BurtTaaUInputTextureSize()
{
    return max(int2((int)_BurtTAAUInputTexelSize.z, (int)_BurtTAAUInputTexelSize.w), int2(1, 1));
}

int2 BurtTaaUClampInputPixel(int2 pixel)
{
    return clamp(pixel, int2(0, 0), BurtTaaUInputTextureSize() - 1);
}

float4 BurtTaaULoadCurrentRaw(int2 pixel)
{
    float4 color = _BurtPostProcessSourceTexture.Load(int3(BurtTaaUClampInputPixel(pixel), 0));
    color.rgb = BurtTaaSanitizeRawColor(color.rgb);
    return color;
}

int2 BurtTaaClampHistoryPixel(int2 pixel)
{
    return clamp(pixel, int2(0, 0), BurtTaaHistoryTextureSize() - 1);
}

int2 BurtTaaClampDepthHistoryPixel(int2 pixel)
{
    return clamp(pixel, int2(0, 0), BurtTaaDepthHistoryTextureSize() - 1);
}

float4 BurtTaaLoadCurrentRaw(int2 pixel)
{
    float4 color = _BurtPostProcessSourceTexture.Load(int3(BurtTaaClampPixel(pixel), 0));
    color.rgb = BurtTaaSanitizeRawColor(color.rgb);
    return color;
}

float BurtTaaLoadCurrentDepth(int2 pixel)
{
    return _BurtTAACurrentDepthTexture.Load(int3(BurtTaaClampPixel(pixel), 0));
}

float BurtTaaLinearEyeDepth(float rawDepth)
{
    return rcp(max(_ZBufferParams.z * rawDepth + _ZBufferParams.w, 1e-6));
}

float BurtTaaDeviceDepthFromLinearEye(float linearDepth)
{
    return (rcp(max(linearDepth, 1e-6)) - _ZBufferParams.w) / _ZBufferParams.z;
}

float BurtTaaDepthPixelRadius(float linearDepth)
{
    return max(linearDepth, 0.0) * max(_BurtTAADepthParams.x, 0.0);
}

float BurtTaaCalculateDeviceZError(float centerDepth)
{
    float centerEyeDepth = BurtTaaLinearEyeDepth(centerDepth);
    float correctedDepth = BurtTaaDeviceDepthFromLinearEye(centerEyeDepth + BurtTaaDepthPixelRadius(centerEyeDepth) * 2.0);
    return abs(correctedDepth - centerDepth);
}

float BurtTaaValidSurfaceWeight(float rawDepth)
{
#if defined(UNITY_REVERSED_Z)
    return step(1e-6, rawDepth);
#else
    return 1.0 - step(1.0 - 1e-6, rawDepth);
#endif
}

float BurtTaaDepthDisocclusionWeight(float currentRawDepth, float historyRawDepth)
{
    float currentSurface = BurtTaaValidSurfaceWeight(currentRawDepth);
    float historySurface = BurtTaaValidSurfaceWeight(historyRawDepth);
    float valid = currentSurface * historySurface;
    float skyContinuity = (1.0 - currentSurface) * (1.0 - historySurface);
    float currentEyeDepth = BurtTaaLinearEyeDepth(currentRawDepth);
    float historyEyeDepth = BurtTaaLinearEyeDepth(historyRawDepth);
    float depthTolerance = max(currentEyeDepth * 0.012, 0.025);
    return max(skyContinuity, valid * saturate(1.0 - abs(currentEyeDepth - historyEyeDepth) / depthTolerance));
}

bool BurtTaaIsCloserDepth(float candidateDepth, float currentDepth)
{
#if defined(UNITY_REVERSED_Z)
    return candidateDepth > currentDepth;
#else
    return candidateDepth < currentDepth;
#endif
}

uint BurtTaaLoadStencilMask(float2 uv)
{
    int2 size = max(int2(_BurtTAAStencilTexelSize.zw), int2(1, 1));
    int2 pixel = clamp(int2(uv * size), int2(0, 0), size - 1);
    return (uint)round(max(0.0, _BurtTAAStencilMaskTexture.Load(int3(pixel, 0))));
}

float2 BurtTaaClipToUv(float4 clipPosition)
{
    float safeW = abs(clipPosition.w) > 1e-6
        ? clipPosition.w
        : (clipPosition.w < 0.0 ? -1e-6 : 1e-6);
    float2 ndc = clipPosition.xy / safeW;
    float2 uv = ndc * 0.5 + 0.5;
#if UNITY_UV_STARTS_AT_TOP
    uv.y = 1.0 - uv.y;
#endif
    return uv;
}

float4 BurtTaaScreenUvToClip(float2 uv, float rawDepth)
{
    float2 clipXY = uv * 2.0 - 1.0;
#if UNITY_UV_STARTS_AT_TOP
    clipXY.y = -clipXY.y;
#endif
    return float4(clipXY, rawDepth, 1.0);
}

float2 BurtTaaComputeStaticVelocity(float2 uv, float rawDepth, out float available)
{
    float4 clip = BurtTaaScreenUvToClip(uv, rawDepth);
    float2 currentFrameJitter = _BurtTAAJitter.xy;
#if UNITY_UV_STARTS_AT_TOP
    currentFrameJitter.y = -currentFrameJitter.y;
#endif
    clip.xy -= currentFrameJitter;
    float4 previousClip = mul(_BurtTAAClipToPreviousClip, clip);
    float2 currentUv = BurtTaaClipToUv(clip);
    float2 previousUv = BurtTaaClipToUv(previousClip);
    available = BurtTaaValidSurfaceWeight(rawDepth) * step(1e-5, previousClip.w);
    available *= step(0.0, previousUv.x) * step(previousUv.x, 1.0) * step(0.0, previousUv.y) * step(previousUv.y, 1.0);
    float2 velocity = currentUv - previousUv;
    float2 velocityPixels = abs(velocity * _BurtTAATexelSize.zw);
    return velocity * step(float2(0.02, 0.02), velocityPixels);
}

void BurtTaaSelectClosestDepthTap(int2 pixel, int2 pixelOffset, float centerDepth, float centerDeviceZError, inout float closestDepth, inout int2 closestOffset)
{
    int2 textureSize = BurtTaaTextureSize();
    int2 samplePixel0 = clamp(pixel + pixelOffset, int2(0, 0), textureSize - 1);
    int2 samplePixel1 = clamp(pixel - pixelOffset, int2(0, 0), textureSize - 1);
    float depth0 = BurtTaaLoadCurrentDepth(samplePixel0);
    float depth1 = BurtTaaLoadCurrentDepth(samplePixel1);
    float depthDiff = abs(depth0 - depth1);
    float depthVariation = 0.5 * (depth0 + depth1) - centerDepth;

#if defined(UNITY_REVERSED_Z)
    bool edgeCandidate = depthVariation > max(depthDiff * 0.25, centerDeviceZError);
#else
    bool edgeCandidate = -depthVariation > max(depthDiff * 0.25, centerDeviceZError);
#endif

    if (edgeCandidate && BurtTaaIsCloserDepth(depth0, closestDepth))
    {
        closestDepth = depth0;
        closestOffset = pixelOffset;
    }

    if (edgeCandidate && BurtTaaIsCloserDepth(depth1, closestDepth))
    {
        closestDepth = depth1;
        closestOffset = -pixelOffset;
    }
}

void BurtTaaScatterPrevUseCount(float2 previousUv)
{
    int2 textureSize = BurtTaaTextureSize();
    float inBounds = step(0.0, previousUv.x) * step(previousUv.x, 1.0) * step(0.0, previousUv.y) * step(previousUv.y, 1.0);
    float2 samplePosition = previousUv * (float2)textureSize - 0.5;
    int2 basePixel = int2(floor(samplePosition));
    float2 blend = saturate(samplePosition - basePixel);

    [unroll]
    for (int y = 0; y < 2; y++)
    {
        float wy = y == 0 ? (1.0 - blend.y) : blend.y;
        [unroll]
        for (int x = 0; x < 2; x++)
        {
            float wx = x == 0 ? (1.0 - blend.x) : blend.x;
            int2 usePixel = basePixel + int2(x, y);
            bool validPixel = usePixel.x >= 0 && usePixel.y >= 0 && usePixel.x < textureSize.x && usePixel.y < textureSize.y;
            uint finalAdd = (uint)round(wx * wy * BURT_TAA_USE_COUNT_QUANTIZATION);
            if (inBounds > 0.5 && validPixel && finalAdd > 0u)
            {
#if !defined(SHADER_API_METAL)
                InterlockedAdd(_BurtTAAPrevUseCountOutputTexture[usePixel], finalAdd);
#endif
            }
        }
    }
}

float3 BurtTaaApplyHistoryExposureCorrection(float3 history)
{
    float correction = max(_BurtTAAHistoryExposureCorrection, 0.0);
    correction = correction > 0.0 ? correction : 1.0;
    return BurtTaaSanitizeRawColor(history * correction);
}

float3 BurtTaaLoadHistoryRaw(int2 pixel)
{
    float3 history = _BurtTAAHistoryTexture.Load(int3(BurtTaaClampHistoryPixel(pixel), 0)).rgb;
    return BurtTaaApplyHistoryExposureCorrection(BurtTaaSanitizeRawColor(history));
}

float BurtTaaLoadHistoryDepth(int2 pixel)
{
    return _BurtTAADepthHistoryTexture.Load(int3(BurtTaaClampDepthHistoryPixel(pixel), 0));
}

float BurtTaaSampleHistoryDepthBilinear(float2 uv)
{
    int2 textureSize = BurtTaaDepthHistoryTextureSize();
    float2 samplePosition = saturate(uv) * (float2)textureSize - 0.5;
    int2 basePixel = int2(floor(samplePosition));
    float2 blend = saturate(samplePosition - basePixel);
    float depth = 0.0;
    float weightSum = 0.0;

    [unroll]
    for (int y = 0; y < 2; y++)
    {
        float wy = y == 0 ? (1.0 - blend.y) : blend.y;
        [unroll]
        for (int x = 0; x < 2; x++)
        {
            float wx = x == 0 ? (1.0 - blend.x) : blend.x;
            float weight = wx * wy;
            depth += BurtTaaLoadHistoryDepth(basePixel + int2(x, y)) * weight;
            weightSum += weight;
        }
    }

    return depth * rcp(max(weightSum, 1e-4));
}

float3 BurtTaaSampleHistoryLinear(float2 uv)
{
    int2 textureSize = BurtTaaHistoryTextureSize();
    float2 samplePosition = saturate(uv) * (float2)textureSize - 0.5;
    int2 basePixel = int2(floor(samplePosition));
    float2 blend = saturate(samplePosition - basePixel);
    float3 history = 0.0;

    [unroll]
    for (int y = 0; y < 2; y++)
    {
        float wy = y == 0 ? (1.0 - blend.y) : blend.y;
        [unroll]
        for (int x = 0; x < 2; x++)
        {
            float wx = x == 0 ? (1.0 - blend.x) : blend.x;
            history += BurtTaaLoadHistoryRaw(basePixel + int2(x, y)) * (wx * wy);
        }
    }

    return BurtTaaSanitizeRawColor(history);
}

float3 BurtTaaSampleHistoryCatmullRom(float2 uv)
{
    int2 textureSize = BurtTaaHistoryTextureSize();
    float2 samplePosition = saturate(uv) * (float2)textureSize;
    float2 texPos1 = floor(samplePosition - 0.5) + 0.5;
    float2 f = samplePosition - texPos1;
    float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    float2 w3 = f * f * (-0.5 + 0.5 * f);
    float2 w12 = w1 + w2;
    float2 offset12 = w2 / max(w12, float2(1e-5, 1e-5));
    float2 texel = _BurtTAAHistoryTexelSize.xy;
    float2 texPos0 = (texPos1 - 1.0) * texel;
    float2 texPos3 = (texPos1 + 2.0) * texel;
    float2 texPos12 = (texPos1 + offset12) * texel;
    float3 result = 0.0;

    result += BurtTaaSampleHistoryLinear(float2(texPos0.x, texPos0.y)) * w0.x * w0.y;
    result += BurtTaaSampleHistoryLinear(float2(texPos12.x, texPos0.y)) * w12.x * w0.y;
    result += BurtTaaSampleHistoryLinear(float2(texPos3.x, texPos0.y)) * w3.x * w0.y;
    result += BurtTaaSampleHistoryLinear(float2(texPos0.x, texPos12.y)) * w0.x * w12.y;
    result += BurtTaaSampleHistoryLinear(float2(texPos12.x, texPos12.y)) * w12.x * w12.y;
    result += BurtTaaSampleHistoryLinear(float2(texPos3.x, texPos12.y)) * w3.x * w12.y;
    result += BurtTaaSampleHistoryLinear(float2(texPos0.x, texPos3.y)) * w0.x * w3.y;
    result += BurtTaaSampleHistoryLinear(float2(texPos12.x, texPos3.y)) * w12.x * w3.y;
    result += BurtTaaSampleHistoryLinear(float2(texPos3.x, texPos3.y)) * w3.x * w3.y;

    // XRender clamps the nine-tap Catmull-Rom history before converting it to
    // working/perceptual space. Negative filter lobes must not seed temporal
    // ringing, and the upper bound matches its CLAMP_MAX constant.
    return clamp(BurtTaaSanitizeRawColor(result), 0.0, 65472.0);
}

float3 BurtTaaSampleTAAUHistoryCatmullRomStubbe(float2 uv)
{
    int2 textureSize = BurtTaaHistoryTextureSize();
    float2 inverseSize = _BurtTAAHistoryTexelSize.xy;
    float2 pixelCoord = saturate(uv) * (float2)textureSize;
    float2 integerUv = floor(pixelCoord - 0.5) + 1.0;
    float2 f = pixelCoord - integerUv;
    float2 f2 = f * f;
    float2 sampleOffset = (1.25 - f2) * f + 0.5;
    float2 t0 = (0.25 * f2 - 0.0625) * (1.125 - 0.5 * f2.yx);
    float2 w0 = t0 - (f + f) * t0;
    float2 w3 = t0 + (f + f) * t0;
    float2 centerUv = (integerUv - 0.5) * inverseSize;
    sampleOffset *= inverseSize;

    float2 sampleUv0 = centerUv + float2(-inverseSize.x, sampleOffset.y);
    float2 sampleUv1 = centerUv + float2(2.0 * inverseSize.x, sampleOffset.y);
    float2 sampleUv2 = centerUv + sampleOffset;
    float2 sampleUv3 = centerUv + float2(sampleOffset.x, -inverseSize.y);
    float2 sampleUv4 = centerUv + float2(sampleOffset.x, 2.0 * inverseSize.y);
    float centerWeight = 1.0 - w0.x - w3.x - w0.y - w3.y;

    float3 centerSample = BurtTaaSampleHistoryLinear(sampleUv2);
    float3 result = 0.0;
    result += BurtTaaSampleHistoryLinear(sampleUv0) * w0.x;
    result += BurtTaaSampleHistoryLinear(sampleUv1) * w3.x;
    result += centerSample * centerWeight;
    result += BurtTaaSampleHistoryLinear(sampleUv3) * w0.y;
    result += BurtTaaSampleHistoryLinear(sampleUv4) * w3.y;

    // XRender falls back to the center fetch when the negative Catmull-Rom
    // lobes create an invalid HDR highlight.
    result = any(result < 0.0) ? max(centerSample, 0.0) : result;
    return BurtTaaSanitizeRawColor(result, centerSample);
}

float BurtTaaCurrentSampleWeight(int x, int y)
{
    if (x == 0 && y == 0) return _BurtTAACurrentSampleWeights0.x;
    if (x == 0 && y == 1) return _BurtTAACurrentSampleWeights0.y;
    if (x == 1 && y == 0) return _BurtTAACurrentSampleWeights0.z;
    if (x == -1 && y == 0) return _BurtTAACurrentSampleWeights0.w;
    if (x == 0 && y == -1) return _BurtTAACurrentSampleWeights1.x;
    if (x == -1 && y == 1) return _BurtTAACurrentSampleWeights1.y;
    if (x == 1 && y == -1) return _BurtTAACurrentSampleWeights1.z;
    if (x == 1 && y == 1) return _BurtTAACurrentSampleWeights1.w;
    return _BurtTAACurrentSampleWeights2.x;
}

[numthreads(8, 8, 1)]
void ClearPrevUseCountAACS(uint3 id : SV_DispatchThreadID)
{
    int2 textureSize = BurtTaaTextureSize();
    int2 pixel = int2(id.xy);
    if (pixel.x >= textureSize.x || pixel.y >= textureSize.y)
    {
        return;
    }

    _BurtTAAPrevUseCountOutputTexture[pixel] = 0u;
}

[numthreads(8, 8, 1)]
void DilateVelocityAACS(uint3 id : SV_DispatchThreadID)
{
    int2 textureSize = BurtTaaTextureSize();
    int2 pixel = int2(id.xy);
    if (pixel.x >= textureSize.x || pixel.y >= textureSize.y)
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5) * _BurtTAATexelSize.xy;
    float centerDepth = BurtTaaLoadCurrentDepth(pixel);
    float closestDepth = centerDepth;
    int2 closestOffset = int2(0, 0);
    float centerDeviceZError = BurtTaaCalculateDeviceZError(centerDepth);

    // Native-resolution XRender TAA checks all four symmetric pairs. XRender's
    // dedicated TAAU path checks only the horizontal/vertical pairs.
    BurtTaaSelectClosestDepthTap(pixel, int2(1, 0), centerDepth, centerDeviceZError, closestDepth, closestOffset);
    BurtTaaSelectClosestDepthTap(pixel, int2(0, 1), centerDepth, centerDeviceZError, closestDepth, closestOffset);
    if (_BurtTAADilateMode < 0.5)
    {
        BurtTaaSelectClosestDepthTap(pixel, int2(1, 1), centerDepth, centerDeviceZError, closestDepth, closestOffset);
        BurtTaaSelectClosestDepthTap(pixel, int2(-1, 1), centerDepth, centerDeviceZError, closestDepth, closestOffset);
    }

    float centerStaticAvailable = 0.0;
    float2 centerVelocity = BurtTaaComputeStaticVelocity(uv, centerDepth, centerStaticAvailable);
    float4 centerObjectVelocity = _BurtTAARawVelocityTexture.Load(int3(pixel, 0));
    float centerStencilObjectMotion = (BurtTaaLoadStencilMask(uv) & BURT_DEFERRED_STENCIL_OBJECT_MOTION_BIT) != 0u ? 1.0 : 0.0;
    // XRender's velocity ownership is entirely stencil driven: bit 8 means the
    // RG payload is authoritative.  Requiring auxiliary Z/W validity channels
    // drops legitimate skinned/fur/multipass velocities that only provide RG.
    centerVelocity = lerp(centerVelocity, centerObjectVelocity.xy, centerStencilObjectMotion);

    float staticAvailable = 0.0;
    float2 finalVelocity = BurtTaaComputeStaticVelocity(uv, closestDepth, staticAvailable);
    int2 closestPixel = clamp(pixel + closestOffset, int2(0, 0), textureSize - 1);
    float2 closestUv = (float2(closestPixel) + 0.5) * _BurtTAATexelSize.xy;
    float4 objectVelocity = _BurtTAARawVelocityTexture.Load(int3(closestPixel, 0));
    float stencilObjectMotion = (BurtTaaLoadStencilMask(closestUv) & BURT_DEFERRED_STENCIL_OBJECT_MOTION_BIT) != 0u ? 1.0 : 0.0;
    finalVelocity = lerp(finalVelocity, objectVelocity.xy, stencilObjectMotion);
    float2 historyUv = uv - finalVelocity;

    BurtTaaScatterPrevUseCount(historyUv);
    float2 velocityDeltaPixels = abs((finalVelocity - centerVelocity) * _BurtTAATexelSize.zw);
    float reprojectionEdgeConfidence = saturate(1.1 - dot(velocityDeltaPixels, float2(1.1, 1.1)));
    float hasReprojectionOffset = any(closestOffset != int2(0, 0)) ? 1.0 : 0.0;
    float reprojectionConfidence = hasReprojectionOffset > 0.0
        ? round(reprojectionEdgeConfidence * 127.0) * (1.0 / 127.0)
        : 1.0;
    float inBounds = step(0.0, historyUv.x) * step(historyUv.x, 1.0) * step(0.0, historyUv.y) * step(historyUv.y, 1.0);
    float offscreenBit = inBounds > 0.5 ? 0.0 : (1.0 / 255.0);
    _BurtTAADilatedVelocityTexture[pixel] = finalVelocity;
    // Decimate mask: R=state bits, G=the 7-bit XRender reprojection confidence,
    // B=parallax validity, A=reserved zero.
    _BurtTAADilateMaskOutputTexture[pixel] = float4(
        offscreenBit,
        reprojectionConfidence,
        0.0,
        0.0);
    _BurtTAAClosestDepthOutputTexture[pixel] = closestDepth;
}

[numthreads(8, 8, 1)]
void DecimateHistoryAACS(uint3 id : SV_DispatchThreadID)
{
    int2 textureSize = BurtTaaTextureSize();
    int2 pixel = int2(id.xy);
    if (pixel.x >= textureSize.x || pixel.y >= textureSize.y)
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5) * _BurtTAATexelSize.xy;
    float2 velocityData = _BurtTAAVelocityTexture.Load(int3(pixel, 0));
    float2 historyUv = uv - velocityData;
    float inBounds = step(0.0, historyUv.x) * step(historyUv.x, 1.0) * step(0.0, historyUv.y) * step(historyUv.y, 1.0);
    float currentRawDepth = _BurtTAAClosestDepthTexture.Load(int3(pixel, 0));
    float currentLinearDepth = max(BurtTaaLinearEyeDepth(currentRawDepth), 1e-4);
    float2 samplePosition = historyUv * (float2)textureSize - 0.5;
    int2 basePixel = int2(floor(samplePosition));
    float2 blend = saturate(samplePosition - basePixel);
    float finalRejection = 0.0;

    [unroll]
    for (int y = 0; y < 2; y++)
    {
        float wy = y == 0 ? (1.0 - blend.y) : blend.y;
        [unroll]
        for (int x = 0; x < 2; x++)
        {
            float wx = x == 0 ? (1.0 - blend.x) : blend.x;
            int2 usePixel = basePixel + int2(x, y);
            bool validPixel = usePixel.x >= 0 && usePixel.y >= 0 && usePixel.x < textureSize.x && usePixel.y < textureSize.y;
            float weight = wx * wy * inBounds * (validPixel ? 1.0 : 0.0);
            int2 safePixel = clamp(usePixel, int2(0, 0), textureSize - 1);
            uint previousUseCount = _BurtTAAPrevUseCountUintTexture.Load(int3(safePixel, 0));
            // XRender native TAA uses Fs=1/Fdepth=4, while its TAAU decimate
            // stage deliberately uses the stricter Fs=2/Fdepth=12 pair.
            float useCountRejectionScale = lerp(1.0, 2.0, _BurtTAADecimateMode);
            float depthRejectionScale = lerp(4.0, 12.0, _BurtTAADecimateMode);
            float historyGhostingRejection = saturate(
                1.0 - useCountRejectionScale * abs(previousUseCount * BURT_TAA_INV_USE_COUNT_QUANTIZATION - 1.0));
            float previousRawDepth = BurtTaaLoadHistoryDepth(safePixel);
            float previousLinearDepth = max(BurtTaaLinearEyeDepth(previousRawDepth), 1e-4);
            float depthDelta = abs(currentLinearDepth - previousLinearDepth);
            float depthRejection = saturate(2.0 - depthRejectionScale * depthDelta / previousLinearDepth);
            // Match XRender's decimate-history contract. These legacy
            // "Rejection" values are history-validity signals; max keeps the
            // feedback stable when jitter makes either depth or coverage noisy.
#if defined(SHADER_API_METAL)
            // The uint scatter is disabled on Metal, so depth is the only
            // reliable validity source on that backend.
            float tapHistoryValidity = depthRejection;
#else
            float tapHistoryValidity = max(historyGhostingRejection, depthRejection);
#endif
            finalRejection += tapHistoryValidity * weight;
        }
    }

    finalRejection = saturate(finalRejection);
    float4 decimateMask = _BurtTAADilateMaskOutputTexture[pixel];
    decimateMask.r = inBounds > 0.5 ? 0.0 : (1.0 / 255.0);
    decimateMask.b = finalRejection;
    _BurtTAADilateMaskOutputTexture[pixel] = decimateMask;
    _BurtTAAParallaxRejectionOutputTexture[pixel] = finalRejection;
}

[numthreads(8, 8, 1)]
void BuildHistoryRejectionAACS(uint3 id : SV_DispatchThreadID)
{
    int2 textureSize = BurtTaaTextureSize();
    int2 pixel = int2(id.xy);
    if (pixel.x >= textureSize.x || pixel.y >= textureSize.y)
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5) * _BurtTAATexelSize.xy;
    float2 velocity = _BurtTAAVelocityTexture.Load(int3(pixel, 0));
    float2 historyUv = uv - velocity;
    float inBounds = step(0.0, historyUv.x) * step(historyUv.x, 1.0) * step(0.0, historyUv.y) * step(historyUv.y, 1.0);
    // Match the signal accumulated by ResolveTemporalAACS. Comparing a single
    // jittered center sample against temporally filtered history makes stable
    // sub-pixel edges look like shading changes and rejects the samples needed
    // to anti-alias them.
    float3 currentFilteredWorking = 0.0;
    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            float3 sampleWorking = BurtTaaToWorkingPerceptualSpace(
                BurtTaaLoadCurrentRaw(pixel + int2(x, y)).rgb);
            currentFilteredWorking += sampleWorking * BurtTaaCurrentSampleWeight(x, y);
        }
    }
    float3 historyWorking = BurtTaaToWorkingPerceptualSpace(BurtTaaSampleHistoryCatmullRom(saturate(historyUv)));
    float shadingRejection = BurtTaaShadingRejection(currentFilteredWorking, historyWorking);
    float outOfBoundsRejection = 1.0 - inBounds;
    // Parallax validity is multiplied once in ResolveTemporalAACS. Folding its
    // inverse into this texture as well squares a noisy edge-validity signal.
    // Responsive AA follows XRender and changes the current blend only.
    _BurtTAAHistoryRejectionOutputTexture[pixel] = saturate(max(shadingRejection, outOfBoundsRejection));
}

[numthreads(8, 8, 1)]
void DilateHistoryRejectionAACS(uint3 id : SV_DispatchThreadID)
{
    int2 textureSize = BurtTaaTextureSize();
    int2 pixel = int2(id.xy);
    if (pixel.x >= textureSize.x || pixel.y >= textureSize.y)
    {
        return;
    }

    float centerRejection = _BurtTAAHistoryRejectionTexture.Load(int3(pixel, 0));
    float neighborhoodRejection = centerRejection;

    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            int2 samplePixel = BurtTaaClampPixel(pixel + int2(x, y));
            neighborhoodRejection = max(
                neighborhoodRejection,
                _BurtTAAHistoryRejectionTexture.Load(int3(samplePixel, 0)));
        }
    }

    // Preserve a hard rejection at the pixel that detected a disocclusion or
    // material change. The surrounding pixel is only a conservative guard
    // band: copying the full 3x3 maximum there clears history on both sides of
    // every moving edge and turns the jitter sequence into visible shimmer.
    float guardBandRejection = 0.5 * smoothstep(0.5, 1.0, neighborhoodRejection);
    _BurtTAADilatedHistoryRejectionOutputTexture[pixel] = saturate(max(centerRejection, guardBandRejection));
}

[numthreads(8, 8, 1)]
void ResolveTemporalAACS(uint3 id : SV_DispatchThreadID)
{
    int2 textureSize = BurtTaaTextureSize();
    int2 pixel = int2(id.xy);
    if (pixel.x >= textureSize.x || pixel.y >= textureSize.y)
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5) * _BurtTAATexelSize.xy;
    float4 rawCurrent = BurtTaaLoadCurrentRaw(pixel);
    float3 current = rawCurrent.rgb;
    float3 neighborhoodSum = 0.0;
    float3 neighborhoodSumSq = 0.0;
    float3 currentFilteredWorking = 0.0;

    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            float3 sampleWorking = BurtTaaToWorkingPerceptualSpace(BurtTaaLoadCurrentRaw(pixel + int2(x, y)).rgb);
            float sampleCurrentWeight = BurtTaaCurrentSampleWeight(x, y);
            neighborhoodSum += sampleWorking;
            neighborhoodSumSq += sampleWorking * sampleWorking;
            currentFilteredWorking += sampleWorking * sampleCurrentWeight;
        }
    }

    float2 velocityData = _BurtTAAVelocityTexture.Load(int3(pixel, 0));
    float2 historyUv = uv - velocityData;
    float historyValid = _BurtTAAParams.z;
    float inBounds = step(0.0, historyUv.x) * step(historyUv.x, 1.0) * step(0.0, historyUv.y) * step(historyUv.y, 1.0);
    float finalHistoryAvailability = historyValid * inBounds;
    if (finalHistoryAvailability <= 0.0)
    {
        // XRender seeds native TSR history with the unfiltered scene color and
        // returns that same resource on the first frame. Filtering here made a
        // history reset/camera cut visibly softer than the following frames.
        _BurtTAAResolveTexture[pixel] = float4(BurtTaaSanitizeRawColor(current), saturate(rawCurrent.a));
        return;
    }

    float3 rawHistory = BurtTaaSampleHistoryCatmullRom(historyUv);
    float3 historyWorking = BurtTaaToWorkingPerceptualSpace(rawHistory);
    float historyValidity = _BurtTAAParallaxRejectionTexture.Load(int3(pixel, 0));
    // Match XRender native TAA: its CalcRejection directly consumes only the
    // parallax/depth history-validity mask. Shading rejection belongs to TAAU.
    float finalRejection = saturate(historyValidity * finalHistoryAvailability);
    uint stencil = BurtTaaLoadStencilMask(uv);
    float stencilResponsive = (stencil & BURT_DEFERRED_STENCIL_RESPONSIVE_AA_BIT) != 0u ? 1.0 : 0.0;
    float responsiveMask = stencilResponsive;

    float3 moment1 = neighborhoodSum * (1.0 / 9.0);
    float3 moment2 = neighborhoodSumSq * (1.0 / 9.0);
    float3 standardDeviation = sqrt(abs(moment2 - moment1 * moment1));
    // XRender ships ACCUMULATE_CONFIG_ANTI_FLICKER_SD_BOOST disabled, so its
    // native TAA always clips history against the fixed 1.5-sigma bound.
    float standardDeviationFactor = 1.5;
    float3 clampMin = moment1 - standardDeviation * standardDeviationFactor;
    float3 clampMax = moment1 + standardDeviation * standardDeviationFactor;
    float3 boxCenter = 0.5 * (clampMax + clampMin);
    float3 boxExtents = max(
        0.5 * (clampMax - clampMin),
        float3(6.103515625e-5, 6.103515625e-5, 6.103515625e-5));
    float3 historyOffset = historyWorking - boxCenter;
    float3 clampUnitVector = abs(historyOffset) / boxExtents;
    float clampUnit = max(max(clampUnitVector.x, clampUnitVector.y), clampUnitVector.z);
    float3 clippedHistoryWorking = clampUnit > 1.0 ? boxCenter + historyOffset / clampUnit : historyWorking;
    float minBoundLuma = clampMin.x;
    float maxBoundLuma = clampMax.x;
    float historyLuma = historyWorking.x;
    float lumaContrast = saturate(
        0.25 * rcp(
            1.0 + max(maxBoundLuma - minBoundLuma, 0.0) /
            max(historyLuma, 6.103515625e-5)));
    float xrenderBaseBlend = max(0.05, lumaContrast);
    float currentBlend = lerp(1.0, xrenderBaseBlend, finalRejection);
    // Match XRender's explicit responsive branch: responsive pixels use a
    // fixed 25% current-frame weight while their history UV remains in bounds.
    currentBlend = lerp(currentBlend, 0.25, responsiveMask * finalHistoryAvailability);
    currentBlend = saturate(currentBlend);

    float3 resolvedWorking = lerp(clippedHistoryWorking, currentFilteredWorking, currentBlend);
    resolvedWorking = lerp(currentFilteredWorking, resolvedWorking, finalHistoryAvailability);
    float3 resolved = BurtTaaFromWorkingPerceptualSpace(resolvedWorking);
    _BurtTAAResolveTexture[pixel] = float4(BurtTaaSanitizeRawColor(resolved, current), saturate(rawCurrent.a));
}

float4 BurtTaaSampleCurrentLinear(float2 uv)
{
    int2 textureSize = BurtTaaTextureSize();
    float2 samplePosition = saturate(uv) * (float2)textureSize - 0.5;
    int2 basePixel = int2(floor(samplePosition));
    float2 blend = saturate(samplePosition - basePixel);
    float4 result = 0.0;

    [unroll]
    for (int y = 0; y < 2; y++)
    {
        float wy = y == 0 ? 1.0 - blend.y : blend.y;
        [unroll]
        for (int x = 0; x < 2; x++)
        {
            float wx = x == 0 ? 1.0 - blend.x : blend.x;
            result += BurtTaaLoadCurrentRaw(basePixel + int2(x, y)) * (wx * wy);
        }
    }

    return result;
}

float2 BurtTaaSampleVelocityLinear(float2 uv)
{
    int2 textureSize = BurtTaaTextureSize();
    float2 samplePosition = saturate(uv) * (float2)textureSize - 0.5;
    int2 basePixel = int2(floor(samplePosition));
    float2 blend = saturate(samplePosition - basePixel);
    float2 result = 0.0;

    [unroll]
    for (int y = 0; y < 2; y++)
    {
        float wy = y == 0 ? 1.0 - blend.y : blend.y;
        [unroll]
        for (int x = 0; x < 2; x++)
        {
            float wx = x == 0 ? 1.0 - blend.x : blend.x;
            result += _BurtTAAVelocityTexture.Load(int3(BurtTaaClampPixel(basePixel + int2(x, y)), 0)) * (wx * wy);
        }
    }

    return result;
}

[numthreads(8, 8, 1)]
void ResolveTemporalAAUpscaleAACS(uint3 id : SV_DispatchThreadID)
{
    int2 outputSize = BurtTaaHistoryTextureSize();
    int2 pixel = int2(id.xy);
    if (pixel.x >= outputSize.x || pixel.y >= outputSize.y)
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5) * _BurtTAAHistoryTexelSize.xy;
    float4 rawCurrent = BurtTaaSampleCurrentLinear(uv);
    float3 current = rawCurrent.rgb;
    float2 velocity = BurtTaaSampleVelocityLinear(uv);
    float2 historyUv = uv - velocity;
    float inBounds = step(0.0, historyUv.x) * step(historyUv.x, 1.0) * step(0.0, historyUv.y) * step(historyUv.y, 1.0);
    float historyAvailable = _BurtTAAParams.z * inBounds;
    if (historyAvailable <= 0.0)
    {
        _BurtTemporalAAOutputTexture[pixel] = float4(current, saturate(rawCurrent.a));
        return;
    }

    int2 inputPixel = BurtTaaClampPixel(int2(uv * (float2)BurtTaaTextureSize()));
    float historyValidity = _BurtTAAParallaxRejectionTexture.Load(int3(inputPixel, 0));
    float historyRejection = _BurtTAADilatedHistoryRejectionTexture.Load(int3(inputPixel, 0));
    float responsive = saturate(_BurtTAAMetadataTexture.Load(int3(inputPixel, 0)).g);
    responsive = max(responsive, (BurtTaaLoadStencilMask(uv) & BURT_DEFERRED_STENCIL_RESPONSIVE_AA_BIT) != 0u ? 1.0 : 0.0);
    float finalRejection = saturate(historyValidity * (1.0 - historyRejection) * historyAvailable);
    float3 history = BurtTaaSampleHistoryCatmullRom(saturate(historyUv));
    float motionPixels = length(velocity * _BurtTAAHistoryTexelSize.zw);
    float currentBlend = lerp(1.0, 0.08, finalRejection);
    currentBlend = max(currentBlend, 0.3 * responsive * historyAvailable);
    currentBlend = max(currentBlend, saturate(motionPixels * 0.04));
    float3 resolved = lerp(history, current, saturate(currentBlend));
    _BurtTemporalAAOutputTexture[pixel] = float4(BurtTaaSanitizeRawColor(resolved, current), saturate(rawCurrent.a));
}

float4 BurtTaaSampleHistoryGuideLinear(float2 uv)
{
    int2 textureSize = max(int2(_BurtTAAUGuideTexelSize.zw), int2(1, 1));
    float2 samplePosition = saturate(uv) * (float2)textureSize - 0.5;
    int2 basePixel = int2(floor(samplePosition));
    float2 blend = saturate(samplePosition - basePixel);
    float4 result = 0.0;

    [unroll]
    for (int y = 0; y < 2; y++)
    {
        float wy = y == 0 ? 1.0 - blend.y : blend.y;
        [unroll]
        for (int x = 0; x < 2; x++)
        {
            float wx = x == 0 ? 1.0 - blend.x : blend.x;
            int2 samplePixel = clamp(basePixel + int2(x, y), int2(0, 0), textureSize - 1);
            result += _BurtTAAUHistoryGuideTexture.Load(int3(samplePixel, 0)) * (wx * wy);
        }
    }

    return result;
}

float4 BurtTaaSampleHistoryGuideCatmullRom(float2 uv)
{
    int2 textureSize = max(int2(_BurtTAAUGuideTexelSize.zw), int2(1, 1));
    float2 samplePosition = saturate(uv) * (float2)textureSize;
    float2 texPos1 = floor(samplePosition - 0.5) + 0.5;
    float2 f = samplePosition - texPos1;
    float2 f2 = f * f;
    float2 f3 = f2 * f;
    float2 w0 = f2 - 0.5 * (f3 + f);
    float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    float2 w3 = 0.5 * (f3 - f2);
    float2 w2 = 1.0 - w0 - w1 - w3;
    float2 combinedWeight = w1 + w2;
    float2 inverseSize = _BurtTAAUGuideTexelSize.xy;
    float2 sample0 = (texPos1 - 1.0) * inverseSize;
    float2 sample1 = (texPos1 + w2 * rcp(max(combinedWeight, float2(1e-5, 1e-5)))) * inverseSize;
    float2 sample2 = (texPos1 + 2.0) * inverseSize;

    // XRender's guide reprojection uses its five-tap optimized Catmull-Rom
    // cross (the four corner taps are deliberately omitted).
    float4 result = 0.0;
    result += BurtTaaSampleHistoryGuideLinear(float2(sample1.x, sample0.y)) * (combinedWeight.x * w0.y);
    result += BurtTaaSampleHistoryGuideLinear(float2(sample0.x, sample1.y)) * (w0.x * combinedWeight.y);
    result += BurtTaaSampleHistoryGuideLinear(sample1) * (combinedWeight.x * combinedWeight.y);
    result += BurtTaaSampleHistoryGuideLinear(float2(sample2.x, sample1.y)) * (w3.x * combinedWeight.y);
    result += BurtTaaSampleHistoryGuideLinear(float2(sample1.x, sample2.y)) * (combinedWeight.x * w3.y);

    result.rgb = BurtTaaSanitizeRawColor(result.rgb);
    result.a = saturate(result.a);
    return result;
}

float4 BurtTaaSampleTAAURejectionLinear(float2 uv)
{
    int2 textureSize = BurtTaaTextureSize();
    float2 samplePosition = saturate(uv) * (float2)textureSize - 0.5;
    int2 basePixel = int2(floor(samplePosition));
    float2 blend = saturate(samplePosition - basePixel);
    float4 result = 0.0;

    [unroll]
    for (int y = 0; y < 2; y++)
    {
        float wy = y == 0 ? 1.0 - blend.y : blend.y;
        [unroll]
        for (int x = 0; x < 2; x++)
        {
            float wx = x == 0 ? 1.0 - blend.x : blend.x;
            int2 samplePixel = clamp(basePixel + int2(x, y), int2(0, 0), textureSize - 1);
            result += _BurtTAAUShadingRejectionTexture.Load(int3(samplePixel, 0)) * (wx * wy);
        }
    }

    return result;
}

float BurtTaaMitchellWeight(float distanceValue)
{
    float d = abs(distanceValue);
    const float b = 1.0 / 3.0;
    const float c = 1.0 / 3.0;
    if (d < 1.0)
    {
        return ((12.0 - 9.0 * b - 6.0 * c) * d * d * d +
                (-18.0 + 12.0 * b + 6.0 * c) * d * d +
                (6.0 - 2.0 * b)) * (1.0 / 6.0);
    }
    if (d < 2.0)
    {
        return ((-b - 6.0 * c) * d * d * d +
                (6.0 * b + 30.0 * c) * d * d +
                (-12.0 * b - 48.0 * c) * d +
                (8.0 * b + 24.0 * c)) * (1.0 / 6.0);
    }
    return 0.0;
}

float BurtTaaHdrWeight(float3 color)
{
    return rcp(dot(max(color, 0.0), float3(1.0, 2.0, 1.0)) + 4.0);
}

float3 BurtTaaLinearToGCS(float3 linearColor)
{
    return linearColor * rcp(linearColor + 0.17);
}

float3 BurtTaaGCSToLinear(float3 gcsColor)
{
    float3 denominator = max(1.0 - gcsColor, float3(1e-5, 1e-5, 1e-5));
    return min(gcsColor * (0.17 / denominator), 65504.0);
}

float3 BurtTaaPreExposureCorrectGCS(float3 gcsColor)
{
    return BurtTaaLinearToGCS(
        BurtTaaGCSToLinear(gcsColor) * max(_BurtTAAHistoryExposureCorrection, 0.0));
}

float3 BurtTaaAddPerceptionOne(float3 linearColor)
{
    return linearColor * rcp(linearColor + 1.0);
}

float3 BurtTaaRemovePerceptionOne(float3 perceptualColor)
{
    return perceptualColor * rcp(max(1.0 - perceptualColor, float3(1e-5, 1e-5, 1e-5)));
}

float BurtTaaComputeUpscaleSampleWeight(float upscaleFactor, float2 pixelDelta, float minimalContribution)
{
    float upscaleFactorSquared = upscaleFactor * upscaleFactor;
    float distanceSquared = saturate(upscaleFactorSquared * dot(pixelDelta, pixelDelta));
    return saturate((0.9 * distanceSquared - 1.9) * distanceSquared + 1.0 + minimalContribution);
}

uint3 BurtTaaRand3DPCG16(int3 position)
{
    uint3 value = uint3(position);
    value = value * 1664525u + 1013904223u;
    value.x += value.y * value.z;
    value.y += value.z * value.x;
    value.z += value.x * value.y;
    value.x += value.y * value.z;
    value.y += value.z * value.x;
    value.z += value.x * value.y;
    return value >> 16u;
}

float3 BurtTaaQuantizePackedHistory(float3 color, float randomValue)
{
    float3 error = color * float3(1.0 / 64.0, 1.0 / 64.0, 1.0 / 32.0);
    error.x = asfloat(asuint(error.x) & ~0x007FFFFFu);
    error.y = asfloat(asuint(error.y) & ~0x007FFFFFu);
    error.z = asfloat(asuint(error.z) & ~0x007FFFFFu);
    return color + error * randomValue;
}

float4 BurtTaaReconstructCurrentForHistory(
    float2 historyUv,
    float kernelInputToHistoryFactor,
    out float3 currentMin,
    out float3 currentMax)
{
    int2 inputSize = BurtTaaUInputTextureSize();
    float2 inputPixelPosition = historyUv * (float2)inputSize - 0.5 + _BurtTAAJitter.zw;
    // XRender selects the nearest input pixel center through
    // floor(InPixelPosCenterOut).  inputPixelPosition is expressed in texel
    // index space here, hence the matching conversion is floor(x + 0.5).
    int2 centerPixel = int2(floor(inputPixelPosition + 0.5));
    float4 accumulated = 0.0;
    float accumulatedWeight = 0.0;
    currentMin = float3(65504.0, 65504.0, 65504.0);
    currentMax = 0.0;

    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            int2 samplePixel = clamp(centerPixel + int2(x, y), int2(0, 0), inputSize - 1);
            float4 sampleColor = BurtTaaULoadCurrentRaw(samplePixel);
            float2 pixelDelta = (float2)samplePixel - inputPixelPosition;
            float spatialWeight = BurtTaaComputeUpscaleSampleWeight(kernelInputToHistoryFactor, pixelDelta, 0.005);
            float sampleWeight = spatialWeight * BurtTaaHdrWeight(sampleColor.rgb);
            accumulated += sampleColor * sampleWeight;
            accumulatedWeight += sampleWeight;
            currentMin = min(currentMin, sampleColor.rgb);
            currentMax = max(currentMax, sampleColor.rgb);
        }
    }

    int2 safeCenterPixel = clamp(centerPixel, int2(0, 0), inputSize - 1);
    float4 center = BurtTaaULoadCurrentRaw(safeCenterPixel);
    float4 reconstructed = accumulatedWeight > 1e-5 ? accumulated / accumulatedWeight : center;
    reconstructed.rgb = clamp(BurtTaaSanitizeRawColor(reconstructed.rgb, center.rgb), currentMin, currentMax);
    reconstructed.a = saturate(center.a);
    return reconstructed;
}

float3 BurtTaaSampleUpdatedHistoryCatmullRom(float2 uv)
{
    uint textureWidth;
    uint textureHeight;
    _BurtTAAUUpdatedHistoryTexture.GetDimensions(textureWidth, textureHeight);
    int2 textureSize = max(int2(textureWidth, textureHeight), int2(1, 1));
    float2 historyTexelSize = rcp((float2)textureSize);
    float2 samplePosition = saturate(uv) * (float2)textureSize;
    float2 texPos1 = floor(samplePosition - 0.5) + 0.5;
    float2 f = samplePosition - texPos1;
    float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    float2 w3 = f * f * (-0.5 + 0.5 * f);
    float2 w12 = w1 + w2;
    float2 offset12 = w2 / max(w12, float2(1e-5, 1e-5));
    float2 texel = historyTexelSize;
    float2 texPos0 = (texPos1 - 1.0) * texel;
    float2 texPos3 = (texPos1 + 2.0) * texel;
    float2 texPos12 = (texPos1 + offset12) * texel;
    float3 result = 0.0;
    float weightSum = 0.0;

    [unroll]
    for (int y = 0; y < 3; y++)
    {
        float sampleY = y == 0 ? texPos0.y : (y == 1 ? texPos12.y : texPos3.y);
        float weightY = y == 0 ? w0.y : (y == 1 ? w12.y : w3.y);
        [unroll]
        for (int x = 0; x < 3; x++)
        {
            float sampleX = x == 0 ? texPos0.x : (x == 1 ? texPos12.x : texPos3.x);
            float weightX = x == 0 ? w0.x : (x == 1 ? w12.x : w3.x);
            int2 samplePixel = clamp(int2(float2(sampleX, sampleY) * (float2)textureSize), int2(0, 0), textureSize - 1);
            float weight = weightX * weightY;
            result += _BurtTAAUUpdatedHistoryTexture.Load(int3(samplePixel, 0)).rgb * weight;
            weightSum += weight;
        }
    }

    return BurtTaaSanitizeRawColor(result * rcp(max(abs(weightSum), 1e-5)));
}

[numthreads(8, 8, 1)]
void ReprojectTAAUHistoryGuideAACS(uint3 id : SV_DispatchThreadID)
{
    int2 textureSize = BurtTaaUInputTextureSize();
    int2 pixel = int2(id.xy);
    if (any(pixel >= textureSize))
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5) * _BurtTAAUInputTexelSize.xy;
    float2 velocity = _BurtTAAVelocityTexture.Load(int3(pixel, 0));
    float2 historyUv = uv - velocity;
    float inBounds = step(0.0, historyUv.x) * step(historyUv.x, 1.0) * step(0.0, historyUv.y) * step(historyUv.y, 1.0);
    float historyAvailable = _BurtTAAParams.z * inBounds;
    float4 guide = historyAvailable > 0.0
        ? BurtTaaSampleHistoryGuideCatmullRom(historyUv)
        : 0.0;
    guide.rgb = BurtTaaPreExposureCorrectGCS(guide.rgb);
    guide.a = historyAvailable > 0.0 ? saturate(guide.a) : 1.0;
    _BurtTAAUReprojectedGuideOutputTexture[pixel] = guide;
}

[numthreads(8, 8, 1)]
void RejectTAAUShadingAACS(uint3 id : SV_DispatchThreadID)
{
    int2 textureSize = BurtTaaUInputTextureSize();
    int2 pixel = int2(id.xy);
    if (any(pixel >= textureSize))
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5) * _BurtTAAUInputTexelSize.xy;
    float3 current = BurtTaaULoadCurrentRaw(pixel).rgb;
    float4 previousGuide = _BurtTAAUReprojectedGuideTexture.Load(int3(pixel, 0));
    float3 historyShading = previousGuide.rgb * previousGuide.rgb;
    float3 neighborhoodMin = float3(65504.0, 65504.0, 65504.0);
    float3 neighborhoodMax = float3(-65504.0, -65504.0, -65504.0);

    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            float3 sampleGcs = BurtTaaLinearToGCS(BurtTaaULoadCurrentRaw(pixel + int2(x, y)).rgb);
            float3 sampleShading = sampleGcs * sampleGcs;
            neighborhoodMin = min(neighborhoodMin, sampleShading);
            neighborhoodMax = max(neighborhoodMax, sampleShading);
        }
    }

    float3 boxCenter = 0.5 * (neighborhoodMin + neighborhoodMax);
    float3 boxExtents = max(0.5 * (neighborhoodMax - neighborhoodMin), float3(1e-5, 1e-5, 1e-5));
    float3 historyOffset = historyShading - boxCenter;
    float3 clampUnitVector = abs(historyOffset) / boxExtents;
    float clampUnit = max(max(clampUnitVector.x, clampUnitVector.y), clampUnitVector.z);
    float historyClip = saturate(rcp(max(clampUnit, 1.0)));

    float4 decimateMask = _BurtTAADilateMaskTexture.Load(int3(pixel, 0));
    uint decimateBits = (uint)round(saturate(decimateMask.r) * 255.0);
    float offscreen = (decimateBits & 1u) != 0u ? 1.0 : 0.0;
    float reprojectionConfidence = saturate(decimateMask.g);
    float parallaxValidity = saturate(decimateMask.b);
    uint stencil = BurtTaaLoadStencilMask(uv);
    float responsive = (stencil & BURT_DEFERRED_STENCIL_RESPONSIVE_AA_BIT) != 0u ? 1.0 : 0.0;
    float historyAvailable = _BurtTAAParams.z;
    float disoccluded = max(offscreen, 1.0 - historyAvailable);
    float rejectionBlendFinal = parallaxValidity;
    float inputReprojectionConfidence = responsive > 0.0 ? 0.0 : reprojectionConfidence;
    float disableHistoryClamp = disoccluded > 0.5
        ? 0.0
        : min(min(0.99, inputReprojectionConfidence), min(saturate(previousGuide.a), historyClip));
    float guideHistoryWeight = min(historyClip, rejectionBlendFinal);
    guideHistoryWeight = responsive > 0.0 ? min(guideHistoryWeight, 0.25) : guideHistoryWeight;
    float guideCurrentBlend = disoccluded > 0.5 ? 1.0 : saturate(1.0 - guideHistoryWeight * 4.0);
    float3 perceptualCurrent = BurtTaaAddPerceptionOne(current);
    float3 perceptualHistory = BurtTaaAddPerceptionOne(BurtTaaGCSToLinear(previousGuide.rgb));
    float3 perceptualGuide = lerp(perceptualHistory, perceptualCurrent, guideCurrentBlend);
    float3 guide = BurtTaaLinearToGCS(BurtTaaRemovePerceptionOne(perceptualGuide));
    uint bitMask = (disoccluded > 0.5 ? 1u : 0u) | (responsive > 0.0 ? 2u : 0u);

    // Match XRender TAAU rejection packing: R=low-frequency retention,
    // G=disable-clamp confidence, B=reserved zero, A=state bits.
    _BurtTAAUHistoryGuideOutputTexture[pixel] = float4(
        BurtTaaSanitizeRawColor(guide, BurtTaaLinearToGCS(current)),
        inputReprojectionConfidence);
    _BurtTAAUShadingRejectionOutputTexture[pixel] = float4(rejectionBlendFinal, disableHistoryClamp, 0.0, bitMask * (1.0 / 255.0));
}

[numthreads(8, 8, 1)]
void DilateTAAUShadingRejectionAACS(uint3 id : SV_DispatchThreadID)
{
    int2 textureSize = BurtTaaUInputTextureSize();
    int2 pixel = int2(id.xy);
    if (any(pixel >= textureSize))
    {
        return;
    }

    float4 centerValue = _BurtTAAUShadingRejectionTexture.Load(int3(pixel, 0));
    float minRetention = centerValue.r;
    float minClampConfidence = centerValue.g;
    bool hasResponsiveAA = centerValue.b < 1e-5;

    [unroll]
    for (int y = -1; y <= 1; y++)
    {
        [unroll]
        for (int x = -1; x <= 1; x++)
        {
            if (x == 0 && y == 0)
            {
                continue;
            }

            int2 samplePixel = clamp(pixel + int2(x, y), int2(0, 0), textureSize - 1);
            float4 sampleValue = _BurtTAAUShadingRejectionTexture.Load(int3(samplePixel, 0));
            hasResponsiveAA = hasResponsiveAA || sampleValue.b < 1e-5;
            minRetention = min(minRetention, sampleValue.r);
            minClampConfidence = min(minClampConfidence, sampleValue.g);
        }
    }

    float outputRetention = hasResponsiveAA ? minRetention : centerValue.r;
    float outputClampConfidence = hasResponsiveAA ? minClampConfidence : centerValue.g;
    _BurtTAAUDilatedShadingRejectionOutputTexture[pixel] = float4(
        outputRetention,
        outputClampConfidence,
        centerValue.b,
        centerValue.a);
}

void BurtUpdateTAAUHistory(uint3 id)
{
    // The persistent history is deliberately 2x output resolution.  Treat the
    // bound UAV as the write-domain authority; a shared compute constant can
    // otherwise retain an input-scaled value and silently leave the right and
    // bottom of this persistent texture stale.
    uint historyWidth;
    uint historyHeight;
    _BurtTAAUUpdatedHistoryOutputTexture.GetDimensions(historyWidth, historyHeight);
    int2 historySize = max(int2(historyWidth, historyHeight), int2(1, 1));
    float2 historyTexelSize = rcp((float2)historySize);
    int2 pixel = int2(id.xy);
    if (any(pixel >= historySize))
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5) * historyTexelSize;
    float2 inputPixelCenter = uv * _BurtTAAUInputTexelSize.zw + _BurtTAAJitter.zw;
    int2 inputPixel = BurtTaaUClampInputPixel(int2(floor(inputPixelCenter)));
    float4 rejection = _BurtTAAUDilatedShadingRejectionTexture.Load(int3(inputPixel, 0));
    float lowFrequencyRejection = saturate(rejection.x);
    uint bitMask = (uint)round(saturate(rejection.w) * 255.0);
    float responsive = (bitMask & 2u) != 0u ? 1.0 : 0.0;
    float2 velocity = _BurtTAAVelocityTexture.Load(int3(inputPixel, 0));
    float2 historyUv = uv - velocity;
    float inBounds = step(0.0, historyUv.x) * step(historyUv.x, 1.0) * step(0.0, historyUv.y) * step(historyUv.y, 1.0);
    float offscreen = 1.0 - saturate(_BurtTAAParams.z * inBounds);
    float disoccluded = offscreen < 0.5 && lowFrequencyRejection < 0.01 ? 1.0 : 0.0;
    float2 inputPixelPosition = inputPixelCenter - 0.5;
    float2 inputPixelAlignmentDelta = inputPixelPosition - round(inputPixelPosition);
    float inputToHistoryFactor =
        historySize.x / max(_BurtTAAUInputTexelSize.z, 1.0);

    float historySampleCount = max(_BurtTAAUHistoryParams.x, 1.0);
    float historyHysteresis = saturate(_BurtTAAUHistoryParams.y);
    float minimumRejectionBlend = 1.0 - lowFrequencyRejection;
    minimumRejectionBlend = offscreen > 0.5 ? 1.0 : minimumRejectionBlend;
    float coarseAlignment = BurtTaaComputeUpscaleSampleWeight(1.0, inputPixelAlignmentDelta, 0.0);
    float idealAlignment = BurtTaaComputeUpscaleSampleWeight(inputToHistoryFactor, inputPixelAlignmentDelta, 0.0);
    float coarseCurrentContribution = coarseAlignment * historyHysteresis;
    float idealCurrentContribution = idealAlignment * historyHysteresis;

    float previousHistoryValidity = offscreen > 0.5 || lowFrequencyRejection <= 0.0 ? 0.0 : 1.0;
    float refiningHysteresis = previousHistoryValidity + idealCurrentContribution > 0.0
        ? idealCurrentContribution * rcp(previousHistoryValidity + idealCurrentContribution)
        : 1.0;
    float rejectedPreviousMultiplier = (1.0 - minimumRejectionBlend) * rcp(max(minimumRejectionBlend, 1e-5));
    float refiningPreviousMultiplier = (1.0 - refiningHysteresis) * rcp(max(refiningHysteresis, 1e-5));
    float coarseRejectedPreviousWeight = min(coarseCurrentContribution * rejectedPreviousMultiplier, 1.0);
    float coarseRefiningPreviousWeight = min(coarseCurrentContribution * refiningPreviousMultiplier, 1.0);
    float refining = coarseRejectedPreviousWeight < coarseRefiningPreviousWeight ? 0.0 : 1.0;
    refining = min(refining, saturate(previousHistoryValidity * historySampleCount));

    float kernelLerp = offscreen > 0.5 || disoccluded > 0.5 || responsive > 0.5
        ? 0.0
        : saturate(lowFrequencyRejection * 16.0 - 13.0) * refining;
    float kernelInputToHistoryFactor = lerp(1.0, inputToHistoryFactor, kernelLerp);
    float alignmentFactor = lerp(1.0, inputToHistoryFactor, kernelLerp);
    float inputAlignment = BurtTaaComputeUpscaleSampleWeight(alignmentFactor, inputPixelAlignmentDelta, 0.0);
    float currentWeight = inputAlignment * historyHysteresis;
    float previousWeight = min(
        (currentWeight > 0.0 ? currentWeight : coarseCurrentContribution) * rejectedPreviousMultiplier,
        previousHistoryValidity);
    previousWeight = min(previousWeight, max(1.0 - currentWeight, 0.0));
    responsive = refining > 0.5 ? 0.0 : responsive;

    float3 currentMin;
    float3 currentMax;
    float4 current = BurtTaaReconstructCurrentForHistory(uv, kernelInputToHistoryFactor, currentMin, currentMax);

    float3 previous = current.rgb;
    if (previousHistoryValidity > 0.0)
    {
        previous = BurtTaaSampleTAAUHistoryCatmullRomStubbe(historyUv);
    }
    float3 clampedPrevious = clamp(previous, currentMin, currentMax);
    float disableHistoryClamp = saturate(rejection.y);
    float clampedHistoryWeight = BurtTaaHdrWeight(clampedPrevious);
    float unclampedHistoryWeight = BurtTaaHdrWeight(previous);
    float clampBlendWeight = lerp(clampedHistoryWeight, unclampedHistoryWeight, disableHistoryClamp);
    previous = lerp(clampedPrevious, previous, saturate(disableHistoryClamp * unclampedHistoryWeight / max(clampBlendWeight, 1e-5)));

    float blendPrevious = previousWeight * BurtTaaHdrWeight(previous);
    float blendCurrent = currentWeight * BurtTaaHdrWeight(current.rgb);
    float finalBlend = blendCurrent * rcp(max(blendPrevious + blendCurrent, 1e-5));
    finalBlend = responsive > 0.5 ? 0.25 : finalBlend;
    finalBlend = previousHistoryValidity > 0.0 ? saturate(finalBlend) : 1.0;
    float3 updated = lerp(previous, current.rgb, finalBlend);
    if (_BurtTAAUHistoryParams.w > 0.5)
    {
        uint random = BurtTaaRand3DPCG16(int3(pixel, (int)_BurtTAAParams.w)).x;
        updated = BurtTaaQuantizePackedHistory(updated, (float)random * (1.0 / 65536.0));
        updated = clamp(updated, 0.0, 64512.0);
    }
    _BurtTAAUUpdatedHistoryOutputTexture[pixel] = BurtTaaSanitizeRawColor(updated, current.rgb);
#if defined(BURT_TAAU_FINAL_BLEND_DEBUG)
    // XRender's TAAU BLEND_FACTOR diagnostic is written by UpdateHistory at
    // history resolution.  It is the actual current-frame coefficient used by
    // the final lerp, not a later approximation reconstructed from other RTs.
    _BurtTAAUFinalBlendDebugOutputTexture[pixel] = float4(finalBlend.xxx, 1.0);
#endif
}

[numthreads(8, 8, 1)]
void UpdateTAAUHistoryAACS(uint3 id : SV_DispatchThreadID)
{
    BurtUpdateTAAUHistory(id);
}

[numthreads(8, 8, 1)]
void UpdateTAAUHistoryDebugAACS(uint3 id : SV_DispatchThreadID)
{
    BurtUpdateTAAUHistory(id);
}

[numthreads(8, 8, 1)]
void ResolveTAAUHistoryAACS(uint3 id : SV_DispatchThreadID)
{
    // XRender dispatches this stage over the final output resource.  Query both
    // resources here so the resolve domain cannot collapse back to the input
    // viewport when render scale is below one.
    uint outputWidth;
    uint outputHeight;
    _BurtTAAUOutputTexture.GetDimensions(outputWidth, outputHeight);
    int2 outputSize = max(int2(outputWidth, outputHeight), int2(1, 1));
    int2 pixel = int2(id.xy);
    if (any(pixel >= outputSize))
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5) * rcp((float2)outputSize);
    uint historyWidth;
    uint historyHeight;
    _BurtTAAUUpdatedHistoryTexture.GetDimensions(historyWidth, historyHeight);
    int2 historySize = max(int2(historyWidth, historyHeight), int2(1, 1));
    float2 historyPixelPosition = uv * (float2)historySize - 0.5;
    int2 topLeft = int2(floor(historyPixelPosition)) - 1;
    float3 accumulated = 0.0;
    float accumulatedWeight = 0.0;
    float3 neighborhoodMin = float3(65504.0, 65504.0, 65504.0);
    float3 neighborhoodMax = 0.0;
    float3 center = _BurtTAAUUpdatedHistoryTexture.Load(int3(clamp(int2(round(historyPixelPosition)), int2(0, 0), historySize - 1), 0));

    [unroll]
    for (int y = 0; y < 4; y++)
    {
        [unroll]
        for (int x = 0; x < 4; x++)
        {
            int2 samplePixel = clamp(topLeft + int2(x, y), int2(0, 0), historySize - 1);
            float3 sampleColor = _BurtTAAUUpdatedHistoryTexture.Load(int3(samplePixel, 0));
            sampleColor = BurtTaaSanitizeRawColor(sampleColor, center);
            float2 pixelDelta = (float2)samplePixel - historyPixelPosition;
            float kernelWeight = BurtTaaMitchellWeight(pixelDelta.x) * BurtTaaMitchellWeight(pixelDelta.y);
            float sampleWeight = kernelWeight * BurtTaaHdrWeight(sampleColor);
            accumulated += sampleColor * sampleWeight;
            accumulatedWeight += sampleWeight;
            neighborhoodMin = min(neighborhoodMin, sampleColor);
            neighborhoodMax = max(neighborhoodMax, sampleColor);
        }
    }

    float3 resolved = abs(accumulatedWeight) > 1e-5 ? accumulated / accumulatedWeight : center;
    resolved = clamp(BurtTaaSanitizeRawColor(resolved, center), neighborhoodMin, neighborhoodMax);
    _BurtTAAUOutputTexture[pixel] = max(resolved, 0.0);
}
