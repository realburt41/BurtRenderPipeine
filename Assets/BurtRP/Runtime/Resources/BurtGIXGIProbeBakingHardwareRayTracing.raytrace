StructuredBuffer<XGIVirtualOffsetProbeData> _XGIVirtualOffsetGen_ProbeData;

float _XGISkyVisibilityGen_OffsetRay;
float _XGISkyVisibilityGen_MaxBounces;
float _XGISkyVisibilityGen_SampleCount;
float _XGISkyVisibilityGen_SampleIndex;
float4 _XGISkyVisibilityGen_Params;
float4 _XGISkyVisibilityGen_Params1;
float4 _XGITimeSliceGen_Params;
