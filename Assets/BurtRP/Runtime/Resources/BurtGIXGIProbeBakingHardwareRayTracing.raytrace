#pragma max_recursion_depth 1

#include "Assets/BurtRP/Runtime/Shaders/ShaderLibrary/Lighting/BurtGIRayTracingShared.hlsl"

RaytracingAccelerationStructure _BurtGIXGIProbeBakingAccelerationStructure;
RWStructuredBuffer<float4> _RW_XGISkyVisibilityGen_Output;
RWStructuredBuffer<float3> _RW_XGISkyVisibilityGen_DirectionOutput;
RWStructuredBuffer<uint> _RW_XGISkyVisibilityGen_DirectionEncodedOutput;
StructuredBuffer<float3> _XGISkyVisibilityGen_ProbePositions;
