void MissShaderB(inout BurtGIRayPayload payload : SV_RayPayload)
{
    payload.Radiance = 0.0;
    payload.HitDistance = BURT_XGI_BAKING_MAX_RAY_DISTANCE;
    payload.Albedo = 0.0;
    payload.Emission = 0.0;
    payload.NormalWS = 0.0;
    payload.Hit = 0.0;
    payload.Padding = 0.0;
}

