#pragma kernel BuildTransmittanceLut
#pragma kernel BuildMultipleScatteringLut
#pragma kernel BuildHorizontalScatteringLut
#pragma kernel BuildSkyViewLut
#pragma kernel BuildFogLut

RWTexture2D<float4> _BurtAtmosphereTransmittanceLut;
RWTexture2D<float4> _BurtAtmosphereMultipleScatteringLut;
RWTexture2D<float4> _BurtAtmosphereHorizontalScatteringLut;
RWTexture2D<float4> _BurtAtmosphereSkyViewLut;
RWTexture3D<float4> _BurtAtmosphereFogLut;
Texture2D<float4> _BurtAtmosphereTransmittanceLutInput;
Texture2D<float4> _BurtAtmosphereMultipleScatteringLutInput;

float _BurtAtmosphereRayleighIntensity;
float _BurtAtmosphereMieIntensity;
float _BurtAtmosphereMieAnisotropy;
float4 _BurtAtmosphereRayleighScatteringCoefficient;
float4 _BurtAtmosphereMieScatteringCoefficient;
float4 _BurtAtmosphereMieAbsorptionCoefficient;
float4 _BurtAtmosphereOzoneParams; // x=intensity, y=layer center km, z=layer half-width km
float4 _BurtAtmosphereOzoneAbsorptionCoefficient;
float4 _BurtAtmospherePlanetParams;
float4 _BurtAtmosphereGroundAlbedo;
float _BurtAtmosphereMultipleScatteringIntensity;
float _BurtAtmosphereTraceSampleCountScale;
float4 _BurtAtmosphereSunDirection;
float4 _BurtAtmosphereFogViewRayBottomLeft;
float4 _BurtAtmosphereFogViewRayBottomRight;
float4 _BurtAtmosphereFogViewRayTopLeft;
float4 _BurtAtmosphereFogViewRayTopRight;
float4 _BurtAtmosphereAerialLutParams; // x=extinction scale, y=coverage km, z=height falloff, w=start depth km
float _BurtAtmosphereCameraAltitudeKm;

static const float PI = 3.14159265359;
static const int OpticalDepthBaseSampleCount = 10;
static const int ScatteringBaseSampleCount = 16;
static const int MultipleScatteringBaseSampleCount = 15;
// XRender uses this 4 -> 32 sample ramp over the first 150 km for its SkyView
// and HorizontalScattering LUTs. Keep the limits local to the LUT generator so
// traceSampleCountScale remains BRP's single quality control.
static const int ViewLutSampleCountMin = 4;
static const int ViewLutSampleCountMax = 32;
static const float ViewLutDistanceToSampleCountMaxKm = 150.0;
static const float AtmosphereSampleNoise = 0.3;
// Matches XRender's PLANET_RADIUS_OFFSET_KM and keeps ray/sphere intersections stable at or below ground.
static const float GroundRadiusOffsetKm = 0.005;

float RayleighPhase(float cosTheta)
{
    return (3.0 / (16.0 * PI)) * (1.0 + cosTheta * cosTheta);
}

float MiePhase(float cosTheta, float g)
{
    float g2 = g * g;
    float denominator = max(0.05, pow(abs(1.0 + g2 - 2.0 * g * cosTheta), 1.5));
    return (1.0 / (4.0 * PI)) * ((1.0 - g2) / denominator);
}

float PlanetBottomRadiusKm()
{
    return max(_BurtAtmospherePlanetParams.x, 1.0);
}

float PlanetTopRadiusKm()
{
    return PlanetBottomRadiusKm() + max(_BurtAtmospherePlanetParams.y, 0.01);
}

float3 RayleighCoefficient()
{
    return max(_BurtAtmosphereRayleighScatteringCoefficient.rgb, 0.0) * max(_BurtAtmosphereRayleighIntensity, 0.0);
}

float MieScale()
{
    // Preserve BRP's existing 0.12 default while aligning its physical baseline to XRender's 0.003996 km^-1.
    return max(_BurtAtmosphereMieIntensity, 0.0) / 0.12;
}

float3 MieScatteringCoefficient()
{
    return max(_BurtAtmosphereMieScatteringCoefficient.rgb, 0.0) * MieScale();
}

float3 MieAbsorptionCoefficient()
{
    return max(_BurtAtmosphereMieAbsorptionCoefficient.rgb, 0.0) * MieScale();
}

float3 OzoneAbsorptionCoefficient()
{
    return max(_BurtAtmosphereOzoneAbsorptionCoefficient.rgb, 0.0) * max(_BurtAtmosphereOzoneParams.x, 0.0);
}

int ResolveSampleCount(int baseCount)
{
    float scale = clamp(_BurtAtmosphereTraceSampleCountScale, 0.25, 8.0);
    return clamp((int)floor(baseCount * scale + 0.5), 4, 128);
}

float ResolveViewLutSampleCount(float distanceKm)
{
    float baseCount = lerp(ViewLutSampleCountMin,
                           ViewLutSampleCountMax,
                           saturate(distanceKm / ViewLutDistanceToSampleCountMaxKm));
    float scale = clamp(_BurtAtmosphereTraceSampleCountScale, 0.25, 8.0);
    return clamp(baseCount * scale, 4.0, 128.0);
}

int ResolveFogLutSampleCount(int sliceIndex)
{
    // XRender grows its atmosphere-fog integration from 2 to 32 samples over
    // its 16 froxel slices: (slice + 1) * 2. Keep TraceSampleCountScale as a
    // quality multiplier without changing the baseline schedule.
    int xrenderBaseCount = (sliceIndex + 1) * 2;
    float scale = clamp(_BurtAtmosphereTraceSampleCountScale, 0.25, 8.0);
    return clamp((int)floor(xrenderBaseCount * scale + 0.5), 2, 128);
}

// Mirrors XRender's CalcVariableSampleCountDeltaT. Quadratic spacing gives the
// dense near-camera integration needed for a stable horizon while avoiding the
// cost of maximum samples on short sky and aerial-perspective rays.
void ResolveVariableSampleSegment(int sampleIndex, float sampleCount, float distanceKm, out float sampleDistanceKm, out float stepKm)
{
    float sampleCountFloor = max(floor(sampleCount), 1.0);
    float rangeFloorKm = distanceKm * sampleCountFloor / max(sampleCount, 1.0);
    float inverseSampleCountFloor = rcp(sampleCountFloor);
    float t0 = sampleIndex * inverseSampleCountFloor;
    float t1 = (sampleIndex + 1) * inverseSampleCountFloor;
    t0 *= t0;
    t1 *= t1;
    t0 *= rangeFloorKm;
    t1 = t1 > 1.0 ? distanceKm : t1 * rangeFloorKm;
    sampleDistanceKm = lerp(t0, t1, AtmosphereSampleNoise);
    stepKm = t1 - t0;
}

void ResolveFixedSampleSegment(int sampleIndex, int sampleCount, float distanceKm, out float sampleDistanceKm, out float stepKm)
{
    stepKm = distanceKm / max(sampleCount, 1);
    sampleDistanceKm = (sampleIndex + AtmosphereSampleNoise) * stepKm;
}

float RaySphereNearest(float3 origin, float3 direction, float radius)
{
    float b = dot(origin, direction);
    float c = dot(origin, origin) - radius * radius;
    float discriminant = b * b - c;
    if (discriminant < 0.0)
    {
        return -1.0;
    }

    float root = sqrt(discriminant);
    float nearDistance = -b - root;
    float farDistance = -b + root;
    return nearDistance > 0.0 ? nearDistance : (farDistance > 0.0 ? farDistance : -1.0);
}

float PlanetShadowVisibility(float3 position, float3 direction)
{
    // XRender shifts the shadow-test sphere center by five metres toward the
    // sample. This prevents false self-shadowing at the ground/tangent limit.
    float3 up = normalize(position);
    return RaySphereNearest(position - up * GroundRadiusOffsetKm, direction, PlanetBottomRadiusKm()) >= 0.0 ? 0.0 : 1.0;
}

// Moves an outside ray to a stable point just inside the top atmosphere.
// This mirrors XRender's MoveToTopAtmosphere convention and lets callers
// distinguish a ray that never enters the atmosphere from a valid space view.
bool MoveToTopAtmosphere(float3 direction, inout float3 origin, out float distanceToEntry)
{
    distanceToEntry = 0.0;
    float topRadius = PlanetTopRadiusKm();
    if (length(origin) <= topRadius)
    {
        return true;
    }

    float3 previousOrigin = origin;
    float viewRadius = length(previousOrigin);
    float entryDistance = RaySphereNearest(previousOrigin, direction, topRadius);
    if (entryDistance < 0.0)
    {
        return false;
    }

    // XRender offsets along the camera's geocentric up vector after advancing
    // to the entry point. Starting exactly on the sphere makes the next boundary
    // intersection numerically ambiguous on some GPUs.
    float3 cameraUp = previousOrigin / max(viewRadius, 1.0e-6);
    origin = previousOrigin + direction * entryDistance - cameraUp * GroundRadiusOffsetKm;
    distanceToEntry = length(origin - previousOrigin);
    return true;
}

float DistanceToAtmosphereBoundary(float3 origin, float3 direction, bool stopAtGround)
{
    float distanceToTop = RaySphereNearest(origin, direction, PlanetTopRadiusKm());
    if (distanceToTop <= 0.0)
    {
        return 0.0;
    }

    if (!stopAtGround)
    {
        return distanceToTop;
    }

    float distanceToGround = RaySphereNearest(origin, direction, PlanetBottomRadiusKm());
    return distanceToGround > 0.0 ? min(distanceToTop, distanceToGround) : distanceToTop;
}

float GetAltitudeKm(float3 position)
{
    return max(length(position) - PlanetBottomRadiusKm(), 0.0);
}

float2 GetDensity(float altitudeKm)
{
    float rayleighScaleHeight = max(_BurtAtmospherePlanetParams.z, 0.01);
    float mieScaleHeight = max(_BurtAtmospherePlanetParams.w, 0.01);
    return float2(exp(-altitudeKm / rayleighScaleHeight), exp(-altitudeKm / mieScaleHeight));
}

float GetOzoneDensity(float altitudeKm)
{
    float center = max(_BurtAtmosphereOzoneParams.y, 0.0);
    float halfWidth = max(_BurtAtmosphereOzoneParams.z, 0.1);
    return saturate(1.0 - abs(altitudeKm - center) / halfWidth);
}

float3 ExtinctionAtPosition(float3 position)
{
    float2 density = GetDensity(GetAltitudeKm(position));
    return RayleighCoefficient() * density.x + (MieScatteringCoefficient() + MieAbsorptionCoefficient()) * density.y + OzoneAbsorptionCoefficient() * GetOzoneDensity(GetAltitudeKm(position));
}

float3 IntegrateOpticalDepth(float3 origin, float3 direction, float distance, int sampleCount)
{
    if (distance <= 0.0)
    {
        return 0.0;
    }

    float stepSize = distance / max(sampleCount, 1);
    float3 opticalDepth = 0.0;
    [loop]
    for (int index = 0; index < sampleCount; index++)
    {
        float3 samplePosition = origin + direction * ((index + AtmosphereSampleNoise) * stepSize);
        opticalDepth += ExtinctionAtPosition(samplePosition) * stepSize;
    }

    return opticalDepth;
}

float3 EvaluateTransmittance(float3 origin, float3 direction, float distance, float extinctionScale)
{
    return exp(-IntegrateOpticalDepth(origin, direction, distance, ResolveSampleCount(OpticalDepthBaseSampleCount)) * max(extinctionScale, 0.0));
}

float3 EvaluateTransmittance(float3 origin, float3 direction, float distance)
{
    return EvaluateTransmittance(origin, direction, distance, 1.0);
}

float4 SampleTransmittanceTextureLinear(float2 uv)
{
    uint width;
    uint height;
    _BurtAtmosphereTransmittanceLutInput.GetDimensions(width, height);
    float2 samplePosition = saturate(uv) * float2(width, height) - 0.5;
    int2 basePosition = int2(floor(samplePosition));
    int2 maximumPosition = int2(width - 1, height - 1);
    int2 p00 = clamp(basePosition, int2(0, 0), maximumPosition);
    int2 p10 = clamp(basePosition + int2(1, 0), int2(0, 0), maximumPosition);
    int2 p01 = clamp(basePosition + int2(0, 1), int2(0, 0), maximumPosition);
    int2 p11 = clamp(basePosition + int2(1, 1), int2(0, 0), maximumPosition);
    float2 fraction = frac(samplePosition);
    return lerp(lerp(_BurtAtmosphereTransmittanceLutInput.Load(int3(p00, 0)), _BurtAtmosphereTransmittanceLutInput.Load(int3(p10, 0)), fraction.x), lerp(_BurtAtmosphereTransmittanceLutInput.Load(int3(p01, 0)), _BurtAtmosphereTransmittanceLutInput.Load(int3(p11, 0)), fraction.x), fraction.y);
}

float4 SampleMultipleScatteringTextureLinear(float2 uv)
{
    uint width;
    uint height;
    _BurtAtmosphereMultipleScatteringLutInput.GetDimensions(width, height);
    float2 samplePosition = saturate(uv) * float2(width, height) - 0.5;
    int2 basePosition = int2(floor(samplePosition));
    int2 maximumPosition = int2(width - 1, height - 1);
    int2 p00 = clamp(basePosition, int2(0, 0), maximumPosition);
    int2 p10 = clamp(basePosition + int2(1, 0), int2(0, 0), maximumPosition);
    int2 p01 = clamp(basePosition + int2(0, 1), int2(0, 0), maximumPosition);
    int2 p11 = clamp(basePosition + int2(1, 1), int2(0, 0), maximumPosition);
    float2 fraction = frac(samplePosition);
    return lerp(lerp(_BurtAtmosphereMultipleScatteringLutInput.Load(int3(p00, 0)), _BurtAtmosphereMultipleScatteringLutInput.Load(int3(p10, 0)), fraction.x), lerp(_BurtAtmosphereMultipleScatteringLutInput.Load(int3(p01, 0)), _BurtAtmosphereMultipleScatteringLutInput.Load(int3(p11, 0)), fraction.x), fraction.y);
}

float2 MapTransmittanceParamsToUv(float viewRadius, float viewZenithCosine)
{
    float bottomRadius = PlanetBottomRadiusKm();
    float topRadius = PlanetTopRadiusKm();
    float h = sqrt(max(topRadius * topRadius - bottomRadius * bottomRadius, 0.0));
    float rho = sqrt(max(viewRadius * viewRadius - bottomRadius * bottomRadius, 0.0));
    float discriminant = viewRadius * viewRadius * (viewZenithCosine * viewZenithCosine - 1.0) + topRadius * topRadius;
    float distance = max(0.0, -viewRadius * viewZenithCosine + sqrt(max(discriminant, 0.0)));
    float distanceMin = topRadius - viewRadius;
    float distanceMax = rho + h;
    return float2(saturate((distance - distanceMin) / max(distanceMax - distanceMin, 0.0001)), saturate(rho / max(h, 0.0001)));
}

float3 SampleTransmittanceLut(float3 position, float3 direction)
{
    float viewRadius = length(position);
    float viewZenithCosine = dot(normalize(position), direction);
    return SampleTransmittanceTextureLinear(MapTransmittanceParamsToUv(viewRadius, viewZenithCosine)).rgb;
}

float3 SampleMultipleScatteringLut(float3 position, float3 sunDirection)
{
    float viewRadius = length(position);
    float sunZenithCosine = dot(normalize(position), sunDirection);
    float altitude01 = saturate((viewRadius - PlanetBottomRadiusKm()) / max(_BurtAtmospherePlanetParams.y, 0.01));
    return SampleMultipleScatteringTextureLinear(float2(saturate(sunZenithCosine * 0.5 + 0.5), altitude01)).rgb;
}

float3 IntegrateOverSegment(float3 inScattering, float3 segmentTransmittance, float3 viewTransmittance, float3 extinction);

float3 EvaluateAtmosphereLuminanceWithSampleCount(float3 origin, float3 direction, float phaseCosine, float distance, float sampleCount, bool variableSampleDistribution, float extinctionScale, out float3 finalTransmittance)
{
    finalTransmittance = 1.0;
    if (distance <= 0.0) return 0.0;

    float3 sunDirection = normalize(_BurtAtmosphereSunDirection.xyz);
    sampleCount = max(sampleCount, 1.0);
    int iterationCount = (int)ceil(sampleCount);
    float3 accumulatedTransmittance = 1.0;
    float3 rayleighScattering = 0.0;
    float3 mieScattering = 0.0;
    float3 multipleScattering = 0.0;
    [loop]
    for (int index = 0; index < iterationCount; index++)
    {
        float sampleDistance;
        float stepSize;
        if (variableSampleDistribution)
        {
            ResolveVariableSampleSegment(index, sampleCount, distance, sampleDistance, stepSize);
        }
        else
        {
            ResolveFixedSampleSegment(index, iterationCount, distance, sampleDistance, stepSize);
        }
        float3 samplePosition = origin + direction * sampleDistance;
        float2 density = GetDensity(GetAltitudeKm(samplePosition));
        float3 localExtinction = RayleighCoefficient() * density.x + (MieScatteringCoefficient() + MieAbsorptionCoefficient()) * density.y + OzoneAbsorptionCoefficient() * GetOzoneDensity(GetAltitudeKm(samplePosition));
        // XRender scales segment optical depth but keeps the physical extinction
        // coefficient in the analytic integration denominator.
        float3 segmentTransmittance = exp(-localExtinction * stepSize * max(extinctionScale, 0.0));
        float planetShadow = PlanetShadowVisibility(samplePosition, sunDirection);
        float3 sunTransmittance = planetShadow * SampleTransmittanceLut(samplePosition, sunDirection);
        float3 rayleighTerm = sunTransmittance * RayleighCoefficient() * density.x * RayleighPhase(phaseCosine);
        float3 mieTerm = sunTransmittance * MieScatteringCoefficient() * density.y * MiePhase(phaseCosine, _BurtAtmosphereMieAnisotropy);
        float3 multiTerm = SampleMultipleScatteringLut(samplePosition, sunDirection) * (RayleighCoefficient() * density.x + MieScatteringCoefficient() * density.y);
        rayleighScattering += IntegrateOverSegment(rayleighTerm, segmentTransmittance, accumulatedTransmittance, localExtinction);
        mieScattering += IntegrateOverSegment(mieTerm, segmentTransmittance, accumulatedTransmittance, localExtinction);
        multipleScattering += IntegrateOverSegment(multiTerm, segmentTransmittance, accumulatedTransmittance, localExtinction);
        accumulatedTransmittance *= segmentTransmittance;
    }

    // Match XRender's normalized SkyView/Fog LUT contract. Main-light color,
    // intensity and environment occlusion are applied once by each consumer.
    finalTransmittance = accumulatedTransmittance;
    return rayleighScattering + mieScattering + multipleScattering;
}

float3 EvaluateAtmosphereLuminanceWithSampleCount(float3 origin, float3 direction, float phaseCosine, float distance, float sampleCount, bool variableSampleDistribution)
{
    float3 unusedTransmittance;
    return EvaluateAtmosphereLuminanceWithSampleCount(origin, direction, phaseCosine, distance, sampleCount, variableSampleDistribution, 1.0, unusedTransmittance);
}

float3 EvaluateAtmosphereLuminance(float3 origin, float3 direction, float phaseCosine, float distance)
{
    return EvaluateAtmosphereLuminanceWithSampleCount(origin, direction, phaseCosine, distance, ResolveViewLutSampleCount(distance), true);
}

// Mirrors XRender's HorizontalScatteringLut: three phase-independent, already-integrated terms.
void EvaluateHorizontalScattering(float3 origin, float3 direction, out float3 rayleighScattering, out float3 mieScattering, out float3 multipleScattering)
{
    rayleighScattering = 0.0;
    mieScattering = 0.0;
    multipleScattering = 0.0;
    float distance = DistanceToAtmosphereBoundary(origin, direction, true);
    if (distance <= 0.0)
    {
        return;
    }

    float3 sunDirection = normalize(_BurtAtmosphereSunDirection.xyz);
    float sampleCount = ResolveViewLutSampleCount(distance);
    int iterationCount = (int)ceil(sampleCount);
    float3 accumulatedTransmittance = 1.0;
    [loop]
    for (int index = 0; index < iterationCount; index++)
    {
        float sampleDistance;
        float stepSize;
        ResolveVariableSampleSegment(index, sampleCount, distance, sampleDistance, stepSize);
        float3 samplePosition = origin + direction * sampleDistance;
        float2 density = GetDensity(GetAltitudeKm(samplePosition));
        float3 extinction = RayleighCoefficient() * density.x + (MieScatteringCoefficient() + MieAbsorptionCoefficient()) * density.y + OzoneAbsorptionCoefficient() * GetOzoneDensity(GetAltitudeKm(samplePosition));
        float3 segmentTransmittance = exp(-extinction * stepSize);
        float planetShadow = PlanetShadowVisibility(samplePosition, sunDirection);
        float3 sunTransmittance = planetShadow * SampleTransmittanceLut(samplePosition, sunDirection);
        float3 rayleighTerm = sunTransmittance * RayleighCoefficient() * density.x;
        float3 mieTerm = sunTransmittance * MieScatteringCoefficient() * density.y;
        float3 multiTerm = SampleMultipleScatteringLut(samplePosition, sunDirection) * (RayleighCoefficient() * density.x + MieScatteringCoefficient() * density.y);
        rayleighScattering += IntegrateOverSegment(rayleighTerm, segmentTransmittance, accumulatedTransmittance, extinction);
        mieScattering += IntegrateOverSegment(mieTerm, segmentTransmittance, accumulatedTransmittance, extinction);
        multipleScattering += IntegrateOverSegment(multiTerm, segmentTransmittance, accumulatedTransmittance, extinction);
        accumulatedTransmittance *= segmentTransmittance;
    }

    // Match XRender's horizontal LUT contract: store phase-independent medium
    // response only. The consuming fog shader applies phase, artistic tint and
    // outer-space light illuminance. In particular, do not bake light color here;
    // the LUT already contains sun-path transmittance and would otherwise apply
    // the main-light illuminance twice.
}

float3 IntegrateOverSegment(float3 inScattering, float3 segmentTransmittance, float3 viewTransmittance, float3 extinction)
{
    // Analytic integration for a homogeneous interval, matching XRender's volumetric integration form.
    float3 safeExtinction = max(extinction, 1.0e-6);
    return inScattering * viewTransmittance * (1.0 - segmentTransmittance) / safeExtinction;
}

void EvaluateMultipleScatteringDirection(float3 origin, float3 direction, float3 sunDirection, out float3 scatteringLuminance, out float3 multiScatterAsOne)
{
    scatteringLuminance = 0.0;
    multiScatterAsOne = 0.0;
    float distance = DistanceToAtmosphereBoundary(origin, direction, true);
    if (distance <= 0.0)
    {
        return;
    }

    int sampleCount = ResolveSampleCount(MultipleScatteringBaseSampleCount);
    float stepSize = distance / sampleCount;
    float3 accumulatedTransmittance = 1.0;
    [loop]
    for (int index = 0; index < sampleCount; index++)
    {
        float3 samplePosition = origin + direction * ((index + AtmosphereSampleNoise) * stepSize);
        float2 density = GetDensity(GetAltitudeKm(samplePosition));
        float3 scatteringCoefficient = RayleighCoefficient() * density.x + MieScatteringCoefficient() * density.y;
        float3 extinctionCoefficient = scatteringCoefficient + MieAbsorptionCoefficient() * density.y + OzoneAbsorptionCoefficient() * GetOzoneDensity(GetAltitudeKm(samplePosition));
        float3 segmentTransmittance = exp(-extinctionCoefficient * stepSize);
        float3 up = normalize(samplePosition);
        float planetShadow = PlanetShadowVisibility(samplePosition, sunDirection);
        float3 sunTransmittance = planetShadow * SampleTransmittanceLut(samplePosition, sunDirection);
        float3 inScattering = sunTransmittance * (1.0 / (4.0 * PI)) * scatteringCoefficient;
        multiScatterAsOne += accumulatedTransmittance * scatteringCoefficient * stepSize;
        scatteringLuminance += IntegrateOverSegment(inScattering, segmentTransmittance, accumulatedTransmittance, extinctionCoefficient);
        accumulatedTransmittance *= segmentTransmittance;
    }

    // A Lambertian ground closes the downward hemisphere, as in XRender's EvaluateMultipleScattering.
    if (RaySphereNearest(origin, direction, PlanetBottomRadiusKm()) >= 0.0)
    {
        float3 groundPosition = origin + direction * distance;
        float3 groundUp = normalize(groundPosition);
        float groundNdotL = saturate(dot(groundUp, sunDirection));
        float3 sunTransmittance = SampleTransmittanceLut(groundPosition, sunDirection);
        scatteringLuminance += sunTransmittance * accumulatedTransmittance * groundNdotL * max(_BurtAtmosphereGroundAlbedo.rgb, 0.0) * (1.0 / PI);
    }
}

float3 CreateDirectionFromViewUp(float viewUp)
{
    return float3(sqrt(saturate(1.0 - viewUp * viewUp)), viewUp, 0.0);
}

// XRender's atmosphere fog LUT is a camera-frustum volume: XY correspond to
// screen position and Z to quadratic view distance. Perspective view rays are
// linear before normalization, so bilinear corner interpolation reproduces the
// full camera projection without storing a matrix in the compute constant data.
float3 CreateFogLutViewDirection(float2 screenUv)
{
    screenUv.y = 1.0 - screenUv.y;
    float3 bottom = lerp(_BurtAtmosphereFogViewRayBottomLeft.xyz, _BurtAtmosphereFogViewRayBottomRight.xyz, screenUv.x);
    float3 top = lerp(_BurtAtmosphereFogViewRayTopLeft.xyz, _BurtAtmosphereFogViewRayTopRight.xyz, screenUv.x);
    return normalize(lerp(bottom, top, screenUv.y));
}

float2 FromSubUvsToUnit(float2 uv, float2 size)
{
    float2 safeSize = max(size, 2.0);
    float2 inverseSize = rcp(safeSize);
    return (uv - 0.5 * inverseSize) * (safeSize / (safeSize - 1.0));
}

void MapTransmittanceUvToParams(float2 uv, out float viewRadius, out float viewZenithCosine)
{
    float bottomRadius = PlanetBottomRadiusKm();
    float topRadius = PlanetTopRadiusKm();
    float h = sqrt(max(topRadius * topRadius - bottomRadius * bottomRadius, 0.0));
    float rho = h * uv.y;
    viewRadius = sqrt(rho * rho + bottomRadius * bottomRadius);
    float distanceMin = topRadius - viewRadius;
    float distanceMax = rho + h;
    float distance = lerp(distanceMin, distanceMax, uv.x);
    viewZenithCosine = distance <= 0.0 ? 1.0 : (h * h - rho * rho - distance * distance) / (2.0 * viewRadius * distance);
    viewZenithCosine = clamp(viewZenithCosine, -1.0, 1.0);
}

float3 MapSkyViewUvToDirection(float2 uv, float viewRadius)
{
    float bottomRadius = PlanetBottomRadiusKm();
    float horizonDistance = sqrt(max(viewRadius * viewRadius - bottomRadius * bottomRadius, 0.0));
    float cosBeta = saturate(horizonDistance / max(viewRadius, 0.001));
    float beta = acos(cosBeta);
    float zenithHorizonAngle = PI - beta;
    float viewZenithAngle;
    if (uv.y < 0.5)
    {
        float coord = 1.0 - 2.0 * uv.y;
        coord = 1.0 - coord * coord;
        viewZenithAngle = zenithHorizonAngle * coord;
    }
    else
    {
        float coord = 2.0 * uv.y - 1.0;
        viewZenithAngle = zenithHorizonAngle + beta * coord * coord;
    }

    float longitude = uv.x * 2.0 * PI;
    float cosZenith = cos(viewZenithAngle);
    float sinZenith = sqrt(saturate(1.0 - cosZenith * cosZenith));
    return float3(sinZenith * sin(longitude), cosZenith, sinZenith * cos(longitude));
}

float3 CameraOriginKm()
{
    // Preserve altitude above the top boundary; SkyView and Fog move individual
    // rays to the atmosphere entry point only when those rays actually hit it.
    float altitude = max(_BurtAtmosphereCameraAltitudeKm, GroundRadiusOffsetKm);
    return float3(0.0, PlanetBottomRadiusKm() + altitude, 0.0);
}

[numthreads(8, 8, 1)]
void BuildTransmittanceLut(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    _BurtAtmosphereTransmittanceLut.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;

    float2 uv = (float2(id.xy) + 0.5) / float2(width, height);
    float viewRadius;
    float viewUp;
    MapTransmittanceUvToParams(uv, viewRadius, viewUp);
    float3 origin = float3(0.0, viewRadius, 0.0);
    float3 direction = CreateDirectionFromViewUp(viewUp);
    float distance = DistanceToAtmosphereBoundary(origin, direction, true);
    _BurtAtmosphereTransmittanceLut[id.xy] = float4(EvaluateTransmittance(origin, direction, distance), 1.0);
}

[numthreads(8, 8, 1)]
void BuildMultipleScatteringLut(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    _BurtAtmosphereMultipleScatteringLut.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;

    float2 uv = (float2(id.xy) + 0.5) / float2(width, height);
    float sunUp = uv.x * 2.0 - 1.0;
    float altitudeKm = uv.y * max(_BurtAtmospherePlanetParams.y, 0.01);
    float3 origin = float3(0.0, PlanetBottomRadiusKm() + altitudeKm, 0.0);
    float3 sunDirection = CreateDirectionFromViewUp(sunUp);
    float3 upwardScattering;
    float3 upwardMultiScatterAsOne;
    float3 downwardScattering;
    float3 downwardMultiScatterAsOne;
    EvaluateMultipleScatteringDirection(origin, float3(0.0, 1.0, 0.0), sunDirection, upwardScattering, upwardMultiScatterAsOne);
    EvaluateMultipleScatteringDirection(origin, float3(0.0, -1.0, 0.0), sunDirection, downwardScattering, downwardMultiScatterAsOne);
    float3 inScatteredLuminance = 0.5 * (upwardScattering + downwardScattering);
    float3 eventRatio = 0.5 * (upwardMultiScatterAsOne + downwardMultiScatterAsOne);
    // XRender evaluates the complete geometric series directly. Physical
    // atmosphere coefficients keep the event ratio below one.
    float3 multiScatter = inScatteredLuminance / (1.0 - eventRatio);
    multiScatter *= max(_BurtAtmosphereMultipleScatteringIntensity, 0.0);
    _BurtAtmosphereMultipleScatteringLut[id.xy] = float4(multiScatter, 1.0);
}

[numthreads(1, 1, 1)]
void BuildHorizontalScatteringLut(uint3 id : SV_DispatchThreadID)
{
    if (id.x != 0 || id.y != 0 || id.z != 0) return;

    // XRender evaluates this stabilization LUT slightly above the physical
    // horizon. This avoids the degenerate tangent ray at ground level.
    float maximumAltitude = max(_BurtAtmospherePlanetParams.y - 0.001, GroundRadiusOffsetKm);
    float horizontalAltitude = min(max(_BurtAtmosphereCameraAltitudeKm, 16.0), maximumAltitude);
    float3 horizontalOrigin = float3(0.0, PlanetBottomRadiusKm() + horizontalAltitude, 0.0);
    float3 horizontalDirection = MapSkyViewUvToDirection(float2(0.5, 0.48), length(horizontalOrigin));
    float3 rayleighScattering;
    float3 mieScattering;
    float3 multipleScattering;
    EvaluateHorizontalScattering(horizontalOrigin, horizontalDirection, rayleighScattering, mieScattering, multipleScattering);
    _BurtAtmosphereHorizontalScatteringLut[int2(0, 0)] = float4(rayleighScattering, 1.0);
    _BurtAtmosphereHorizontalScatteringLut[int2(1, 0)] = float4(mieScattering, 1.0);
    _BurtAtmosphereHorizontalScatteringLut[int2(2, 0)] = float4(multipleScattering, 1.0);
}

[numthreads(8, 8, 1)]
void BuildSkyViewLut(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    _BurtAtmosphereSkyViewLut.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;

    float2 uv = (float2(id.xy) + 0.5) / float2(width, height);
    // XRender stores the full unit parameter domain at the centers of the first
    // and last SkyView texels. Undo the storage sub-UV before evaluating a ray.
    float2 unitUv = FromSubUvsToUnit(uv, float2(width, height));
    float3 origin = CameraOriginKm();
    float3 direction = MapSkyViewUvToDirection(unitUv, length(origin));
    float distanceToEntry;
    if (!MoveToTopAtmosphere(direction, origin, distanceToEntry))
    {
        _BurtAtmosphereSkyViewLut[id.xy] = float4(0.0, 0.0, 0.0, 1.0);
        return;
    }

    float phaseCosine = dot(direction, normalize(_BurtAtmosphereSunDirection.xyz));
    float distance = DistanceToAtmosphereBoundary(origin, direction, true);
    float3 scattering = EvaluateAtmosphereLuminance(origin, direction, phaseCosine, distance);
    _BurtAtmosphereSkyViewLut[id.xy] = float4(scattering, 1.0);
}

[numthreads(4, 4, 4)]
void BuildFogLut(uint3 id : SV_DispatchThreadID)
{
    uint width, height, depth;
    _BurtAtmosphereFogLut.GetDimensions(width, height, depth);
    if (id.x >= width || id.y >= height || id.z >= depth) return;

    float3 uvw = (float3(id.xyz) + 0.5) / float3(width, height, depth);
    // XRender uses a fixed 96 km physical fog-LUT coverage.
    float coverageKm = 96.0;
    float startDepthKm = max(_BurtAtmosphereAerialLutParams.w, 0.0);
    float extinctionScale = max(_BurtAtmosphereAerialLutParams.x, 0.0);
    // Like XRender, the 3D LUT stores the segment after the fog start depth.
    // The z coordinate has a quadratic distribution so nearby geometry has more slices.
    float rayDistance = uvw.z * uvw.z * coverageKm;
    float3 origin = CameraOriginKm();
    float3 direction = CreateFogLutViewDirection(uvw.xy);
    float bottomRadius = PlanetBottomRadiusKm();
    float3 fogOrigin = origin + direction * startDepthKm;
    float3 fogVoxelPosition = fogOrigin + direction * rayDistance;
    float distanceToGround = RaySphereNearest(origin, direction, PlanetBottomRadiusKm());
    bool underGround = length(fogVoxelPosition) < bottomRadius;
    // Compare distances in kilometres. XRender's source spells this test with
    // CurrSlice (a dimensionless slice index), but the intended endpoint test
    // and all surrounding sphere intersections are in kilometres.
    bool belowHorizon = distanceToGround > 0.0 && startDepthKm + rayDistance > distanceToGround;
    if (underGround || belowHorizon)
    {
        // XRender's ground/horizon reprojection prevents unstable atmosphere
        // values for froxel endpoints that are under or behind the planet.
        origin *= 1.0 + 0.02 / max(length(origin), 1.0);
        float3 viewGroundPosition = normalize(origin) * bottomRadius;
        float3 normalizedVoxelPosition = normalize(fogVoxelPosition);
        float3 voxelGroundPosition = normalizedVoxelPosition * bottomRadius;
        float3 voxelGroundToViewDirection = normalize(origin - voxelGroundPosition);
        if (belowHorizon && dot(voxelGroundToViewDirection, normalizedVoxelPosition) < 0.0001)
        {
            float3 middleGroundPosition = normalize(0.5 * (viewGroundPosition + voxelGroundPosition)) * bottomRadius;
            fogVoxelPosition = origin + 2.0 * (middleGroundPosition - origin);
        }
        else if (underGround)
        {
            fogVoxelPosition = voxelGroundPosition;
        }

        direction = normalize(fogVoxelPosition - origin);
        fogOrigin = origin + direction * startDepthKm;
        rayDistance = max(length(fogVoxelPosition - fogOrigin), 0.0);
    }

    // A fog froxel can begin in space. It contributes only after the ray reaches
    // the top atmosphere; slices that end before that point remain transparent.
    float3 fogOriginBeforeEntry = fogOrigin;
    float distanceToAtmosphereEntry;
    if (!MoveToTopAtmosphere(direction, fogOrigin, distanceToAtmosphereEntry)
        || rayDistance < distanceToAtmosphereEntry)
    {
        _BurtAtmosphereFogLut[id.xyz] = float4(0.0, 0.0, 0.0, 1.0);
        return;
    }

    if (distanceToAtmosphereEntry > 0.0)
    {
        rayDistance = max(rayDistance - length(fogOrigin - fogOriginBeforeEntry), 0.0);
    }

    float atmosphereDistance = DistanceToAtmosphereBoundary(fogOrigin, direction, true);
    rayDistance = min(rayDistance, atmosphereDistance);
    float3 sunDirection = normalize(_BurtAtmosphereSunDirection.xyz);
    float phaseCosine = dot(direction, sunDirection);
    float3 transmittance;
    // XRender writes RGB scattering and scalar transmittance from the same Fog
    // integration. Sharing the exact 2..32 sample schedule avoids a separate
    // ten-sample alpha estimate drifting from the stored luminance.
    float3 scattering = EvaluateAtmosphereLuminanceWithSampleCount(fogOrigin, direction, phaseCosine, rayDistance, ResolveFogLutSampleCount((int)id.z), false, extinctionScale, transmittance);
    _BurtAtmosphereFogLut[id.xyz] = float4(scattering, dot(transmittance, 1.0 / 3.0));
}
