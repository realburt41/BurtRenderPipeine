float3 BurtGISceneVoxelWorldToUVW(float3 worldPosition)
{
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float extent = max(centerExtent.w, 0.001);
    return (worldPosition - centerExtent.xyz) / (extent * 2.0) + 0.5;
}

void BurtGISceneVoxelWriteDispatchIndirectArgs(RWBuffer<uint> argsBuffer, uint offset, uint groupX, uint groupY, uint groupZ)
{
    argsBuffer[offset + 0u] = groupX;
    argsBuffer[offset + 1u] = groupY;
    argsBuffer[offset + 2u] = groupZ;
}

uint3 BurtGIVoxelNodeIndexWithClipmap(uint3 nodeIndex, uint textureSize, uint clipmapIndex)
{
    return nodeIndex + uint3(0u, 0u, clipmapIndex * textureSize);
}

uint BurtGIVoxelNodeIndex2Flat(uint3 nodeIndexWithClipmap, uint textureSize, uint clipmapCount)
{
    uint safeTextureSize = max(textureSize, 1u);
    uint safeClipmapCount = max(clipmapCount, 1u);
    uint3 volumeSizeWithClipmap = uint3(safeTextureSize, safeTextureSize, safeTextureSize * safeClipmapCount);
    return nodeIndexWithClipmap.x +
        nodeIndexWithClipmap.z * volumeSizeWithClipmap.x +
        nodeIndexWithClipmap.y * volumeSizeWithClipmap.x * volumeSizeWithClipmap.z;
}

bool BurtGIVoxelMaterialIndexIsValid(uint index, uint maxIndex)
{
    return index != XGI_VOXEL_MATERIAL_INDEX_INVALID_ID &&
        index != XGI_VOXEL_MATERIAL_INDEX_WAITING &&
        index <= maxIndex;
}

uint BurtGIVoxelProbeNodeSize(uint volumeSize)
{
    return max(volumeSize >> 2u, 1u);
}

uint3 BurtGIVoxelProbeFlat2NodeIndex(uint flatIndex, uint textureSize, uint clipmapCount)
{
    uint safeTextureSize = max(textureSize, 1u);
    uint safeClipmapCount = max(clipmapCount, 1u);
    uint3 volumeSizeWithClipmap = uint3(safeTextureSize, safeTextureSize, safeTextureSize * safeClipmapCount);
    uint yz = flatIndex / volumeSizeWithClipmap.x;
    return uint3(flatIndex % volumeSizeWithClipmap.x, yz / volumeSizeWithClipmap.z, yz % volumeSizeWithClipmap.z);
}

bool BurtGIVoxelProbeClipmapValid(uint validMask, uint clipmapIndex)
{
    return ((validMask >> clipmapIndex) & 1u) != 0u;
}

uint BurtGIVoxelProbeClipmapFromArgs(uint threadIndex)
{
    uint clipmapIndex = 0u;
    if (BurtGIVoxelProbeClipmapValid((uint)max(VoxelProbeClipmapValidMask, 0), 4u) && VoxelProbeArgsBufferParams[4] <= threadIndex)
    {
        clipmapIndex = 4u;
    }
    if (clipmapIndex + 2u < BURT_GI_XGI_PROBE_ALLOCATOR_OFFSET && VoxelProbeArgsBufferParams[clipmapIndex + 2u] <= threadIndex)
    {
        clipmapIndex += 2u;
    }
    if (clipmapIndex + 1u < BURT_GI_XGI_PROBE_ALLOCATOR_OFFSET && VoxelProbeArgsBufferParams[clipmapIndex + 1u] <= threadIndex)
    {
        clipmapIndex += 1u;
    }
    return clipmapIndex;
}

float4 BurtGIProbeClipmapCenterExtent(uint clipmapIndex)
{
    return clipmapIndex < 6u ? _BurtGISceneVoxelClipmapCenterExtent[clipmapIndex] : _BurtGISceneVoxelCenterExtent;
}

bool BurtGIProbeSampleOccupied(uint3 probeNodeIndex, uint probeNodeSize, uint clipmapIndex, out float4 occupancyValue)
{
    occupancyValue = 0.0;
    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelOccupancyMipReadTexture.GetDimensions(width, height, depth);
    uint3 occupancySize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    uint3 occupancyCoord = min((probeNodeIndex * occupancySize) / max(probeNodeSize, 1u), occupancySize - 1u);

    if (clipmapIndex == 1u)
    {
        _BurtGISceneVoxelClipmap1OccupancyMipReadTexture.GetDimensions(width, height, depth);
        occupancySize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
        occupancyCoord = min((probeNodeIndex * occupancySize) / max(probeNodeSize, 1u), occupancySize - 1u);
        occupancyValue = _BurtGISceneVoxelClipmap1OccupancyMipReadTexture.Load(int4((int3)occupancyCoord, 0));
    }
    else if (clipmapIndex == 2u)
    {
        _BurtGISceneVoxelClipmap2OccupancyMipReadTexture.GetDimensions(width, height, depth);
        occupancySize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
        occupancyCoord = min((probeNodeIndex * occupancySize) / max(probeNodeSize, 1u), occupancySize - 1u);
        occupancyValue = _BurtGISceneVoxelClipmap2OccupancyMipReadTexture.Load(int4((int3)occupancyCoord, 0));
    }
    else if (clipmapIndex == 3u)
    {
        _BurtGISceneVoxelClipmap3OccupancyMipReadTexture.GetDimensions(width, height, depth);
        occupancySize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
        occupancyCoord = min((probeNodeIndex * occupancySize) / max(probeNodeSize, 1u), occupancySize - 1u);
        occupancyValue = _BurtGISceneVoxelClipmap3OccupancyMipReadTexture.Load(int4((int3)occupancyCoord, 0));
    }
    else
    {
        occupancyValue = _BurtGISceneVoxelOccupancyMipReadTexture.Load(int4((int3)occupancyCoord, 0));
    }

    return max(occupancyValue.x, occupancyValue.y) > 0.001;
}

uint3 BurtGIVoxelFlat2LocalChildIndex(uint flatIndex)
{
    uint yz = flatIndex >> 2u;
    return uint3(flatIndex & 3u, yz >> 2u, yz & 3u);
}

bool BurtGIProbeChildOccupied(uint3 probeNodeIndex, uint3 childIndex, uint clipmapIndex)
{
    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    float4 geometry = 0.0;

    if (clipmapIndex == 1u)
    {
        _BurtGISceneVoxelClipmap1GeometryReadTexture.GetDimensions(width, height, depth);
        uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
        uint3 coord = min(probeNodeIndex * 4u + childIndex, volumeSize - 1u);
        geometry = _BurtGISceneVoxelClipmap1GeometryReadTexture.Load(int4((int3)coord, 0));
    }
    else if (clipmapIndex == 2u)
    {
        _BurtGISceneVoxelClipmap2GeometryReadTexture.GetDimensions(width, height, depth);
        uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
        uint3 coord = min(probeNodeIndex * 4u + childIndex, volumeSize - 1u);
        geometry = _BurtGISceneVoxelClipmap2GeometryReadTexture.Load(int4((int3)coord, 0));
    }
    else if (clipmapIndex == 3u)
    {
        _BurtGISceneVoxelClipmap3GeometryReadTexture.GetDimensions(width, height, depth);
        uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
        uint3 coord = min(probeNodeIndex * 4u + childIndex, volumeSize - 1u);
        geometry = _BurtGISceneVoxelClipmap3GeometryReadTexture.Load(int4((int3)coord, 0));
    }
    else
    {
        _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
        uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
        uint3 coord = min(probeNodeIndex * 4u + childIndex, volumeSize - 1u);
        geometry = _BurtGISceneVoxelGeometryReadTexture.Load(int4((int3)coord, 0));
    }

    return saturate(geometry.a) > 0.001;
}

[numthreads(BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE)]
void GenArgsData(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint voxelTextureSize = max((uint)GenArgsDataVoxelTextureSize, 1u);
    if (any(dispatchThreadId >= voxelTextureSize))
    {
        return;
    }

    uint clipmapIndex = min((uint)max(GenArgsDataClipmapIndex, 0), max((uint)GenArgsDataClipmapCount, 1u) - 1u);
    uint indexOffsetClipmap = max((uint)GenArgsDataIndexOffsetClipmap, 1u);
    uint3 nodeIndexWithClipmap = BurtGIVoxelNodeIndexWithClipmap(dispatchThreadId, voxelTextureSize, clipmapIndex);
    uint allocatedPhysicalIndex = GenArgsDataPageTable[nodeIndexWithClipmap];
    if (!BurtGIVoxelMaterialIndexIsValid(allocatedPhysicalIndex, indexOffsetClipmap))
    {
        return;
    }

    uint materialNodeIndex;
    InterlockedAdd(RWGenArgsDataArgsData[clipmapIndex], 1u, materialNodeIndex);

    uint nodeIndexFlat = BurtGIVoxelNodeIndex2Flat(dispatchThreadId, voxelTextureSize, 1u);
    uint argsDataIndex = allocatedPhysicalIndex - XGI_VOXEL_MATERIAL_PENDING_LIST_ALLOCATOR_OFFSET + XGI_VOXEL_LIGHTING_ARGS_DATA_ALLOCATOR_OFFSET;
    argsDataIndex += clipmapIndex * indexOffsetClipmap;
    RWGenArgsDataArgsData[argsDataIndex] = nodeIndexFlat;
}

[numthreads(1, 1, 1)]
void SceneRepresentLightingVoxelGenArgsCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint clipMapResolution = max(_XGISceneRepresentUpdateVoxel_ClipMapResolution, 1u);
    uint clipMapCount = max(_XGISceneRepresentUpdateVoxel_ClipMapNum, 1u);
    uint voxelDirectionCount = max(_XGISceneRepresentUpdateVoxel_VoxelDirectionsNum, 1u);
    uint maxCount = clipMapResolution * clipMapResolution * clipMapResolution * clipMapCount * voxelDirectionCount;
    uint threadCount = min(RWVoxelBufferCount[0], maxCount);
    uint groupCountX = (threadCount + BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE_1D - 1u) / BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE_1D;
    BurtGISceneVoxelWriteDispatchIndirectArgs(_RW_SceneRepresentLightingVoxelIndirectArgs, 0u, groupCountX, 1u, 1u);
    _RW_SceneRepresentLightingVoxelThreadCountX[0] = 0u;
}

[numthreads(1, 1, 1)]
void GenArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    SceneRepresentLightingVoxelGenArgsCS(dispatchThreadId);
}

[numthreads(BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE)]
void ProbePlacement(
    uint groupIndex : SV_GroupIndex,
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint probeNodeSize = BurtGIVoxelProbeNodeSize((uint)max(VoxelApplyVolumeSize, 1));
    uint clipmapIndex = min((uint)max(ProbePlaceClipmapIndex, 0), max((uint)max(ProbePlaceClipmapCount, 1), 1u) - 1u);
    uint3 probeNodeIndex = dispatchThreadId;
    if (any(probeNodeIndex >= probeNodeSize))
    {
        return;
    }

    int3 offsets[7];
    offsets[0] = int3(0, 0, 0);
    offsets[1] = int3(-1, 0, 0);
    offsets[2] = int3(1, 0, 0);
    offsets[3] = int3(0, 0, 1);
    offsets[4] = int3(0, 0, -1);
    offsets[5] = int3(0, 1, 0);
    offsets[6] = int3(0, -1, 0);

    bool probeValid = false;
    bool probeNodeSelfValid = false;
    int3 probeTriggerOffset = int3(0, 0, 0);
    [unroll]
    for (int offsetIndex = 0; offsetIndex < 7; ++offsetIndex)
    {
        int3 neighborProbeNodeIndex = (int3)probeNodeIndex + offsets[offsetIndex];
        if (any(neighborProbeNodeIndex < 0) || any(neighborProbeNodeIndex >= (int3)probeNodeSize))
        {
            continue;
        }

        float4 occupancyValue = 0.0;
        bool nodeValid = BurtGIProbeSampleOccupied((uint3)neighborProbeNodeIndex, probeNodeSize, clipmapIndex, occupancyValue);
        if (offsetIndex == 0)
        {
            probeNodeSelfValid = nodeValid;
        }
        if (nodeValid)
        {
            probeValid = true;
            probeTriggerOffset = offsets[offsetIndex];
            break;
        }
    }

    uint3 probeNodeIndexWithClipmap = BurtGIVoxelNodeIndexWithClipmap(probeNodeIndex, probeNodeSize, clipmapIndex);
    if (!probeValid)
    {
        ProbePlaceProbePageTable[probeNodeIndexWithClipmap] = uint4(0u, 0u, 0u, BURT_GI_XGI_PROBE_PAGE_INVALID);
        return;
    }

    uint3 probeOffset = uint3(0u, 0u, 0u);
    bool probeOffsetValid = false;
    if (probeNodeSelfValid)
    {
        float minDistanceSqr = 65504.0;
        [unroll]
        for (uint childID = 0u; childID < 64u; ++childID)
        {
            uint3 childIndex = BurtGIVoxelFlat2LocalChildIndex(childID);
            if (BurtGIProbeChildOccupied(probeNodeIndex, childIndex, clipmapIndex))
            {
                continue;
            }

            float3 childDelta = (float3)childIndex - 1.5;
            float distanceSqr = dot(childDelta, childDelta);
            if (distanceSqr < minDistanceSqr)
            {
                minDistanceSqr = distanceSqr;
                probeOffset = childIndex;
                probeOffsetValid = true;
            }
        }
    }
    else
    {
        probeOffset = uint3(1u, 1u, 1u);
        if (probeTriggerOffset.x < 0) probeOffset.x = 0u;
        else if (probeTriggerOffset.x > 0) probeOffset.x = 3u;
        if (probeTriggerOffset.y < 0) probeOffset.y = 0u;
        else if (probeTriggerOffset.y > 0) probeOffset.y = 3u;
        if (probeTriggerOffset.z < 0) probeOffset.z = 0u;
        else if (probeTriggerOffset.z > 0) probeOffset.z = 3u;
        probeOffsetValid = true;
    }

    ProbePlaceProbePageTable[probeNodeIndexWithClipmap] = probeOffsetValid
        ? uint4(probeOffset, BURT_GI_XGI_PROBE_PAGE_CANDIDATE)
        : uint4(0u, 0u, 0u, BURT_GI_XGI_PROBE_PAGE_INVALID);
}

[numthreads(BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE)]
void ProbeMark(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint voxelTextureSize = max((uint)max(VoxelApplyTextureSize, 1), 1u);
    uint clipmapIndex = min((uint)max(ProbePlaceClipmapIndex, 0), max((uint)max(VoxelApplyClipmapCount, 1), 1u) - 1u);
    uint3 nodeIndex = dispatchThreadId;
    if (any(nodeIndex >= voxelTextureSize))
    {
        return;
    }

    float4 occupancyValue = 0.0;
    if (!BurtGIProbeSampleOccupied(nodeIndex, voxelTextureSize, clipmapIndex, occupancyValue))
    {
        return;
    }

    uint probeNodeSize = BurtGIVoxelProbeNodeSize((uint)max(VoxelApplyVolumeSize, 1));
    float3 position01 = ((float3)nodeIndex + 0.5) / (float)voxelTextureSize;
    int3 cornerProbeIndex3D = (int3)floor(position01 * (float)probeNodeSize - 0.5);

    [unroll]
    for (uint neighborIndex = 0u; neighborIndex < 8u; ++neighborIndex)
    {
        int3 probeOffset = int3((neighborIndex & 4u) >> 2u, (neighborIndex & 2u) >> 1u, neighborIndex & 1u);
        int3 probeIndex3DInt = cornerProbeIndex3D + probeOffset;
        if (any(probeIndex3DInt < 0) || any(probeIndex3DInt >= (int3)probeNodeSize))
        {
            continue;
        }

        uint3 probeIndex3DWithClipmap = BurtGIVoxelNodeIndexWithClipmap((uint3)probeIndex3DInt, probeNodeSize, clipmapIndex);
        uint4 probeInfo = ProbePlaceProbePageTable[probeIndex3DWithClipmap];
        if (probeInfo.w == BURT_GI_XGI_PROBE_PAGE_INVALID)
        {
            continue;
        }

        ProbePlaceProbePageTable[probeIndex3DWithClipmap] = uint4(probeInfo.xyz, BURT_GI_XGI_PROBE_PAGE_MARKED);
    }
}

[numthreads(BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE)]
void ProbeCompact(
    uint groupIndex : SV_GroupIndex,
    uint3 dispatchThreadId : SV_DispatchThreadID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint groupThreadIndex = groupThreadId.z * BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE * BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE +
        groupThreadId.y * BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE +
        groupThreadId.x;
    if (groupThreadIndex == 0u)
    {
        BurtGISharedNumProbesToAllocate = 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    uint probeNodeSize = BurtGIVoxelProbeNodeSize((uint)max(VoxelApplyVolumeSize, 1));
    uint clipmapIndex = min((uint)max(ProbePlaceClipmapIndex, 0), max((uint)max(ProbePlaceClipmapCount, 1), 1u) - 1u);
    uint3 probeNodeIndex = dispatchThreadId;
    bool probeValid = false;
    if (!any(probeNodeIndex >= probeNodeSize))
    {
        uint3 probeNodeIndexWithClipmap = BurtGIVoxelNodeIndexWithClipmap(probeNodeIndex, probeNodeSize, clipmapIndex);
        uint4 probeInfo = ProbePlaceProbePageTable[probeNodeIndexWithClipmap];
        probeValid = probeInfo.w == BURT_GI_XGI_PROBE_PAGE_MARKED;
        ProbePlaceProbePageTable[probeNodeIndexWithClipmap] = probeValid ? uint4(probeInfo.xyz, 1u) : uint4(0u, 0u, 0u, 0u);
    }

    if (probeValid)
    {
        uint probeAllocatedIndex = 0u;
        InterlockedAdd(BurtGISharedNumProbesToAllocate, 1u, probeAllocatedIndex);
        BurtGISharedProbeNodeIndex[probeAllocatedIndex] = BurtGIVoxelNodeIndex2Flat(probeNodeIndex, probeNodeSize, 1u);
    }
    GroupMemoryBarrierWithGroupSync();

    if (groupThreadIndex == 0u)
    {
        InterlockedAdd(RWProbePlaceProbeIndex[clipmapIndex], BurtGISharedNumProbesToAllocate, BurtGISharedProbeBaseIndex);
    }
    GroupMemoryBarrierWithGroupSync();

    if (groupThreadIndex < BurtGISharedNumProbesToAllocate)
    {
        uint indexOffsetClipmap = max((uint)max(ProbePlaceIndexOffsetClipmap, 1), 1u);
        uint probePlaceProbeIndex = groupThreadIndex + BURT_GI_XGI_PROBE_ALLOCATOR_OFFSET + BurtGISharedProbeBaseIndex + clipmapIndex * indexOffsetClipmap;
        RWProbePlaceProbeIndex[probePlaceProbeIndex] = BurtGISharedProbeNodeIndex[groupThreadIndex];
    }
}

[numthreads(BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE)]
void ProbeCompactFromOccupancy(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint probeNodeSize = BurtGIVoxelProbeNodeSize((uint)max(VoxelApplyVolumeSize, 1));
    uint clipmapIndex = min((uint)max(ProbePlaceClipmapIndex, 0), max((uint)max(ProbePlaceClipmapCount, 1), 1u) - 1u);
    uint3 probeNodeIndex = dispatchThreadId;
    if (any(probeNodeIndex >= probeNodeSize))
    {
        return;
    }

    float4 occupancyValue = 0.0;
    bool probeValid = BurtGIProbeSampleOccupied(probeNodeIndex, probeNodeSize, clipmapIndex, occupancyValue);
    uint3 probeNodeIndexWithClipmap = BurtGIVoxelNodeIndexWithClipmap(probeNodeIndex, probeNodeSize, clipmapIndex);
    if (!probeValid)
    {
        ProbePlaceProbePageTable[probeNodeIndexWithClipmap] = uint4(0u, 0u, 0u, 0u);
        return;
    }

    ProbePlaceProbePageTable[probeNodeIndexWithClipmap] = uint4(1u, 1u, 1u, 1u);

    uint compactIndex = 0u;
    InterlockedAdd(RWProbePlaceProbeIndex[clipmapIndex], 1u, compactIndex);
    uint indexOffsetClipmap = max((uint)max(ProbePlaceIndexOffsetClipmap, 1), 1u);
    if (compactIndex >= indexOffsetClipmap)
    {
        return;
    }

    uint probePlaceProbeIndex = compactIndex + BURT_GI_XGI_PROBE_ALLOCATOR_OFFSET + clipmapIndex * indexOffsetClipmap;
    RWProbePlaceProbeIndex[probePlaceProbeIndex] = BurtGIVoxelNodeIndex2Flat(probeNodeIndex, probeNodeSize, 1u);
}

[numthreads(1, 1, 1)]
void ProbeGenArgs(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint probeCount = 0u;
    int clipmapCount = max(VoxelProbeArgsClipmapCount, 0);
    [loop]
    for (int i = 0; i < clipmapCount; ++i)
    {
        RWVoxelProbeArgsBufferParams[i] = probeCount;
        if (BurtGIVoxelProbeClipmapValid((uint)max(VoxelProbeClipmapValidMask, 0), (uint)i))
        {
            probeCount += VoxelProbeArgsProbeIndex[i];
        }
    }

    probeCount = min(probeCount, (uint)max(VoxelProbeArgsMaxProbeCount, 0));
    [loop]
    for (int j = clipmapCount; j <= (int)BURT_GI_XGI_PROBE_ALLOCATOR_OFFSET; ++j)
    {
        RWVoxelProbeArgsBufferParams[j] = probeCount;
    }

    uint probeThreadNumSqrt = max((uint)ceil(sqrt((float)probeCount)), 1u);
    RWVoxelProbeArgsBuffer[0] = probeThreadNumSqrt;
    RWVoxelProbeArgsBuffer[1] = probeThreadNumSqrt;
    RWVoxelProbeArgsBuffer[2] = 1u;
    RWVoxelProbeArgsBufferParams[BURT_GI_XGI_PROBE_ALLOCATOR_OFFSET + 1u] = probeThreadNumSqrt;
}

float3 BurtGISceneVoxelLightingSafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001 ? value * rsqrt(lengthSq) : fallback;
}

float BurtGISceneVoxelSmoothDistanceAttenuation(float distanceSqr, float lightRange)
{
    float invSqrAttRadius = rcp(max(lightRange * lightRange, 0.000001));
    float factor = distanceSqr * invSqrAttRadius;
    float smoothFactor = saturate(1.0 - factor * factor);
    return (smoothFactor * smoothFactor) / max(distanceSqr, 0.0001);
}

float BurtGISceneVoxelSpotAngleAttenuation(float3 normalizedLightVector, float3 lightForward, float outerCos, float invAngleRange)
{
    float angleScale = max(invAngleRange, 0.0);
    float angleOffset = -outerCos * angleScale;
    float attenuation = saturate(dot(lightForward, normalizedLightVector) * angleScale + angleOffset);
    return attenuation * attenuation;
}

float2 BurtGISceneVoxelInverseEquiAreaSphericalMapping(float3 direction)
{
    direction = BurtGISceneVoxelLightingSafeNormalize(direction, float3(0.0, 1.0, 0.0));
    float2 uv = direction.xy / max(1.0 + abs(direction.z), 0.000001);
    if (direction.z < 0.0)
    {
        float2 signNotZero = float2(uv.x >= 0.0 ? 1.0 : -1.0, uv.y >= 0.0 ? 1.0 : -1.0);
        uv = (1.0 - abs(uv.yx)) * signNotZero;
    }

    return uv * 0.5 + 0.5;
}

float3 BurtGISceneVoxelEquiAreaSphericalMapping(float2 uv)
{
    float2 f = uv * 2.0 - 1.0;
    float3 direction = float3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    if (direction.z < 0.0)
    {
        float2 signNotZero = float2(direction.x >= 0.0 ? 1.0 : -1.0, direction.y >= 0.0 ? 1.0 : -1.0);
        direction.xy = (1.0 - abs(direction.yx)) * signNotZero;
    }

    return BurtGISceneVoxelLightingSafeNormalize(direction, float3(0.0, 1.0, 0.0));
}

void BurtGISceneVoxelEvaluateSHBasis3(float3 directionWS, out float SH[BURT_GI_XGI_PROBE_TRACE_SH_COEFFICIENT_COUNT])
{
    const float shBasis0 = 0.28209479177387814;
    const float shBasis1 = 0.4886025119029199;
    const float shBasis2 = 1.092548430592079;
    const float shBasis3 = 0.31539156525252;
    const float shBasis4 = 0.5462742152960395;
    float3 axis = BurtGISceneVoxelLightingSafeNormalize(directionWS, float3(0.0, 1.0, 0.0)).zxy;
    SH[0] = shBasis0;
    SH[1] = -shBasis1 * axis.y;
    SH[2] = shBasis1 * axis.z;
    SH[3] = -shBasis1 * axis.x;
    SH[4] = shBasis2 * axis.x * axis.y;
    SH[5] = -shBasis2 * axis.y * axis.z;
    SH[6] = shBasis3 * (3.0 * axis.z * axis.z - 1.0);
    SH[7] = -shBasis2 * axis.x * axis.z;
    SH[8] = shBasis4 * (axis.x * axis.x - axis.y * axis.y);
}

void BurtGISceneVoxelWriteProbeSH(
    uint groupThreadIndexFlat,
    uint3 probeNodeIndex3DWithClipmap,
    uint probeNodeSize,
    float SH[BURT_GI_XGI_PROBE_TRACE_SH_COEFFICIENT_COUNT],
    float3 radiance)
{
    [unroll]
    for (uint coefficientIndex = 0u; coefficientIndex < BURT_GI_XGI_PROBE_TRACE_SH_COEFFICIENT_COUNT; ++coefficientIndex)
    {
        BurtGISharedProbeTraceSH[coefficientIndex * BURT_GI_XGI_PROBE_TRACE_SAMPLE_COUNT + groupThreadIndexFlat] = SH[coefficientIndex] * radiance;
    }

    GroupMemoryBarrierWithGroupSync();

    if (groupThreadIndexFlat != 0u)
    {
        return;
    }

    float3 sums[BURT_GI_XGI_PROBE_TRACE_SH_COEFFICIENT_COUNT];
    [unroll]
    for (uint coefficientIndex = 0u; coefficientIndex < BURT_GI_XGI_PROBE_TRACE_SH_COEFFICIENT_COUNT; ++coefficientIndex)
    {
        sums[coefficientIndex] = 0.0;
        [unroll]
        for (uint sampleIndex = 0u; sampleIndex < BURT_GI_XGI_PROBE_TRACE_SAMPLE_COUNT; ++sampleIndex)
        {
            sums[coefficientIndex] += BurtGISharedProbeTraceSH[coefficientIndex * BURT_GI_XGI_PROBE_TRACE_SAMPLE_COUNT + sampleIndex];
        }
    }

    float normalizeWeight = BURT_GI_FOUR_PI / (float)BURT_GI_XGI_PROBE_TRACE_SAMPLE_COUNT;
    RWVoxelProbeIrradianceSHAmbient[probeNodeIndex3DWithClipmap] = float4(max(sums[0] * normalizeWeight, 0.0), 1.0);
    [unroll]
    for (uint colorColumn = 0u; colorColumn < 3u; ++colorColumn)
    {
        float4 directionalSH0 = float4(sums[1][colorColumn], sums[2][colorColumn], sums[3][colorColumn], sums[4][colorColumn]) * normalizeWeight;
        float4 directionalSH1 = float4(sums[5][colorColumn], sums[6][colorColumn], sums[7][colorColumn], sums[8][colorColumn]) * normalizeWeight;
        RWVoxelProbeIrradianceSHDirectional[uint3(probeNodeIndex3DWithClipmap.x + (colorColumn * 2u + 0u) * probeNodeSize, probeNodeIndex3DWithClipmap.y, probeNodeIndex3DWithClipmap.z)] = directionalSH0;
        RWVoxelProbeIrradianceSHDirectional[uint3(probeNodeIndex3DWithClipmap.x + (colorColumn * 2u + 1u) * probeNodeSize, probeNodeIndex3DWithClipmap.y, probeNodeIndex3DWithClipmap.z)] = directionalSH1;
    }
}

float3 BurtGISceneVoxelEvaluateAmbientSH(float3 normalWS)
{
    float4 normal = float4(BurtGISceneVoxelLightingSafeNormalize(normalWS, float3(0.0, 1.0, 0.0)), 1.0);
    float3 sh = float3(
        dot(unity_SHAr, normal),
        dot(unity_SHAg, normal),
        dot(unity_SHAb, normal));

    float4 vB = normal.xyzz * normal.yzzx;
    sh += float3(
        dot(unity_SHBr, vB),
        dot(unity_SHBg, vB),
        dot(unity_SHBb, vB));

    float vC = normal.x * normal.x - normal.y * normal.y;
    sh += unity_SHC.rgb * vC;
    return max(sh, 0.0);
}

float3 BurtGISceneVoxelRecoverBoostedDiffuseColor(float3 storedRadiance)
{
    return saturate(max(storedRadiance, float3(0.0, 0.0, 0.0)) / 0.12);
}

uint BurtGISceneVoxelRadianceCacheClipmapCount()
{
    return max(1u, min((uint)_BurtGIRadianceCacheClipMapParams.z, BURT_GI_RADIANCE_CACHE_MAX_CLIPMAPS));
}

uint BurtGISceneVoxelRadianceCacheClipmapResolution()
{
    return max(1u, (uint)_BurtGIRadianceCacheClipMapParams.w);
}

uint BurtGISceneVoxelRadianceCacheAtlasResolutionInProbes()
{
    return max(1u, (uint)_BurtGIRadianceCacheClipMapParams.x);
}

bool BurtGISceneVoxelRadianceCacheIsAvailable()
{
    return _BurtGISceneVoxelRadianceCacheParams.x > 0.5 &&
        _BurtGIRadianceCacheClipMapParams.x > 0.5 &&
        _BurtGIRadianceCacheClipMapParams.z > 0.5 &&
        _BurtGIRadianceCacheClipMapParams.w > 0.5 &&
        _BurtGIRadianceCacheClipMapIndirectionSize.x > 0.5 &&
        _BurtGIRadianceCacheClipMapIndirectionSize.y > 0.5;
}

bool BurtGISceneVoxelRadianceCacheWorldToProbeCoord(float3 worldPosition, out uint clipmapIndex, out float3 probeCoordFloat)
{
    uint clipmapCount = BurtGISceneVoxelRadianceCacheClipmapCount();
    uint clipmapResolution = BurtGISceneVoxelRadianceCacheClipmapResolution();
    float invFadeSize = max(_BurtGIRadianceCacheClipMapWorldParams.z, 0.0001);

    [unroll]
    for (uint currentClipmapIndex = 0u; currentClipmapIndex < BURT_GI_RADIANCE_CACHE_MAX_CLIPMAPS; ++currentClipmapIndex)
    {
        if (currentClipmapIndex >= clipmapCount)
        {
            continue;
        }

        float4 worldToProbeCoord = _BurtGIRadianceCacheClipMapWorldPositionToProbeCoord[currentClipmapIndex];
        float3 currentProbeCoordFloat = worldPosition * worldToProbeCoord.w + worldToProbeCoord.xyz;
        float3 bottomEdgeFade = saturate((currentProbeCoordFloat - 0.5) * invFadeSize);
        float3 topEdgeFade = saturate(((float3)clipmapResolution - 0.5 - currentProbeCoordFloat) * invFadeSize);
        float edgeFade = min(
            min(bottomEdgeFade.x, min(bottomEdgeFade.y, bottomEdgeFade.z)),
            min(topEdgeFade.x, min(topEdgeFade.y, topEdgeFade.z)));
        if (edgeFade > 0.0001)
        {
            clipmapIndex = currentClipmapIndex;
            probeCoordFloat = currentProbeCoordFloat;
            return true;
        }
    }

    clipmapIndex = 0u;
    probeCoordFloat = 0.0;
    return false;
}

uint BurtGISceneVoxelRadianceCacheProbeIndex(uint clipmapIndex, uint3 probeCoord)
{
    uint clipmapResolution = BurtGISceneVoxelRadianceCacheClipmapResolution();
    uint2 indirectionSize = max((uint2)_BurtGIRadianceCacheClipMapIndirectionSize.xy, uint2(1u, 1u));
    uint2 indirectionCoord = uint2(
        clipmapIndex * clipmapResolution + probeCoord.x,
        probeCoord.y + probeCoord.z * clipmapResolution);

    if (indirectionCoord.x >= indirectionSize.x || indirectionCoord.y >= indirectionSize.y)
    {
        return BURT_GI_RADIANCE_CACHE_INVALID_PROBE_INDEX;
    }

    return _BurtGIRadianceCacheClipMapIndirectionTexture.Load(int3((int2)indirectionCoord, 0));
}

float3 BurtGISceneVoxelSampleRadianceCacheProbeIrradiance(uint probeIndex, float3 normalWS)
{
    uint atlasResolutionInProbes = BurtGISceneVoxelRadianceCacheAtlasResolutionInProbes();
    uint maxProbeCount = atlasResolutionInProbes * atlasResolutionInProbes;
    if (probeIndex >= maxProbeCount)
    {
        return 0.0;
    }

    uint finalIrradianceProbeResolution = max(1u, _BurtGIRadianceCacheClipMapFinalIrradianceProbeResolution);
    uint borderSize = 1u << min(_BurtGIRadianceCacheClipMapFinalRadianceAtlasMaxMip, 8u);
    uint irradianceProbeResolution = max(1u, finalIrradianceProbeResolution > 2u * borderSize ? finalIrradianceProbeResolution - 2u * borderSize : 1u);
    float2 probeUV = BurtGISceneVoxelInverseEquiAreaSphericalMapping(normalWS);
    float2 probeTexelCoord = probeUV * (float)irradianceProbeResolution + (float)borderSize;
    float2 probeAtlasBaseCoord = (float2)(uint2(probeIndex % atlasResolutionInProbes, probeIndex / atlasResolutionInProbes) * finalIrradianceProbeResolution);
    float2 finalAtlasResolution = (float)(atlasResolutionInProbes * finalIrradianceProbeResolution);
    float2 probeAtlasUV = (probeAtlasBaseCoord + probeTexelCoord) / max(finalAtlasResolution, float2(1.0, 1.0));
    return max(_BurtGIRadianceCacheClipMapFinalIrradianceAtlasTexture.SampleLevel(sampler_LinearClamp, probeAtlasUV, 0.0).rgb, 0.0);
}

float3 BurtGISceneVoxelRadianceCacheProbeWorldPosition(uint clipmapIndex, uint3 probeCoord, uint probeIndex)
{
    float4 worldToProbeCoord = _BurtGIRadianceCacheClipMapWorldPositionToProbeCoord[min(clipmapIndex, BURT_GI_RADIANCE_CACHE_MAX_CLIPMAPS - 1u)];
    float invScale = rcp(max(abs(worldToProbeCoord.w), 1.0e-6));
    float3 probeWorldPosition = ((float3)probeCoord - worldToProbeCoord.xyz) * invScale;
    uint atlasResolutionInProbes = BurtGISceneVoxelRadianceCacheAtlasResolutionInProbes();
    uint maxProbeCount = atlasResolutionInProbes * atlasResolutionInProbes;
    if (probeIndex < maxProbeCount)
    {
        probeWorldPosition += _BurtGIRadianceCacheClipMapProbeWorldOffsetBuffer[probeIndex].xyz;
    }

    return probeWorldPosition;
}

float BurtGISceneVoxelSampleRadianceCacheProbeOcclusion(uint probeIndex, float3 probeToSampleWS, float sampleDistance)
{
    uint atlasResolutionInProbes = BurtGISceneVoxelRadianceCacheAtlasResolutionInProbes();
    uint maxProbeCount = atlasResolutionInProbes * atlasResolutionInProbes;
    if (probeIndex >= maxProbeCount)
    {
        return 1.0;
    }

    uint finalProbeResolution = max(1u, _BurtGIRadianceCacheClipMapFinalOcclusionProbeResolution);
    uint borderSize = 1u << min(_BurtGIRadianceCacheClipMapFinalRadianceAtlasMaxMip, 8u);
    uint probeResolution = max(1u, finalProbeResolution > 2u * borderSize ? finalProbeResolution - 2u * borderSize : 1u);
    float2 probeUV = BurtGISceneVoxelInverseEquiAreaSphericalMapping(probeToSampleWS);
    float2 probeTexelCoord = probeUV * (float)probeResolution + (float)borderSize;
    float2 probeAtlasBaseCoord = (float2)(uint2(probeIndex % atlasResolutionInProbes, probeIndex / atlasResolutionInProbes) * finalProbeResolution);
    float2 atlasResolution = (float)(atlasResolutionInProbes * finalProbeResolution);
    float2 moments = _BurtGIRadianceCacheClipMapProbeOcclusionAtlasTexture.SampleLevel(
        sampler_LinearClamp,
        (probeAtlasBaseCoord + probeTexelCoord) / max(atlasResolution, float2(1.0, 1.0)),
        0.0);

    float meanDepth = max(moments.x, 0.0);
    if (meanDepth <= 0.0001 || sampleDistance <= meanDepth)
    {
        return 1.0;
    }

    float variance = max(abs(moments.y - meanDepth * meanDepth), 0.0001);
    float distanceDelta = sampleDistance - meanDepth;
    float visibility = variance / (variance + distanceDelta * distanceDelta);
    return saturate(visibility * visibility * visibility);
}

float BurtGISceneVoxelApplyRadianceCacheProbeOcclusionWeightThreshold(float weight)
{
    const float weightThreshold = 0.2;
    weight = max(weight, 0.0);
    return weight < weightThreshold
        ? weight * weight * weight / (weightThreshold * weightThreshold)
        : weight;
}

bool BurtGISceneVoxelSampleRadianceCacheIrradiance(float3 worldPosition, float3 normalWS, out float3 irradiance)
{
    irradiance = 0.0;
    if (!BurtGISceneVoxelRadianceCacheIsAvailable())
    {
        return false;
    }

    uint clipmapIndex = 0u;
    float3 probeCoordFloat = 0.0;
    if (!BurtGISceneVoxelRadianceCacheWorldToProbeCoord(worldPosition, clipmapIndex, probeCoordFloat))
    {
        return false;
    }

    uint clipmapResolution = BurtGISceneVoxelRadianceCacheClipmapResolution();
    float3 cornerProbeCoordFloat = probeCoordFloat - 0.5 + 0.0001;
    int3 cornerProbeCoord = (int3)floor(cornerProbeCoordFloat);
    float3 lerpAlphas = saturate(frac(cornerProbeCoordFloat));
    int3 maxProbeCoord = int3((int)clipmapResolution - 1, (int)clipmapResolution - 1, (int)clipmapResolution - 1);

    float weightSum = 0.0;
    [unroll]
    for (int z = 0; z < 2; ++z)
    {
        [unroll]
        for (int y = 0; y < 2; ++y)
        {
            [unroll]
            for (int x = 0; x < 2; ++x)
            {
                uint3 probeCoord = (uint3)clamp(cornerProbeCoord + int3(x, y, z), int3(0, 0, 0), maxProbeCoord);
                uint probeIndex = BurtGISceneVoxelRadianceCacheProbeIndex(clipmapIndex, probeCoord);
                if (probeIndex >= BURT_GI_RADIANCE_CACHE_USED_PROBE_INDEX)
                {
                    continue;
                }

                float3 cornerWeight = lerp(1.0 - lerpAlphas, lerpAlphas, float3((float)x, (float)y, (float)z));
                float weight = cornerWeight.x * cornerWeight.y * cornerWeight.z;
                float3 probeWorldPosition = BurtGISceneVoxelRadianceCacheProbeWorldPosition(clipmapIndex, probeCoord, probeIndex);
                float3 probeToSampleWS = worldPosition - probeWorldPosition;
                float sampleDistance = length(probeToSampleWS);
                float visibility = BurtGISceneVoxelSampleRadianceCacheProbeOcclusion(probeIndex, probeToSampleWS, sampleDistance);
                float finalWeight = BurtGISceneVoxelApplyRadianceCacheProbeOcclusionWeightThreshold(weight * visibility);
                irradiance += BurtGISceneVoxelSampleRadianceCacheProbeIrradiance(probeIndex, normalWS) * finalWeight;
                weightSum += finalWeight;
            }
        }
    }

    return weightSum > 0.0001;
}

bool BurtGISceneVoxelOctreeMaskContains(uint lowMask, uint highMask, uint bitIndex)
{
    uint word = bitIndex < 32u ? lowMask : highMask;
    return ((word >> (bitIndex & 31u)) & 1u) != 0u;
}

bool BurtGISceneVoxelOctreeContainsVoxel(uint3 voxelCoord)
{
    uint3 parentCoord = voxelCoord >> 4u;
    uint3 leafCoord = voxelCoord >> 2u;
    uint rootBit = parentCoord.x + parentCoord.y * 4u + parentCoord.z * 16u;
    if (!BurtGISceneVoxelOctreeMaskContains(
            _BurtGISceneVoxelOctreeRootLowTexture[uint3(0u, 0u, 0u)],
            _BurtGISceneVoxelOctreeRootHighTexture[uint3(0u, 0u, 0u)],
            rootBit))
    {
        return false;
    }

    uint3 parentChild = leafCoord & 3u;
    uint parentBit = parentChild.x + parentChild.y * 4u + parentChild.z * 16u;
    if (!BurtGISceneVoxelOctreeMaskContains(
            _BurtGISceneVoxelOctreeParentLowTexture[parentCoord],
            _BurtGISceneVoxelOctreeParentHighTexture[parentCoord],
            parentBit))
    {
        return false;
    }

    uint3 leafChild = voxelCoord & 3u;
    uint leafBit = leafChild.x + leafChild.y * 4u + leafChild.z * 16u;
    return BurtGISceneVoxelOctreeMaskContains(
        _BurtGISceneVoxelOctreeLeafLowTexture[leafCoord],
        _BurtGISceneVoxelOctreeLeafHighTexture[leafCoord],
        leafBit);
}

bool BurtGISceneVoxelOctreeMayContain(float3 samplePosition)
{
    if (_BurtGISceneVoxelOctreeValid <= 0.5)
    {
        return true;
    }

    uint geometryWidth = 1u;
    uint geometryHeight = 1u;
    uint geometryDepth = 1u;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(geometryWidth, geometryHeight, geometryDepth);
    uint3 geometrySize = max(uint3(geometryWidth, geometryHeight, geometryDepth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGISceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)geometrySize), geometrySize - 1u);
    return BurtGISceneVoxelOctreeContainsVoxel(voxelCoord);
}

bool BurtGIRayTraceSceneVoxelOctree(float3 originWS, float3 directionWS, float maxDistance, out float hitDistance)
{
    hitDistance = maxDistance;
    if (_BurtGISceneVoxelOctreeValid <= 0.5 || maxDistance <= 0.0)
    {
        return false;
    }

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float extent = max(centerExtent.w, 0.001);
    float3 boxMin = centerExtent.xyz - extent;
    float3 boxMax = centerExtent.xyz + extent;
    float3 direction = BurtGISceneVoxelLightingSafeNormalize(directionWS, float3(0.0, 0.0, 1.0));
    float3 invDirection = rcp(max(abs(direction), 0.000001)) * sign(direction + 0.000001);
    float3 t0 = (boxMin - originWS) * invDirection;
    float3 t1 = (boxMax - originWS) * invDirection;
    float entryDistance = max(max(min(t0.x, t1.x), min(t0.y, t1.y)), min(t0.z, t1.z));
    float exitDistance = min(min(max(t0.x, t1.x), max(t0.y, t1.y)), max(t0.z, t1.z));
    float voxelSizeWS = extent * 2.0 / max((float)volumeSize.x, 1.0);
    float traceDistance = max(0.0, entryDistance) + voxelSizeWS * 0.001;
    float traceEnd = min(maxDistance, exitDistance);
    if (traceDistance >= traceEnd)
    {
        return false;
    }

    uint maxTraceSteps = min((uint)max(_BurtGISceneVoxelTraceControls.x, 1.0), 64u);
    [loop]
    for (uint stepIndex = 0u; stepIndex < maxTraceSteps && traceDistance < traceEnd; ++stepIndex)
    {
        float3 positionWS = originWS + direction * traceDistance;
        float3 localPosition = clamp(positionWS - boxMin, 0.0, extent * 2.0 - voxelSizeWS * 0.001);
        uint3 voxelCoord = min((uint3)(localPosition / voxelSizeWS), volumeSize - 1u);
        uint3 parentCoord = voxelCoord >> 4u;
        uint3 leafCoord = voxelCoord >> 2u;
        uint rootBit = parentCoord.x + parentCoord.y * 4u + parentCoord.z * 16u;
        bool occupied = BurtGISceneVoxelOctreeMaskContains(
            _BurtGISceneVoxelOctreeRootLowTexture[uint3(0u, 0u, 0u)],
            _BurtGISceneVoxelOctreeRootHighTexture[uint3(0u, 0u, 0u)],
            rootBit);
        uint levelScale = 16u;
        if (occupied)
        {
            uint3 parentChild = leafCoord & 3u;
            uint parentBit = parentChild.x + parentChild.y * 4u + parentChild.z * 16u;
            occupied = BurtGISceneVoxelOctreeMaskContains(
                _BurtGISceneVoxelOctreeParentLowTexture[parentCoord],
                _BurtGISceneVoxelOctreeParentHighTexture[parentCoord],
                parentBit);
            levelScale = 4u;
        }
        if (occupied)
        {
            uint3 leafChild = voxelCoord & 3u;
            uint leafBit = leafChild.x + leafChild.y * 4u + leafChild.z * 16u;
            occupied = BurtGISceneVoxelOctreeMaskContains(
                _BurtGISceneVoxelOctreeLeafLowTexture[leafCoord],
                _BurtGISceneVoxelOctreeLeafHighTexture[leafCoord],
                leafBit);
            levelScale = 1u;
        }
        if (occupied)
        {
            hitDistance = traceDistance;
            return true;
        }

        float cellSizeWS = voxelSizeWS * (float)levelScale;
        float3 cellIndex = floor(localPosition / cellSizeWS);
        float3 cellMin = boxMin + cellIndex * cellSizeWS;
        float3 cellMax = cellMin + cellSizeWS;
        float3 boundary = lerp(cellMin, cellMax, step(0.0, direction));
        float3 safeDirection = sign(direction + 0.000001) * max(abs(direction), 0.000001);
        float3 distanceToBoundary = (boundary - positionWS) / safeDirection;
        distanceToBoundary = max(distanceToBoundary, voxelSizeWS * 0.001);
        traceDistance += min(min(distanceToBoundary.x, distanceToBoundary.y), distanceToBoundary.z);
    }

    return false;
}

uint BurtGIResolveSceneVoxelClipmap(float3 samplePosition)
{
    float4 baseCenterExtent = _BurtGISceneVoxelCenterExtent;
    if (all(abs(samplePosition - baseCenterExtent.xyz) <= baseCenterExtent.www))
    {
        return 0u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 2u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[1].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[1].www))
    {
        return 1u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 4u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[2].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[2].www))
    {
        return 2u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 8u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[3].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[3].www))
    {
        return 3u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 16u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[4].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[4].www))
    {
        return 4u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 32u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[5].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[5].www))
    {
        return 5u;
    }

    return 0u;
}

struct BurtGISceneVoxelOccupancySample
{
    uint Sampled;
    float Occupancy;
};

BurtGISceneVoxelOccupancySample BurtGIMakeSceneVoxelOccupancySample(uint sampled, float occupancy)
{
    BurtGISceneVoxelOccupancySample result = (BurtGISceneVoxelOccupancySample)0;
    result.Sampled = sampled;
    result.Occupancy = occupancy;
    return result;
}

BurtGISceneVoxelOccupancySample BurtGITrySampleSceneVoxelOccupancyMipResource(
    Texture3D<float4> occupancyTexture,
    float4 centerExtent,
    float3 samplePosition,
    float sampleRadius)
{
    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    occupancyTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = (samplePosition - centerExtent.xyz) / max(centerExtent.w * 2.0, 0.001) + 0.5;
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return BurtGIMakeSceneVoxelOccupancySample(0u, 0.0);
    }

    float voxelSizeWS = max(centerExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    uint mipLevel = (uint)clamp(floor(log2(max(sampleRadius, voxelSizeWS) / voxelSizeWS)), 0.0, (float)(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_COUNT - 1u));
    uint3 mipSize = max(volumeSize >> mipLevel, uint3(1u, 1u, 1u));
    uint3 mipCoord = min((uint3)(uvw * (float3)mipSize), mipSize - 1u);
    float4 occupancyMip = occupancyTexture.Load(int4((int3)mipCoord, (int)mipLevel));
    float occupancy = saturate(max(occupancyMip.x, occupancyMip.y));
    return BurtGIMakeSceneVoxelOccupancySample(occupancy > 0.001 ? 1u : 0u, occupancy);
}

BurtGISceneVoxelOccupancySample BurtGITrySampleSceneVoxelOccupancyMip(float3 samplePosition, float sampleRadius)
{
    uint clipmapLevel = BurtGIResolveSceneVoxelClipmap(samplePosition);
    if (clipmapLevel == 1u)
    {
        return BurtGITrySampleSceneVoxelOccupancyMipResource(
            _BurtGISceneVoxelClipmap1OccupancyMipReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[1],
            samplePosition,
            sampleRadius);
    }
    if (clipmapLevel == 2u)
    {
        return BurtGITrySampleSceneVoxelOccupancyMipResource(
            _BurtGISceneVoxelClipmap2OccupancyMipReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[2],
            samplePosition,
            sampleRadius);
    }
    if (clipmapLevel == 3u)
    {
        return BurtGITrySampleSceneVoxelOccupancyMipResource(
            _BurtGISceneVoxelClipmap3OccupancyMipReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[3],
            samplePosition,
            sampleRadius);
    }
    if (clipmapLevel == 4u)
    {
        return BurtGITrySampleSceneVoxelOccupancyMipResource(
            _BurtGISceneVoxelClipmap4OccupancyMipReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[4],
            samplePosition,
            sampleRadius);
    }
    if (clipmapLevel == 5u)
    {
        return BurtGITrySampleSceneVoxelOccupancyMipResource(
            _BurtGISceneVoxelClipmap5OccupancyMipReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[5],
            samplePosition,
            sampleRadius);
    }
    if (!BurtGISceneVoxelOctreeMayContain(samplePosition))
    {
        return BurtGIMakeSceneVoxelOccupancySample(0u, 0.0);
    }

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelOccupancyMipReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGISceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return BurtGIMakeSceneVoxelOccupancySample(0u, 0.0);
    }

    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float voxelSizeWS = max(centerExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float mipLevel = clamp(floor(log2(max(sampleRadius, voxelSizeWS) / voxelSizeWS)), 0.0, (float)(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_COUNT - 1u));
    float4 occupancyMip = _BurtGISceneVoxelOccupancyMipReadTexture.SampleLevel(sampler_BurtGISceneVoxelOccupancyMipReadTexture, uvw, mipLevel);
    float occupancy = saturate(max(occupancyMip.x, occupancyMip.y));
    return BurtGIMakeSceneVoxelOccupancySample(occupancy > 0.001 ? 1u : 0u, occupancy);
}

bool BurtGITrySampleSceneVoxelLightingResource(
    Texture3D<float4> radianceTexture,
    Texture3D<float4> geometryTexture,
    Texture3D<float4> lightingTexture,
    float4 centerExtent,
    float3 samplePosition,
    float3 traceDirection,
    float sampleRadius,
    out float3 radiance,
    out float confidence,
    out uint hitBackface)
{
    radiance = 0.0;
    confidence = 0.0;
    hitBackface = 0u;

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    geometryTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float extent = max(centerExtent.w, 0.001);
    float3 uvw = (samplePosition - centerExtent.xyz) / (extent * 2.0) + 0.5;
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 storedRadiance = radianceTexture.Load(int4((int3)coord, 0));
    float4 geometry = geometryTexture.Load(int4((int3)coord, 0));
    float4 lighting = lightingTexture.Load(int4((int3)coord, 0));
    float occupancy = saturate(geometry.a);
    float lightingConfidence = saturate(lighting.a);
    float3 lightingRadiance = max(lighting.rgb, 0.0);
    if (occupancy <= 0.001 || lightingConfidence <= 0.001)
    {
        return false;
    }

    float3 normalWS = BurtGISceneVoxelLightingSafeNormalize(geometry.xyz * 2.0 - 1.0, float3(0.0, 1.0, 0.0));
    float3 traceDirectionWS = BurtGISceneVoxelLightingSafeNormalize(traceDirection, float3(0.0, 0.0, 1.0));
    float frontFacing = dot(normalWS, -traceDirectionWS);
    hitBackface = frontFacing < 0.0 ? 1u : 0u;
    float facing = hitBackface != 0u ? -frontFacing : frontFacing;
    float normalFacingWeight = saturate(facing * 0.85 + 0.15);
    float voxelSizeWS = max(extent * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float footprintWeight = saturate(voxelSizeWS / max(sampleRadius, voxelSizeWS));
    confidence = lightingConfidence * occupancy * normalFacingWeight * lerp(0.5, 1.0, footprintWeight);
    radiance = lightingRadiance;
    if (hitBackface != 0u)
    {
        float3 backNormalWS = -normalWS;
        float backHemi = saturate(backNormalWS.y * 0.5 + 0.5);
        float skyLightEnabled = _BurtGISceneVoxelDirectLightTint.w > 0.5 ? 1.0 : 0.0;
        float3 analyticSkyTint = lerp(float3(0.015, 0.018, 0.022), float3(0.08, 0.095, 0.12), backHemi);
        float3 ambientSkyTint = BurtGISceneVoxelEvaluateAmbientSH(backNormalWS);
        float3 skyTint = max(ambientSkyTint, analyticSkyTint) * skyLightEnabled;
        float3 boostedDiffuseColor = BurtGISceneVoxelRecoverBoostedDiffuseColor(storedRadiance.rgb);
        float3 mainLightDirection = _BurtGIMainLightDirection.xyz;
        float mainLightDirectionLengthSq = dot(mainLightDirection, mainLightDirection);
        mainLightDirection = mainLightDirectionLengthSq > 0.0001 ? mainLightDirection * rsqrt(mainLightDirectionLengthSq) : float3(0.0, 1.0, 0.0);
        float mainLightNdotL = saturate(dot(backNormalWS, mainLightDirection));
        float oneOverPreExposure = max(_BurtGISceneVoxelExposureParams.x, 0.0);
        float normalBoost = lerp(0.75, 1.2, saturate(dot(backNormalWS, normalize(float3(0.35, 0.75, 0.45))) * 0.5 + 0.5));
        float3 mainLightRadiance = max(_BurtGIMainLightColor.rgb, 0.0) * mainLightNdotL;
        float3 directLighting = (normalBoost.xxx + mainLightRadiance) *
            (max(_BurtGISceneVoxelDirectLightTint.rgb, 0.0) * max(_BurtGISceneVoxelLightingParams.z, 0.0) * oneOverPreExposure);
        const float xgiSecondaryBounceSkyScale = 0.2;
        float3 indirectLighting = skyTint * boostedDiffuseColor *
            (max(_BurtGISceneVoxelIndirectLightTint.rgb, 0.0) * max(_BurtGISceneVoxelLightingParams.w, 0.0) * xgiSecondaryBounceSkyScale);
        radiance = max(storedRadiance.rgb, 0.0) * directLighting + indirectLighting * storedRadiance.a;
        radiance = max(radiance, lightingRadiance * 0.2);
    }
    return confidence > 0.001 && dot(radiance, radiance) > 0.0;
}

bool BurtGITrySampleSceneVoxelLightingHit(
    uint clipmapLevel,
    float3 samplePosition,
    float3 traceDirection,
    float sampleRadius,
    out float3 radiance,
    out float confidence,
    out uint hitBackface)
{
    if (clipmapLevel == 1u)
    {
        return BurtGITrySampleSceneVoxelLightingResource(
            _BurtGISceneVoxelClipmap1RadianceReadTexture,
            _BurtGISceneVoxelClipmap1GeometryReadTexture,
            _BurtGISceneVoxelClipmap1LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[1],
            samplePosition,
            traceDirection,
            sampleRadius,
            radiance,
            confidence,
            hitBackface);
    }

    if (clipmapLevel == 2u)
    {
        return BurtGITrySampleSceneVoxelLightingResource(
            _BurtGISceneVoxelClipmap2RadianceReadTexture,
            _BurtGISceneVoxelClipmap2GeometryReadTexture,
            _BurtGISceneVoxelClipmap2LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[2],
            samplePosition,
            traceDirection,
            sampleRadius,
            radiance,
            confidence,
            hitBackface);
    }

    if (clipmapLevel == 3u)
    {
        return BurtGITrySampleSceneVoxelLightingResource(
            _BurtGISceneVoxelClipmap3RadianceReadTexture,
            _BurtGISceneVoxelClipmap3GeometryReadTexture,
            _BurtGISceneVoxelClipmap3LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[3],
            samplePosition,
            traceDirection,
            sampleRadius,
            radiance,
            confidence,
            hitBackface);
    }

    if (clipmapLevel == 4u)
    {
        return BurtGITrySampleSceneVoxelLightingResource(
            _BurtGISceneVoxelClipmap4RadianceReadTexture,
            _BurtGISceneVoxelClipmap4GeometryReadTexture,
            _BurtGISceneVoxelClipmap4LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[4],
            samplePosition,
            traceDirection,
            sampleRadius,
            radiance,
            confidence,
            hitBackface);
    }

    if (clipmapLevel == 5u)
    {
        return BurtGITrySampleSceneVoxelLightingResource(
            _BurtGISceneVoxelClipmap5RadianceReadTexture,
            _BurtGISceneVoxelClipmap5GeometryReadTexture,
            _BurtGISceneVoxelClipmap5LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[5],
            samplePosition,
            traceDirection,
            sampleRadius,
            radiance,
            confidence,
            hitBackface);
    }

    return BurtGITrySampleSceneVoxelLightingResource(
        _BurtGISceneVoxelRadianceReadTexture,
        _BurtGISceneVoxelGeometryReadTexture,
        _BurtGISceneVoxelLightingReadTexture,
        _BurtGISceneVoxelCenterExtent,
        samplePosition,
        traceDirection,
        sampleRadius,
        radiance,
        confidence,
        hitBackface);
}

bool BurtGITraceSceneVoxelLighting(float3 worldPosition, float3 directionWS, float maxTraceDistance, out float3 radiance)
{
    radiance = 0.0;

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelLightingReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float4 baseCenterExtent = _BurtGISceneVoxelCenterExtent;
    float voxelSizeWS = max(baseCenterExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float3 direction = BurtGISceneVoxelLightingSafeNormalize(directionWS, float3(0.0, 0.0, 1.0));
    float startDistance = voxelSizeWS * 1.5;
    float traceDistance = 0.0;

    if (_BurtGISceneVoxelOctreeValid > 0.5 &&
        BurtGIRayTraceSceneVoxelOctree(
            worldPosition + direction * startDistance,
            direction,
            max(maxTraceDistance - startDistance, 0.0),
            traceDistance))
    {
        float hitDistance = startDistance + traceDistance;
        float3 hitPosition = worldPosition + direction * (hitDistance + voxelSizeWS * 0.001);
        float confidence = 0.0;
        uint hitBackface = 0u;
        if (BurtGITrySampleSceneVoxelLightingHit(
                0u,
                hitPosition,
                direction,
                voxelSizeWS,
                radiance,
                confidence,
                hitBackface))
        {
            radiance *= confidence;
            return true;
        }
    }

    uint maxTraceSteps = min((uint)max(_BurtGISceneVoxelTraceControls.x, 1.0), 64u);
    float bestConfidence = 0.0;
    float3 bestRadiance = 0.0;
    [loop]
    for (uint stepIndex = 0u; stepIndex < maxTraceSteps; ++stepIndex)
    {
        float stepT = ((float)stepIndex + 0.5) / max((float)maxTraceSteps, 1.0);
        float sampleDistance = lerp(startDistance, maxTraceDistance, stepT);
        float sampleRadius = max(voxelSizeWS, sampleDistance * 0.08);
        float3 samplePosition = worldPosition + direction * sampleDistance;
        BurtGISceneVoxelOccupancySample occupancySample = BurtGITrySampleSceneVoxelOccupancyMip(samplePosition, sampleRadius);
        if (occupancySample.Sampled == 0u)
        {
            continue;
        }

        uint clipmapLevel = BurtGIResolveSceneVoxelClipmap(samplePosition);
        float4 sampleCenterExtent = BurtGIProbeClipmapCenterExtent(clipmapLevel);
        float hitBiasWS = max(sampleCenterExtent.w / 65536.0, 0.0005);
        float3 hitPosition = samplePosition + direction * hitBiasWS;
        float3 sampleRadiance = 0.0;
        float sampleConfidence = 0.0;
        uint hitBackface = 0u;
        if (!BurtGITrySampleSceneVoxelLightingHit(
                clipmapLevel,
                hitPosition,
                direction,
                sampleRadius,
                sampleRadiance,
                sampleConfidence,
                hitBackface))
        {
            continue;
        }

        sampleConfidence *= occupancySample.Occupancy * (1.0 - stepT * 0.35);
        if (sampleConfidence > 0.02)
        {
            radiance = sampleRadiance * saturate(sampleConfidence);
            return dot(radiance, radiance) > 0.0;
        }

        if (sampleConfidence > bestConfidence)
        {
            bestConfidence = sampleConfidence;
            bestRadiance = sampleRadiance;
            if (bestConfidence > 0.75)
            {
                break;
            }
        }
    }

    if (bestConfidence <= 0.001)
    {
        return false;
    }

    radiance = bestRadiance * saturate(bestConfidence);
    return dot(radiance, radiance) > 0.0;
}

float BurtGITraceSceneVoxelDirectionalVisibility(float3 worldPosition, float3 direction, float maxDistance)
{
    float4 octreeCenterExtent = _BurtGISceneVoxelCenterExtent;
    float octreeVoxelSizeWS = max(octreeCenterExtent.w / 32.0, 0.001);
    float3 octreeDirection = BurtGISceneVoxelLightingSafeNormalize(direction, float3(0.0, 0.0, 1.0));
    float octreeHitDistance = 0.0;
    if (BurtGIRayTraceSceneVoxelOctree(
            worldPosition + octreeDirection * (octreeVoxelSizeWS * 1.5),
            octreeDirection,
            max(maxDistance - octreeVoxelSizeWS * 1.5, 0.0),
            octreeHitDistance))
    {
        return 0.0;
    }
    if (_BurtGISceneVoxelOctreeValid > 0.5)
    {
        return 1.0;
    }

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float voxelSizeWS = max(centerExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float3 traceDirection = BurtGISceneVoxelLightingSafeNormalize(direction, float3(0.0, 0.0, 1.0));
    float transmittance = 1.0;
    float traceDistance = voxelSizeWS * 1.5;

    [unroll]
    for (uint stepIndex = 0u; stepIndex < 6u && traceDistance < maxDistance; ++stepIndex)
    {
        float sampleRadius = max(voxelSizeWS, traceDistance * 0.45);
        BurtGISceneVoxelOccupancySample occupancySample = BurtGITrySampleSceneVoxelOccupancyMip(
            worldPosition + traceDirection * traceDistance,
            sampleRadius);
        if (occupancySample.Sampled != 0u)
        {
            transmittance *= 1.0 - saturate(occupancySample.Occupancy * 0.55);
            if (transmittance <= 0.02)
            {
                return 0.0;
            }
        }

        traceDistance += max(voxelSizeWS, sampleRadius * 1.35);
    }

    return saturate(transmittance);
}

float3 BurtGISceneVoxelEvaluateAdditionalLights(float3 worldPosition, float3 normalWS)
{
    float3 lighting = 0.0;
    uint additionalLightCount = min(_BurtGIAdditionalLightCount, 8u);
    [loop]
    for (uint lightIndex = 0u; lightIndex < additionalLightCount; ++lightIndex)
    {
        float4 positionAndRange = _BurtGIAdditionalLightPositionAndRange[lightIndex];
        float4 colorAndType = _BurtGIAdditionalLightColorAndType[lightIndex];
        float lightType = colorAndType.w;
        float3 lightDirection = float3(0.0, 1.0, 0.0);
        float attenuation = 1.0;
        float lightTraceDistance = 0.0;

        if (lightType < 0.5)
        {
            lightDirection = BurtGISceneVoxelLightingSafeNormalize(
                _BurtGIAdditionalLightDirectionAndSpot[lightIndex].xyz,
                float3(0.0, 1.0, 0.0));
        }
        else
        {
            float3 toLight = positionAndRange.xyz - worldPosition;
            float distanceToLight = length(toLight);
            float lightRange = max(positionAndRange.w, 0.001);
            if (distanceToLight >= lightRange)
            {
                continue;
            }

            lightDirection = toLight / max(distanceToLight, 0.0001);
            lightTraceDistance = distanceToLight;
            float distanceSqr = max(distanceToLight * distanceToLight, 0.0001);
            attenuation = BurtGISceneVoxelSmoothDistanceAttenuation(distanceSqr, lightRange);

            if (lightType > 1.5)
            {
                float3 lightForward = BurtGISceneVoxelLightingSafeNormalize(
                    _BurtGIAdditionalLightDirectionAndSpot[lightIndex].xyz,
                    float3(0.0, 0.0, 1.0));
                float4 spotParams = _BurtGIAdditionalLightSpotParams[lightIndex];
                attenuation *= BurtGISceneVoxelSpotAngleAttenuation(-lightDirection, lightForward, spotParams.y, spotParams.z);
            }
        }

        float lightVisibility = 1.0;
        if (_BurtGISceneVoxelRadianceCacheParams.w > 0.5 && lightType >= 0.5)
        {
            float normalBias = min(max(_BurtGISceneVoxelCenterExtent.w / 64.0, 0.01), 1.0);
            lightVisibility = BurtGITraceSceneVoxelDirectionalVisibility(
                worldPosition + normalWS * normalBias,
                lightDirection,
                max(lightTraceDistance, 1.0));
        }

        lighting += max(colorAndType.rgb, 0.0) * (saturate(dot(normalWS, lightDirection)) * attenuation * lightVisibility);
    }

    return lighting;
}

uint BurtGISceneVoxelResolveXGILightGridLevel(float3 worldPosition)
{
    [unroll]
    for (uint level = 0u; level < 6u; ++level)
    {
        if (all(worldPosition >= _BurtGIXGILightGridBoundMin[level].xyz) && all(worldPosition <= _BurtGIXGILightGridBoundMax[level].xyz))
        {
            return level + 1u;
        }
    }

    return 0u;
}

uint BurtGISceneVoxelResolveXGILightGridCell(float3 worldPosition, uint level)
{
    uint resolution = max(1u, _BurtGIXGILightGridResolution);
    float3 boundMin = _BurtGIXGILightGridBoundMin[level].xyz;
    float3 boundSize = max(_BurtGIXGILightGridBoundMax[level].xyz - boundMin, 0.0001);
    float3 normalizedPosition = saturate((worldPosition - boundMin) / boundSize);
    uint axis = min((uint)max(_BurtGIXGILightGridAxis[level].x, 0.0), 2u);
    uint2 coord = axis == 0u
        ? min((uint2)floor(normalizedPosition.yz * resolution), resolution - 1u)
        : axis == 1u
            ? min((uint2)floor(normalizedPosition.xz * resolution), resolution - 1u)
            : min((uint2)floor(normalizedPosition.xy * resolution), resolution - 1u);
    return level * resolution * resolution + coord.x + coord.y * resolution;
}

float3 BurtGISceneVoxelEvaluateXGILightGrid(float3 worldPosition, float3 normalWS)
{
    float3 lighting = 0.0;
    lighting += BurtGISceneVoxelEvaluateAdditionalLights(worldPosition, normalWS);
    if (_BurtGIXGILightGridValid == 0u)
    {
        return lighting;
    }

    uint levelPlusOne = BurtGISceneVoxelResolveXGILightGridLevel(worldPosition);
    if (levelPlusOne == 0u)
    {
        return lighting;
    }

    uint level = levelPlusOne - 1u;
    uint cellIndex = BurtGISceneVoxelResolveXGILightGridCell(worldPosition, level);
    uint lightCount = min(_BurtGIXGILightGridCount[cellIndex], _BurtGIXGILightGridMaxLights);
    lighting = 0.0;
    [loop]
    for (uint listIndex = 0u; listIndex < lightCount; ++listIndex)
    {
        uint lightIndex = 0u;
        uint lightDataIndex = 0u;
        float4 positionAndRange = 0.0;
        float4 colorAndType = 0.0;
        float4 directionAndSpot = 0.0;
        float4 spotParams = 0.0;
        lightIndex = _BurtGIXGILightGridList[cellIndex * _BurtGIXGILightGridMaxLights + listIndex];
        lightDataIndex = lightIndex * 4u;
        positionAndRange = _BurtGIXGILightData[lightDataIndex];
        colorAndType = _BurtGIXGILightData[lightDataIndex + 1u];
        directionAndSpot = _BurtGIXGILightData[lightDataIndex + 2u];
        spotParams = _BurtGIXGILightData[lightDataIndex + 3u];
        float3 lightDirection = directionAndSpot.xyz;
        float attenuation = 1.0;
        float lightTraceDistance = 0.0;

        if (colorAndType.w >= 0.5)
        {
            float3 toLight = positionAndRange.xyz - worldPosition;
            float distanceToLight = length(toLight);
            float lightRange = max(positionAndRange.w, 0.001);
            if (distanceToLight >= lightRange)
            {
                continue;
            }

            lightDirection = toLight / max(distanceToLight, 0.0001);
            lightTraceDistance = distanceToLight;
            float distanceSqr = max(distanceToLight * distanceToLight, 0.0001);
            attenuation = BurtGISceneVoxelSmoothDistanceAttenuation(distanceSqr, lightRange);
            if (colorAndType.w > 1.5)
            {
                float3 spotForward = BurtGISceneVoxelLightingSafeNormalize(directionAndSpot.xyz, float3(0.0, 0.0, 1.0));
                attenuation *= BurtGISceneVoxelSpotAngleAttenuation(-lightDirection, spotForward, spotParams.y, spotParams.z);
            }
        }

        float lightDirectionLengthSq = dot(lightDirection, lightDirection);
        lightDirection = lightDirectionLengthSq > 0.0001 ? lightDirection * rsqrt(lightDirectionLengthSq) : float3(0.0, 1.0, 0.0);
        float lightVisibility = 1.0;
        if (_BurtGISceneVoxelRadianceCacheParams.w > 0.5 && colorAndType.w >= 0.5)
        {
            float normalBias = min(max(_BurtGISceneVoxelCenterExtent.w / 64.0, 0.01), 1.0);
            lightVisibility = BurtGITraceSceneVoxelDirectionalVisibility(
                worldPosition + normalWS * normalBias,
                lightDirection,
                max(lightTraceDistance, 1.0));
        }

        lighting += max(colorAndType.rgb, 0.0) * (saturate(dot(normalWS, lightDirection)) * attenuation * lightVisibility);
    }

    return lighting;
}

void BurtGISceneVoxelBuildLighting(uint3 dispatchThreadId)
{
    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelLightingTexture.GetDimensions(width, height, depth);
    if (dispatchThreadId.x >= width || dispatchThreadId.y >= height || dispatchThreadId.z >= depth)
    {
        return;
    }

    float4 radiance = _BurtGISceneVoxelRadianceReadTexture.Load(int4((int)dispatchThreadId.x, (int)dispatchThreadId.y, (int)dispatchThreadId.z, 0));
    float4 geometry = _BurtGISceneVoxelGeometryReadTexture.Load(int4((int)dispatchThreadId.x, (int)dispatchThreadId.y, (int)dispatchThreadId.z, 0));
    float occupancy = saturate(geometry.a);
    if (occupancy <= 0.001 || radiance.a <= 0.001)
    {
        _BurtGISceneVoxelLightingTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
        return;
    }

    float3 normalWS = geometry.rgb * 2.0 - 1.0;
    float normalLengthSq = dot(normalWS, normalWS);
    normalWS = normalLengthSq > 0.0001 ? normalWS * rsqrt(normalLengthSq) : float3(0.0, 1.0, 0.0);

    uint mipWidth = 1u;
    uint mipHeight = 1u;
    uint mipDepth = 1u;
    _BurtGISceneVoxelOccupancyMipReadTexture.GetDimensions(mipWidth, mipHeight, mipDepth);
    uint3 mipSize = max(uint3(mipWidth, mipHeight, mipDepth), uint3(1u, 1u, 1u));
    uint3 fullSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    uint3 mipCoord = min((dispatchThreadId * mipSize) / fullSize, mipSize - 1u);
    float coarseOccupancy = saturate(_BurtGISceneVoxelOccupancyMipReadTexture.Load(int4((int)mipCoord.x, (int)mipCoord.y, (int)mipCoord.z, 0)).x);

    float hemi = saturate(normalWS.y * 0.5 + 0.5);
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float traceDistance = max(centerExtent.w * 1.25, 1.0);
    float3 worldPosition = centerExtent.xyz + (((float3(dispatchThreadId) + 0.5) / (float3)fullSize) - 0.5) * (centerExtent.w * 2.0);
    float sceneVoxelLightingType = _BurtGISceneVoxelRadianceCacheParams.y;
    float skyVisibilityTrace = BurtGITraceSceneVoxelDirectionalVisibility(worldPosition, normalWS, traceDistance);
    float skyVisibility = lerp(1.0, skyVisibilityTrace, saturate(_BurtGISceneVoxelIndirectLightTint.w));
    float skyLightEnabled = _BurtGISceneVoxelDirectLightTint.w > 0.5 ? 1.0 : 0.0;
    float3 analyticSkyTint = lerp(float3(0.015, 0.018, 0.022), float3(0.08, 0.095, 0.12), hemi);
    float3 ambientSkyTint = BurtGISceneVoxelEvaluateAmbientSH(normalWS);
    float3 skyTint = max(ambientSkyTint, analyticSkyTint) * skyVisibility * skyLightEnabled;
    float normalBoost = lerp(0.75, 1.2, saturate(dot(normalWS, normalize(float3(0.35, 0.75, 0.45))) * 0.5 + 0.5));
    float3 mainLightDirection = _BurtGIMainLightDirection.xyz;
    float mainLightDirectionLengthSq = dot(mainLightDirection, mainLightDirection);
    mainLightDirection = mainLightDirectionLengthSq > 0.0001 ? mainLightDirection * rsqrt(mainLightDirectionLengthSq) : float3(0.0, 1.0, 0.0);
    float mainLightNdotL = saturate(dot(normalWS, mainLightDirection));
    float mainLightVisibility = _BurtGISceneVoxelRadianceCacheParams.z > 0.5
        ? BurtGITraceSceneVoxelDirectionalVisibility(worldPosition, mainLightDirection, traceDistance)
        : 1.0;
    float3 mainLightRadiance = max(_BurtGIMainLightColor.rgb, 0.0) * (mainLightNdotL * mainLightVisibility);
    float3 additionalLightRadiance = sceneVoxelLightingType >= 1.5
        ? BurtGISceneVoxelEvaluateXGILightGrid(worldPosition, normalWS)
        : 0.0;
    float oneOverPreExposure = max(_BurtGISceneVoxelExposureParams.x, 0.0);
    float3 directLighting = (normalBoost.xxx + mainLightRadiance + additionalLightRadiance) *
        (max(_BurtGISceneVoxelDirectLightTint.rgb, 0.0) * max(_BurtGISceneVoxelLightingParams.z, 0.0) * oneOverPreExposure);
    const float xgiSecondaryBounceSkyScale = 0.2;
    float3 boostedDiffuseColor = BurtGISceneVoxelRecoverBoostedDiffuseColor(radiance.rgb);
    float3 indirectLighting = skyTint * boostedDiffuseColor * (max(_BurtGISceneVoxelIndirectLightTint.rgb, 0.0) * max(_BurtGISceneVoxelLightingParams.w, 0.0) * xgiSecondaryBounceSkyScale);
    float3 radianceCacheIrradiance = 0.0;
    if (_BurtGISceneVoxelRadianceCacheParams.x > 0.5 &&
        BurtGISceneVoxelSampleRadianceCacheIrradiance(worldPosition, normalWS, radianceCacheIrradiance))
    {
        indirectLighting = radianceCacheIrradiance * boostedDiffuseColor *
            (max(_BurtGISceneVoxelIndirectLightTint.rgb, 0.0) * max(_BurtGISceneVoxelLightingParams.w, 0.0));
    }
    float3 lighting = max(radiance.rgb, 0.0) * directLighting + indirectLighting * radiance.a;

    float grey = dot(lighting, float3(0.299, 0.587, 0.114));
    float3 adjustedLighting = lerp(grey.xxx, lighting, saturate(_BurtGISceneVoxelLightingParams.y));
    lighting = lighting.g > (lighting.b + lighting.r) * 0.6 ? adjustedLighting : lighting;

    float luminance = dot(lighting, float3(0.2126, 0.7152, 0.0722));
    lighting = lerp(lighting, luminance.xxx, saturate(coarseOccupancy * 0.18));
    lighting = max(lighting, 0.0);
    _BurtGISceneVoxelLightingTexture[dispatchThreadId] = float4(lighting, saturate(radiance.a * occupancy));
}

[numthreads(BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE)]
void SceneVoxelBuildLightingLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGISceneVoxelBuildLighting(dispatchThreadId);
}

[numthreads(BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE)]
void SceneRepresentLightingVoxelCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGISceneVoxelBuildLighting(dispatchThreadId);
}

[numthreads(BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE)]
void LightingDirect(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGISceneVoxelBuildLighting(dispatchThreadId);
}

[numthreads(BURT_GI_XGI_PROBE_TRACE_THREADGROUP_SIZE, BURT_GI_XGI_PROBE_TRACE_THREADGROUP_SIZE, 1)]
void ProbeTraceRadiance(
    uint groupIndex : SV_GroupIndex,
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint threadGroupNumX = max(VoxelProbeArgsBufferParams[BURT_GI_XGI_PROBE_ALLOCATOR_OFFSET + 1u], 1u);
    uint probeThreadIndex = groupId.x + groupId.y * threadGroupNumX;
    uint probeCount = VoxelProbeArgsBufferParams[BURT_GI_XGI_PROBE_ALLOCATOR_OFFSET];
    if (probeThreadIndex >= probeCount)
    {
        return;
    }

    uint clipmapIndex = min(BurtGIVoxelProbeClipmapFromArgs(probeThreadIndex), max((uint)max(VoxelApplyClipmapCount, 1), 1u) - 1u);
    uint clipmapProbeBaseIndex = VoxelProbeArgsBufferParams[clipmapIndex];
    uint localProbeIndex = probeThreadIndex - min(clipmapProbeBaseIndex, probeThreadIndex);
    uint indexOffsetClipmap = max((uint)max(VoxelProbeIndexOffsetClipmap, 1), 1u);
    uint probeIndexBufferIndex = localProbeIndex + BURT_GI_XGI_PROBE_ALLOCATOR_OFFSET + clipmapIndex * indexOffsetClipmap;
    uint probeNodeIndexFlat = VoxelProbeIndexBuffer[probeIndexBufferIndex];

    uint voxelVolumeSize = max((uint)max(VoxelApplyVolumeSize, 1), max(_XGISceneRepresentUpdateVoxel_ClipMapResolution, 1u));
    uint probeNodeSize = BurtGIVoxelProbeNodeSize(voxelVolumeSize);
    uint3 probeNodeIndex3D = BurtGIVoxelProbeFlat2NodeIndex(probeNodeIndexFlat, probeNodeSize, 1u);
    if (any(probeNodeIndex3D >= probeNodeSize))
    {
        return;
    }

    uint3 probeNodeIndex3DWithClipmap = BurtGIVoxelNodeIndexWithClipmap(probeNodeIndex3D, probeNodeSize, clipmapIndex);
    uint4 probeInfo = VoxelProbePageTable[probeNodeIndex3DWithClipmap];
    if (probeInfo.w == BURT_GI_XGI_PROBE_PAGE_INVALID)
    {
        return;
    }

    uint groupThreadIndexFlat = groupThreadId.y * BURT_GI_XGI_PROBE_TRACE_THREADGROUP_SIZE + groupThreadId.x;
    float3 childOffset01 = ((float3)min(probeInfo.xyz, uint3(3u, 3u, 3u)) + 0.5) * 0.25;
    float3 probePosition01 = ((float3)probeNodeIndex3D + childOffset01) / max((float)probeNodeSize, 1.0);
    float4 centerExtent = BurtGIProbeClipmapCenterExtent(clipmapIndex);
    float3 worldPosition = centerExtent.xyz + (probePosition01 - 0.5) * (centerExtent.w * 2.0);
    float2 traceUV = ((float2)groupThreadId.xy + 0.5) / (float)BURT_GI_XGI_PROBE_TRACE_THREADGROUP_SIZE;
    float3 rayDirectionWS = BurtGISceneVoxelEquiAreaSphericalMapping(traceUV);
    float3 tracedRadiance = 0.0;
    float maxTraceDistance = max(centerExtent.w * 2.0, 1.0);
    bool tracedSceneVoxel = BurtGITraceSceneVoxelLighting(worldPosition, rayDirectionWS, maxTraceDistance, tracedRadiance);
    float3 ambientIrradiance = max(BurtGISceneVoxelEvaluateAmbientSH(rayDirectionWS), float3(0.015, 0.018, 0.022));
    float3 directIrradiance = max(BurtGISceneVoxelEvaluateAdditionalLights(worldPosition, rayDirectionWS), 0.0);
    float3 fallbackRadiance = max(
        ambientIrradiance * max(_BurtGISceneVoxelIndirectLightTint.rgb, 0.0) +
        directIrradiance * max(_BurtGISceneVoxelDirectLightTint.rgb, 0.0),
        0.0);
    float3 radiance = tracedSceneVoxel ? max(tracedRadiance, 0.0) : fallbackRadiance;

    float SH[BURT_GI_XGI_PROBE_TRACE_SH_COEFFICIENT_COUNT];
    BurtGISceneVoxelEvaluateSHBasis3(rayDirectionWS, SH);
    BurtGISceneVoxelWriteProbeSH(groupThreadIndexFlat, probeNodeIndex3DWithClipmap, probeNodeSize, SH, radiance);
}
