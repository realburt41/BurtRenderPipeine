    out float4 compositeRadiance,
    out float compositeHit);

















bool BurtGIScreenProbeTraceCompactIsSkyDepth(float rawDepth)
{
#if defined(UNITY_REVERSED_Z)
    return rawDepth <= 0.00001f;
#else
    return rawDepth >= 0.99999f;
#endif
}
float3 BurtGIScreenProbeTraceSafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001 ? value * rsqrt(lengthSq) : fallback;
}
void BurtGIUnpackScreenProbeImportanceRayInfo(uint rayInfo, out uint2 texelCoord, out uint level)
{
    texelCoord.x = rayInfo & 0x3fu;
    texelCoord.y = (rayInfo >> 6) & 0x3fu;
    level = (rayInfo >> 12) & 0xfu;
}
void BurtGIUnpackScreenProbeAdaptiveProbeData(uint packedProbeData, out uint2 adaptiveFineProbeCoord, out uint adaptiveLevel)
{
    adaptiveFineProbeCoord.x = packedProbeData & 0x3fffu;
    adaptiveFineProbeCoord.y = (packedProbeData >> 14) & 0x3fffu;
    adaptiveLevel = (packedProbeData >> 28) & 0xfu;
}
uint2 BurtGIAdaptiveFineProbeCoordToBaseCoord(uint2 adaptiveFineProbeCoord, uint adaptiveLevel, uint2 screenProbeGridSize)
{
    uint adaptiveSubGridSize = 1u << min(adaptiveLevel, 13u);
    return min(adaptiveFineProbeCoord / max(1u, adaptiveSubGridSize), screenProbeGridSize - 1u);
}
uint BurtGIGetScreenProbeUniformCount(uint screenProbeWidth, uint screenProbeHeight)
{
    return max(1u, screenProbeWidth * screenProbeHeight);
}
uint BurtGIGetScreenProbeAdaptiveCount(uint maxAdaptiveProbeCount)
{
    return min(_BurtGIScreenProbeAdaptiveProbeNumBuffer[0], maxAdaptiveProbeCount);
}
bool BurtGIResolveScreenProbeSourceAndAtlasCoord(
    uint screenProbeIndex,
    uint screenProbeWidth,
    uint screenProbeHeight,
    uint maxAdaptiveProbeCount,
    out uint2 sourceScreenProbeCoord,
    out uint2 atlasScreenProbeCoord)
{
    uint uniformProbeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight);
    atlasScreenProbeCoord = uint2(screenProbeIndex % screenProbeWidth, screenProbeIndex / screenProbeWidth);
    if (screenProbeIndex < uniformProbeCount)
    {
        sourceScreenProbeCoord = atlasScreenProbeCoord;
        return sourceScreenProbeCoord.y < screenProbeHeight;
    }

    uint adaptiveProbeIndex = screenProbeIndex - uniformProbeCount;
    if (adaptiveProbeIndex >= BurtGIGetScreenProbeAdaptiveCount(maxAdaptiveProbeCount))
    {
        sourceScreenProbeCoord = uint2(0u, 0u);
        return false;
    }

    uint adaptiveLevel;
    uint2 adaptiveFineProbeCoord;
    BurtGIUnpackScreenProbeAdaptiveProbeData(
        _BurtGIScreenProbeAdaptiveProbeDataBuffer[adaptiveProbeIndex],
        adaptiveFineProbeCoord,
        adaptiveLevel);
    sourceScreenProbeCoord = BurtGIAdaptiveFineProbeCoordToBaseCoord(
        adaptiveFineProbeCoord,
        adaptiveLevel,
        uint2(screenProbeWidth, screenProbeHeight));
    return sourceScreenProbeCoord.x < screenProbeWidth && sourceScreenProbeCoord.y < screenProbeHeight;
}
float3 BurtGIEquiAreaSphericalMapping(float2 uv)
{
    uv = 2.0 * uv - 1.0;
    float d = 1.0 - (abs(uv.x) + abs(uv.y));
    float r = 1.0 - abs(d);
    float phi = r == 0.0 ? 0.0 : 0.7853981633974483 * ((abs(uv.y) - abs(uv.x)) / r + 1.0);
    float f = r * sqrt(max(2.0 - r * r, 0.0));
    return BurtGIScreenProbeTraceSafeNormalize(float3(
        f * sign(uv.y) * abs(sin(phi)),
        sign(d) * (1.0 - r * r),
        f * sign(uv.x) * abs(cos(phi))),
        float3(0.0f, 1.0f, 0.0f));
}
uint2 BurtGIOctahedralMapWrapBorder(uint2 texelCoord, uint resolution, uint borderSize)
{
    if (texelCoord.x < borderSize)
    {
        texelCoord.x = borderSize - 1u + borderSize - texelCoord.x;
        texelCoord.y = resolution - 1u - texelCoord.y;
    }

    if (texelCoord.x >= resolution - borderSize)
    {
        texelCoord.x = (resolution - borderSize) - (texelCoord.x - (resolution - borderSize - 1u));
        texelCoord.y = resolution - 1u - texelCoord.y;
    }

    if (texelCoord.y < borderSize)
    {
        texelCoord.y = borderSize - 1u + borderSize - texelCoord.y;
        texelCoord.x = resolution - 1u - texelCoord.x;
    }

    if (texelCoord.y >= resolution - borderSize)
    {
        texelCoord.y = (resolution - borderSize) - (texelCoord.y - (resolution - borderSize - 1u));
        texelCoord.x = resolution - 1u - texelCoord.x;
    }

    return texelCoord - borderSize;
}
float4 BurtGISHBasis3V0(float3 direction)
{
    return float4(
        0.28209479,
        -0.48860251 * direction.y,
        0.48860251 * direction.z,
        -0.48860251 * direction.x);
}
float4 BurtGISHBasis3V1(float3 direction)
{
    return float4(
        1.09254843 * direction.x * direction.y,
        -1.09254843 * direction.y * direction.z,
        0.31539157 * (3.0 * direction.z * direction.z - 1.0),
        -1.09254843 * direction.x * direction.z);
}
float BurtGISHBasis3V2(float3 direction)
{
    return 0.54627422 * (direction.x * direction.x - direction.y * direction.y);
}
bool BurtGIScreenProbeHasValidPlacement(uint2 screenProbeCoord)
{
    float rawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(screenProbeCoord, 0));
    float4 encodedNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(screenProbeCoord, 0));
    float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(screenProbeCoord, 0));
    return encodedNormal.a > 0.5f &&
        encodedPosition.a > 0.5f &&
        !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth);
}
uint BurtGIRadianceCacheHashGridHash(uint3 value)
{
    uint h = value.x * 0x8da6b343u;
    h ^= value.y * 0xd8163841u;
    h ^= value.z * 0xcb1ab31fu;
    h ^= h >> 16;
    h *= 0x7feb352du;
    h ^= h >> 15;
    h *= 0x846ca68bu;
    h ^= h >> 16;
    return h;
}
float BurtGIScreenProbeInterleavedGradientNoise(uint2 coord, uint temporalIndex)
{
    uint hash = BurtGIRadianceCacheHashGridHash(uint3(coord.x, coord.y, temporalIndex));
    return (float)(hash & 0x00ffffffu) * (1.0 / 16777216.0);
}
float2 BurtGIScreenProbeBlueNoiseVec2(uint2 coord, uint temporalIndex)
{
    return float2(
        BurtGIScreenProbeInterleavedGradientNoise(coord, temporalIndex),
        BurtGIScreenProbeInterleavedGradientNoise(coord ^ uint2(0x9e37u, 0x7f4au), temporalIndex + 17u));
}
[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_SH3_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_SH3_THREADGROUP_SIZE, 1)]
void ScreenProbeIrradianceSH3CS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint2 shAtlasSize;
    _BurtGIScreenProbeRadianceSHAmbientTexture.GetDimensions(shAtlasSize.x, shAtlasSize.y);
    uint2 atlasScreenProbeCoord = dispatchThreadId.xy;
    if (atlasScreenProbeCoord.x >= shAtlasSize.x || atlasScreenProbeCoord.y >= shAtlasSize.y)
    {
        return;
    }

    uint screenProbeIndex = atlasScreenProbeCoord.y * screenProbeWidth + atlasScreenProbeCoord.x;
    uint2 sourceScreenProbeCoord;
    uint2 resolvedAtlasScreenProbeCoord;
    bool validProbe = BurtGIResolveScreenProbeSourceAndAtlasCoord(
        screenProbeIndex,
        screenProbeWidth,
        screenProbeHeight,
        maxAdaptiveProbeCount,
        sourceScreenProbeCoord,
        resolvedAtlasScreenProbeCoord);
    if (!validProbe || !BurtGIScreenProbeHasValidPlacement(sourceScreenProbeCoord))
    {
        _BurtGIScreenProbeRadianceSHAmbientTexture[atlasScreenProbeCoord] = float4(0.0, 0.0, 0.0, 0.0);

        [unroll]
        for (uint clearTileIndex = 0u; clearTileIndex < 6u; ++clearTileIndex)
        {
            _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(atlasScreenProbeCoord.x + clearTileIndex * screenProbeWidth, atlasScreenProbeCoord.y)] =
                float4(0.0, 0.0, 0.0, 0.0);
        }

        return;
    }

    float3 sh0 = 0.0;
    float3 sh1 = 0.0;
    float3 sh2 = 0.0;
    float3 sh3 = 0.0;
    float3 sh4 = 0.0;
    float3 sh5 = 0.0;
    float3 sh6 = 0.0;
    float3 sh7 = 0.0;
    float3 sh8 = 0.0;
    float sampleCount = 0.0;
    // SH3 integrates XRender's complete fixed-direction gather atlas (8x8).
    // The 6x6 constant is the output irradiance-oct resolution.
    uint gatherResolution = BURT_GI_SCREEN_PROBE_RADIANCE_OCT_RESOLUTION;

    [loop]
    for (uint y = 0u; y < gatherResolution; ++y)
    {
        [loop]
        for (uint x = 0u; x < gatherResolution; ++x)
        {
            uint2 gatherTexelCoord = uint2(x, y);
            float2 octUV = (float2(gatherTexelCoord) + 0.5) / (float)gatherResolution;
            float3 direction = BurtGIEquiAreaSphericalMapping(octUV).zxy;
            float4 traceRadiance;
            float hit;
            BurtGISampleScreenProbeTraceAtlasComposite(
                atlasScreenProbeCoord,
                octUV,
                traceResolution,
                gatherResolution,
                traceRadiance,
                hit);
            float3 radiance = max(traceRadiance.rgb, 0.0);
            float4 basis0 = BurtGISHBasis3V0(direction);
            float4 basis1 = BurtGISHBasis3V1(direction);
            float basis2 = BurtGISHBasis3V2(direction);

            sh0 += radiance * basis0.x;
            sh1 += radiance * basis0.y;
            sh2 += radiance * basis0.z;
            sh3 += radiance * basis0.w;
            sh4 += radiance * basis1.x;
            sh5 += radiance * basis1.y;
            sh6 += radiance * basis1.z;
            sh7 += radiance * basis1.w;
            sh8 += radiance * basis2;
            sampleCount += 1.0;
        }
    }

    float normalizeWeight = rcp(max(sampleCount, 1.0));
    float3 traceAmbient = sh0 * normalizeWeight;
    // Match XRender: SH3 is built exclusively from the filtered directional
    // radiance atlas.  A ray that misses geometry can still contain valid sky
    // radiance, so hit confidence must not replace it with a low-resolution
    // per-probe fallback (which exposes the probe tiles in the final image).
    _BurtGIScreenProbeRadianceSHAmbientTexture[atlasScreenProbeCoord] = float4(traceAmbient, 1.0);

    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(atlasScreenProbeCoord.x + 0u * screenProbeWidth, atlasScreenProbeCoord.y)] =
        float4(sh1.r, sh2.r, sh3.r, sh4.r) * normalizeWeight;
    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(atlasScreenProbeCoord.x + 1u * screenProbeWidth, atlasScreenProbeCoord.y)] =
        float4(sh5.r, sh6.r, sh7.r, sh8.r) * normalizeWeight;
    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(atlasScreenProbeCoord.x + 2u * screenProbeWidth, atlasScreenProbeCoord.y)] =
        float4(sh1.g, sh2.g, sh3.g, sh4.g) * normalizeWeight;
    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(atlasScreenProbeCoord.x + 3u * screenProbeWidth, atlasScreenProbeCoord.y)] =
        float4(sh5.g, sh6.g, sh7.g, sh8.g) * normalizeWeight;
    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(atlasScreenProbeCoord.x + 4u * screenProbeWidth, atlasScreenProbeCoord.y)] =
        float4(sh1.b, sh2.b, sh3.b, sh4.b) * normalizeWeight;
    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(atlasScreenProbeCoord.x + 5u * screenProbeWidth, atlasScreenProbeCoord.y)] =
        float4(sh5.b, sh6.b, sh7.b, sh8.b) * normalizeWeight;
}
void BurtGISampleScreenProbeTraceAtlasComposite(
    uint2 atlasScreenProbeCoord,
    float2 gatherUV,
    uint traceResolution,
    uint gatherResolution,
    out float4 compositeRadiance,
    out float compositeHit)
{
    gatherResolution = max(1u, gatherResolution);
    traceResolution = max(1u, traceResolution);
    uint2 gatherTexelCoord = min((uint2)floor(saturate(gatherUV) * (float)gatherResolution), gatherResolution - 1u);
    uint2 fixedDirectionTexel = min(gatherTexelCoord * traceResolution / gatherResolution, traceResolution - 1u);
    uint2 traceAtlasCoord = atlasScreenProbeCoord * traceResolution + fixedDirectionTexel;
    compositeRadiance = _BurtGIScreenProbeTraceRadianceTexture[traceAtlasCoord];
    compositeHit = saturate(_BurtGIScreenProbeTraceHitTexture[traceAtlasCoord]);
    compositeRadiance = float4(max(compositeRadiance.rgb, 0.0f), compositeHit);
}
