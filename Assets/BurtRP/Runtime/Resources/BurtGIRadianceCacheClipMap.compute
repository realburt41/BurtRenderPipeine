uint BurtGIDivRoundUp(uint value, uint divisor)
{
    return divisor == 0u ? 0u : (value + divisor - 1u) / divisor;
}

uint BurtGIMulClamp(uint a, uint b)
{
    uint result = a * b;
    return b != 0u && result / b != a ? 0xffffffffu : result;
}

uint BurtGIPackTraceTileInfo(uint tileX, uint tileY, uint level)
{
    return (tileX & 0xffu) | ((tileY & 0xffu) << 8) | ((level & 0xffu) << 16);
}

void BurtGIUnpackTraceTileInfo(uint2 packedTraceTile, out uint2 tileCoord, out uint tileLevel, out uint probeTraceIndex)
{
    tileCoord = uint2(packedTraceTile.x & 0xffu, (packedTraceTile.x >> 8) & 0xffu);
    tileLevel = (packedTraceTile.x >> 16) & 0xffu;
    probeTraceIndex = packedTraceTile.y;
}

uint BurtGIClipmapCount()
{
    return max(1u, min((uint)_BurtGIRadianceCacheClipMapParams.z, (uint)BURT_GI_CLIPMAP_COUNT));
}

uint BurtGIClipmapResolution()
{
    return max(1u, (uint)_BurtGIRadianceCacheClipMapParams.w);
}

uint2 BurtGIIndirectionSize()
{
    return max(uint2(1u, 1u), (uint2)_BurtGIRadianceCacheClipMapIndirectionSize.xy);
}

uint2 BurtGIScreenProbeGridSize()
{
    return max(uint2(1u, 1u), (uint2)_BurtGIScreenProbeGridParams.xy);
}

uint2 BurtGIPackIndirectionCoord(uint clipmapIndex, uint3 probeCoord)
{
    uint clipmapResolution = BurtGIClipmapResolution();
    return uint2(clipmapIndex * clipmapResolution + probeCoord.x, probeCoord.y + probeCoord.z * clipmapResolution);
}

bool BurtGIDecodeIndirectionCoord(uint2 indirectionCoord, out uint clipmapIndex, out uint3 probeCoord)
{
    uint clipmapResolution = BurtGIClipmapResolution();
    clipmapIndex = indirectionCoord.x / clipmapResolution;
    probeCoord = uint3(indirectionCoord.x - clipmapIndex * clipmapResolution, indirectionCoord.y % clipmapResolution, indirectionCoord.y / clipmapResolution);
    return clipmapIndex < BurtGIClipmapCount() &&
        probeCoord.x < clipmapResolution &&
        probeCoord.y < clipmapResolution &&
        probeCoord.z < clipmapResolution;
}

bool BurtGIWorldPositionToProbeCoordFloatDithered(float3 worldPosition, float clipmapDitherRandom, out uint clipmapIndex, out float3 probeCoordFloat)
{
    uint clipmapCount = BurtGIClipmapCount();
    uint clipmapResolution = BurtGIClipmapResolution();
    float invFadeSize = max(_BurtGIRadianceCacheClipMapWorldParams.z, 0.0001);

    [unroll]
    for (uint currentClipmapIndex = 0u; currentClipmapIndex < BURT_GI_CLIPMAP_COUNT; ++currentClipmapIndex)
    {
        if (currentClipmapIndex < clipmapCount)
        {
            float4 worldToProbeCoord = _BurtGIRadianceCacheClipMapWorldPositionToProbeCoord[currentClipmapIndex];
            float3 currentProbeCoordFloat = worldPosition * worldToProbeCoord.w + worldToProbeCoord.xyz;
            float3 bottomEdgeFade = saturate((currentProbeCoordFloat - 0.5) * invFadeSize);
            float3 topEdgeFade = saturate(((float3)clipmapResolution - 0.5 - currentProbeCoordFloat) * invFadeSize);
            float edgeFade = min(
                min(bottomEdgeFade.x, min(bottomEdgeFade.y, bottomEdgeFade.z)),
                min(topEdgeFade.x, min(topEdgeFade.y, topEdgeFade.z)));

            if (edgeFade > clipmapDitherRandom)
            {
                clipmapIndex = currentClipmapIndex;
                probeCoordFloat = currentProbeCoordFloat;
                return true;
            }
        }
    }

    clipmapIndex = 0u;
    probeCoordFloat = 0.0;
    return false;
}

bool BurtGIWorldPositionToProbeCoordDithered(float3 worldPosition, float clipmapDitherRandom, out uint clipmapIndex, out uint3 probeCoord)
{
    float3 probeCoordFloat;
    if (BurtGIWorldPositionToProbeCoordFloatDithered(worldPosition, clipmapDitherRandom, clipmapIndex, probeCoordFloat))
    {
        int3 signedProbeCoord = (int3)floor(probeCoordFloat);
        probeCoord = (uint3)signedProbeCoord;
        return true;
    }

    clipmapIndex = 0u;
    probeCoord = uint3(0u, 0u, 0u);
    return false;
}

bool BurtGIWorldPositionToProbeCoord(float3 worldPosition, out uint clipmapIndex, out uint3 probeCoord)
{
    return BurtGIWorldPositionToProbeCoordDithered(worldPosition, 0.01, clipmapIndex, probeCoord);
}

bool BurtGIWorldPositionToProbeCoordInClipmap(float3 worldPosition, uint clipmapIndex, out uint3 probeCoord)
{
    uint clipmapResolution = BurtGIClipmapResolution();
    if (clipmapIndex >= BurtGIClipmapCount())
    {
        probeCoord = uint3(0u, 0u, 0u);
        return false;
    }

    float4 worldToProbeCoord = _BurtGIRadianceCacheClipMapWorldPositionToProbeCoord[clipmapIndex];
    int3 signedProbeCoord = (int3)floor(worldPosition * worldToProbeCoord.w + worldToProbeCoord.xyz);
    if (signedProbeCoord.x >= 0 &&
        signedProbeCoord.y >= 0 &&
        signedProbeCoord.z >= 0 &&
        signedProbeCoord.x < (int)clipmapResolution &&
        signedProbeCoord.y < (int)clipmapResolution &&
        signedProbeCoord.z < (int)clipmapResolution)
    {
        probeCoord = (uint3)signedProbeCoord;
        return true;
    }

    probeCoord = uint3(0u, 0u, 0u);
    return false;
}

float3 BurtGIProbeCoordToWorldPosition(uint clipmapIndex, uint3 probeCoord)
{
    float4 probeCoordToWorld = _BurtGIRadianceCacheClipMapProbeCoordToWorldCenter[clipmapIndex];
    return probeCoordToWorld.xyz + (float3)probeCoord * probeCoordToWorld.w;
}

uint BurtGIProbeAtlasResolutionInProbes()
{
    return max(1u, (uint)_BurtGIRadianceCacheClipMapParams.x);
}

uint2 BurtGIProbeAtlasBaseCoord(uint probeIndex, uint probeResolution)
{
    uint atlasResolutionInProbes = BurtGIProbeAtlasResolutionInProbes();
    uint2 probeCoord = uint2(probeIndex % atlasResolutionInProbes, probeIndex / atlasResolutionInProbes);
    return probeCoord * probeResolution;
}

uint BurtGIGetProbeIndexFromTraceData(uint probeTraceIndex)
{
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapMaxProbeCount)
    {
        return 0u;
    }

    return asuint(_BurtGIRadianceCacheClipMapProbeTraceDataBuffer[probeTraceIndex].w) & 0x00ffffffu;
}

uint BurtGIGetClipmapIndexFromTraceData(uint probeTraceIndex)
{
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapMaxProbeCount)
    {
        return 0u;
    }

    return (asuint(_BurtGIRadianceCacheClipMapProbeTraceDataBuffer[probeTraceIndex].w) >> 24) & 0xffu;
}

void BurtGISelectNearestValidProbeDepth(
    uint2 rawBaseCoord,
    uint2 sampleCoord,
    inout float nearestDepth,
    inout uint2 nearestCoord)
{
    float sampleDepth = _BurtGIRadianceCacheClipMapDepthProbeAtlasReadTexture.Load(int3(rawBaseCoord + sampleCoord, 0));
    if (sampleDepth > 0.0001 && sampleDepth < nearestDepth)
    {
        nearestDepth = sampleDepth;
        nearestCoord = sampleCoord;
    }
}

float3 BurtGIGetProbeTraceWorldCenter(uint probeTraceIndex)
{
    float4 probeTraceData = _BurtGIRadianceCacheClipMapProbeTraceDataBuffer[probeTraceIndex];
    uint probeIndex = BurtGIGetProbeIndexFromTraceData(probeTraceIndex);
    float3 probeWorldOffset = probeIndex < _BurtGIRadianceCacheClipMapMaxProbeCount
        ? _BurtGIRadianceCacheClipMapProbeWorldOffsetBuffer[probeIndex].xyz
        : 0.0;
    return probeTraceData.xyz + probeWorldOffset;
}

uint BurtGIGetProbeIndexFromIndirectionCoord(int3 probeCoord, uint clipmapIndex)
{
    int clipmapResolution = (int)BurtGIClipmapResolution();
    if (clipmapIndex >= BurtGIClipmapCount() ||
        probeCoord.x < 0 ||
        probeCoord.y < 0 ||
        probeCoord.z < 0 ||
        probeCoord.x >= clipmapResolution ||
        probeCoord.y >= clipmapResolution ||
        probeCoord.z >= clipmapResolution)
    {
        return BURT_GI_INVALID_PROBE_INDEX;
    }

    uint2 indirectionCoord = BurtGIPackIndirectionCoord(clipmapIndex, (uint3)probeCoord);
    uint2 indirectionSize = BurtGIIndirectionSize();
    if (indirectionCoord.x >= indirectionSize.x || indirectionCoord.y >= indirectionSize.y)
    {
        return BURT_GI_INVALID_PROBE_INDEX;
    }

    uint probeIndex = _BurtGIRadianceCacheClipMapIndirectionTexture[indirectionCoord];
    return probeIndex < _BurtGIRadianceCacheClipMapMaxProbeCount ? probeIndex : BURT_GI_INVALID_PROBE_INDEX;
}

float3 BurtGIOctahedralDirectionFromUV(float2 octUV)
{
    float2 f = octUV * 2.0 - 1.0;
    float3 n = float3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0)
    {
        float2 signNotZero = float2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
        n.xy = (1.0 - abs(n.yx)) * signNotZero;
    }

    return normalize(n);
}

float3 BurtGIEquiAreaSphericalMapping(float2 uv)
{
    uv = 2.0 * uv - 1.0;
    float d = 1.0 - (abs(uv.x) + abs(uv.y));
    float r = 1.0 - abs(d);
    float phi = r == 0.0 ? 0.0 : 0.7853981633974483 * ((abs(uv.y) - abs(uv.x)) / r + 1.0);
    float f = r * sqrt(max(2.0 - r * r, 0.0));
    return normalize(float3(
        f * sign(uv.y) * abs(sin(phi)),
        sign(d) * (1.0 - r * r),
        f * sign(uv.x) * abs(cos(phi))));
}

float2 BurtGIInverseEquiAreaSphericalMapping(float3 direction)
{
    direction = normalize(float3(direction.z, direction.x, direction.y));
    float3 absDirection = abs(direction);
    float r = sqrt(max(1.0 - absDirection.z, 0.0));
    float x = min(absDirection.x, absDirection.y) / (max(absDirection.x, absDirection.y) + 1e-8);
    const float t1 = 0.406758566246788489601959989e-5;
    const float t2 = 0.636226545274016134946890922156;
    const float t3 = 0.61572017898280213493197203466e-2;
    const float t4 = -0.247333733281268944196501420480;
    const float t5 = 0.881770664775316294736387951347e-1;
    const float t6 = 0.419038818029165735901852432784e-1;
    const float t7 = -0.251390972343483509333252996350e-1;
    float phi = t6 + t7 * x;
    phi = t5 + phi * x;
    phi = t4 + phi * x;
    phi = t3 + phi * x;
    phi = t2 + phi * x;
    phi = t1 + phi * x;
    phi = absDirection.x < absDirection.y ? 1.0 - phi : phi;
    float2 uv = float2(r - phi * r, phi * r);
    uv = direction.z < 0.0 ? 1.0 - uv.yx : uv;
    uv.x = direction.x < 0.0 ? -uv.x : uv.x;
    uv.y = direction.y < 0.0 ? -uv.y : uv.y;
    return saturate(uv * 0.5 + 0.5);
}

float2 BurtGIOctahedralUVFromDirection(float3 direction)
{
    float3 n = normalize(direction);
    n /= max(abs(n.x) + abs(n.y) + abs(n.z), 0.0001);
    float2 oct = n.xy;
    if (n.z < 0.0)
    {
        float2 signNotZero = float2(oct.x >= 0.0 ? 1.0 : -1.0, oct.y >= 0.0 ? 1.0 : -1.0);
        oct = (1.0 - abs(oct.yx)) * signNotZero;
    }

    return saturate(oct * 0.5 + 0.5);
}

struct BurtGIThreeBandSHVector
{
    float4 V0;
    float4 V1;
    float V2;
};

BurtGIThreeBandSHVector BurtGISHBasisFunction3(float3 inputVector)
{
    const float kSHBasis0 = 0.2820947918;
    const float kSHBasis1 = 0.4886025119;
    const float kSHBasis2 = 1.0925484306;
    const float kSHBasis3 = 0.3153915653;
    const float kSHBasis4 = 0.5462742153;

    BurtGIThreeBandSHVector result;
    result.V0 = float4(
        kSHBasis0,
        -kSHBasis1 * inputVector.y,
        kSHBasis1 * inputVector.z,
        -kSHBasis1 * inputVector.x);

    float3 vectorSquared = inputVector * inputVector;
    result.V1 = float4(
        kSHBasis2 * inputVector.x * inputVector.y,
        -kSHBasis2 * inputVector.y * inputVector.z,
        kSHBasis3 * (3.0 * vectorSquared.z - 1.0),
        -kSHBasis2 * inputVector.x * inputVector.z);
    result.V2 = kSHBasis4 * (vectorSquared.x - vectorSquared.y);
    return result;
}

float BurtGIDotSH3(BurtGIThreeBandSHVector a, BurtGIThreeBandSHVector b)
{
    return dot(a.V0, b.V0) + dot(a.V1, b.V1) + a.V2 * b.V2;
}

int BurtGIEncodeProbePDFCoefficient(float value)
{
    return (int)clamp(round(value * BURT_GI_RADIANCE_PROBE_PDF_ENCODE_SCALE), -2147483000.0, 2147483000.0);
}

float BurtGIDecodeProbePDFCoefficient(int value)
{
    return (float)value / BURT_GI_RADIANCE_PROBE_PDF_ENCODE_SCALE;
}

uint BurtGIProbePDFBaseIndex(uint probeIndex)
{
    return probeIndex * max(BURT_GI_RADIANCE_PROBE_PDF_COEFFICIENT_COUNT, _BurtGIRadianceCacheClipMapRadianceProbePDFCoefficientCount);
}

float3 BurtGIDecodeScreenProbeNormalWS(float4 encodedNormal)
{
    return normalize(encodedNormal.xyz * 2.0 - 1.0);
}

bool BurtGIHasValidScreenProbePlacement(uint2 screenProbeCoord)
{
    float4 encodedNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    return encodedNormal.a > 0.5 && encodedPosition.a > 0.5;
}

uint BurtGIGetScreenProbeAdaptiveCount()
{
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    return min(_BurtGIScreenProbeAdaptiveProbeNumBuffer[0], maxAdaptiveProbeCount);
}

void BurtGIUnpackScreenProbeAdaptiveProbeData(uint packedProbeData, out uint2 adaptiveFineProbeCoord, out uint adaptiveLevel)
{
    adaptiveFineProbeCoord.x = packedProbeData & 0x3fffu;
    adaptiveFineProbeCoord.y = (packedProbeData >> 14) & 0x3fffu;
    adaptiveLevel = (packedProbeData >> 28) & 0xfu;
}

bool BurtGIResolveAdaptiveScreenProbeWorldPosition(uint adaptiveProbeIndex, out float3 worldPosition)
{
    worldPosition = 0.0;
    if (adaptiveProbeIndex >= BurtGIGetScreenProbeAdaptiveCount())
    {
        return false;
    }

    uint adaptiveLevel;
    uint2 adaptiveFineProbeCoord;
    BurtGIUnpackScreenProbeAdaptiveProbeData(
        _BurtGIScreenProbeAdaptiveProbeDataBuffer[adaptiveProbeIndex],
        adaptiveFineProbeCoord,
        adaptiveLevel);

    uint2 screenProbeGridSize = BurtGIScreenProbeGridSize();
    uint adaptiveSubGridSize = 1u << min(adaptiveLevel, 13u);
    uint2 baseProbeCoord = min(
        adaptiveFineProbeCoord / max(1u, adaptiveSubGridSize),
        screenProbeGridSize - 1u);
    uint2 adaptiveCellCoord = adaptiveFineProbeCoord - baseProbeCoord * adaptiveSubGridSize;
    float2 adaptiveCellUV = (float2(adaptiveCellCoord) + 0.5f) / (float)max(1u, adaptiveSubGridSize);
    float2 bilinearUV = saturate(adaptiveCellUV);
    float4 bilinearWeights = float4(
        (1.0 - bilinearUV.x) * (1.0 - bilinearUV.y),
        bilinearUV.x * (1.0 - bilinearUV.y),
        (1.0 - bilinearUV.x) * bilinearUV.y,
        bilinearUV.x * bilinearUV.y);

    uint2 rightProbeCoord = uint2(min(baseProbeCoord.x + 1u, screenProbeGridSize.x - 1u), baseProbeCoord.y);
    uint2 downProbeCoord = uint2(baseProbeCoord.x, min(baseProbeCoord.y + 1u, screenProbeGridSize.y - 1u));
    uint2 rightDownProbeCoord = uint2(rightProbeCoord.x, downProbeCoord.y);
    float4 position00 = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)baseProbeCoord.x, (int)baseProbeCoord.y, 0));
    float4 position10 = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)rightProbeCoord.x, (int)rightProbeCoord.y, 0));
    float4 position01 = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)downProbeCoord.x, (int)downProbeCoord.y, 0));
    float4 position11 = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)rightDownProbeCoord.x, (int)rightDownProbeCoord.y, 0));
    float4 validWeights = bilinearWeights * float4(
        position00.a > 0.5 ? 1.0 : 0.0,
        position10.a > 0.5 ? 1.0 : 0.0,
        position01.a > 0.5 ? 1.0 : 0.0,
        position11.a > 0.5 ? 1.0 : 0.0);
    float validWeightSum = dot(validWeights, float4(1.0, 1.0, 1.0, 1.0));
    if (validWeightSum <= 0.0001)
    {
        return false;
    }

    worldPosition =
        (position00.xyz * validWeights.x +
            position10.xyz * validWeights.y +
            position01.xyz * validWeights.z +
            position11.xyz * validWeights.w) / validWeightSum;
    return true;
}

float BurtGIRadianceCacheTransferPDFNeighborhoodWeight(
    uint2 sampleProbeCoord,
    float3 sourcePositionWS,
    float3 sourceNormalWS,
    out float3 sampleNormalWS)
{
    sampleNormalWS = sourceNormalWS;
    if (!BurtGIHasValidScreenProbePlacement(sampleProbeCoord))
    {
        return 0.0;
    }

    float4 encodedNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3((int)sampleProbeCoord.x, (int)sampleProbeCoord.y, 0));
    float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)sampleProbeCoord.x, (int)sampleProbeCoord.y, 0));
    sampleNormalWS = BurtGIDecodeScreenProbeNormalWS(encodedNormal);
    float3 samplePositionWS = encodedPosition.xyz;
    float sampleDistance = max(distance(sourcePositionWS, samplePositionWS), 0.05);
    float planeDistance = abs(dot(sourcePositionWS - samplePositionWS, sampleNormalWS));
    float relativePlaneDistance = planeDistance / sampleDistance;
    float planeWeight = exp2(-32.0 * relativePlaneDistance * relativePlaneDistance);
    float normalWeight = saturate(dot(sourceNormalWS, sampleNormalWS) * 0.5 + 0.5);
    return planeWeight * normalWeight;
}

float BurtGIRadianceCacheScreenProbeTransferPDF(uint probeIndex, float3 direction)
{
    uint2 screenProbeGridSize = BurtGIScreenProbeGridSize();
    uint2 screenProbeCoord = uint2(probeIndex % screenProbeGridSize.x, (probeIndex / screenProbeGridSize.x) % screenProbeGridSize.y);
    if (!BurtGIHasValidScreenProbePlacement(screenProbeCoord))
    {
        return saturate(direction.y * 0.5 + 0.5);
    }

    float3 sourceNormalWS = BurtGIDecodeScreenProbeNormalWS(_BurtGIScreenProbeWorldNormalTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0)));
    float3 sourcePositionWS = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0)).xyz;
    float transferPDF = 0.0;
    float transferWeightSum = 0.0;

    [unroll]
    for (int offsetY = -1; offsetY <= 1; ++offsetY)
    {
        [unroll]
        for (int offsetX = -1; offsetX <= 1; ++offsetX)
        {
            int2 sampleProbeCoordInt = clamp(
                (int2)screenProbeCoord + int2(offsetX, offsetY),
                int2(0, 0),
                int2((int)screenProbeGridSize.x - 1, (int)screenProbeGridSize.y - 1));
            uint2 sampleProbeCoord = (uint2)sampleProbeCoordInt;
            float3 sampleNormalWS;
            float sampleWeight = BurtGIRadianceCacheTransferPDFNeighborhoodWeight(
                sampleProbeCoord,
                sourcePositionWS,
                sourceNormalWS,
                sampleNormalWS);
            transferPDF += saturate(dot(sampleNormalWS, direction)) * sampleWeight;
            transferWeightSum += sampleWeight;
        }
    }

    float centerPDF = saturate(dot(sourceNormalWS, direction));
    return transferWeightSum > 0.0001 ? saturate(transferPDF / transferWeightSum) : centerPDF;
}

uint2 BurtGIWrapProbeTexelToRaw(uint2 finalProbeTexelCoord, uint finalProbeResolution, uint rawProbeResolution)
{
    rawProbeResolution = max(1u, rawProbeResolution);
    finalProbeResolution = max(rawProbeResolution, finalProbeResolution);
    uint borderSize = max(0u, (finalProbeResolution - rawProbeResolution) / 2u);

    if (borderSize == 0u)
    {
        return min(finalProbeTexelCoord, uint2(rawProbeResolution - 1u, rawProbeResolution - 1u));
    }

    uint2 wrappedCoord = min(finalProbeTexelCoord, uint2(finalProbeResolution - 1u, finalProbeResolution - 1u));
    if (wrappedCoord.x < borderSize)
    {
        wrappedCoord.x = borderSize - 1u + borderSize - wrappedCoord.x;
        wrappedCoord.y = finalProbeResolution - 1u - wrappedCoord.y;
    }
    if (wrappedCoord.x >= finalProbeResolution - borderSize)
    {
        wrappedCoord.x = (finalProbeResolution - borderSize) - (wrappedCoord.x - (finalProbeResolution - borderSize - 1u));
        wrappedCoord.y = finalProbeResolution - 1u - wrappedCoord.y;
    }
    if (wrappedCoord.y < borderSize)
    {
        wrappedCoord.y = borderSize - 1u + borderSize - wrappedCoord.y;
        wrappedCoord.x = finalProbeResolution - 1u - wrappedCoord.x;
    }
    if (wrappedCoord.y >= finalProbeResolution - borderSize)
    {
        wrappedCoord.y = (finalProbeResolution - borderSize) - (wrappedCoord.y - (finalProbeResolution - borderSize - 1u));
        wrappedCoord.x = finalProbeResolution - 1u - wrappedCoord.x;
    }

    return min(wrappedCoord - borderSize, uint2(rawProbeResolution - 1u, rawProbeResolution - 1u));
}

uint2 BurtGIWrapFinalProbeTexelToRaw(uint2 finalProbeTexelCoord)
{
    uint radianceProbeResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution);
    uint finalProbeResolution = max(radianceProbeResolution, _BurtGIRadianceCacheClipMapFinalProbeResolution);
    return BurtGIWrapProbeTexelToRaw(finalProbeTexelCoord, finalProbeResolution, radianceProbeResolution);
}

uint2 BurtGIWrapRawProbeTexel(int2 rawProbeTexelCoord)
{
    uint radianceProbeResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution);
    int2 wrappedCoord = rawProbeTexelCoord;

    if (wrappedCoord.x < 0)
    {
        wrappedCoord.x += (int)radianceProbeResolution;
    }
    else if (wrappedCoord.x >= (int)radianceProbeResolution)
    {
        wrappedCoord.x -= (int)radianceProbeResolution;
    }

    if (wrappedCoord.y < 0)
    {
        wrappedCoord.y += (int)radianceProbeResolution;
    }
    else if (wrappedCoord.y >= (int)radianceProbeResolution)
    {
        wrappedCoord.y -= (int)radianceProbeResolution;
    }

    return (uint2)wrappedCoord;
}

float3 BurtGISafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001 ? value * rsqrt(lengthSq) : fallback;
}

bool BurtGIRadianceCacheTrySampleSkyRadiance(float3 directionWS, float roughness, out float3 skyRadiance)
{
    skyRadiance = 0.0;
    if (_BurtSkyReflectionEnabled <= 0.5)
    {
        return false;
    }

    float3 safeDirectionWS = BurtGISafeNormalize(directionWS, float3(0.0, 1.0, 0.0));
    float2 rotation = _BurtSkyReflectionRotation.xy;
    float2 rotatedXZ = float2(
        safeDirectionWS.x * rotation.x - safeDirectionWS.z * rotation.y,
        safeDirectionWS.x * rotation.y + safeDirectionWS.z * rotation.x);
    float3 sampleDirectionWS = BurtGISafeNormalize(
        float3(rotatedXZ.x, safeDirectionWS.y, rotatedXZ.y),
        safeDirectionWS);
    float mipLevel = saturate(roughness) * max(_BurtSkyReflectionMaxMip, 0.0);
    float4 encodedSky = _BurtSkyReflectionTexture.SampleLevel(sampler_BurtSkyReflectionTexture, sampleDirectionWS, mipLevel);
    float hdrMultiplier = _BurtSkyReflectionHDR.x * pow(max(abs(encodedSky.a), 0.0001), _BurtSkyReflectionHDR.y);
    skyRadiance = max(encodedSky.rgb * hdrMultiplier, 0.0) *
        max(_BurtSkyReflectionTint.rgb, 0.0) *
        max(_BurtSkyReflectionIntensity, 0.0);

    if (_BurtSkyLowerHemisphereEnabled > 0.5 && safeDirectionWS.y < 0.0)
    {
        skyRadiance = lerp(skyRadiance, max(_BurtSkyLowerHemisphereDiffuseColor.rgb, 0.0), saturate(_BurtSkyLowerHemisphereDiffuseColor.a));
    }

    return dot(skyRadiance, skyRadiance) > 0.000001;
}

float3 BurtGIRadianceCacheResolveSkyRadiance(float3 directionWS, float roughness)
{
    float3 skyRadiance = max(_BurtGIRadianceCacheClipMapSkyRadiance.rgb, 0.0);
    if (_BurtGIRadianceCacheClipMapSkyRadiance.w > 0.5)
    {
        float3 sampledSkyRadiance;
        if (BurtGIRadianceCacheTrySampleSkyRadiance(directionWS, roughness, sampledSkyRadiance))
        {
            skyRadiance = sampledSkyRadiance;
        }
    }

    return skyRadiance;
}

void BurtGIUnpackScreenProbeImportanceRayInfo(uint rayInfo, out uint2 texelCoord, out uint level)
{
    texelCoord.x = rayInfo & 0x3fu;
    texelCoord.y = (rayInfo >> 6) & 0x3fu;
    level = (rayInfo >> 12) & 0xfu;
}

void BurtGISampleScreenProbeImportanceTraceByDirection(
    uint2 traceProbeCoord,
    float3 direction,
    uint traceResolution,
    uint2 traceAtlasSize,
    out float4 traceRadiance,
    out float traceHit)
{
    uint maxImportanceTraceResolution = min(64u, max(traceResolution, traceResolution << 1u));
    float bestDirectionDot = -2.0;
    uint2 bestTraceAtlasCoord = min(traceProbeCoord * traceResolution, traceAtlasSize - 1u);

    [loop]
    for (uint y = 0u; y < traceResolution; ++y)
    {
        [loop]
        for (uint x = 0u; x < traceResolution; ++x)
        {
            uint2 traceTexelCoord = uint2(x, y);
            uint2 traceAtlasCoord = min(traceProbeCoord * traceResolution + traceTexelCoord, traceAtlasSize - 1u);
            uint2 sourceTraceTexelCoord = traceTexelCoord;
            uint sourceTraceLevel = 0u;
            BurtGIUnpackScreenProbeImportanceRayInfo(
                _BurtGIScreenProbeImportanceRayInfoTexture.Load(int3((int)traceAtlasCoord.x, (int)traceAtlasCoord.y, 0)),
                sourceTraceTexelCoord,
                sourceTraceLevel);

            uint sourceMipSize = max(1u, maxImportanceTraceResolution >> min(sourceTraceLevel, 5u));
            if (sourceTraceTexelCoord.x >= sourceMipSize || sourceTraceTexelCoord.y >= sourceMipSize)
            {
                sourceTraceTexelCoord = traceTexelCoord;
                sourceMipSize = traceResolution;
            }

            float3 sourceDirection = BurtGIEquiAreaSphericalMapping((float2(sourceTraceTexelCoord) + 0.5) / (float)sourceMipSize);
            float directionDot = dot(sourceDirection, direction);
            if (directionDot > bestDirectionDot)
            {
                bestDirectionDot = directionDot;
                bestTraceAtlasCoord = traceAtlasCoord;
            }
        }
    }

    traceRadiance = _BurtGIScreenProbeTraceRadianceTexture.Load(int3((int)bestTraceAtlasCoord.x, (int)bestTraceAtlasCoord.y, 0));
    traceHit = _BurtGIScreenProbeTraceHitTexture.Load(int3((int)bestTraceAtlasCoord.x, (int)bestTraceAtlasCoord.y, 0));
}

float3 BurtGISampleRawScreenGI(uint probeIndex, float3 direction, float3 probeWorldCenter, out float hitDistance)
{
    float skyTraceEnabled = _BurtGIRadianceCacheClipMapSkyRadiance.w > 0.5 ? 1.0 : 0.0;
    float3 skyRadiance = BurtGIRadianceCacheResolveSkyRadiance(direction, 0.18);

    if (_BurtGIRadianceCacheClipMapUseIrradianceField != 0u)
    {
        hitDistance = max(_BurtGIScreenProbeTraceParams.w, 1.0);
        return skyRadiance * skyTraceEnabled;
    }

    uint2 screenProbeGridSize = BurtGIScreenProbeGridSize();
    uint2 screenProbeCoord = uint2(probeIndex % screenProbeGridSize.x, (probeIndex / screenProbeGridSize.x) % screenProbeGridSize.y);
    float2 sourceUV = (float2(screenProbeCoord) + 0.5) / (float2)screenProbeGridSize;

    uint rawWidth;
    uint rawHeight;
    _BurtScreenSpaceGlobalIlluminationRawTexture.GetDimensions(rawWidth, rawHeight);
    uint2 rawSize = max(uint2(rawWidth, rawHeight), uint2(1u, 1u));
    uint2 rawCoord = min((uint2)(saturate(sourceUV) * (float2)rawSize), rawSize - 1u);

    float4 rawGI = _BurtScreenSpaceGlobalIlluminationRawTexture.Load(int3((int)rawCoord.x, (int)rawCoord.y, 0));
    float4 screenProbeWorldPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    float validSurface = screenProbeWorldPosition.w > 0.0 ? 1.0 : 0.0;
    float maxTraceDistance = max(_BurtGIScreenProbeTraceParams.w, 1.0);
    hitDistance = validSurface > 0.0 ? distance(probeWorldCenter, screenProbeWorldPosition.xyz) : maxTraceDistance;

    float upFactor = saturate(direction.y * 0.5 + 0.5);
    float3 analyticSkyFallback = lerp(float3(0.015, 0.018, 0.022), float3(0.08, 0.09, 0.11), upFactor);
    float3 skyFallback = lerp(analyticSkyFallback, skyRadiance, skyTraceEnabled);
    float directionalEnergy = lerp(0.72, 1.18, saturate(direction.z * 0.5 + 0.5));
    float3 fallbackRadiance = max(lerp(skyFallback, rawGI.rgb, validSurface), 0.0) * directionalEnergy;

    uint traceWidth;
    uint traceHeight;
    _BurtGIScreenProbeTraceRadianceTexture.GetDimensions(traceWidth, traceHeight);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint2 traceAtlasSize = max(uint2(traceWidth, traceHeight), uint2(1u, 1u));
    uint2 traceProbeCapacity = max(traceAtlasSize / traceResolution, uint2(1u, 1u));
    uint2 traceProbeCoord = min(screenProbeCoord, traceProbeCapacity - 1u);
    float4 traceRadiance;
    float traceHit;
    BurtGISampleScreenProbeImportanceTraceByDirection(traceProbeCoord, direction, traceResolution, traceAtlasSize, traceRadiance, traceHit);
    traceHit = saturate(traceHit);
    float traceConfidence = saturate(max(traceRadiance.a, traceHit) * traceHit);
    float traceDistance = maxTraceDistance * lerp(1.0, 0.35, traceConfidence);
    hitDistance = min(hitDistance, traceDistance);

    return lerp(fallbackRadiance, max(traceRadiance.rgb, 0.0), traceConfidence);
}

float BurtGIRadianceCacheDirectionImportance(uint probeIndex, float3 probeWorldCenter, float2 probeUV)
{
    float3 direction = BurtGIEquiAreaSphericalMapping(probeUV);

    float hitDistance;
    float3 radiance = BurtGISampleRawScreenGI(probeIndex, direction, probeWorldCenter, hitDistance);
    float luminance = dot(radiance, float3(0.2126, 0.7152, 0.0722));
    float distanceWeight = saturate(1.0 - hitDistance / max(_BurtGIScreenProbeTraceParams.w, 1.0));
    float horizonWeight = saturate(abs(direction.y) * 0.35 + 0.65);
    float transferPDF = BurtGIRadianceCacheScreenProbeTransferPDF(probeIndex, direction);
    float screenGIFallbackPDF = luminance * (0.45 + 0.55 * distanceWeight) * horizonWeight;
    return max(transferPDF, screenGIFallbackPDF * 0.25);
}

float BurtGIRadianceCacheTraceTileImportance(uint probeIndex, float3 probeWorldCenter, uint2 tileCoord, uint traceTileResolution)
{
    float2 probeUV = (float2(tileCoord) + 0.5) / (float)max(traceTileResolution, 1u);
    return BurtGIRadianceCacheDirectionImportance(probeIndex, probeWorldCenter, probeUV);
}

float BurtGIRadianceCacheProbePDFDirectionImportanceUV(float2 probeUV)
{
    if (BurtGITraceTileProbePDFValid == 0u)
    {
        return 0.0;
    }

    float3 direction = BurtGIEquiAreaSphericalMapping(probeUV);
    BurtGIThreeBandSHVector directionSH = BurtGISHBasisFunction3(direction);

    BurtGIThreeBandSHVector probePDF;
    probePDF.V0 = BurtGITraceTileProbePDFV0;
    probePDF.V1 = BurtGITraceTileProbePDFV1;
    probePDF.V2 = BurtGITraceTileProbePDFV2;

    return max(BurtGIDotSH3(probePDF, directionSH), 0.0);
}

void BurtGIStoreProbePDFCoefficient(uint baseIndex, uint coefficientIndex, float value)
{
    _BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + coefficientIndex] = BurtGIEncodeProbePDFCoefficient(value);
}

void BurtGILoadRadianceProbePDF(uint probeIndex)
{
    uint baseIndex = BurtGIProbePDFBaseIndex(probeIndex);
    float totalWeight = max(BurtGIDecodeProbePDFCoefficient(_BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 9u]), 0.0);
    float normalizeWeight = totalWeight > 0.0001 ? rcp(totalWeight) : 0.0;
    BurtGITraceTileProbePDFV0 = float4(
        BurtGIDecodeProbePDFCoefficient(_BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 0u]),
        BurtGIDecodeProbePDFCoefficient(_BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 1u]),
        BurtGIDecodeProbePDFCoefficient(_BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 2u]),
        BurtGIDecodeProbePDFCoefficient(_BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 3u])) * normalizeWeight;
    BurtGITraceTileProbePDFV1 = float4(
        BurtGIDecodeProbePDFCoefficient(_BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 4u]),
        BurtGIDecodeProbePDFCoefficient(_BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 5u]),
        BurtGIDecodeProbePDFCoefficient(_BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 6u]),
        BurtGIDecodeProbePDFCoefficient(_BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 7u])) * normalizeWeight;
    BurtGITraceTileProbePDFV2 = BurtGIDecodeProbePDFCoefficient(_BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 8u]) * normalizeWeight;
    BurtGITraceTileProbePDFValid = totalWeight > 0.0001 ? 1u : 0u;
}

void BurtGIBuildRadianceProbePDF(uint probeIndex, float3 probeWorldCenter)
{
    BurtGIThreeBandSHVector accumulatedPDF;
    accumulatedPDF.V0 = 0.0;
    accumulatedPDF.V1 = 0.0;
    accumulatedPDF.V2 = 0.0;
    float totalWeight = 0.0;

    [loop]
    for (uint y = 0u; y < 8u; ++y)
    {
        [loop]
        for (uint x = 0u; x < 8u; ++x)
        {
            float2 probeUV = (float2(x, y) + 0.5) * 0.125;
            float3 direction = BurtGIEquiAreaSphericalMapping(probeUV);

            float hitDistance;
            float3 radiance = BurtGISampleRawScreenGI(probeIndex, direction, probeWorldCenter, hitDistance);
            float luminance = dot(radiance, float3(0.2126, 0.7152, 0.0722));
            float distanceWeight = saturate(1.0 - hitDistance / max(_BurtGIScreenProbeTraceParams.w, 1.0));
            float horizonWeight = saturate(abs(direction.y) * 0.35 + 0.65);
            float transferPDF = BurtGIRadianceCacheScreenProbeTransferPDF(probeIndex, direction);
            float screenGIFallbackPDF = luminance * (0.45 + 0.55 * distanceWeight) * horizonWeight;
            float sampleWeight = max(transferPDF, screenGIFallbackPDF * 0.25);

            BurtGIThreeBandSHVector basis = BurtGISHBasisFunction3(direction);
            accumulatedPDF.V0 += basis.V0 * sampleWeight;
            accumulatedPDF.V1 += basis.V1 * sampleWeight;
            accumulatedPDF.V2 += basis.V2 * sampleWeight;
            totalWeight += sampleWeight;
        }
    }

    uint baseIndex = BurtGIProbePDFBaseIndex(probeIndex);
    BurtGIStoreProbePDFCoefficient(baseIndex, 0u, accumulatedPDF.V0.x);
    BurtGIStoreProbePDFCoefficient(baseIndex, 1u, accumulatedPDF.V0.y);
    BurtGIStoreProbePDFCoefficient(baseIndex, 2u, accumulatedPDF.V0.z);
    BurtGIStoreProbePDFCoefficient(baseIndex, 3u, accumulatedPDF.V0.w);
    BurtGIStoreProbePDFCoefficient(baseIndex, 4u, accumulatedPDF.V1.x);
    BurtGIStoreProbePDFCoefficient(baseIndex, 5u, accumulatedPDF.V1.y);
    BurtGIStoreProbePDFCoefficient(baseIndex, 6u, accumulatedPDF.V1.z);
    BurtGIStoreProbePDFCoefficient(baseIndex, 7u, accumulatedPDF.V1.w);
    BurtGIStoreProbePDFCoefficient(baseIndex, 8u, accumulatedPDF.V2);
    _BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + 9u] = BurtGIEncodeProbePDFCoefficient(totalWeight);

    BurtGILoadRadianceProbePDF(probeIndex);
}

bool BurtGIShouldRefineProbeTraceTile(uint probeIndex, float3 probeWorldCenter, uint2 tileCoord, uint traceTileResolution, float threshold)
{
    float invTraceTileResolution = rcp((float)max(traceTileResolution, 1u));
    float2 tileMinUV = (float2)tileCoord * invTraceTileResolution;
    float2 tileExtentUV = float2(invTraceTileResolution, invTraceTileResolution);
    float2 centerUV = tileMinUV + tileExtentUV * 0.5;
    float2 sampleUV0 = tileMinUV + tileExtentUV * 0.25;
    float2 sampleUV1 = tileMinUV + tileExtentUV * float2(0.75, 0.25);
    float2 sampleUV2 = tileMinUV + tileExtentUV * float2(0.25, 0.75);
    float2 sampleUV3 = tileMinUV + tileExtentUV * 0.75;

    float tileImportance = BurtGIRadianceCacheDirectionImportance(probeIndex, probeWorldCenter, centerUV);
    tileImportance = max(tileImportance, BurtGIRadianceCacheProbePDFDirectionImportanceUV(centerUV) * 0.75);
    tileImportance = max(tileImportance, BurtGIRadianceCacheDirectionImportance(probeIndex, probeWorldCenter, sampleUV0));
    tileImportance = max(tileImportance, BurtGIRadianceCacheDirectionImportance(probeIndex, probeWorldCenter, sampleUV1));
    tileImportance = max(tileImportance, BurtGIRadianceCacheDirectionImportance(probeIndex, probeWorldCenter, sampleUV2));
    tileImportance = max(tileImportance, BurtGIRadianceCacheDirectionImportance(probeIndex, probeWorldCenter, sampleUV3));
    tileImportance = max(tileImportance, max(
        max(BurtGIRadianceCacheProbePDFDirectionImportanceUV(sampleUV0), BurtGIRadianceCacheProbePDFDirectionImportanceUV(sampleUV1)),
        max(BurtGIRadianceCacheProbePDFDirectionImportanceUV(sampleUV2), BurtGIRadianceCacheProbePDFDirectionImportanceUV(sampleUV3))) * 0.75);

    return tileImportance > threshold;
}

void BurtGIQueueCompletedProbeTraceTile(uint2 tileCoord, uint tileLevel, uint probeTraceIndex)
{
    uint tileIndex;
    InterlockedAdd(BurtGITraceTileCompletedCount, 1u, tileIndex);
    if (tileIndex < BURT_GI_TRACE_TILE_THREADGROUP_SIZE * BURT_GI_TRACE_TILE_THREADGROUP_SIZE * 4)
    {
        BurtGITraceTileCompletedList[tileIndex] = uint2(BurtGIPackTraceTileInfo(tileCoord.x, tileCoord.y, tileLevel), probeTraceIndex);
    }
}

void BurtGIQueuePendingProbeTraceTile(uint2 tileCoord, uint tileLevel, uint probeTraceIndex)
{
    uint tileBaseIndex;
    InterlockedAdd(BurtGITraceTilePendingCount, 4u, tileBaseIndex);
    if (tileBaseIndex + 3u < BURT_GI_TRACE_TILE_THREADGROUP_SIZE * BURT_GI_TRACE_TILE_THREADGROUP_SIZE * 4)
    {
        BurtGITraceTilePendingList[tileBaseIndex + 0u] = uint2(BurtGIPackTraceTileInfo(tileCoord.x * 2u + 0u, tileCoord.y * 2u + 0u, tileLevel), probeTraceIndex);
        BurtGITraceTilePendingList[tileBaseIndex + 1u] = uint2(BurtGIPackTraceTileInfo(tileCoord.x * 2u + 1u, tileCoord.y * 2u + 0u, tileLevel), probeTraceIndex);
        BurtGITraceTilePendingList[tileBaseIndex + 2u] = uint2(BurtGIPackTraceTileInfo(tileCoord.x * 2u + 0u, tileCoord.y * 2u + 1u, tileLevel), probeTraceIndex);
        BurtGITraceTilePendingList[tileBaseIndex + 3u] = uint2(BurtGIPackTraceTileInfo(tileCoord.x * 2u + 1u, tileCoord.y * 2u + 1u, tileLevel), probeTraceIndex);
    }
}

uint BurtGIResolveTraceTileLevelCount(float3 probeWorldCenter, uint maxLevels)
{
    float3 cameraToProbe = probeWorldCenter - _BurtDeferredCameraWorldPosition.xyz;
    float distanceFromCameraSq = dot(cameraToProbe, cameraToProbe);

    if (_BurtGIRadianceCacheClipMapForcedUniformTraceTileLevel >= 0)
    {
        uint forcedUniformLevel = min((uint)_BurtGIRadianceCacheClipMapForcedUniformTraceTileLevel, maxLevels - 1u);
        return distanceFromCameraSq >= _BurtGIRadianceCacheClipMapDownsampleDistanceFromCameraSq
            ? 1u
            : forcedUniformLevel + 1u;
    }

    if (distanceFromCameraSq >= _BurtGIRadianceCacheClipMapDownsampleDistanceFromCameraSq)
    {
        return 1u;
    }

    return min(maxLevels, distanceFromCameraSq < _BurtGIRadianceCacheClipMapSupersampleDistanceFromCameraSq ? 3u : 2u);
}

uint BurtGIGetProbeTraceCost(float3 probeWorldCenter)
{
    float3 cameraToProbe = _BurtDeferredCameraWorldPosition.xyz - probeWorldCenter;
    float distanceFromCameraSq = dot(cameraToProbe, cameraToProbe);
    uint traceCost = 1u;

    if (distanceFromCameraSq < _BurtGIRadianceCacheClipMapSupersampleDistanceFromCameraSq)
    {
        traceCost = 16u;
    }

    if (distanceFromCameraSq < _BurtGIRadianceCacheClipMapDownsampleDistanceFromCameraSq)
    {
        traceCost = 4u;
    }

    return traceCost;
}

uint BurtGIGetPriorityBucketIndex(uint lastTracedFrameIndex, uint lastUsedFrameIndex, uint clipmapIndex)
{
    if (lastTracedFrameIndex == 0u)
    {
        return 0u;
    }

    uint framesBetweenTracedAndUsed = lastUsedFrameIndex > lastTracedFrameIndex
        ? lastUsedFrameIndex - lastTracedFrameIndex
        : 1u;
    float updateImportance = (float)framesBetweenTracedAndUsed / ((float)clipmapIndex + 1.0);
    uint logBucket = (uint)clamp(log2(updateImportance), 0.0, (float)(BURT_GI_PRIORITY_HISTOGRAM_SIZE - 2u));
    return BURT_GI_PRIORITY_HISTOGRAM_SIZE - 1u - logBucket;
}

void BurtGIQueueUniformProbeTraceTiles(uint threadIndex, uint baseTileResolution, uint tileLevel, uint probeTraceIndex)
{
    uint tileResolution = baseTileResolution << tileLevel;
    uint numTraceTiles = tileResolution * tileResolution;

    if (threadIndex == 0u)
    {
        InterlockedAdd(_BurtGIRadianceCacheClipMapProbeTraceTileAllocatorBuffer[0], numTraceTiles, BurtGITraceTileGlobalOffset);
    }

    GroupMemoryBarrierWithGroupSync();

    [loop]
    for (uint traceTileIndex = threadIndex; traceTileIndex < numTraceTiles; traceTileIndex += BURT_GI_TRACE_TILE_THREADGROUP_SIZE * BURT_GI_TRACE_TILE_THREADGROUP_SIZE)
    {
        uint2 tileCoord = uint2(traceTileIndex % tileResolution, traceTileIndex / tileResolution);
        _BurtGIRadianceCacheClipMapProbeTraceTileDataBuffer[BurtGITraceTileGlobalOffset + traceTileIndex] =
            uint2(BurtGIPackTraceTileInfo(tileCoord.x, tileCoord.y, tileLevel), probeTraceIndex);
    }
}

#define BURT_GI_WRITE_DISPATCH_ARGS(Buffer, TupleIndex, X, Y, Z) Buffer[TupleIndex] = uint3((uint)(X), (uint)(Y), (uint)(Z))

uint BurtGIRadianceCacheHashGridTileCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.x);
}

uint BurtGIRadianceCacheHashGridCellCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.y);
}

uint BurtGIRadianceCacheHashGridCellsPerTile()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.z);
}

uint BurtGIRadianceCacheHashGridBucketCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.z);
}

uint BurtGIRadianceCacheHashGridTilesPerBucket()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.w);
}

uint BurtGIRadianceCacheHashGridTraceTexelCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.w);
}

uint BurtGIRadianceCacheHashGridPingPong()
{
    return _BurtGIRadianceCacheClipMapFrameIndex & 1u;
}

uint BurtGIRadianceCacheHashGridPackedTileCountIndex()
{
    return 2u + BurtGIRadianceCacheHashGridPingPong();
}

uint BurtGIRadianceCacheHashGridPackedTileCountPrevIndex()
{
    return 3u - BurtGIRadianceCacheHashGridPingPong();
}

uint BurtGIRadianceCacheHashGridHash(uint3 value)
{
    uint h = value.x * 0x8da6b343u;
    h ^= value.y * 0xd8163841u;
    h ^= value.z * 0xcb1ab31fu;
    h ^= h >> 16;
    h *= 0x7feb352du;
    h ^= h >> 15;
    h *= 0x846ca68bu;
    h ^= h >> 16;
    return h;
}

float BurtGIInterleavedGradientNoise(uint2 coord, uint temporalIndex)
{
    uint hash = BurtGIRadianceCacheHashGridHash(uint3(coord.x, coord.y, temporalIndex));
    return (float)(hash & 0x00ffffffu) * (1.0 / 16777216.0);
}

void BurtGIMarkProbeIndirectionCoord(int3 probeCoord, uint clipmapIndex)
{
    int clipmapResolution = (int)BurtGIClipmapResolution();
    if (clipmapIndex >= BurtGIClipmapCount() ||
        probeCoord.x < 0 ||
        probeCoord.y < 0 ||
        probeCoord.z < 0 ||
        probeCoord.x >= clipmapResolution ||
        probeCoord.y >= clipmapResolution ||
        probeCoord.z >= clipmapResolution)
    {
        return;
    }

    uint2 indirectionCoord = BurtGIPackIndirectionCoord(clipmapIndex, (uint3)probeCoord);
    uint2 indirectionSize = BurtGIIndirectionSize();
    if (indirectionCoord.x < indirectionSize.x && indirectionCoord.y < indirectionSize.y)
    {
        _BurtGIRadianceCacheClipMapIndirectionTexture[indirectionCoord] = BURT_GI_USED_PROBE_INDEX;
    }
}

void BurtGIMarkPositionUsedInIndirectionTexture(float3 worldPosition, float clipmapDitherRandom)
{
    uint clipmapIndex;
    float3 probeCoordFloat;
    if (!BurtGIWorldPositionToProbeCoordFloatDithered(worldPosition, clipmapDitherRandom, clipmapIndex, probeCoordFloat))
    {
        return;
    }

    int3 bottomCornerProbeCoord = (int3)floor(probeCoordFloat - 0.5 + 0.0001);
    [unroll]
    for (int z = 0; z <= 1; ++z)
    {
        [unroll]
        for (int y = 0; y <= 1; ++y)
        {
            [unroll]
            for (int x = 0; x <= 1; ++x)
            {
                BurtGIMarkProbeIndirectionCoord(bottomCornerProbeCoord + int3(x, y, z), clipmapIndex);
            }
        }
    }
}

uint BurtGIRadianceCacheHashGridTileHash(float3 worldPosition, float3 rayDirection)
{
    float cellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    float tileCellRatio = max(1.0, _BurtGIRadianceCacheHashGridParams0.y);
    float tileSize = cellSize * tileCellRatio;
    int3 signedTileCoord = (int3)floor(worldPosition / tileSize);
    int3 signedDirectionCoord = (int3)floor(0.5 + (0.5 * rayDirection + 0.5) * 4.0);
    uint3 tileKey = uint3((uint)signedTileCoord.x, (uint)signedTileCoord.y, (uint)signedTileCoord.z);
    uint3 directionKey = uint3((uint)signedDirectionCoord.x, (uint)signedDirectionCoord.y, (uint)signedDirectionCoord.z);
    uint hash = BurtGIRadianceCacheHashGridHash(tileKey ^ (directionKey * 0x9e3779b9u));
    return hash == 0xffffffffu ? 0xfffffffeu : max(1u, hash);
}

uint BurtGIRadianceCacheHashGridLocalCell(float3 worldPosition, float3 rayDirection)
{
    float cellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    uint tileCellRatio = max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.y);
    float tileSize = cellSize * (float)tileCellRatio;
    int3 signedTileCoord = (int3)floor(worldPosition / tileSize);
    int3 signedCellCoord = (int3)floor(worldPosition / cellSize) - signedTileCoord * (int)tileCellRatio;
    uint3 maxCellCoord = uint3(tileCellRatio - 1u, tileCellRatio - 1u, tileCellRatio - 1u);
    uint3 cellCoord = min(uint3((uint)signedCellCoord.x, (uint)signedCellCoord.y, (uint)signedCellCoord.z), maxCellCoord);
    float3 absDirection = abs(rayDirection);
    float maxDirection = max(max(absDirection.x, absDirection.y), absDirection.z);
    uint2 cellOffset = absDirection.x == maxDirection
        ? uint2(cellCoord.y, cellCoord.z)
        : (absDirection.y == maxDirection ? uint2(cellCoord.x, cellCoord.z) : uint2(cellCoord.x, cellCoord.y));
    uint mip0CellCount = tileCellRatio * tileCellRatio;
    return min(cellOffset.x + cellOffset.y * tileCellRatio, min(BurtGIRadianceCacheHashGridCellsPerTile() - 1u, mip0CellCount - 1u));
}

uint BurtGIRadianceCacheHashGridCellIndexFromTile(uint tileIndex, uint localCellIndex)
{
    return min(tileIndex * BurtGIRadianceCacheHashGridCellsPerTile() + localCellIndex, BurtGIRadianceCacheHashGridCellCount() - 1u);
}

float3 BurtGIRadianceCacheHashGridDebugCellCenter(float3 worldPosition)
{
    float cellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    uint tileCellRatio = max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.y);
    float tileSize = cellSize * (float)tileCellRatio;
    int3 signedTileCoord = (int3)floor(worldPosition / tileSize);
    int3 signedCellCoord = (int3)floor(worldPosition / cellSize) - signedTileCoord * (int)tileCellRatio;
    uint3 maxCellCoord = uint3(tileCellRatio - 1u, tileCellRatio - 1u, tileCellRatio - 1u);
    uint3 cellCoord = min(uint3((uint)signedCellCoord.x, (uint)signedCellCoord.y, (uint)signedCellCoord.z), maxCellCoord);
    return (float3)signedTileCoord * tileSize + ((float3)cellCoord + 0.5) * cellSize;
}

float4 BurtGIRadianceCacheHashGridPackDebugCell(float3 positionWS, float3 directionWS, float cellSize, float confidence)
{
    uint4 centerAndSize = f32tof16(float4(positionWS, cellSize));
    uint4 directionAndConfidence = f32tof16(float4(normalize(directionWS), saturate(confidence)));
    return asfloat((centerAndSize << 16) | directionAndConfidence);
}

float4 BurtGIRadianceCacheHashGridUpdateDebugCellConfidence(float4 packedCell, float confidence)
{
    uint4 rawCell = asuint(packedCell);
    if (!any(rawCell != 0u))
    {
        return packedCell;
    }

    rawCell.w = (rawCell.w & 0xffff0000u) | f32tof16(saturate(confidence));
    return asfloat(rawCell);
}

uint BurtGIRadianceCacheHashGridMipLocalCellIndex(uint2 cellCoord, uint mipLevel)
{
    if (mipLevel == 1u)
    {
        return BURT_GI_HASH_GRID_TILE_MIP1_OFFSET + min(cellCoord.x, 3u) + min(cellCoord.y, 3u) * 4u;
    }

    if (mipLevel == 2u)
    {
        return BURT_GI_HASH_GRID_TILE_MIP2_OFFSET + min(cellCoord.x, 1u) + min(cellCoord.y, 1u) * 2u;
    }

    if (mipLevel == 3u)
    {
        return BURT_GI_HASH_GRID_TILE_MIP3_OFFSET;
    }

    return BURT_GI_HASH_GRID_TILE_MIP0_OFFSET + min(cellCoord.x, 7u) + min(cellCoord.y, 7u) * 8u;
}

void BurtGIRadianceCacheHashGridAppendPackedTile(uint tileIndex)
{
    uint packedTileIndex;
    InterlockedAdd(_BurtGIRadianceCacheHashGridCountBuffer[BurtGIRadianceCacheHashGridPackedTileCountIndex()], 1u, packedTileIndex);
    if (packedTileIndex >= BurtGIRadianceCacheHashGridTileCount())
    {
        return;
    }

    if (BurtGIRadianceCacheHashGridPingPong() == 0u)
    {
        _BurtGIRadianceCacheHashGridTileBuffer[packedTileIndex].z = tileIndex;
    }
    else
    {
        _BurtGIRadianceCacheHashGridTileBuffer[packedTileIndex].w = tileIndex;
    }
}

uint BurtGIRadianceCacheHashGridPackedTilePrev(uint packedTileIndex)
{
    uint4 packedTile = _BurtGIRadianceCacheHashGridTileBuffer[packedTileIndex];
    return BurtGIRadianceCacheHashGridPingPong() == 0u ? packedTile.w : packedTile.z;
}

void BurtGIRadianceCacheHashGridClearTileCells(uint tileIndex)
{
    uint cellsPerTile = BurtGIRadianceCacheHashGridCellsPerTile();

    [loop]
    for (uint localCellIndex = 0u; localCellIndex < cellsPerTile; ++localCellIndex)
    {
        uint cellIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(tileIndex, localCellIndex);
        _BurtGIRadianceCacheHashGridValueBuffer[cellIndex] = uint4(0u, 0u, 0xffffffffu, 0u);
        uint updateCellBase = cellIndex * 4u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 0u] = 0u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 1u] = 0u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 2u] = 0u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 3u] = 0u;
        _BurtGIRadianceCacheHashGridDebugCellBuffer[cellIndex + 1u] = 0.0;
    }
}

bool BurtGIRadianceCacheHashGridFindOrInsertTile(uint tileHash, out uint tileIndex, out bool isNewTile)
{
    uint bucketIndex = BurtGIRadianceCacheHashGridHash(uint3(tileHash, tileHash >> 7, tileHash >> 17)) % BurtGIRadianceCacheHashGridBucketCount();
    uint tilesPerBucket = BurtGIRadianceCacheHashGridTilesPerBucket();
    tileIndex = 0xffffffffu;
    isNewTile = false;

    [loop]
    for (uint bucketOffset = 0u; bucketOffset < tilesPerBucket; ++bucketOffset)
    {
        uint candidateTileIndex = bucketIndex * tilesPerBucket + bucketOffset;
        if (candidateTileIndex >= BurtGIRadianceCacheHashGridTileCount())
        {
            break;
        }

        uint previousHash;
        InterlockedCompareExchange(_BurtGIRadianceCacheHashGridTileBuffer[candidateTileIndex].x, 0xffffffffu, tileHash, previousHash);
        if (previousHash == 0xffffffffu || previousHash == tileHash)
        {
            tileIndex = candidateTileIndex;
            isNewTile = previousHash == 0xffffffffu;
            return true;
        }
    }

    return false;
}

bool BurtGIRadianceCacheHashGridFindTile(uint tileHash, out uint tileIndex)
{
    uint bucketIndex = BurtGIRadianceCacheHashGridHash(uint3(tileHash, tileHash >> 7, tileHash >> 17)) % BurtGIRadianceCacheHashGridBucketCount();
    uint tilesPerBucket = BurtGIRadianceCacheHashGridTilesPerBucket();
    tileIndex = 0xffffffffu;

    [loop]
    for (uint bucketOffset = 0u; bucketOffset < tilesPerBucket; ++bucketOffset)
    {
        uint candidateTileIndex = bucketIndex * tilesPerBucket + bucketOffset;
        if (candidateTileIndex >= BurtGIRadianceCacheHashGridTileCount())
        {
            break;
        }

        if (_BurtGIRadianceCacheHashGridTileBuffer[candidateTileIndex].x == tileHash)
        {
            tileIndex = candidateTileIndex;
            return true;
        }
    }

    return false;
}

uint2 BurtGIRadianceCacheHashGridPackRadiance(float3 radiance, float confidence)
{
    uint3 encodedRadiance = (uint3)round(saturate(radiance / 8.0) * 65535.0);
    uint encodedConfidence = (uint)round(saturate(confidence) * 65535.0);
    return uint2(
        (encodedRadiance.x & 0xffffu) | ((encodedRadiance.y & 0xffffu) << 16),
        (encodedRadiance.z & 0xffffu) | ((encodedConfidence & 0xffffu) << 16));
}

uint4 BurtGIRadianceCacheHashGridQuantizeRadiance(float3 radiance, float sampleWeight)
{
    return uint4(
        (uint)round(saturate(radiance.x / 8.0) * 65535.0),
        (uint)round(saturate(radiance.y / 8.0) * 65535.0),
        (uint)round(saturate(radiance.z / 8.0) * 65535.0),
        (uint)round(saturate(sampleWeight) * 65535.0));
}

float4 BurtGIRadianceCacheHashGridRecoverRadiance(uint4 quantized)
{
    return float4(
        (float)quantized.x / 65535.0 * 8.0,
        (float)quantized.y / 65535.0 * 8.0,
        (float)quantized.z / 65535.0 * 8.0,
        (float)quantized.w / 65535.0);
}

float4 BurtGIRadianceCacheHashGridUnpackPackedRadiance(uint2 packedRadiance)
{
    float3 radiance = float3(
        (float)(packedRadiance.x & 0xffffu),
        (float)((packedRadiance.x >> 16) & 0xffffu),
        (float)(packedRadiance.y & 0xffffu)) / 65535.0 * 8.0;
    float sampleWeight = (float)((packedRadiance.y >> 16) & 0xffffu) / 65535.0;
    return float4(radiance, sampleWeight);
}

float4 BurtGIRadianceCacheHashGridUnpackRadiance(uint4 packedValue)
{
    return BurtGIRadianceCacheHashGridUnpackPackedRadiance(packedValue.xy);
}

uint BurtGIRadianceCacheHashGridFrameDelta(uint frameIndex, uint lastUpdateFrame)
{
    if (lastUpdateFrame == 0xffffffffu)
    {
        return BURT_GI_HASH_GRID_TILE_DECAY_MAX;
    }

    return frameIndex >= lastUpdateFrame
        ? frameIndex - lastUpdateFrame
        : (0xffffffffu - lastUpdateFrame) + frameIndex + 1u;
}

float BurtGIRadianceCacheHashGridAgeConfidenceScale(uint4 packedValue)
{
    uint frameDelta = BurtGIRadianceCacheHashGridFrameDelta(_BurtGIRadianceCacheClipMapFrameIndex, packedValue.z);
    return 1.0 - saturate((float)frameDelta / (float)BURT_GI_HASH_GRID_TILE_DECAY_MAX);
}

float3 BurtGISceneVoxelWorldToUVW(float3 worldPosition)
{
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float extent = max(centerExtent.w, 0.001);
    return (worldPosition - centerExtent.xyz) / (extent * 2.0) + 0.5;
}

bool BurtGISceneVoxelOctreeMaskContains(uint lowMask, uint highMask, uint bitIndex)
{
    uint word = bitIndex < 32u ? lowMask : highMask;
    return ((word >> (bitIndex & 31u)) & 1u) != 0u;
}

bool BurtGISceneVoxelOctreeContainsVoxel(uint3 voxelCoord)
{
    uint3 parentCoord = voxelCoord >> 4u;
    uint3 leafCoord = voxelCoord >> 2u;
    uint rootBit = parentCoord.x + parentCoord.y * 4u + parentCoord.z * 16u;
    uint rootLow = _BurtGISceneVoxelOctreeRootLowTexture[uint3(0u, 0u, 0u)];
    uint rootHigh = _BurtGISceneVoxelOctreeRootHighTexture[uint3(0u, 0u, 0u)];
    if (!BurtGISceneVoxelOctreeMaskContains(rootLow, rootHigh, rootBit))
    {
        return false;
    }

    uint3 parentChild = leafCoord & 3u;
    uint parentBit = parentChild.x + parentChild.y * 4u + parentChild.z * 16u;
    uint parentLow = _BurtGISceneVoxelOctreeParentLowTexture[parentCoord];
    uint parentHigh = _BurtGISceneVoxelOctreeParentHighTexture[parentCoord];
    if (!BurtGISceneVoxelOctreeMaskContains(parentLow, parentHigh, parentBit))
    {
        return false;
    }

    uint3 leafChild = voxelCoord & 3u;
    uint leafBit = leafChild.x + leafChild.y * 4u + leafChild.z * 16u;
    uint leafLow = _BurtGISceneVoxelOctreeLeafLowTexture[leafCoord];
    uint leafHigh = _BurtGISceneVoxelOctreeLeafHighTexture[leafCoord];
    return BurtGISceneVoxelOctreeMaskContains(leafLow, leafHigh, leafBit);
}

bool BurtGISceneVoxelOctreeMayContain(float3 samplePosition)
{
    if (_BurtGISceneVoxelOctreeValid <= 0.5)
    {
        return true;
    }

    uint geometryWidth;
    uint geometryHeight;
    uint geometryDepth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(geometryWidth, geometryHeight, geometryDepth);
    uint3 geometrySize = max(uint3(geometryWidth, geometryHeight, geometryDepth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGISceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)geometrySize), geometrySize - 1u);
    return BurtGISceneVoxelOctreeContainsVoxel(voxelCoord);
}

bool BurtGIRayTraceSceneVoxelOctree(float3 originWS, float3 directionWS, float maxDistance, out float hitDistance)
{
    hitDistance = maxDistance;
    if (_BurtGISceneVoxelOctreeValid <= 0.5 || maxDistance <= 0.0)
    {
        return false;
    }

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float extent = max(centerExtent.w, 0.001);
    float3 boxMin = centerExtent.xyz - extent;
    float3 boxMax = centerExtent.xyz + extent;
    float3 direction = normalize(directionWS);
    float3 invDirection = rcp(max(abs(direction), 0.000001)) * sign(direction + 0.000001);
    float3 t0 = (boxMin - originWS) * invDirection;
    float3 t1 = (boxMax - originWS) * invDirection;
    float entryDistance = max(max(min(t0.x, t1.x), min(t0.y, t1.y)), min(t0.z, t1.z));
    float exitDistance = min(min(max(t0.x, t1.x), max(t0.y, t1.y)), max(t0.z, t1.z));
    float voxelSizeWS = extent * 2.0 / max((float)volumeSize.x, 1.0);
    float traceDistance = max(0.0, entryDistance) + voxelSizeWS * 0.001;
    float traceEnd = min(maxDistance, exitDistance);
    if (traceDistance >= traceEnd)
    {
        return false;
    }

    uint maxTraceSteps = min((uint)max(_BurtGISceneVoxelTraceControls.x, 1.0), 64u);
    [loop]
    for (uint stepIndex = 0u; stepIndex < maxTraceSteps && traceDistance < traceEnd; ++stepIndex)
    {
        float3 positionWS = originWS + direction * traceDistance;
        float3 localPosition = clamp(positionWS - boxMin, 0.0, extent * 2.0 - voxelSizeWS * 0.001);
        uint3 voxelCoord = min((uint3)(localPosition / voxelSizeWS), volumeSize - 1u);
        uint3 parentCoord = voxelCoord >> 4u;
        uint3 leafCoord = voxelCoord >> 2u;
        uint rootBit = parentCoord.x + parentCoord.y * 4u + parentCoord.z * 16u;
        bool rootOccupied = BurtGISceneVoxelOctreeMaskContains(
            _BurtGISceneVoxelOctreeRootLowTexture[uint3(0u, 0u, 0u)],
            _BurtGISceneVoxelOctreeRootHighTexture[uint3(0u, 0u, 0u)],
            rootBit);
        uint levelScale = 16u;
        bool occupied = rootOccupied;
        if (occupied)
        {
            uint3 parentChild = leafCoord & 3u;
            uint parentBit = parentChild.x + parentChild.y * 4u + parentChild.z * 16u;
            occupied = BurtGISceneVoxelOctreeMaskContains(
                _BurtGISceneVoxelOctreeParentLowTexture[parentCoord],
                _BurtGISceneVoxelOctreeParentHighTexture[parentCoord],
                parentBit);
            levelScale = occupied ? 4u : 4u;
        }
        if (occupied)
        {
            uint3 leafChild = voxelCoord & 3u;
            uint leafBit = leafChild.x + leafChild.y * 4u + leafChild.z * 16u;
            occupied = BurtGISceneVoxelOctreeMaskContains(
                _BurtGISceneVoxelOctreeLeafLowTexture[leafCoord],
                _BurtGISceneVoxelOctreeLeafHighTexture[leafCoord],
                leafBit);
            levelScale = 1u;
        }
        if (occupied)
        {
            hitDistance = traceDistance;
            return true;
        }

        float cellSizeWS = voxelSizeWS * (float)levelScale;
        float3 cellIndex = floor(localPosition / cellSizeWS);
        float3 cellMin = boxMin + cellIndex * cellSizeWS;
        float3 cellMax = cellMin + cellSizeWS;
        float3 boundary = lerp(cellMin, cellMax, step(0.0, direction));
        float3 safeDirection = sign(direction + 0.000001) * max(abs(direction), 0.000001);
        float3 distanceToBoundary = (boundary - positionWS) / safeDirection;
        distanceToBoundary = max(distanceToBoundary, voxelSizeWS * 0.001);
        traceDistance += min(min(distanceToBoundary.x, distanceToBoundary.y), distanceToBoundary.z);
    }

    return false;
}

uint BurtGIResolveSceneVoxelClipmap(float3 samplePosition)
{
    float4 baseCenterExtent = _BurtGISceneVoxelCenterExtent;
    if (all(abs(samplePosition - baseCenterExtent.xyz) <= baseCenterExtent.www))
    {
        return 0u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 2u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[1].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[1].www))
    {
        return 1u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 4u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[2].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[2].www))
    {
        return 2u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 8u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[3].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[3].www))
    {
        return 3u;
    }

    return 0u;
}

bool BurtGITrySampleSceneVoxelGeometryResource(
    Texture3D<float4> geometryTexture,
    float4 centerExtent,
    float3 samplePosition,
    float3 traceDirection,
    out float3 normalWS,
    out float occupancy,
    out float normalFacingWeight)
{
    normalWS = float3(0.0, 1.0, 0.0);
    occupancy = 0.0;
    normalFacingWeight = 0.0;
    uint width;
    uint height;
    uint depth;
    geometryTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = (samplePosition - centerExtent.xyz) / max(centerExtent.w * 2.0, 0.001) + 0.5;
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 geometry = geometryTexture.Load(int4((int3)voxelCoord, 0));
    occupancy = saturate(geometry.a);
    float3 decodedNormal = geometry.rgb * 2.0 - 1.0;
    float normalLengthSq = dot(decodedNormal, decodedNormal);
    if (occupancy <= 0.001 || normalLengthSq <= 0.0001)
    {
        return false;
    }

    normalWS = decodedNormal * rsqrt(normalLengthSq);
    normalFacingWeight = saturate(dot(normalWS, -normalize(traceDirection)) * 0.85 + 0.15);
    return normalFacingWeight > 0.001;
}

bool BurtGITrySampleSceneVoxelGeometry(
    float3 samplePosition,
    float3 traceDirection,
    out float3 normalWS,
    out float occupancy,
    out float normalFacingWeight)
{
    uint clipmapLevel = BurtGIResolveSceneVoxelClipmap(samplePosition);
    if (clipmapLevel == 1u)
    {
        return BurtGITrySampleSceneVoxelGeometryResource(_BurtGISceneVoxelClipmap1GeometryReadTexture, _BurtGISceneVoxelClipmapCenterExtent[1], samplePosition, traceDirection, normalWS, occupancy, normalFacingWeight);
    }

    if (clipmapLevel == 2u)
    {
        return BurtGITrySampleSceneVoxelGeometryResource(_BurtGISceneVoxelClipmap2GeometryReadTexture, _BurtGISceneVoxelClipmapCenterExtent[2], samplePosition, traceDirection, normalWS, occupancy, normalFacingWeight);
    }

    if (clipmapLevel == 3u)
    {
        return BurtGITrySampleSceneVoxelGeometryResource(_BurtGISceneVoxelClipmap3GeometryReadTexture, _BurtGISceneVoxelClipmapCenterExtent[3], samplePosition, traceDirection, normalWS, occupancy, normalFacingWeight);
    }

    normalWS = float3(0.0, 1.0, 0.0);
    occupancy = 0.0;
    normalFacingWeight = 0.0;

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGISceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 geometry = _BurtGISceneVoxelGeometryReadTexture.Load(int4((int)voxelCoord.x, (int)voxelCoord.y, (int)voxelCoord.z, 0));
    occupancy = saturate(geometry.a);
    if (occupancy <= 0.001)
    {
        return false;
    }

    float3 decodedNormal = geometry.rgb * 2.0 - 1.0;
    float normalLengthSq = dot(decodedNormal, decodedNormal);
    if (normalLengthSq <= 0.0001)
    {
        return false;
    }

    normalWS = decodedNormal * rsqrt(normalLengthSq);
    normalFacingWeight = saturate(dot(normalWS, -normalize(traceDirection)) * 0.85 + 0.15);
    return normalFacingWeight > 0.001;
}

bool BurtGITrySampleSceneVoxelOccupancyMipResource(
    Texture3D<float4> occupancyTexture,
    float4 centerExtent,
    float3 samplePosition,
    float sampleRadius,
    out float occupancy)
{
    occupancy = 0.0;
    uint width;
    uint height;
    uint depth;
    occupancyTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = (samplePosition - centerExtent.xyz) / max(centerExtent.w * 2.0, 0.001) + 0.5;
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    float voxelSizeWS = max(centerExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    uint mipLevel = (uint)clamp(
        floor(log2(max(sampleRadius, voxelSizeWS) / voxelSizeWS)),
        0.0,
        (float)(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_COUNT - 1u));
    uint3 mipSize = max(volumeSize >> mipLevel, uint3(1u, 1u, 1u));
    uint3 mipCoord = min((uint3)(uvw * (float3)mipSize), mipSize - 1u);
    float4 occupancyMip = occupancyTexture.Load(int4((int3)mipCoord, (int)mipLevel));
    occupancy = saturate(max(occupancyMip.x, occupancyMip.y));
    return occupancy > 0.001;
}

bool BurtGITrySampleSceneVoxelOccupancyMip(float3 samplePosition, float sampleRadius, out float occupancy)
{
    occupancy = 0.0;

    uint clipmapLevel = BurtGIResolveSceneVoxelClipmap(samplePosition);
    if (clipmapLevel == 1u)
    {
        return BurtGITrySampleSceneVoxelOccupancyMipResource(_BurtGISceneVoxelClipmap1OccupancyMipReadTexture, _BurtGISceneVoxelClipmapCenterExtent[1], samplePosition, sampleRadius, occupancy);
    }

    if (clipmapLevel == 2u)
    {
        return BurtGITrySampleSceneVoxelOccupancyMipResource(_BurtGISceneVoxelClipmap2OccupancyMipReadTexture, _BurtGISceneVoxelClipmapCenterExtent[2], samplePosition, sampleRadius, occupancy);
    }

    if (clipmapLevel == 3u)
    {
        return BurtGITrySampleSceneVoxelOccupancyMipResource(_BurtGISceneVoxelClipmap3OccupancyMipReadTexture, _BurtGISceneVoxelClipmapCenterExtent[3], samplePosition, sampleRadius, occupancy);
    }

    if (!BurtGISceneVoxelOctreeMayContain(samplePosition))
    {
        return false;
    }

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelOccupancyMipReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGISceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float voxelSizeWS = max(centerExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float mipLevel = clamp(
        floor(log2(max(sampleRadius, voxelSizeWS) / voxelSizeWS)),
        0.0,
        (float)(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_COUNT - 1u));
    float4 occupancyMip = _BurtGISceneVoxelOccupancyMipReadTexture.SampleLevel(
        sampler_BurtGISceneVoxelOccupancyMipReadTexture,
        uvw,
        mipLevel);
    occupancy = saturate(max(occupancyMip.x, occupancyMip.y));
    return occupancy > 0.001;
}

float BurtGITraceSceneVoxelDirectionalVisibility(float3 worldPosition, float3 direction, float maxDistance)
{
    float4 octreeCenterExtent = _BurtGISceneVoxelCenterExtent;
    float octreeVoxelSizeWS = max(octreeCenterExtent.w / 32.0, 0.001);
    float3 octreeDirection = normalize(direction);
    float octreeHitDistance;
    if (BurtGIRayTraceSceneVoxelOctree(
            worldPosition + octreeDirection * (octreeVoxelSizeWS * 1.5),
            octreeDirection,
            max(maxDistance - octreeVoxelSizeWS * 1.5, 0.0),
            octreeHitDistance))
    {
        return 0.0;
    }
    if (_BurtGISceneVoxelOctreeValid > 0.5)
    {
        return 1.0;
    }

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float voxelSizeWS = max(centerExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float3 traceDirection = normalize(direction);
    float transmittance = 1.0;
    float traceDistance = voxelSizeWS * 1.5;

    [unroll]
    for (uint stepIndex = 0u; stepIndex < 6u && traceDistance < maxDistance; ++stepIndex)
    {
        float sampleRadius = max(voxelSizeWS, traceDistance * 0.45);
        float occupancy;
        if (BurtGITrySampleSceneVoxelOccupancyMip(worldPosition + traceDirection * traceDistance, sampleRadius, occupancy))
        {
            transmittance *= 1.0 - saturate(occupancy * 0.55);
            if (transmittance <= 0.02)
            {
                return 0.0;
            }
        }

        traceDistance += max(voxelSizeWS, sampleRadius * 1.35);
    }

    return saturate(transmittance);
}

bool BurtGITrySampleSceneVoxelRadianceResource(
    Texture3D<float4> radianceTexture,
    Texture3D<float4> lightingTexture,
    float4 centerExtent,
    float3 samplePosition,
    float sampleRadius,
    out float3 radiance,
    out float confidence)
{
    radiance = 0.0;
    confidence = 0.0;
    uint width;
    uint height;
    uint depth;
    radianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = (samplePosition - centerExtent.xyz) / max(centerExtent.w * 2.0, 0.001) + 0.5;
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 voxelRadiance = radianceTexture.Load(int4((int3)voxelCoord, 0));
    float4 voxelLighting = lightingTexture.Load(int4((int3)voxelCoord, 0));
    if (voxelLighting.a > 0.001 && dot(voxelLighting.rgb, voxelLighting.rgb) > 0.0)
    {
        voxelRadiance = voxelLighting;
    }

    confidence = saturate(voxelRadiance.a);
    if (confidence <= 0.001 || dot(voxelRadiance.rgb, voxelRadiance.rgb) <= 0.0)
    {
        return false;
    }

    float voxelSizeWS = max(centerExtent.w * 2.0 / (float)max(volumeSize.x, 1u), 0.001);
    confidence *= lerp(0.5, 1.0, saturate(voxelSizeWS / max(voxelSizeWS, sampleRadius)));
    radiance = max(voxelRadiance.rgb, 0.0);
    return true;
}

bool BurtGITrySampleSceneVoxelRadiance(
    float3 samplePosition,
    float sampleRadius,
    out float3 radiance,
    out float confidence)
{
    radiance = 0.0;
    confidence = 0.0;

    uint clipmapLevel = BurtGIResolveSceneVoxelClipmap(samplePosition);
    if (clipmapLevel == 1u)
    {
        return BurtGITrySampleSceneVoxelRadianceResource(_BurtGISceneVoxelClipmap1RadianceReadTexture, _BurtGISceneVoxelClipmap1LightingReadTexture, _BurtGISceneVoxelClipmapCenterExtent[1], samplePosition, sampleRadius, radiance, confidence);
    }

    if (clipmapLevel == 2u)
    {
        return BurtGITrySampleSceneVoxelRadianceResource(_BurtGISceneVoxelClipmap2RadianceReadTexture, _BurtGISceneVoxelClipmap2LightingReadTexture, _BurtGISceneVoxelClipmapCenterExtent[2], samplePosition, sampleRadius, radiance, confidence);
    }

    if (clipmapLevel == 3u)
    {
        return BurtGITrySampleSceneVoxelRadianceResource(_BurtGISceneVoxelClipmap3RadianceReadTexture, _BurtGISceneVoxelClipmap3LightingReadTexture, _BurtGISceneVoxelClipmapCenterExtent[3], samplePosition, sampleRadius, radiance, confidence);
    }

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGISceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 voxelRadiance = _BurtGISceneVoxelRadianceReadTexture.Load(int4((int)voxelCoord.x, (int)voxelCoord.y, (int)voxelCoord.z, 0));
    float4 voxelLighting = _BurtGISceneVoxelLightingReadTexture.Load(int4((int)voxelCoord.x, (int)voxelCoord.y, (int)voxelCoord.z, 0));
    if (voxelLighting.a > 0.001 && dot(voxelLighting.rgb, voxelLighting.rgb) > 0.0)
    {
        voxelRadiance = voxelLighting;
    }

    confidence = saturate(voxelRadiance.a);
    if (confidence <= 0.001 || dot(voxelRadiance.rgb, voxelRadiance.rgb) <= 0.0)
    {
        return false;
    }

    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float voxelSizeWS = max(centerExtent.w * 2.0 / (float)max(volumeSize.x, 1u), 0.001);
    float footprintWeight = saturate(voxelSizeWS / max(voxelSizeWS, sampleRadius));
    radiance = max(voxelRadiance.rgb, 0.0);
    confidence *= lerp(0.5, 1.0, footprintWeight);
    return true;
}

bool BurtGITrySampleSceneVoxelConeTrace(
    float3 probeWorldCenter,
    float3 direction,
    float coneHalfAngle,
    float minSampleRadius,
    float minTraceDistance,
    float maxTraceDistance,
    float stepFactor,
    out float3 radiance,
    out float hitDistance,
    out float confidence)
{
    radiance = 0.0;
    hitDistance = maxTraceDistance;
    confidence = 0.0;

    if (maxTraceDistance <= minTraceDistance)
    {
        return false;
    }

    float3 accumulatedRadiance = 0.0;
    float accumulatedWeight = 0.0;
    float nearestHitDistance = maxTraceDistance;
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float voxelSizeWS = max(centerExtent.w / 32.0, 0.001);
    float tanConeHalfAngle = min(tan(coneHalfAngle), 8.0);
    float traceRange = max(maxTraceDistance - minTraceDistance, 0.001);
    float traceDistance = minTraceDistance;

    uint maxTraceSteps = min((uint)max(_BurtGISceneVoxelTraceControls.x, 1.0), 64u);
    [loop]
    for (uint stepIndex = 0u; stepIndex < maxTraceSteps; ++stepIndex)
    {
        if (traceDistance >= maxTraceDistance)
        {
            break;
        }

        float sampleRadius = max(minSampleRadius, traceDistance * tanConeHalfAngle);
        float stepLength = max(voxelSizeWS, sampleRadius * max(stepFactor * max(_BurtGISceneVoxelTraceControls.y, 0.1), 0.25));
        float sampleDistance = min(traceDistance + stepLength * 0.5, maxTraceDistance);
        float stepFraction = saturate((sampleDistance - minTraceDistance) / traceRange);
        float3 samplePosition = probeWorldCenter + direction * sampleDistance;

        float coarseOccupancy;
        if (!BurtGITrySampleSceneVoxelOccupancyMip(samplePosition, sampleRadius, coarseOccupancy))
        {
            traceDistance += max(stepLength, voxelSizeWS * 2.0);
            continue;
        }

        float3 sampleRadiance;
        float sampleConfidence;
        if (BurtGITrySampleSceneVoxelRadiance(samplePosition, sampleRadius, sampleRadiance, sampleConfidence))
        {
            float3 sampleNormal;
            float sampleOccupancy;
            float sampleNormalFacingWeight;
            if (!BurtGITrySampleSceneVoxelGeometry(samplePosition, direction, sampleNormal, sampleOccupancy, sampleNormalFacingWeight))
            {
                traceDistance += stepLength;
                continue;
            }

            sampleConfidence *= saturate(max(coarseOccupancy, sampleOccupancy) * sampleNormalFacingWeight);
            float nearWeight = lerp(1.0, 0.4, stepFraction);
            float sampleWeight = sampleConfidence * nearWeight;
            accumulatedRadiance += sampleRadiance * sampleWeight;
            accumulatedWeight += sampleWeight;
            nearestHitDistance = min(nearestHitDistance, sampleDistance);
        }

        traceDistance += stepLength;
    }

    if (accumulatedWeight <= 0.001)
    {
        return false;
    }

    radiance = max(accumulatedRadiance / accumulatedWeight, 0.0);
    hitDistance = nearestHitDistance;
    confidence = saturate(accumulatedWeight * 0.35);
    return confidence > 0.001;
}

bool BurtGITrySampleRadianceCacheHashGridSceneCache(
    float3 probeWorldCenter,
    float3 direction,
    float coneHalfAngle,
    float minSampleRadius,
    float minTraceDistance,
    float maxTraceDistance,
    float stepFactor,
    out float3 radiance,
    out float hitDistance,
    out float confidence)
{
    radiance = 0.0;
    hitDistance = maxTraceDistance;
    confidence = 0.0;

    if (maxTraceDistance <= minTraceDistance)
    {
        return false;
    }

    float3 accumulatedRadiance = 0.0;
    float accumulatedWeight = 0.0;
    float nearestHitDistance = maxTraceDistance;
    float hashGridCellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    float tanConeHalfAngle = min(tan(coneHalfAngle), 8.0);
    float traceRange = max(maxTraceDistance - minTraceDistance, 0.001);
    float traceDistance = minTraceDistance;

    [loop]
    for (uint stepIndex = 0u; stepIndex < 8u; ++stepIndex)
    {
        if (traceDistance >= maxTraceDistance)
        {
            break;
        }

        float sampleRadius = max(minSampleRadius, traceDistance * tanConeHalfAngle);
        float stepLength = max(hashGridCellSize * 0.5, sampleRadius * max(stepFactor, 0.25));
        float sampleDistance = min(traceDistance + stepLength * 0.5, maxTraceDistance);
        float stepFraction = saturate((sampleDistance - minTraceDistance) / traceRange);
        float3 samplePosition = probeWorldCenter + direction * sampleDistance;
        uint tileHash = BurtGIRadianceCacheHashGridTileHash(samplePosition, direction);
        uint tileIndex;
        if (!BurtGIRadianceCacheHashGridFindTile(tileHash, tileIndex))
        {
            traceDistance += stepLength;
            continue;
        }

        uint localCellIndex = BurtGIRadianceCacheHashGridLocalCell(samplePosition, direction);
        uint cellIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(tileIndex, localCellIndex);
        uint4 packedValue = _BurtGIRadianceCacheHashGridValueBuffer[cellIndex];
        float4 cachedRadiance = BurtGIRadianceCacheHashGridUnpackRadiance(packedValue);
        float cachedConfidence = saturate(cachedRadiance.a * BurtGIRadianceCacheHashGridAgeConfidenceScale(packedValue));
        if (cachedConfidence <= 0.001 || dot(cachedRadiance.rgb, cachedRadiance.rgb) <= 0.0)
        {
            traceDistance += stepLength;
            continue;
        }

        float nearWeight = lerp(1.0, 0.45, stepFraction);
        float footprintWeight = saturate(hashGridCellSize / max(hashGridCellSize, sampleRadius));
        float sampleWeight = cachedConfidence * nearWeight * lerp(0.5, 1.0, footprintWeight);
        accumulatedRadiance += cachedRadiance.rgb * sampleWeight;
        accumulatedWeight += sampleWeight;
        nearestHitDistance = min(nearestHitDistance, sampleDistance);
        traceDistance += stepLength;
    }

    if (accumulatedWeight <= 0.001)
    {
        return false;
    }

    radiance = max(accumulatedRadiance / accumulatedWeight, 0.0);
    hitDistance = nearestHitDistance;
    confidence = saturate(accumulatedWeight * 0.3);
    return confidence > 0.001;
}

float4 BurtGIRadianceCacheHashGridCombineMipRadiance(float4 radiance00, float4 radiance10, float4 radiance01, float4 radiance11)
{
    float totalWeight = radiance00.a + radiance10.a + radiance01.a + radiance11.a;
    float3 weightedRadiance =
        radiance00.rgb * radiance00.a +
        radiance10.rgb * radiance10.a +
        radiance01.rgb * radiance01.a +
        radiance11.rgb * radiance11.a;

    return totalWeight > 0.0001
        ? float4(weightedRadiance / totalWeight, saturate(totalWeight))
        : float4(0.0, 0.0, 0.0, 0.0);
}

[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void SceneVoxelClearLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    if (dispatchThreadId.x >= width || dispatchThreadId.y >= height || dispatchThreadId.z >= depth)
    {
        return;
    }

    _BurtGISceneVoxelRadianceTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
    _BurtGISceneVoxelGeometryTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
    _BurtGISceneVoxelLightingTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
}

[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void SceneVoxelReprojectHistoryCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = uint3(width, height, depth);
    if (any(dispatchThreadId >= volumeSize))
    {
        return;
    }

    float3 currentUVW = (float3(dispatchThreadId) + 0.5) / max(float3(volumeSize), 1.0);
    float3 worldPosition = (currentUVW * 2.0 - 1.0) * _BurtGISceneVoxelHistoryCurrentCenterExtent.www + _BurtGISceneVoxelHistoryCurrentCenterExtent.xyz;
    float3 historyUVW = (worldPosition - _BurtGISceneVoxelHistoryPreviousCenterExtent.xyz) /
        max(_BurtGISceneVoxelHistoryPreviousCenterExtent.www, 0.0001) * 0.5 + 0.5;
    if (any(historyUVW < 0.0) || any(historyUVW > 1.0))
    {
        return;
    }

    _BurtGISceneVoxelRadianceTexture[dispatchThreadId] = _BurtGISceneVoxelHistoryRadianceTexture.SampleLevel(sampler_BurtGISceneVoxelHistoryRadianceTexture, historyUVW, 0.0);
    _BurtGISceneVoxelGeometryTexture[dispatchThreadId] = _BurtGISceneVoxelHistoryGeometryTexture.SampleLevel(sampler_BurtGISceneVoxelHistoryGeometryTexture, historyUVW, 0.0);
    _BurtGISceneVoxelLightingTexture[dispatchThreadId] = _BurtGISceneVoxelHistoryLightingTexture.SampleLevel(sampler_BurtGISceneVoxelHistoryLightingTexture, historyUVW, 0.0);
}

[numthreads(BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_POPULATE_THREADGROUP_SIZE, 1)]
void SceneVoxelPopulateScreenProbesLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 screenProbeGridSize = BurtGIScreenProbeGridSize();
    uint2 screenProbeCoord = dispatchThreadId.xy;
    if (screenProbeCoord.x >= screenProbeGridSize.x || screenProbeCoord.y >= screenProbeGridSize.y)
    {
        return;
    }

    float4 worldPositionValue = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    if (worldPositionValue.w <= 0.0001)
    {
        return;
    }

    float4 worldNormalValue = _BurtGIScreenProbeWorldNormalTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    if (worldNormalValue.w <= 0.0001)
    {
        return;
    }

    float3 decodedWorldNormal = worldNormalValue.xyz * 2.0 - 1.0;
    float normalLengthSq = dot(decodedWorldNormal, decodedWorldNormal);
    if (normalLengthSq <= 0.0001)
    {
        return;
    }

    float3 normalWS = decodedWorldNormal * rsqrt(normalLengthSq);
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGISceneVoxelWorldToUVW(worldPositionValue.xyz);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return;
    }

    uint rawWidth;
    uint rawHeight;
    _BurtScreenSpaceGlobalIlluminationRawTexture.GetDimensions(rawWidth, rawHeight);
    uint2 rawSize = max(uint2(rawWidth, rawHeight), uint2(1u, 1u));
    float2 sourceUV = (float2(screenProbeCoord) + 0.5) / (float2)screenProbeGridSize;
    uint2 rawCoord = min((uint2)(saturate(sourceUV) * (float2)rawSize), rawSize - 1u);
    float3 radiance = max(_BurtScreenSpaceGlobalIlluminationRawTexture.Load(int3((int)rawCoord.x, (int)rawCoord.y, 0)).rgb, 0.0);
    float confidence = saturate(worldPositionValue.w * worldNormalValue.w);
    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 existingRadiance = _BurtGISceneVoxelRadianceTexture[voxelCoord];
    float4 existingGeometry = _BurtGISceneVoxelGeometryTexture[voxelCoord];
    float sourceConfidence = saturate(max(existingRadiance.a, existingGeometry.a));
    float screenWeight = confidence * (1.0 - sourceConfidence * 0.75);
    float totalWeight = max(sourceConfidence + screenWeight, 0.0001);
    float3 existingNormalWS = existingGeometry.xyz * 2.0 - 1.0;
    float existingNormalLengthSq = dot(existingNormalWS, existingNormalWS);
    existingNormalWS = existingNormalLengthSq > 0.0001 ? existingNormalWS * rsqrt(existingNormalLengthSq) : normalWS;
    float3 blendedNormalWS = existingNormalWS * sourceConfidence + normalWS * screenWeight;
    float blendedNormalLengthSq = dot(blendedNormalWS, blendedNormalWS);
    blendedNormalWS = blendedNormalLengthSq > 0.0001 ? blendedNormalWS * rsqrt(blendedNormalLengthSq) : normalWS;
    float3 blendedRadiance = (max(existingRadiance.rgb, 0.0) * sourceConfidence + radiance * screenWeight) / totalWeight;
    float blendedConfidence = saturate(max(sourceConfidence, confidence));
    _BurtGISceneVoxelRadianceTexture[voxelCoord] = float4(blendedRadiance, blendedConfidence);
    _BurtGISceneVoxelGeometryTexture[voxelCoord] = float4(blendedNormalWS * 0.5 + 0.5, blendedConfidence);
}

[numthreads(64, 1, 1)]
void SceneVoxelVoxelizeTrianglesCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint triangleIndex = dispatchThreadId.x;
    if (triangleIndex >= _BurtGISceneVoxelTriangleCount)
    {
        return;
    }

    BurtGISceneVoxelTriangle triangle = _BurtGISceneVoxelTriangleBuffer[triangleIndex];
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelRadianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float voxelSizeWS = max(_BurtGISceneVoxelCenterExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float edgeLength01 = length(triangle.Position1 - triangle.Position0);
    float edgeLength12 = length(triangle.Position2 - triangle.Position1);
    float edgeLength20 = length(triangle.Position0 - triangle.Position2);
    uint sampleResolution = (uint)clamp(ceil(max(edgeLength01, max(edgeLength12, edgeLength20)) / voxelSizeWS), 1.0, 16.0);
    float3 normalWS = normalize(triangle.Normal);
    float3 baseColorBoosted = min(saturate(pow(max(triangle.Albedo, 0.0), _BurtGISceneVoxelLightingParams.x)), 0.99);
    float3 radiance = baseColorBoosted * 0.12 + max(triangle.Emission, 0.0);

    [loop]
    for (uint sampleY = 0u; sampleY <= sampleResolution; ++sampleY)
    {
        [loop]
        for (uint sampleX = 0u; sampleX <= sampleResolution - sampleY; ++sampleX)
        {
            float barycentricY = (float)sampleY / max((float)sampleResolution, 1.0);
            float barycentricX = (float)sampleX / max((float)sampleResolution, 1.0);
            float barycentricZ = 1.0 - barycentricX - barycentricY;
            float3 samplePosition = triangle.Position0 * barycentricZ + triangle.Position1 * barycentricX + triangle.Position2 * barycentricY;
            float3 uvw = BurtGISceneVoxelWorldToUVW(samplePosition);
            if (any(uvw < 0.0) || any(uvw > 1.0))
            {
                continue;
            }

            uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
            float4 previousRadiance = _BurtGISceneVoxelRadianceTexture[voxelCoord];
            float4 previousGeometry = _BurtGISceneVoxelGeometryTexture[voxelCoord];
            float previousConfidence = saturate(max(previousRadiance.a, previousGeometry.a));
            float writeWeight = 1.0 / max(1.0 + previousConfidence, 1.0);
            float3 blendedRadiance = lerp(max(previousRadiance.rgb, 0.0), radiance, writeWeight);
            float3 previousNormalWS = previousGeometry.xyz * 2.0 - 1.0;
            float previousNormalLengthSq = dot(previousNormalWS, previousNormalWS);
            previousNormalWS = previousNormalLengthSq > 0.0001 ? previousNormalWS * rsqrt(previousNormalLengthSq) : normalWS;
            float3 blendedNormalWS = normalize(lerp(previousNormalWS, normalWS, writeWeight));
            _BurtGISceneVoxelRadianceTexture[voxelCoord] = float4(blendedRadiance, 1.0);
            _BurtGISceneVoxelGeometryTexture[voxelCoord] = float4(blendedNormalWS * 0.5 + 0.5, 1.0);
        }
    }
}

[numthreads(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE)]
void SceneVoxelBuildOccupancyMipLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint mipWidth;
    uint mipHeight;
    uint mipDepth;
    _BurtGISceneVoxelOccupancyMipTexture.GetDimensions(mipWidth, mipHeight, mipDepth);
    if (dispatchThreadId.x >= mipWidth || dispatchThreadId.y >= mipHeight || dispatchThreadId.z >= mipDepth)
    {
        return;
    }

    uint sourceWidth;
    uint sourceHeight;
    uint sourceDepth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(sourceWidth, sourceHeight, sourceDepth);
    uint3 sourceSize = max(uint3(sourceWidth, sourceHeight, sourceDepth), uint3(1u, 1u, 1u));
    uint3 mipSize = max(uint3(mipWidth, mipHeight, mipDepth), uint3(1u, 1u, 1u));
    uint3 blockSize = max(sourceSize / mipSize, uint3(1u, 1u, 1u));
    uint3 sourceBase = dispatchThreadId * blockSize;

    float maxOccupancy = 0.0;
    float occupancySum = 0.0;
    float sampleCount = 0.0;

    [loop]
    for (uint z = 0u; z < blockSize.z; ++z)
    {
        [loop]
        for (uint y = 0u; y < blockSize.y; ++y)
        {
            [loop]
            for (uint x = 0u; x < blockSize.x; ++x)
            {
                uint3 sourceCoord = min(sourceBase + uint3(x, y, z), sourceSize - 1u);
                float occupancy = saturate(_BurtGISceneVoxelGeometryReadTexture.Load(int4((int)sourceCoord.x, (int)sourceCoord.y, (int)sourceCoord.z, 0)).a);
                maxOccupancy = max(maxOccupancy, occupancy);
                occupancySum += occupancy;
                sampleCount += 1.0;
            }
        }
    }

    float meanOccupancy = sampleCount > 0.0 ? occupancySum / sampleCount : 0.0;
    _BurtGISceneVoxelOccupancyMipTexture[dispatchThreadId] = float4(maxOccupancy, meanOccupancy, saturate(occupancySum), 1.0);
}

[numthreads(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_THREADGROUP_SIZE)]
void SceneVoxelDownsampleOccupancyMipCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint targetWidth;
    uint targetHeight;
    uint targetDepth;
    _BurtGISceneVoxelOccupancyMipTexture.GetDimensions(targetWidth, targetHeight, targetDepth);
    uint3 targetSize = max(uint3(targetWidth, targetHeight, targetDepth), uint3(1u, 1u, 1u));
    if (any(dispatchThreadId >= targetSize))
    {
        return;
    }

    uint3 sourceSize = max(targetSize * 2u, uint3(1u, 1u, 1u));
    uint3 sourceBase = dispatchThreadId * 2u;
    float maxOccupancy = 0.0;
    float meanOccupancy = 0.0;
    float coverage = 0.0;

    [unroll]
    for (uint z = 0u; z < 2u; ++z)
    {
        [unroll]
        for (uint y = 0u; y < 2u; ++y)
        {
            [unroll]
            for (uint x = 0u; x < 2u; ++x)
            {
                uint3 sourceCoord = min(sourceBase + uint3(x, y, z), sourceSize - 1u);
                float4 sourceOccupancy = _BurtGISceneVoxelOccupancyMipReadTexture.Load(int4(
                    (int)sourceCoord.x,
                    (int)sourceCoord.y,
                    (int)sourceCoord.z,
                    (int)_BurtGISceneVoxelOccupancyMipSourceMip));
                maxOccupancy = max(maxOccupancy, saturate(sourceOccupancy.x));
                meanOccupancy += saturate(sourceOccupancy.y);
                coverage += saturate(sourceOccupancy.z);
            }
        }
    }

    _BurtGISceneVoxelOccupancyMipTexture[dispatchThreadId] = float4(
        maxOccupancy,
        meanOccupancy * 0.125,
        saturate(coverage * 0.125),
        1.0);
}

float3 BurtGISceneVoxelEvaluateAdditionalLights(float3 worldPosition, float3 normalWS)
{
    float3 lighting = 0.0;
    uint additionalLightCount = min(_BurtGIAdditionalLightCount, 8u);
    [loop]
    for (uint lightIndex = 0u; lightIndex < additionalLightCount; ++lightIndex)
    {
        float4 positionAndRange = _BurtGIAdditionalLightPositionAndRange[lightIndex];
        float4 colorAndType = _BurtGIAdditionalLightColorAndType[lightIndex];
        float lightType = colorAndType.w;
        float3 lightDirection;
        float attenuation = 1.0;

        if (lightType < 0.5)
        {
            lightDirection = normalize(_BurtGIAdditionalLightDirectionAndSpot[lightIndex].xyz);
        }
        else
        {
            float3 toLight = positionAndRange.xyz - worldPosition;
            float distanceToLight = length(toLight);
            float lightRange = max(positionAndRange.w, 0.001);
            if (distanceToLight >= lightRange)
            {
                continue;
            }

            lightDirection = toLight / max(distanceToLight, 0.0001);
            float rangeAttenuation = saturate(1.0 - distanceToLight / lightRange);
            attenuation = rangeAttenuation * rangeAttenuation;

            if (lightType > 1.5)
            {
                float3 lightForward = normalize(_BurtGIAdditionalLightDirectionAndSpot[lightIndex].xyz);
                float4 spotParams = _BurtGIAdditionalLightSpotParams[lightIndex];
                float lightToSurfaceCos = dot(lightForward, -lightDirection);
                attenuation *= saturate((lightToSurfaceCos - spotParams.y) * spotParams.z);
            }
        }

        lighting += max(colorAndType.rgb, 0.0) * (saturate(dot(normalWS, lightDirection)) * attenuation);
    }

    return lighting;
}

uint BurtGISceneVoxelResolveXGILightGridLevel(float3 worldPosition)
{
    [unroll]
    for (uint level = 0u; level < 4u; ++level)
    {
        if (all(worldPosition >= _BurtGIXGILightGridBoundMin[level].xyz) && all(worldPosition <= _BurtGIXGILightGridBoundMax[level].xyz))
        {
            return level;
        }
    }

    return 0u;
}

uint BurtGISceneVoxelResolveXGILightGridCell(float3 worldPosition, uint level)
{
    uint resolution = max(1u, _BurtGIXGILightGridResolution);
    float3 boundMin = _BurtGIXGILightGridBoundMin[level].xyz;
    float3 boundSize = max(_BurtGIXGILightGridBoundMax[level].xyz - boundMin, 0.0001);
    float3 normalizedPosition = saturate((worldPosition - boundMin) / boundSize);
    uint axis = min((uint)max(_BurtGIXGILightGridAxis[level].x, 0.0), 2u);
    uint2 coord = axis == 0u
        ? min((uint2)floor(normalizedPosition.yz * resolution), resolution - 1u)
        : axis == 1u
            ? min((uint2)floor(normalizedPosition.xz * resolution), resolution - 1u)
            : min((uint2)floor(normalizedPosition.xy * resolution), resolution - 1u);
    return level * resolution * resolution + coord.x + coord.y * resolution;
}

float3 BurtGISceneVoxelEvaluateXGILightGrid(float3 worldPosition, float3 normalWS)
{
    if (_BurtGIXGILightGridValid == 0u)
    {
        return BurtGISceneVoxelEvaluateAdditionalLights(worldPosition, normalWS);
    }

    uint level = BurtGISceneVoxelResolveXGILightGridLevel(worldPosition);
    uint cellIndex = BurtGISceneVoxelResolveXGILightGridCell(worldPosition, level);
    uint lightCount = min(_BurtGIXGILightGridCount[cellIndex], _BurtGIXGILightGridMaxLights);
    float3 lighting = 0.0;
    [loop]
    for (uint listIndex = 0u; listIndex < lightCount; ++listIndex)
    {
        uint lightIndex = _BurtGIXGILightGridList[cellIndex * _BurtGIXGILightGridMaxLights + listIndex];
        uint lightDataIndex = lightIndex * 4u;
        float4 positionAndRange = _BurtGIXGILightData[lightDataIndex];
        float4 colorAndType = _BurtGIXGILightData[lightDataIndex + 1u];
        float3 lightDirection = _BurtGIXGILightData[lightDataIndex + 2u].xyz;
        float attenuation = 1.0;

        if (colorAndType.w >= 0.5)
        {
            float3 toLight = positionAndRange.xyz - worldPosition;
            float distanceToLight = length(toLight);
            float lightRange = max(positionAndRange.w, 0.001);
            if (distanceToLight >= lightRange)
            {
                continue;
            }

            lightDirection = toLight / max(distanceToLight, 0.0001);
            float rangeAttenuation = saturate(1.0 - distanceToLight / lightRange);
            attenuation = rangeAttenuation * rangeAttenuation;
            if (colorAndType.w > 1.5)
            {
                float4 spotParams = _BurtGIXGILightData[lightDataIndex + 3u];
                attenuation *= saturate((dot(normalize(_BurtGIXGILightData[lightDataIndex + 2u].xyz), -lightDirection) - spotParams.y) * spotParams.z);
            }
        }

        lighting += max(colorAndType.rgb, 0.0) * (saturate(dot(normalWS, normalize(lightDirection))) * attenuation);
    }

    return lighting;
}

[numthreads(BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_LIGHTING_THREADGROUP_SIZE)]
void SceneVoxelBuildLightingLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelLightingTexture.GetDimensions(width, height, depth);
    if (dispatchThreadId.x >= width || dispatchThreadId.y >= height || dispatchThreadId.z >= depth)
    {
        return;
    }

    float4 radiance = _BurtGISceneVoxelRadianceReadTexture.Load(int4((int)dispatchThreadId.x, (int)dispatchThreadId.y, (int)dispatchThreadId.z, 0));
    float4 geometry = _BurtGISceneVoxelGeometryReadTexture.Load(int4((int)dispatchThreadId.x, (int)dispatchThreadId.y, (int)dispatchThreadId.z, 0));
    float occupancy = saturate(geometry.a);
    if (occupancy <= 0.001 || radiance.a <= 0.001)
    {
        _BurtGISceneVoxelLightingTexture[dispatchThreadId] = float4(0.0, 0.0, 0.0, 0.0);
        return;
    }

    float3 normalWS = geometry.rgb * 2.0 - 1.0;
    float normalLengthSq = dot(normalWS, normalWS);
    normalWS = normalLengthSq > 0.0001 ? normalWS * rsqrt(normalLengthSq) : float3(0.0, 1.0, 0.0);

    uint mipWidth;
    uint mipHeight;
    uint mipDepth;
    _BurtGISceneVoxelOccupancyMipReadTexture.GetDimensions(mipWidth, mipHeight, mipDepth);
    uint3 mipSize = max(uint3(mipWidth, mipHeight, mipDepth), uint3(1u, 1u, 1u));
    uint3 fullSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    uint3 mipCoord = min((dispatchThreadId * mipSize) / fullSize, mipSize - 1u);
    float coarseOccupancy = saturate(_BurtGISceneVoxelOccupancyMipReadTexture.Load(int4((int)mipCoord.x, (int)mipCoord.y, (int)mipCoord.z, 0)).x);

    float hemi = saturate(normalWS.y * 0.5 + 0.5);
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float traceDistance = max(centerExtent.w * 1.25, 1.0);
    float3 worldPosition = centerExtent.xyz + (((float3(dispatchThreadId) + 0.5) / (float3)fullSize) - 0.5) * (centerExtent.w * 2.0);
    float skyVisibility = BurtGITraceSceneVoxelDirectionalVisibility(worldPosition, normalWS, traceDistance);
    float3 skyTint = lerp(float3(0.015, 0.018, 0.022), float3(0.08, 0.095, 0.12), hemi) * skyVisibility;
    float normalBoost = lerp(0.75, 1.2, saturate(dot(normalWS, normalize(float3(0.35, 0.75, 0.45))) * 0.5 + 0.5));
    float3 mainLightDirection = _BurtGIMainLightDirection.xyz;
    float mainLightDirectionLengthSq = dot(mainLightDirection, mainLightDirection);
    mainLightDirection = mainLightDirectionLengthSq > 0.0001
        ? mainLightDirection * rsqrt(mainLightDirectionLengthSq)
        : float3(0.0, 1.0, 0.0);
    float mainLightNdotL = saturate(dot(normalWS, mainLightDirection));
    float mainLightVisibility = BurtGITraceSceneVoxelDirectionalVisibility(worldPosition, mainLightDirection, traceDistance);
    float3 mainLightRadiance = max(_BurtGIMainLightColor.rgb, 0.0) * (mainLightNdotL * mainLightVisibility);
    float3 additionalLightRadiance = BurtGISceneVoxelEvaluateXGILightGrid(worldPosition, normalWS);
    float3 directLighting = (normalBoost.xxx + mainLightRadiance + additionalLightRadiance) *
        (max(_BurtGISceneVoxelDirectLightTint.rgb, 0.0) * max(_BurtGISceneVoxelLightingParams.z, 0.0));
    float3 indirectLighting = skyTint * (max(_BurtGISceneVoxelIndirectLightTint.rgb, 0.0) * max(_BurtGISceneVoxelLightingParams.w, 0.0));
    float3 lighting = max(radiance.rgb, 0.0) * directLighting + indirectLighting * radiance.a;

    float grey = dot(lighting, float3(0.299, 0.587, 0.114));
    float3 adjustedLighting = lerp(grey.xxx, lighting, saturate(_BurtGISceneVoxelLightingParams.y));
    lighting = lighting.g > (lighting.b + lighting.r) * 0.6 ? adjustedLighting : lighting;

    float luminance = dot(lighting, float3(0.2126, 0.7152, 0.0722));
    lighting = lerp(lighting, luminance.xxx, saturate(coarseOccupancy * 0.18));
    lighting = max(lighting, 0.0);
    _BurtGISceneVoxelLightingTexture[dispatchThreadId] = float4(lighting, saturate(radiance.a * occupancy));
}

void BurtGISetOctreeMaskBit(uint bitIndex, inout uint lowMask, inout uint highMask)
{
    if (bitIndex < 32u)
    {
        lowMask |= 1u << bitIndex;
    }
    else
    {
        highMask |= 1u << (bitIndex - 32u);
    }
}

bool BurtGIOctreeNodeOccupied(uint lowMask, uint highMask)
{
    return lowMask != 0u || highMask != 0u;
}

[numthreads(1, 1, 1)]
void SceneVoxelBuildOctreeLeafCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint leafWidth;
    uint leafHeight;
    uint leafDepth;
    _BurtGISceneVoxelOctreeLeafLowTexture.GetDimensions(leafWidth, leafHeight, leafDepth);
    if (any(dispatchThreadId >= uint3(leafWidth, leafHeight, leafDepth)))
    {
        return;
    }

    uint geometryWidth;
    uint geometryHeight;
    uint geometryDepth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(geometryWidth, geometryHeight, geometryDepth);
    uint3 geometrySize = max(uint3(geometryWidth, geometryHeight, geometryDepth), uint3(1u, 1u, 1u));
    uint3 baseCoord = dispatchThreadId * 4u;
    uint lowMask = 0u;
    uint highMask = 0u;
    [unroll]
    for (uint z = 0u; z < 4u; ++z)
    {
        [unroll]
        for (uint y = 0u; y < 4u; ++y)
        {
            [unroll]
            for (uint x = 0u; x < 4u; ++x)
            {
                uint3 voxelCoord = baseCoord + uint3(x, y, z);
                if (any(voxelCoord >= geometrySize))
                {
                    continue;
                }

                float occupancy = saturate(_BurtGISceneVoxelGeometryReadTexture.Load(int4(voxelCoord, 0)).a);
                if (occupancy > 0.001)
                {
                    BurtGISetOctreeMaskBit(x + y * 4u + z * 16u, lowMask, highMask);
                }
            }
        }
    }

    _BurtGISceneVoxelOctreeLeafLowTexture[dispatchThreadId] = lowMask;
    _BurtGISceneVoxelOctreeLeafHighTexture[dispatchThreadId] = highMask;
}

[numthreads(1, 1, 1)]
void SceneVoxelBuildOctreeParentCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint parentWidth;
    uint parentHeight;
    uint parentDepth;
    _BurtGISceneVoxelOctreeParentLowTexture.GetDimensions(parentWidth, parentHeight, parentDepth);
    if (any(dispatchThreadId >= uint3(parentWidth, parentHeight, parentDepth)))
    {
        return;
    }

    uint leafWidth;
    uint leafHeight;
    uint leafDepth;
    _BurtGISceneVoxelOctreeLeafLowTexture.GetDimensions(leafWidth, leafHeight, leafDepth);
    uint3 leafSize = uint3(leafWidth, leafHeight, leafDepth);
    uint3 baseCoord = dispatchThreadId * 4u;
    uint lowMask = 0u;
    uint highMask = 0u;
    [unroll]
    for (uint z = 0u; z < 4u; ++z)
    {
        [unroll]
        for (uint y = 0u; y < 4u; ++y)
        {
            [unroll]
            for (uint x = 0u; x < 4u; ++x)
            {
                uint3 childCoord = baseCoord + uint3(x, y, z);
                if (any(childCoord >= leafSize))
                {
                    continue;
                }

                uint low = _BurtGISceneVoxelOctreeLeafLowTexture[childCoord];
                uint high = _BurtGISceneVoxelOctreeLeafHighTexture[childCoord];
                if (BurtGIOctreeNodeOccupied(low, high))
                {
                    BurtGISetOctreeMaskBit(x + y * 4u + z * 16u, lowMask, highMask);
                }
            }
        }
    }

    _BurtGISceneVoxelOctreeParentLowTexture[dispatchThreadId] = lowMask;
    _BurtGISceneVoxelOctreeParentHighTexture[dispatchThreadId] = highMask;
}

[numthreads(1, 1, 1)]
void SceneVoxelBuildOctreeRootCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint rootWidth;
    uint rootHeight;
    uint rootDepth;
    _BurtGISceneVoxelOctreeRootLowTexture.GetDimensions(rootWidth, rootHeight, rootDepth);
    if (any(dispatchThreadId >= uint3(rootWidth, rootHeight, rootDepth)))
    {
        return;
    }

    uint parentWidth;
    uint parentHeight;
    uint parentDepth;
    _BurtGISceneVoxelOctreeParentLowTexture.GetDimensions(parentWidth, parentHeight, parentDepth);
    uint3 parentSize = uint3(parentWidth, parentHeight, parentDepth);
    uint lowMask = 0u;
    uint highMask = 0u;
    [unroll]
    for (uint z = 0u; z < 4u; ++z)
    {
        [unroll]
        for (uint y = 0u; y < 4u; ++y)
        {
            [unroll]
            for (uint x = 0u; x < 4u; ++x)
            {
                uint3 childCoord = uint3(x, y, z);
                if (any(childCoord >= parentSize))
                {
                    continue;
                }

                uint low = _BurtGISceneVoxelOctreeParentLowTexture[childCoord];
                uint high = _BurtGISceneVoxelOctreeParentHighTexture[childCoord];
                if (BurtGIOctreeNodeOccupied(low, high))
                {
                    BurtGISetOctreeMaskBit(x + y * 4u + z * 16u, lowMask, highMask);
                }
            }
        }
    }

    _BurtGISceneVoxelOctreeRootLowTexture[dispatchThreadId] = lowMask;
    _BurtGISceneVoxelOctreeRootHighTexture[dispatchThreadId] = highMask;
}

[numthreads(BURT_GI_HASH_GRID_PREPARE_THREADGROUP_SIZE, 1, 1)]
void RadianceCacheHashGridPrepareLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint linearIndex = dispatchThreadId.x;
    uint cellCount = BurtGIRadianceCacheHashGridCellCount();
    uint tileCount = BurtGIRadianceCacheHashGridTileCount();
    uint traceTexelCount = BurtGIRadianceCacheHashGridTraceTexelCount();
    uint updateCellValueCount = cellCount * 4u;

    if (linearIndex < 2u)
    {
        _BurtGIRadianceCacheHashGridCountBuffer[linearIndex] = 0u;
    }

    if (linearIndex == 0u)
    {
        _BurtGIRadianceCacheHashGridCountBuffer[BurtGIRadianceCacheHashGridPackedTileCountIndex()] = 0u;
    }

    if (linearIndex < cellCount)
    {
        _BurtGIRadianceCacheHashGridDebugCellBuffer[linearIndex + 1u] = 0.0;
    }

    if (linearIndex < traceTexelCount)
    {
        _BurtGIRadianceCacheHashGridVisibilityCellQueryBuffer[linearIndex] = uint2(0xffffffffu, 0xffffffffu);
    }

    if (linearIndex < updateCellValueCount)
    {
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[linearIndex] = 0u;
    }

    if (linearIndex < min(traceTexelCount, cellCount))
    {
        _BurtGIRadianceCacheHashGridUpdateTileBuffer[linearIndex] = 0xffffffffu;
    }

    if (linearIndex == 0u)
    {
        _BurtGIRadianceCacheHashGridDebugCellBuffer[0] = float4(cellCount, tileCount, traceTexelCount, 3.0);
        _BurtGIRadianceCacheHashGridDebugDrawArgsBuffer[0] = uint4(0u, 1u, 0u, 0u);
    }
}

[numthreads(BURT_GI_HASH_GRID_POPULATE_THREADGROUP_SIZE, 1, 1)]
void RadianceCacheHashGridPopulateScreenProbesLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint linearIndex = dispatchThreadId.x;
    uint traceTexelCount = BurtGIRadianceCacheHashGridTraceTexelCount();
    if (linearIndex >= traceTexelCount)
    {
        return;
    }

    uint2 traceSize = max(uint2(1u, 1u), (uint2)_BurtGIScreenProbeTraceParams.yz);
    uint traceX = linearIndex % traceSize.x;
    uint traceY = linearIndex / traceSize.x;
    if (traceY >= traceSize.y)
    {
        return;
    }

    float hitConfidence = _BurtGIScreenProbeTraceHitTexture.Load(int3((int)traceX, (int)traceY, 0));
    if (hitConfidence <= 0.0001)
    {
        return;
    }

    uint octResolution = max(1u, (uint)_BurtGIScreenProbeTraceParams.x);
    uint2 screenProbeCoord = uint2(traceX / octResolution, traceY / octResolution);
    float4 worldPositionValue = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    if (worldPositionValue.w <= 0.0001)
    {
        return;
    }

    uint2 traceTexelCoord = uint2(traceX % octResolution, traceY % octResolution);
    uint2 sourceTraceTexelCoord = traceTexelCoord;
    uint sourceTraceLevel = 0u;
    BurtGIUnpackScreenProbeImportanceRayInfo(
        _BurtGIScreenProbeImportanceRayInfoTexture.Load(int3((int)traceX, (int)traceY, 0)),
        sourceTraceTexelCoord,
        sourceTraceLevel);
    uint maxImportanceTraceResolution = min(64u, max(octResolution, octResolution << 1u));
    uint sourceMipSize = max(1u, maxImportanceTraceResolution >> min(sourceTraceLevel, 5u));
    if (sourceTraceTexelCoord.x >= sourceMipSize || sourceTraceTexelCoord.y >= sourceMipSize)
    {
        sourceTraceTexelCoord = traceTexelCoord;
        sourceMipSize = octResolution;
    }

    float2 octUV = (float2(sourceTraceTexelCoord) + 0.5) / (float)sourceMipSize;
    float3 rayDirection = BurtGIEquiAreaSphericalMapping(octUV);
    uint tileHash = BurtGIRadianceCacheHashGridTileHash(worldPositionValue.xyz, rayDirection);
    uint tileIndex;
    bool isNewTile;
    if (!BurtGIRadianceCacheHashGridFindOrInsertTile(tileHash, tileIndex, isNewTile))
    {
        return;
    }

    uint previousTileFrame;
    InterlockedExchange(_BurtGIRadianceCacheHashGridTileBuffer[tileIndex].y, _BurtGIRadianceCacheClipMapFrameIndex, previousTileFrame);
    if (isNewTile)
    {
        BurtGIRadianceCacheHashGridAppendPackedTile(tileIndex);
        BurtGIRadianceCacheHashGridClearTileCells(tileIndex);
    }

    uint localCellIndex = BurtGIRadianceCacheHashGridLocalCell(worldPositionValue.xyz, rayDirection);
    uint cellIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(tileIndex, localCellIndex);
    uint tileCount = BurtGIRadianceCacheHashGridTileCount();
    uint updateTileCapacity = min(traceTexelCount, tileCount);
    uint4 quantizedRadiance = BurtGIRadianceCacheHashGridQuantizeRadiance(
        _BurtGIScreenProbeTraceRadianceTexture.Load(int3((int)traceX, (int)traceY, 0)).rgb,
        hitConfidence);

    uint visibilityIndex;
    InterlockedAdd(_BurtGIRadianceCacheHashGridCountBuffer[0], 1u, visibilityIndex);
    if (visibilityIndex < traceTexelCount)
    {
        _BurtGIRadianceCacheHashGridVisibilityCellQueryBuffer[visibilityIndex] = uint2(cellIndex, linearIndex);
    }

    if (isNewTile || previousTileFrame != _BurtGIRadianceCacheClipMapFrameIndex)
    {
        uint updateTileIndex;
        InterlockedAdd(_BurtGIRadianceCacheHashGridCountBuffer[1], 1u, updateTileIndex);
        if (updateTileIndex < updateTileCapacity)
        {
            _BurtGIRadianceCacheHashGridUpdateTileBuffer[updateTileIndex] = tileIndex;
        }
    }

    uint updateCellBase = cellIndex * 4u;
    InterlockedAdd(_BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 0u], quantizedRadiance.x);
    InterlockedAdd(_BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 1u], quantizedRadiance.y);
    InterlockedAdd(_BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 2u], quantizedRadiance.z);
    InterlockedAdd(_BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 3u], quantizedRadiance.w);
    _BurtGIRadianceCacheHashGridDebugCellBuffer[cellIndex + 1u] = BurtGIRadianceCacheHashGridPackDebugCell(
        BurtGIRadianceCacheHashGridDebugCellCenter(worldPositionValue.xyz),
        rayDirection,
        max(0.001, _BurtGIRadianceCacheHashGridParams0.x),
        hitConfidence);
}

[numthreads(1, 1, 1)]
void RadianceCacheHashGridUpdateTilesGenIndirectArgsLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint updateTileCount = min(
        _BurtGIRadianceCacheHashGridCountBuffer[1],
        min(BurtGIRadianceCacheHashGridTraceTexelCount(), BurtGIRadianceCacheHashGridTileCount()));
    uint groupCountX = max(1u, updateTileCount);
    uint packedTileCount = min(
        _BurtGIRadianceCacheHashGridCountBuffer[BurtGIRadianceCacheHashGridPackedTileCountIndex()],
        BurtGIRadianceCacheHashGridTileCount());

    _BurtGIRadianceCacheHashGridUpdateTilesIndirectArgsBuffer[0] = uint3(groupCountX, 1u, 1u);
    _BurtGIRadianceCacheHashGridUpdateTilesGroupCountXBuffer[0] = groupCountX;
    _BurtGIRadianceCacheHashGridDebugDrawArgsBuffer[0] = uint4(packedTileCount * BurtGIRadianceCacheHashGridCellsPerTile() * 6u, 1u, 0u, 0u);
}

[numthreads(BURT_GI_HASH_GRID_UPDATE_TILE_THREADGROUP_SIZE, BURT_GI_HASH_GRID_UPDATE_TILE_THREADGROUP_SIZE, 1)]
void RadianceCacheHashGridUpdateTilesLiteCS(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint updateTileListIndex = groupId.x;
    uint updateTileCount = min(
        _BurtGIRadianceCacheHashGridCountBuffer[1],
        min(BurtGIRadianceCacheHashGridTraceTexelCount(), BurtGIRadianceCacheHashGridTileCount()));
    if (updateTileListIndex >= updateTileCount)
    {
        return;
    }

    uint tileIndex = _BurtGIRadianceCacheHashGridUpdateTileBuffer[updateTileListIndex];
    if (tileIndex >= BurtGIRadianceCacheHashGridTileCount())
    {
        return;
    }

    uint2 mip0CellCoord = groupThreadId.xy;
    uint localCellIndex = BurtGIRadianceCacheHashGridMipLocalCellIndex(mip0CellCoord, 0u);
    uint cellIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(tileIndex, localCellIndex);
    uint cellCount = BurtGIRadianceCacheHashGridCellCount();
    if (cellIndex >= cellCount)
    {
        return;
    }

    uint updateCellBase = cellIndex * 4u;
    uint4 accumulatedRadiance = uint4(
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 0u],
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 1u],
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 2u],
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 3u]);

    uint4 previousPackedValue = _BurtGIRadianceCacheHashGridValueBuffer[cellIndex];
    float4 previousRadiance = BurtGIRadianceCacheHashGridUnpackRadiance(previousPackedValue);
    previousRadiance.a *= BurtGIRadianceCacheHashGridAgeConfidenceScale(previousPackedValue);
    float4 resolvedRadiance = previousRadiance;
    if (accumulatedRadiance.w > 0u)
    {
        float sampleWeight = max((float)accumulatedRadiance.w / 65535.0, 0.0001);
        float4 newRadiance = BurtGIRadianceCacheHashGridRecoverRadiance(accumulatedRadiance);
        newRadiance.rgb /= sampleWeight;
        newRadiance.a = saturate(sampleWeight);

        float historyWeight = previousRadiance.a > 0.0001 ? saturate(previousRadiance.a / (previousRadiance.a + newRadiance.a)) : 0.0;
        resolvedRadiance = float4(lerp(newRadiance.rgb, previousRadiance.rgb, historyWeight), saturate(previousRadiance.a + newRadiance.a));
        uint2 packedMip0Radiance = BurtGIRadianceCacheHashGridPackRadiance(resolvedRadiance.rgb, resolvedRadiance.a);
        _BurtGIRadianceCacheHashGridValueBuffer[cellIndex] = uint4(packedMip0Radiance.x, packedMip0Radiance.y, _BurtGIRadianceCacheClipMapFrameIndex, asuint(resolvedRadiance.a));

        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 0u] = 0u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 1u] = 0u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 2u] = 0u;
        _BurtGIRadianceCacheHashGridUpdateCellValueBuffer[updateCellBase + 3u] = 0u;
    }

    float4 debugCell = _BurtGIRadianceCacheHashGridDebugCellBuffer[cellIndex + 1u];
    _BurtGIRadianceCacheHashGridDebugCellBuffer[cellIndex + 1u] = BurtGIRadianceCacheHashGridUpdateDebugCellConfidence(debugCell, resolvedRadiance.a);
    BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y][groupThreadId.x] = BurtGIRadianceCacheHashGridPackRadiance(resolvedRadiance.rgb, resolvedRadiance.a);

    GroupMemoryBarrierWithGroupSync();
    if ((groupThreadId.x & 1u) == 0u && (groupThreadId.y & 1u) == 0u)
    {
        float4 mipRadiance = BurtGIRadianceCacheHashGridCombineMipRadiance(
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y + 0u][groupThreadId.x + 0u]),
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y + 0u][groupThreadId.x + 1u]),
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y + 1u][groupThreadId.x + 0u]),
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y + 1u][groupThreadId.x + 1u]));
        uint2 packedMipRadiance = BurtGIRadianceCacheHashGridPackRadiance(mipRadiance.rgb, mipRadiance.a);
        BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y][groupThreadId.x] = packedMipRadiance;

        uint mipCellIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(tileIndex, BurtGIRadianceCacheHashGridMipLocalCellIndex(groupThreadId.xy / 2u, 1u));
        _BurtGIRadianceCacheHashGridValueBuffer[mipCellIndex] = uint4(packedMipRadiance.x, packedMipRadiance.y, _BurtGIRadianceCacheClipMapFrameIndex, asuint(mipRadiance.a));
        _BurtGIRadianceCacheHashGridDebugCellBuffer[mipCellIndex + 1u] = float4((float)tileIndex, 1.0, mipRadiance.a, dot(mipRadiance.rgb, float3(0.2126, 0.7152, 0.0722)));
    }

    GroupMemoryBarrierWithGroupSync();
    if ((groupThreadId.x & 3u) == 0u && (groupThreadId.y & 3u) == 0u)
    {
        float4 mipRadiance = BurtGIRadianceCacheHashGridCombineMipRadiance(
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y + 0u][groupThreadId.x + 0u]),
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y + 0u][groupThreadId.x + 2u]),
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y + 2u][groupThreadId.x + 0u]),
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y + 2u][groupThreadId.x + 2u]));
        uint2 packedMipRadiance = BurtGIRadianceCacheHashGridPackRadiance(mipRadiance.rgb, mipRadiance.a);
        BurtGIRadianceCacheHashGridUpdateTilesLDS[groupThreadId.y][groupThreadId.x] = packedMipRadiance;

        uint mipCellIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(tileIndex, BurtGIRadianceCacheHashGridMipLocalCellIndex(groupThreadId.xy / 4u, 2u));
        _BurtGIRadianceCacheHashGridValueBuffer[mipCellIndex] = uint4(packedMipRadiance.x, packedMipRadiance.y, _BurtGIRadianceCacheClipMapFrameIndex, asuint(mipRadiance.a));
        _BurtGIRadianceCacheHashGridDebugCellBuffer[mipCellIndex + 1u] = float4((float)tileIndex, 2.0, mipRadiance.a, dot(mipRadiance.rgb, float3(0.2126, 0.7152, 0.0722)));
    }

    GroupMemoryBarrierWithGroupSync();
    if (groupThreadId.x == 0u && groupThreadId.y == 0u)
    {
        float4 mipRadiance = BurtGIRadianceCacheHashGridCombineMipRadiance(
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[0u][0u]),
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[0u][4u]),
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[4u][0u]),
            BurtGIRadianceCacheHashGridUnpackPackedRadiance(BurtGIRadianceCacheHashGridUpdateTilesLDS[4u][4u]));
        uint2 packedMipRadiance = BurtGIRadianceCacheHashGridPackRadiance(mipRadiance.rgb, mipRadiance.a);

        uint mipCellIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(tileIndex, BurtGIRadianceCacheHashGridMipLocalCellIndex(uint2(0u, 0u), 3u));
        _BurtGIRadianceCacheHashGridValueBuffer[mipCellIndex] = uint4(packedMipRadiance.x, packedMipRadiance.y, _BurtGIRadianceCacheClipMapFrameIndex, asuint(mipRadiance.a));
        _BurtGIRadianceCacheHashGridDebugCellBuffer[mipCellIndex + 1u] = float4((float)tileIndex, 3.0, mipRadiance.a, dot(mipRadiance.rgb, float3(0.2126, 0.7152, 0.0722)));
    }
}

[numthreads(BURT_GI_HASH_GRID_POPULATE_THREADGROUP_SIZE, 1, 1)]
void RadianceCacheHashGridResolveTraceRadianceLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint visibilityIndex = dispatchThreadId.x;
    uint visibilityCount = min(_BurtGIRadianceCacheHashGridCountBuffer[0], BurtGIRadianceCacheHashGridTraceTexelCount());
    if (visibilityIndex >= visibilityCount)
    {
        return;
    }

    uint2 query = _BurtGIRadianceCacheHashGridVisibilityCellQueryBuffer[visibilityIndex];
    uint cellIndex = query.x;
    uint linearIndex = query.y;
    if (cellIndex >= BurtGIRadianceCacheHashGridCellCount() || linearIndex >= BurtGIRadianceCacheHashGridTraceTexelCount())
    {
        return;
    }

    uint4 packedValue = _BurtGIRadianceCacheHashGridValueBuffer[cellIndex];
    float4 radiance = BurtGIRadianceCacheHashGridUnpackRadiance(packedValue);
    radiance.a *= BurtGIRadianceCacheHashGridAgeConfidenceScale(packedValue);
    if (radiance.a <= 0.0001 || dot(radiance.rgb, radiance.rgb) <= 0.0)
    {
        return;
    }

    uint2 traceSize = max(uint2(1u, 1u), (uint2)_BurtGIScreenProbeTraceParams.yz);
    uint traceX = linearIndex % traceSize.x;
    uint traceY = linearIndex / traceSize.x;
    if (traceY >= traceSize.y)
    {
        return;
    }

    float4 traceRadiance = _BurtGIScreenProbeTraceRadianceRWTexture[uint2(traceX, traceY)];
    traceRadiance.rgb += radiance.rgb * saturate(radiance.a);
    traceRadiance.a = max(traceRadiance.a, radiance.a);
    _BurtGIScreenProbeTraceRadianceRWTexture[uint2(traceX, traceY)] = traceRadiance;
}

[numthreads(BURT_GI_HASH_GRID_POPULATE_THREADGROUP_SIZE, 1, 1)]
void RadianceCacheHashGridPurgeTilesLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint packedTilePrevIndex = dispatchThreadId.x;
    uint packedTilePrevCount = min(
        _BurtGIRadianceCacheHashGridCountBuffer[BurtGIRadianceCacheHashGridPackedTileCountPrevIndex()],
        BurtGIRadianceCacheHashGridTileCount());
    if (packedTilePrevIndex >= packedTilePrevCount)
    {
        return;
    }

    uint tileIndex = BurtGIRadianceCacheHashGridPackedTilePrev(packedTilePrevIndex);
    if (tileIndex >= BurtGIRadianceCacheHashGridTileCount())
    {
        return;
    }

    uint4 tileValue = _BurtGIRadianceCacheHashGridTileBuffer[tileIndex];
    if (tileValue.x == 0xffffffffu)
    {
        return;
    }

    uint frameDelta = BurtGIRadianceCacheHashGridFrameDelta(_BurtGIRadianceCacheClipMapFrameIndex, tileValue.y);
    if (frameDelta >= BURT_GI_HASH_GRID_TILE_DECAY_MAX)
    {
        BurtGIRadianceCacheHashGridClearTileCells(tileIndex);
        _BurtGIRadianceCacheHashGridTileBuffer[tileIndex].x = 0xffffffffu;
        _BurtGIRadianceCacheHashGridTileBuffer[tileIndex].y = 0u;
        return;
    }

    BurtGIRadianceCacheHashGridAppendPackedTile(tileIndex);
}

[numthreads(BURT_GI_INIT_THREADGROUP_SIZE, BURT_GI_INIT_THREADGROUP_SIZE, 1)]
void InitClipMapCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 indirectionSize = BurtGIIndirectionSize();
    uint2 coord = dispatchThreadId.xy;
    uint linearIndex = coord.y * indirectionSize.x + coord.x;
    bool resetPersistentProbeState = _BurtGIRadianceCacheClipMapHistoryParams.x <= 0.5;

    if (coord.x < indirectionSize.x && coord.y < indirectionSize.y)
    {
        _BurtGIRadianceCacheClipMapIndirectionTexture[coord] = BURT_GI_INVALID_PROBE_INDEX;
    }

    if (linearIndex == 0u)
    {
        if (resetPersistentProbeState)
        {
            _BurtGIRadianceCacheClipMapProbeAllocatorBuffer[0] = 0u;
            _BurtGIRadianceCacheClipMapProbeFreeListAllocatorBuffer[0] = 0u;
        }
        _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0] = 0u;
        _BurtGIRadianceCacheClipMapMaxUpdateBucketBuffer[0] = 0u;
        _BurtGIRadianceCacheClipMapMaxTracesFromMaxUpdateBucketBuffer[0] = 0u;
        _BurtGIRadianceCacheClipMapProbeTraceTileAllocatorBuffer[0] = 0u;
        _BurtGIRadianceCacheClipMapHardwareRayTracingRayAllocatorBuffer[0] = 0u;

        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapClearProbePDFsIndirectArgsBuffer, 0, 0u, 1u, 1u);
        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapClearProbePDFsIndirectArgsBuffer, 1, 0u, 1u, 1u);
        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapGenerateProbeTraceTilesIndirectArgsBuffer, 0, 0u, 1u, 1u);
        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapGenerateProbeTraceTilesIndirectArgsBuffer, 1, 0u, 1u, 1u);
        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapGenerateProbeTraceTilesIndirectArgsBuffer, 2, 0u, 1u, 1u);
        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapFilterProbesIndirectArgsBuffer, 0, 0u, 1u, 1u);
        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapPrepareProbeOcclusionIndirectArgsBuffer, 0, 0u, 1u, 1u);
        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapFixupProbeBordersIndirectArgsBuffer, 0, 0u, 1u, 1u);
        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapTraceProbesIndirectArgsBuffer, 0, 0u, 1u, 1u);
        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapSortProbeTraceTilesIndirectArgsBuffer, 0, 0u, 1u, 1u);
        BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapRadianceCacheHardwareRayTracingIndirectArgsBuffer, 0, 0u, 1u, 1u);
    }

    if (linearIndex < _BurtGIRadianceCacheClipMapMaxProbeCount)
    {
        if (resetPersistentProbeState)
        {
            _BurtGIRadianceCacheClipMapProbeFreeListBuffer[linearIndex] = 0u;
            _BurtGIRadianceCacheClipMapProbeLastUsedFrameBuffer[linearIndex] = 0u;
            _BurtGIRadianceCacheClipMapProbeLastTracedFrameBuffer[linearIndex] = 0u;
            _BurtGIRadianceCacheClipMapProbeWorldOffsetBuffer[linearIndex] = float4(0.0, 0.0, 0.0, 0.0);
        }

        _BurtGIRadianceCacheClipMapProbeTraceDataBuffer[linearIndex] = float4(0.0, 0.0, 0.0, 0.0);
    }

    if (linearIndex < BURT_GI_PRIORITY_HISTOGRAM_SIZE)
    {
        _BurtGIRadianceCacheClipMapPriorityHistogramBuffer[linearIndex] = 0u;
    }

    if (linearIndex < 2u)
    {
        _BurtGIRadianceCacheClipMapProbesToUpdateTraceCostBuffer[linearIndex] = 0u;
    }
}

[numthreads(BURT_GI_MARK_SCREEN_PROBE_THREADGROUP_SIZE, BURT_GI_MARK_SCREEN_PROBE_THREADGROUP_SIZE, 1)]
void MarkUsedRadianceProbesFromScreenProbesCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 screenProbeGridSize = BurtGIScreenProbeGridSize();
    uint2 screenProbeCoord = dispatchThreadId.xy;
    if (screenProbeCoord.x < screenProbeGridSize.x && screenProbeCoord.y < screenProbeGridSize.y)
    {
        float4 screenProbeWorldPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
        if (screenProbeWorldPosition.w > 0.0)
        {
            float clipmapDitherRandom = BurtGIInterleavedGradientNoise(screenProbeCoord, _BurtGIRadianceCacheClipMapFrameIndex & 7u);
            BurtGIMarkPositionUsedInIndirectionTexture(screenProbeWorldPosition.xyz, clipmapDitherRandom);
        }
    }

    if (dispatchThreadId.y != 0u)
    {
        return;
    }

    uint adaptiveProbeIndex = dispatchThreadId.x;
    float3 adaptiveWorldPosition;
    if (BurtGIResolveAdaptiveScreenProbeWorldPosition(adaptiveProbeIndex, adaptiveWorldPosition))
    {
        float clipmapDitherRandom = BurtGIInterleavedGradientNoise(
            uint2(adaptiveProbeIndex & 1023u, adaptiveProbeIndex >> 10),
            _BurtGIRadianceCacheClipMapFrameIndex & 7u);
        BurtGIMarkPositionUsedInIndirectionTexture(adaptiveWorldPosition, clipmapDitherRandom);
    }
}

float4 BurtGIClipMapBuildDeferredClipPosition(float2 screenUV, float rawDepth)
{
    float2 clipXY = screenUV * 2.0 - 1.0;
    #if UNITY_UV_STARTS_AT_TOP
        clipXY.y = -clipXY.y;
    #endif

    #if defined(UNITY_REVERSED_Z)
        float clipZ = rawDepth;
    #else
        float clipZ = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, rawDepth);
    #endif

    return float4(clipXY, clipZ, 1.0);
}

float3 BurtGIClipMapReconstructGBufferPositionWS(float2 screenUV, float rawDepth)
{
    float4 positionWS = mul(_BurtDeferredInverseViewProjectionMatrix, BurtGIClipMapBuildDeferredClipPosition(screenUV, rawDepth));
    float safeW = abs(positionWS.w) > 0.00001 ? positionWS.w : (positionWS.w < 0.0 ? -0.00001 : 0.00001);
    return positionWS.xyz / safeW;
}

[numthreads(BURT_GI_MARK_SCREEN_PROBE_THREADGROUP_SIZE, BURT_GI_MARK_SCREEN_PROBE_THREADGROUP_SIZE, 1)]
void MarkUsedRadianceProbesFromGBufferCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _BurtCameraDepthTexture.GetDimensions(width, height);
    if (dispatchThreadId.x >= width || dispatchThreadId.y >= height)
    {
        return;
    }

    float rawDepth = _BurtCameraDepthTexture.Load(int3(dispatchThreadId.xy, 0));
    #if defined(UNITY_REVERSED_Z)
        if (rawDepth <= 0.000001)
        {
            return;
        }
    #else
        if (rawDepth >= 0.999999)
        {
            return;
        }
    #endif

    float2 screenUV = (float2(dispatchThreadId.xy) + 0.5) / float2(max(width, 1u), max(height, 1u));
    float3 worldPosition = BurtGIClipMapReconstructGBufferPositionWS(screenUV, rawDepth);
    float clipmapDitherRandom = BurtGIInterleavedGradientNoise(dispatchThreadId.xy, _BurtGIRadianceCacheClipMapFrameIndex & 7u);
    BurtGIMarkPositionUsedInIndirectionTexture(worldPosition, clipmapDitherRandom);
}

[numthreads(BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE, BURT_GI_SCENE_VOXEL_CLEAR_THREADGROUP_SIZE)]
void MarkUsedRadianceProbesFromSceneVoxelCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    if (any(dispatchThreadId >= volumeSize))
    {
        return;
    }

    float occupancy = _BurtGISceneVoxelGeometryReadTexture.Load(int4(dispatchThreadId, 0)).a;
    if (occupancy <= 0.001)
    {
        return;
    }

    float3 uvw = (float3(dispatchThreadId) + 0.5) / (float3)volumeSize;
    float3 worldPosition = (uvw * 2.0 - 1.0) * _BurtGISceneVoxelCenterExtent.www + _BurtGISceneVoxelCenterExtent.xyz;
    uint2 noiseCoord = uint2(dispatchThreadId.x ^ (dispatchThreadId.z * 73856093u), dispatchThreadId.y ^ (dispatchThreadId.z * 19349663u));
    float clipmapDitherRandom = BurtGIInterleavedGradientNoise(noiseCoord, _BurtGIRadianceCacheClipMapFrameIndex & 7u);
    BurtGIMarkPositionUsedInIndirectionTexture(worldPosition, clipmapDitherRandom);
}

[numthreads(BURT_GI_ALLOCATE_USED_PROBE_THREADGROUP_SIZE, BURT_GI_ALLOCATE_USED_PROBE_THREADGROUP_SIZE, 1)]
void UpdateCacheForUsedProbesLiteCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (_BurtGIRadianceCacheClipMapHistoryParams.x <= 0.5)
    {
        return;
    }

    uint2 indirectionSize = BurtGIIndirectionSize();
    uint2 lastFrameIndirectionCoord = dispatchThreadId.xy;
    if (lastFrameIndirectionCoord.x >= indirectionSize.x || lastFrameIndirectionCoord.y >= indirectionSize.y)
    {
        return;
    }

    uint clipmapIndex;
    uint3 lastFrameProbeCoord;
    if (!BurtGIDecodeIndirectionCoord(lastFrameIndirectionCoord, clipmapIndex, lastFrameProbeCoord))
    {
        return;
    }

    uint lastFrameProbeIndex = _BurtGIRadianceCacheClipMapLastFrameIndirectionTexture.Load(int3(lastFrameIndirectionCoord, 0));
    if (lastFrameProbeIndex == BURT_GI_INVALID_PROBE_INDEX || lastFrameProbeIndex == BURT_GI_USED_PROBE_INDEX)
    {
        return;
    }

    float4 lastFrameCoordToWorld = _BurtGIRadianceCacheClipMapLastFrameProbeCoordToWorldCenter[clipmapIndex];
    float3 probeWorldCenter = lastFrameCoordToWorld.xyz + (float3)lastFrameProbeCoord * lastFrameCoordToWorld.w;

    uint3 currentProbeCoord;
    bool reused = false;
    if (BurtGIWorldPositionToProbeCoordInClipmap(probeWorldCenter, clipmapIndex, currentProbeCoord))
    {
        uint2 currentIndirectionCoord = BurtGIPackIndirectionCoord(clipmapIndex, currentProbeCoord);
        if (currentIndirectionCoord.x < indirectionSize.x && currentIndirectionCoord.y < indirectionSize.y)
        {
            uint currentMarker = _BurtGIRadianceCacheClipMapIndirectionTexture[currentIndirectionCoord];
            uint lastUsedFrame = _BurtGIRadianceCacheClipMapProbeLastUsedFrameBuffer[lastFrameProbeIndex];
            uint frameDelta = _BurtGIRadianceCacheClipMapFrameIndex >= lastUsedFrame ? _BurtGIRadianceCacheClipMapFrameIndex - lastUsedFrame : 0u;
            uint keepFrameCount = (uint)max(1.0, _BurtGIRadianceCacheClipMapHistoryParams.y);
            uint allocatedProbeCount = min(_BurtGIRadianceCacheClipMapProbeAllocatorBuffer[0], _BurtGIRadianceCacheClipMapMaxProbeCount);
            uint freeProbeCount = (_BurtGIRadianceCacheClipMapMaxProbeCount - allocatedProbeCount) + _BurtGIRadianceCacheClipMapProbeFreeListAllocatorBuffer[0];
            if (freeProbeCount < _BurtGIRadianceCacheClipMapNumProbesToTraceBudget)
            {
                keepFrameCount = min(2u, keepFrameCount);
            }
            if (currentMarker == BURT_GI_USED_PROBE_INDEX || frameDelta < keepFrameCount)
            {
                reused = true;
                if (currentMarker == BURT_GI_USED_PROBE_INDEX)
                {
                    _BurtGIRadianceCacheClipMapProbeLastUsedFrameBuffer[lastFrameProbeIndex] = _BurtGIRadianceCacheClipMapFrameIndex;
                }

                _BurtGIRadianceCacheClipMapIndirectionTexture[currentIndirectionCoord] = lastFrameProbeIndex;
                InterlockedMax(_BurtGIRadianceCacheClipMapProbeAllocatorBuffer[0], lastFrameProbeIndex + 1u);
            }
        }
    }

    if (!reused)
    {
        uint freeListIndex;
        InterlockedAdd(_BurtGIRadianceCacheClipMapProbeFreeListAllocatorBuffer[0], 1u, freeListIndex);
        if (freeListIndex < _BurtGIRadianceCacheClipMapMaxProbeCount)
        {
            _BurtGIRadianceCacheClipMapProbeFreeListBuffer[freeListIndex] = lastFrameProbeIndex;
        }
    }
}

[numthreads(BURT_GI_ALLOCATE_USED_PROBE_THREADGROUP_SIZE, BURT_GI_ALLOCATE_USED_PROBE_THREADGROUP_SIZE, 1)]
void AllocateUsedProbesCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 indirectionSize = BurtGIIndirectionSize();
    uint2 indirectionCoord = dispatchThreadId.xy;
    if (indirectionCoord.x >= indirectionSize.x || indirectionCoord.y >= indirectionSize.y)
    {
        return;
    }

    uint marker = _BurtGIRadianceCacheClipMapIndirectionTexture[indirectionCoord];
    if (marker == BURT_GI_INVALID_PROBE_INDEX)
    {
        return;
    }

    uint clipmapIndex;
    uint3 probeCoord;
    if (!BurtGIDecodeIndirectionCoord(indirectionCoord, clipmapIndex, probeCoord))
    {
        _BurtGIRadianceCacheClipMapIndirectionTexture[indirectionCoord] = BURT_GI_INVALID_PROBE_INDEX;
        return;
    }

    uint probeIndex = marker;
    uint lastTracedFrame = 0u;
    uint lastUsedFrame = 0u;
    if (marker == BURT_GI_USED_PROBE_INDEX)
    {
        bool poppedFreeProbe = false;
        [loop]
        for (uint popAttempt = 0u; popAttempt < 8u; ++popAttempt)
        {
            uint freeListCount = _BurtGIRadianceCacheClipMapProbeFreeListAllocatorBuffer[0];
            if (freeListCount == 0u)
            {
                break;
            }

            uint previousFreeListCount;
            InterlockedCompareExchange(
                _BurtGIRadianceCacheClipMapProbeFreeListAllocatorBuffer[0],
                freeListCount,
                freeListCount - 1u,
                previousFreeListCount);
            if (previousFreeListCount == freeListCount)
            {
                probeIndex = _BurtGIRadianceCacheClipMapProbeFreeListBuffer[min(freeListCount - 1u, _BurtGIRadianceCacheClipMapMaxProbeCount - 1u)];
                poppedFreeProbe = true;
                break;
            }
        }

        if (!poppedFreeProbe)
        {
            InterlockedAdd(_BurtGIRadianceCacheClipMapProbeAllocatorBuffer[0], 1u, probeIndex);
        }

        lastTracedFrame = 0u;
        lastUsedFrame = _BurtGIRadianceCacheClipMapFrameIndex;
    }
    else if (probeIndex < _BurtGIRadianceCacheClipMapMaxProbeCount)
    {
        lastTracedFrame = _BurtGIRadianceCacheClipMapProbeLastTracedFrameBuffer[probeIndex];
        lastUsedFrame = _BurtGIRadianceCacheClipMapProbeLastUsedFrameBuffer[probeIndex];
    }

    if (probeIndex < _BurtGIRadianceCacheClipMapMaxProbeCount)
    {
        float4 coordToWorld = _BurtGIRadianceCacheClipMapProbeCoordToWorldCenter[clipmapIndex];
        float3 probeWorldCenter = coordToWorld.xyz + (float3)probeCoord * coordToWorld.w;
        uint packedClipmapAndProbe = (clipmapIndex << 24) | (probeIndex & 0x00ffffffu);

        _BurtGIRadianceCacheClipMapIndirectionTexture[indirectionCoord] = probeIndex;
        if (marker == BURT_GI_USED_PROBE_INDEX)
        {
            _BurtGIRadianceCacheClipMapProbeLastTracedFrameBuffer[probeIndex] = 0u;
        }

        _BurtGIRadianceCacheClipMapProbeLastUsedFrameBuffer[probeIndex] = _BurtGIRadianceCacheClipMapFrameIndex;
        _BurtGIRadianceCacheClipMapProbeTraceDataBuffer[probeIndex] = float4(probeWorldCenter, asfloat(packedClipmapAndProbe));

        uint priorityBucketIndex = BurtGIGetPriorityBucketIndex(lastTracedFrame, lastUsedFrame, clipmapIndex);
        uint traceCost = BurtGIGetProbeTraceCost(probeWorldCenter);
        InterlockedAdd(_BurtGIRadianceCacheClipMapPriorityHistogramBuffer[priorityBucketIndex], traceCost);
    }
    else
    {
        _BurtGIRadianceCacheClipMapIndirectionTexture[indirectionCoord] = BURT_GI_INVALID_PROBE_INDEX;
    }
}

[numthreads(1, 1, 1)]
void SelectMaxPriorityBucketCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x != 0u || dispatchThreadId.y != 0u || dispatchThreadId.z != 0u)
    {
        return;
    }

    uint traceBudget = _BurtGIRadianceCacheClipMapNumProbesToTraceBudget * 4u;
    uint traceSum = 0u;
    uint priorityBucketIndex = 0u;
    uint tracesFromPriorityBucket = traceBudget;

    [loop]
    for (; priorityBucketIndex < BURT_GI_PRIORITY_HISTOGRAM_SIZE; ++priorityBucketIndex)
    {
        uint bucketTraceCost = _BurtGIRadianceCacheClipMapPriorityHistogramBuffer[priorityBucketIndex];
        if (traceSum + bucketTraceCost >= traceBudget)
        {
            tracesFromPriorityBucket = traceBudget - traceSum;
            break;
        }

        traceSum += bucketTraceCost;
    }

    _BurtGIRadianceCacheClipMapMaxUpdateBucketBuffer[0] = priorityBucketIndex;
    _BurtGIRadianceCacheClipMapMaxTracesFromMaxUpdateBucketBuffer[0] = tracesFromPriorityBucket;
}

[numthreads(1, 1, 1)]
void AllocateProbeTracesCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x != 0u || dispatchThreadId.y != 0u || dispatchThreadId.z != 0u)
    {
        return;
    }

    uint maxProbeCount = max(1u, _BurtGIRadianceCacheClipMapMaxProbeCount);
    uint allocatedProbeCount = min(_BurtGIRadianceCacheClipMapProbeAllocatorBuffer[0], maxProbeCount);
    uint maxUpdateBucket = min(_BurtGIRadianceCacheClipMapMaxUpdateBucketBuffer[0], (uint)(BURT_GI_PRIORITY_HISTOGRAM_SIZE - 1u));
    uint maxTracesFromBucket = _BurtGIRadianceCacheClipMapMaxTracesFromMaxUpdateBucketBuffer[0];
    uint traceBudgetCost = maxTracesFromBucket > 0u
        ? maxTracesFromBucket
        : _BurtGIRadianceCacheClipMapNumProbesToTraceBudget * 4u;
    uint traceCount = 0u;
    uint totalTraceCost = 0u;
    uint maxBucketTraceCost = 0u;

    if (allocatedProbeCount > 0u)
    {
        uint2 indirectionSize = BurtGIIndirectionSize();

        [loop]
        for (uint indirectionY = 0u; indirectionY < indirectionSize.y && traceCount < maxProbeCount; ++indirectionY)
        {
            [loop]
            for (uint indirectionX = 0u; indirectionX < indirectionSize.x && traceCount < maxProbeCount; ++indirectionX)
            {
                uint2 indirectionCoord = uint2(indirectionX, indirectionY);
                uint probeIndex = _BurtGIRadianceCacheClipMapIndirectionTexture[indirectionCoord];
                if (probeIndex >= maxProbeCount)
                {
                    continue;
                }

                uint clipmapIndex;
                uint3 probeCoord;
                if (!BurtGIDecodeIndirectionCoord(indirectionCoord, clipmapIndex, probeCoord))
                {
                    continue;
                }

                uint lastTracedFrame = _BurtGIRadianceCacheClipMapProbeLastTracedFrameBuffer[probeIndex];
                uint lastUsedFrame = _BurtGIRadianceCacheClipMapProbeLastUsedFrameBuffer[probeIndex];
                uint priorityBucketIndex = BurtGIGetPriorityBucketIndex(lastTracedFrame, lastUsedFrame, clipmapIndex);
                if (priorityBucketIndex > maxUpdateBucket)
                {
                    continue;
                }

                float4 coordToWorld = _BurtGIRadianceCacheClipMapProbeCoordToWorldCenter[clipmapIndex];
                float3 probeWorldCenter = coordToWorld.xyz + (float3)probeCoord * coordToWorld.w;
                uint traceCost = BurtGIGetProbeTraceCost(probeWorldCenter);
                if (priorityBucketIndex == maxUpdateBucket && maxUpdateBucket > 0u)
                {
                    if (maxBucketTraceCost + traceCost > maxTracesFromBucket)
                    {
                        continue;
                    }

                    maxBucketTraceCost += traceCost;
                }

                uint packedClipmapAndProbe = (clipmapIndex << 24) | (probeIndex & 0x00ffffffu);
                _BurtGIRadianceCacheClipMapProbeTraceDataBuffer[traceCount] = float4(probeWorldCenter, asfloat(packedClipmapAndProbe));
                _BurtGIRadianceCacheClipMapProbeLastTracedFrameBuffer[probeIndex] = _BurtGIRadianceCacheClipMapFrameIndex;

                totalTraceCost += traceCost;
                ++traceCount;
            }
        }

        _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0] = traceCount;
        _BurtGIRadianceCacheClipMapProbesToUpdateTraceCostBuffer[0] = totalTraceCost;
        _BurtGIRadianceCacheClipMapProbesToUpdateTraceCostBuffer[1] = maxBucketTraceCost;
        return;
    }

    uint clipmapCount = BurtGIClipmapCount();
    uint clipmapResolution = BurtGIClipmapResolution();
    uint clipmapProbeCount = max(1u, clipmapResolution * clipmapResolution * clipmapResolution);

    [loop]
    for (uint sourceIndex = 0u; sourceIndex < maxProbeCount && traceCount < maxProbeCount; ++sourceIndex)
    {
        uint clipmapIndex = sourceIndex % clipmapCount;
        uint coordLinear = (sourceIndex / clipmapCount) % clipmapProbeCount;
        uint coordX = coordLinear % clipmapResolution;
        uint coordY = (coordLinear / clipmapResolution) % clipmapResolution;
        uint coordZ = (coordLinear / (clipmapResolution * clipmapResolution)) % clipmapResolution;
        float4 coordToWorld = _BurtGIRadianceCacheClipMapProbeCoordToWorldCenter[clipmapIndex];
        float3 probeWorldCenter = coordToWorld.xyz + float3(coordX, coordY, coordZ) * coordToWorld.w;
        uint traceCost = BurtGIGetProbeTraceCost(probeWorldCenter);
        if (traceCount > 0u && totalTraceCost + traceCost > traceBudgetCost)
        {
            break;
        }

        uint packedClipmapAndProbe = (clipmapIndex << 24) | (traceCount & 0x00ffffffu);
        _BurtGIRadianceCacheClipMapProbeTraceDataBuffer[traceCount] = float4(probeWorldCenter, asfloat(packedClipmapAndProbe));
        _BurtGIRadianceCacheClipMapProbeWorldOffsetBuffer[traceCount] = float4(0.0, 0.0, 0.0, 0.0);
        _BurtGIRadianceCacheClipMapProbeLastTracedFrameBuffer[traceCount] = _BurtGIRadianceCacheClipMapFrameIndex;
        totalTraceCost += traceCost;
        ++traceCount;
    }

    _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0] = traceCount;
    _BurtGIRadianceCacheClipMapProbesToUpdateTraceCostBuffer[0] = totalTraceCost;
    _BurtGIRadianceCacheClipMapProbesToUpdateTraceCostBuffer[1] = totalTraceCost;
}

[numthreads(1, 1, 1)]
void SetupProbeIndirectArgsCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x != 0u || dispatchThreadId.y != 0u || dispatchThreadId.z != 0u)
    {
        return;
    }

    uint maxProbeCount = max(1u, _BurtGIRadianceCacheClipMapMaxProbeCount);
    _BurtGIRadianceCacheClipMapProbeFreeListAllocatorBuffer[0] = min(_BurtGIRadianceCacheClipMapProbeFreeListAllocatorBuffer[0], maxProbeCount);
    _BurtGIRadianceCacheClipMapProbeAllocatorBuffer[0] = min(_BurtGIRadianceCacheClipMapProbeAllocatorBuffer[0], maxProbeCount);
    uint numProbesToTrace = min(_BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0], maxProbeCount);
    _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0] = numProbesToTrace;

    BURT_GI_WRITE_DISPATCH_ARGS(
        _BurtGIRadianceCacheClipMapClearProbePDFsIndirectArgsBuffer,
        0,
        BurtGIDivRoundUp(BurtGIMulClamp(numProbesToTrace, _BurtGIRadianceCacheClipMapRadianceProbePDFCoefficientCount), _BurtGIRadianceCacheClipMapClearProbePDFGroupSize),
        1u,
        1u);

    BURT_GI_WRITE_DISPATCH_ARGS(_BurtGIRadianceCacheClipMapGenerateProbeTraceTilesIndirectArgsBuffer, 0, 1u, 1u, numProbesToTrace);
    _BurtGIRadianceCacheClipMapProbeTraceTileAllocatorBuffer[0] = 0u;

    BURT_GI_WRITE_DISPATCH_ARGS(
        _BurtGIRadianceCacheClipMapFilterProbesIndirectArgsBuffer,
        0,
        BurtGIDivRoundUp(_BurtGIRadianceCacheClipMapRadianceProbeResolution, _BurtGIRadianceCacheClipMapFilterProbesGroupSize),
        BurtGIDivRoundUp(_BurtGIRadianceCacheClipMapRadianceProbeResolution, _BurtGIRadianceCacheClipMapFilterProbesGroupSize),
        numProbesToTrace);

    BURT_GI_WRITE_DISPATCH_ARGS(
        _BurtGIRadianceCacheClipMapPrepareProbeOcclusionIndirectArgsBuffer,
        0,
        BurtGIDivRoundUp(_BurtGIRadianceCacheClipMapFinalOcclusionProbeResolution, _BurtGIRadianceCacheClipMapTraceFromProbesGroupSize),
        BurtGIDivRoundUp(_BurtGIRadianceCacheClipMapFinalOcclusionProbeResolution, _BurtGIRadianceCacheClipMapTraceFromProbesGroupSize),
        numProbesToTrace);

    BURT_GI_WRITE_DISPATCH_ARGS(
        _BurtGIRadianceCacheClipMapFixupProbeBordersIndirectArgsBuffer,
        0,
        BurtGIDivRoundUp(_BurtGIRadianceCacheClipMapFinalProbeResolution, _BurtGIRadianceCacheClipMapTraceFromProbesGroupSize),
        BurtGIDivRoundUp(_BurtGIRadianceCacheClipMapFinalProbeResolution, _BurtGIRadianceCacheClipMapTraceFromProbesGroupSize),
        numProbesToTrace);
}

[numthreads(64, 1, 1)]
void ClearProbePDFsCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint coefficientCount = max(BURT_GI_RADIANCE_PROBE_PDF_COEFFICIENT_COUNT, _BurtGIRadianceCacheClipMapRadianceProbePDFCoefficientCount);
    uint coefficientLinearIndex = dispatchThreadId.x;
    uint probeTraceIndex = coefficientLinearIndex / coefficientCount;
    uint coefficientIndex = coefficientLinearIndex - probeTraceIndex * coefficientCount;
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0] || coefficientIndex >= BURT_GI_RADIANCE_PROBE_PDF_COEFFICIENT_COUNT)
    {
        return;
    }

    uint probeIndex = BurtGIGetProbeIndexFromTraceData(probeTraceIndex);
    uint baseIndex = BurtGIProbePDFBaseIndex(probeIndex);
    _BurtGIRadianceCacheClipMapRadianceProbePDFBuffer[baseIndex + coefficientIndex] = 0;
}

[numthreads(BURT_GI_TRACE_TILE_THREADGROUP_SIZE, BURT_GI_TRACE_TILE_THREADGROUP_SIZE, 1)]
void GenerateProbeTraceTilesCS(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint probeTraceIndex = groupId.z;
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0])
    {
        return;
    }

    uint threadIndex = groupThreadId.y * BURT_GI_TRACE_TILE_THREADGROUP_SIZE + groupThreadId.x;
    float3 probeWorldCenter = BurtGIGetProbeTraceWorldCenter(probeTraceIndex);
    uint probeIndex = BurtGIGetProbeIndexFromTraceData(probeTraceIndex);
    uint baseTileResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution / (uint)BURT_GI_TRACE_TILE_THREADGROUP_SIZE / 2u);
    uint maxTileResolution = max(baseTileResolution, _BurtGIRadianceCacheClipMapFallbackTraceTileResolution * 2u);
    uint maxLevels = maxTileResolution >= baseTileResolution * 4u ? 3u : (maxTileResolution >= baseTileResolution * 2u ? 2u : 1u);
    uint traceCost = min(_BurtGIRadianceCacheClipMapProbesToUpdateTraceCostBuffer[0], _BurtGIRadianceCacheClipMapMaxProbeCount);
    uint traceBudget = max(1u, _BurtGIRadianceCacheClipMapNumProbesToTraceBudget);
    uint levelCount = BurtGIResolveTraceTileLevelCount(probeWorldCenter, maxLevels);

    if (_BurtGIRadianceCacheClipMapForcedUniformTraceTileLevel >= 0)
    {
        BurtGIQueueUniformProbeTraceTiles(threadIndex, baseTileResolution, levelCount - 1u, probeTraceIndex);
        return;
    }

    if (traceCost > traceBudget * 2u)
    {
        levelCount = 1u;
    }

    if (threadIndex == 0u)
    {
        BurtGITraceTilePendingCount = 0u;
        BurtGITraceTileCompletedCount = 0u;
        BurtGIBuildRadianceProbePDF(probeIndex, probeWorldCenter);
    }

    GroupMemoryBarrierWithGroupSync();

    if (groupThreadId.x < baseTileResolution && groupThreadId.y < baseTileResolution)
    {
        uint2 tileCoord = groupThreadId.xy;
        bool refine = levelCount > 1u &&
            BurtGIShouldRefineProbeTraceTile(probeIndex, probeWorldCenter, tileCoord, baseTileResolution, 0.0);

        if (refine)
        {
            BurtGIQueuePendingProbeTraceTile(tileCoord, 1u, probeTraceIndex);
        }
        else
        {
            BurtGIQueueCompletedProbeTraceTile(tileCoord, 0u, probeTraceIndex);
        }
    }

    GroupMemoryBarrierWithGroupSync();

    uint pendingStartIndex = 0u;

    [unroll]
    for (uint traceLevel = 1u; traceLevel < 3u; ++traceLevel)
    {
        uint pendingEndIndex = min(BurtGITraceTilePendingCount, (uint)(BURT_GI_TRACE_TILE_THREADGROUP_SIZE * BURT_GI_TRACE_TILE_THREADGROUP_SIZE * 4));
        uint traceTileResolution = baseTileResolution << traceLevel;

        if (traceLevel >= levelCount - 1u)
        {
            for (uint pendingIndex = pendingStartIndex + threadIndex; pendingIndex < pendingEndIndex; pendingIndex += BURT_GI_TRACE_TILE_THREADGROUP_SIZE * BURT_GI_TRACE_TILE_THREADGROUP_SIZE)
            {
                uint2 tileCoord;
                uint tileLevel;
                uint packedProbeTraceIndex;
                BurtGIUnpackTraceTileInfo(BurtGITraceTilePendingList[pendingIndex], tileCoord, tileLevel, packedProbeTraceIndex);
                BurtGIQueueCompletedProbeTraceTile(tileCoord, tileLevel, packedProbeTraceIndex);
            }
        }
        else
        {
            for (uint pendingIndex = pendingStartIndex + threadIndex; pendingIndex < pendingEndIndex; pendingIndex += BURT_GI_TRACE_TILE_THREADGROUP_SIZE * BURT_GI_TRACE_TILE_THREADGROUP_SIZE)
            {
                uint2 tileCoord;
                uint tileLevel;
                uint packedProbeTraceIndex;
                BurtGIUnpackTraceTileInfo(BurtGITraceTilePendingList[pendingIndex], tileCoord, tileLevel, packedProbeTraceIndex);

                bool refine = BurtGIShouldRefineProbeTraceTile(
                    probeIndex,
                    probeWorldCenter,
                    tileCoord,
                    traceTileResolution,
                    _BurtGIRadianceCacheClipMapSupersampleTileBRDFThreshold);

                if (refine)
                {
                    BurtGIQueuePendingProbeTraceTile(tileCoord, traceLevel + 1u, packedProbeTraceIndex);
                }
                else
                {
                    BurtGIQueueCompletedProbeTraceTile(tileCoord, tileLevel, packedProbeTraceIndex);
                }
            }
        }

        GroupMemoryBarrierWithGroupSync();
        pendingStartIndex = pendingEndIndex;
    }

    uint numTraceTiles = min(BurtGITraceTileCompletedCount, (uint)(BURT_GI_TRACE_TILE_THREADGROUP_SIZE * BURT_GI_TRACE_TILE_THREADGROUP_SIZE * 4));

    if (threadIndex == 0u)
    {
        InterlockedAdd(_BurtGIRadianceCacheClipMapProbeTraceTileAllocatorBuffer[0], numTraceTiles, BurtGITraceTileGlobalOffset);
    }

    GroupMemoryBarrierWithGroupSync();

    [loop]
    for (uint traceTileIndex = threadIndex; traceTileIndex < numTraceTiles; traceTileIndex += BURT_GI_TRACE_TILE_THREADGROUP_SIZE * BURT_GI_TRACE_TILE_THREADGROUP_SIZE)
    {
        _BurtGIRadianceCacheClipMapProbeTraceTileDataBuffer[BurtGITraceTileGlobalOffset + traceTileIndex] =
            BurtGITraceTileCompletedList[traceTileIndex];
    }
}

[numthreads(1, 1, 1)]
void SetupTraceFromProbesCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x != 0u || dispatchThreadId.y != 0u || dispatchThreadId.z != 0u)
    {
        return;
    }

    uint numProbeTraceTiles = _BurtGIRadianceCacheClipMapProbeTraceTileAllocatorBuffer[0];

    BURT_GI_WRITE_DISPATCH_ARGS(
        _BurtGIRadianceCacheClipMapTraceProbesIndirectArgsBuffer,
        0,
        _BurtGIRadianceCacheClipMapTraceTileGroupStride,
        BurtGIDivRoundUp(numProbeTraceTiles, _BurtGIRadianceCacheClipMapTraceTileGroupStride),
        1u);

    BURT_GI_WRITE_DISPATCH_ARGS(
        _BurtGIRadianceCacheClipMapSortProbeTraceTilesIndirectArgsBuffer,
        0,
        BurtGIDivRoundUp(numProbeTraceTiles, _BurtGIRadianceCacheClipMapSortTraceTilesGroupSize),
        1u,
        1u);

    BURT_GI_WRITE_DISPATCH_ARGS(
        _BurtGIRadianceCacheClipMapRadianceCacheHardwareRayTracingIndirectArgsBuffer,
        0,
        _BurtGIRadianceCacheClipMapTraceTileSize1D,
        numProbeTraceTiles,
        1u);

    _BurtGIRadianceCacheClipMapHardwareRayTracingRayAllocatorBuffer[0] =
        BurtGIMulClamp(numProbeTraceTiles, _BurtGIRadianceCacheClipMapTraceTileSize1D);
}

[numthreads(BURT_GI_COMPUTE_PROBE_WORLD_OFFSET_THREADGROUP_SIZE, 1, 1)]
void ComputeProbeWorldOffsetsLiteCS(
    uint3 groupId : SV_GroupID)
{
    uint probeTraceIndex = groupId.z;
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0])
    {
        return;
    }

    uint probeIndex = BurtGIGetProbeIndexFromTraceData(probeTraceIndex);
    if (probeIndex >= _BurtGIRadianceCacheClipMapMaxProbeCount)
    {
        return;
    }

    _BurtGIRadianceCacheClipMapProbeWorldOffsetBuffer[probeIndex] = float4(0.0, 0.0, 0.0, 0.0);
}

[numthreads(BURT_GI_SORT_TRACE_TILES_THREADGROUP_SIZE, 1, 1)]
void SortProbeTraceTilesCS(
    uint groupId : SV_GroupID,
    uint groupThreadId : SV_GroupThreadID)
{
    [loop]
    for (uint binIndex = groupThreadId; binIndex < BURT_GI_TRACE_TILE_DIRECTION_BINS_1D; binIndex += BURT_GI_SORT_TRACE_TILES_THREADGROUP_SIZE)
    {
        BurtGITraceTileDirectionBinCount[binIndex] = 0u;
        BurtGITraceTileDirectionBinOffset[binIndex] = 0u;
    }

    GroupMemoryBarrierWithGroupSync();

    uint traceTileIndex = groupId * BURT_GI_SORT_TRACE_TILES_THREADGROUP_SIZE + groupThreadId;
    if (traceTileIndex < _BurtGIRadianceCacheClipMapProbeTraceTileAllocatorBuffer[0])
    {
        uint2 traceTileCoord;
        uint traceTileLevel;
        uint probeTraceIndex;
        BurtGIUnpackTraceTileInfo(_BurtGIRadianceCacheClipMapProbeTraceTileDataBuffer[traceTileIndex], traceTileCoord, traceTileLevel, probeTraceIndex);

        uint baseTileResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution / (uint)BURT_GI_TRACE_TILE_THREADGROUP_SIZE / 2u);
        uint traceResolution = max(1u, baseTileResolution << traceTileLevel);
        uint2 directionalBin = min(
            traceTileCoord * (uint)BURT_GI_TRACE_TILE_DIRECTION_BINS_2D / traceResolution,
            uint2(BURT_GI_TRACE_TILE_DIRECTION_BINS_2D - 1u, BURT_GI_TRACE_TILE_DIRECTION_BINS_2D - 1u));
        uint finalBinIndex = directionalBin.y * (uint)BURT_GI_TRACE_TILE_DIRECTION_BINS_2D + directionalBin.x;
        InterlockedAdd(BurtGITraceTileDirectionBinCount[finalBinIndex], 1u);
    }

    GroupMemoryBarrierWithGroupSync();

    if (traceTileIndex < _BurtGIRadianceCacheClipMapProbeTraceTileAllocatorBuffer[0])
    {
        uint2 traceTileData = _BurtGIRadianceCacheClipMapProbeTraceTileDataBuffer[traceTileIndex];
        uint2 traceTileCoord;
        uint traceTileLevel;
        uint probeTraceIndex;
        BurtGIUnpackTraceTileInfo(traceTileData, traceTileCoord, traceTileLevel, probeTraceIndex);

        uint baseTileResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution / (uint)BURT_GI_TRACE_TILE_THREADGROUP_SIZE / 2u);
        uint traceResolution = max(1u, baseTileResolution << traceTileLevel);
        uint2 directionalBin = min(
            traceTileCoord * (uint)BURT_GI_TRACE_TILE_DIRECTION_BINS_2D / traceResolution,
            uint2(BURT_GI_TRACE_TILE_DIRECTION_BINS_2D - 1u, BURT_GI_TRACE_TILE_DIRECTION_BINS_2D - 1u));
        uint finalBinIndex = directionalBin.y * (uint)BURT_GI_TRACE_TILE_DIRECTION_BINS_2D + directionalBin.x;

        uint sortedTraceTileOffset;
        InterlockedAdd(BurtGITraceTileDirectionBinOffset[finalBinIndex], 1u, sortedTraceTileOffset);

        [loop]
        for (uint binIndex = 0u; binIndex < finalBinIndex; ++binIndex)
        {
            sortedTraceTileOffset += BurtGITraceTileDirectionBinCount[binIndex];
        }

        _BurtGIRadianceCacheClipMapSortedProbeTraceTileDataBuffer[groupId * BURT_GI_SORT_TRACE_TILES_THREADGROUP_SIZE + sortedTraceTileOffset] = traceTileData;
    }
}

[numthreads(BURT_GI_TRACE_TILE_THREADGROUP_SIZE, BURT_GI_TRACE_TILE_THREADGROUP_SIZE, 1)]
void TraceFromProbesCS(
    uint3 groupId : SV_GroupID,
    uint2 groupThreadId : SV_GroupThreadID)
{
    uint traceTileIndex = groupId.y * max(1u, _BurtGIRadianceCacheClipMapTraceTileGroupStride) + groupId.x;
    if (traceTileIndex >= _BurtGIRadianceCacheClipMapProbeTraceTileAllocatorBuffer[0])
    {
        return;
    }

    uint2 traceTileCoord;
    uint traceTileLevel;
    uint probeTraceIndex;
    BurtGIUnpackTraceTileInfo(_BurtGIRadianceCacheClipMapSortedProbeTraceTileDataBuffer[traceTileIndex], traceTileCoord, traceTileLevel, probeTraceIndex);
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0])
    {
        return;
    }

    uint radianceProbeResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution);
    uint traceResolution = max(1u, max(1u, radianceProbeResolution / 2u) << min(traceTileLevel, 4u));

    uint2 probeTexelCoord = traceTileCoord * BURT_GI_TRACE_TILE_THREADGROUP_SIZE + groupThreadId.xy;
    bool validTraceTexel = probeTexelCoord.x < traceResolution && probeTexelCoord.y < traceResolution;

    BurtGISharedTraceRadiance[groupThreadId.y][groupThreadId.x] = 0.0;
    BurtGISharedTraceHitDistance[groupThreadId.y][groupThreadId.x] = 65504.0;

    float3 probeWorldCenter = BurtGIGetProbeTraceWorldCenter(probeTraceIndex);
    uint probeIndex = BurtGIGetProbeIndexFromTraceData(probeTraceIndex);

    if (validTraceTexel)
    {
        float2 probeUV = (float2(probeTexelCoord) + 0.5) / (float)traceResolution;
        float3 direction = BurtGIEquiAreaSphericalMapping(probeUV);

        float hitDistance;
        float3 radiance = BurtGISampleRawScreenGI(probeIndex, direction, probeWorldCenter, hitDistance);
        uint clipmapIndex = min(BurtGIGetClipmapIndexFromTraceData(probeTraceIndex), BurtGIClipmapCount() - 1u);
        float clipmapProbeSpacing = max(_BurtGIRadianceCacheClipMapProbeCoordToWorldCenter[clipmapIndex].w, 0.001);
        float hashGridCellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
        float coneHalfAngle = acos(1.0 - rcp(max(1.0, (float)(traceResolution * traceResolution))));
        float minSampleRadius = max(0.05, min(clipmapProbeSpacing * 0.5, hashGridCellSize * 0.5));
        float probeTMin = max(_BurtGIRadianceCacheClipMapClipmapParams[clipmapIndex].y, 0.001);
        float minTraceDistance = max(0.0001, probeTMin);
        float maxTraceDistance = max(_BurtGIScreenProbeTraceParams.w, minTraceDistance + clipmapProbeSpacing);
        float3 sceneCacheRadiance = 0.0;
        float sceneCacheHitDistance = maxTraceDistance;
        float sceneCacheConfidence = 0.0;
        float3 sceneVoxelRadiance = 0.0;
        float sceneVoxelHitDistance = maxTraceDistance;
        float sceneVoxelConfidence = 0.0;
        if (BurtGITrySampleSceneVoxelConeTrace(
                probeWorldCenter,
                direction,
                coneHalfAngle,
                minSampleRadius,
                minTraceDistance,
                maxTraceDistance,
                1.0,
                sceneVoxelRadiance,
                sceneVoxelHitDistance,
                sceneVoxelConfidence))
        {
            float sceneVoxelBlend = saturate(sceneVoxelConfidence * 0.85);
            radiance = lerp(radiance, sceneVoxelRadiance, sceneVoxelBlend);
            hitDistance = lerp(hitDistance, min(hitDistance, sceneVoxelHitDistance), sceneVoxelBlend);
        }

        if (BurtGITrySampleRadianceCacheHashGridSceneCache(
                probeWorldCenter,
                direction,
                coneHalfAngle,
                minSampleRadius,
                minTraceDistance,
                maxTraceDistance,
                1.0,
                sceneCacheRadiance,
                sceneCacheHitDistance,
                sceneCacheConfidence))
        {
            float sceneCacheBlend = saturate(sceneCacheConfidence * 0.75 * (1.0 - saturate(sceneVoxelConfidence)));
            radiance = lerp(radiance, sceneCacheRadiance, sceneCacheBlend);
            hitDistance = lerp(hitDistance, min(hitDistance, sceneCacheHitDistance), sceneCacheBlend);
        }

        float skyTraceEnabled = _BurtGIRadianceCacheClipMapSkyRadiance.w > 0.5 ? 1.0 : 0.0;
        float sceneTraceConfidence = saturate(max(sceneVoxelConfidence, sceneCacheConfidence));
        float skyMissWeight = skyTraceEnabled * saturate(1.0 - sceneTraceConfidence);
        float3 skyRadiance = BurtGIRadianceCacheResolveSkyRadiance(direction, 0.18);
        radiance = lerp(radiance, max(radiance, skyRadiance), skyMissWeight * 0.5);
        hitDistance = lerp(hitDistance, maxTraceDistance, skyMissWeight);

        BurtGISharedTraceRadiance[groupThreadId.y][groupThreadId.x] = radiance;
        BurtGISharedTraceHitDistance[groupThreadId.y][groupThreadId.x] = min(hitDistance, 65504.0);
    }

    GroupMemoryBarrierWithGroupSync();

    uint2 probeAtlasBaseCoord = BurtGIProbeAtlasBaseCoord(probeIndex, radianceProbeResolution);
    if (traceResolution < radianceProbeResolution)
    {
        if (!validTraceTexel)
        {
            return;
        }

        uint upsampleFactor = max(1u, radianceProbeResolution / traceResolution);
        uint2 atlasProbeTexelBaseCoord = probeTexelCoord * upsampleFactor;
        [loop]
        for (uint writeY = 0u; writeY < upsampleFactor; ++writeY)
        {
            [loop]
            for (uint writeX = 0u; writeX < upsampleFactor; ++writeX)
            {
                uint2 atlasProbeTexelCoord = atlasProbeTexelBaseCoord + uint2(writeX, writeY);
                if (atlasProbeTexelCoord.x < radianceProbeResolution && atlasProbeTexelCoord.y < radianceProbeResolution)
                {
                    uint2 atlasCoord = probeAtlasBaseCoord + atlasProbeTexelCoord;
                    _BurtGIRadianceCacheClipMapRadianceProbeAtlasTexture[atlasCoord] = float4(BurtGISharedTraceRadiance[groupThreadId.y][groupThreadId.x], 1.0);
                    _BurtGIRadianceCacheClipMapDepthProbeAtlasTexture[atlasCoord] = BurtGISharedTraceHitDistance[groupThreadId.y][groupThreadId.x];
                }
            }
        }
    }
    else
    {
        uint downsampleFactor = min(
            max(1u, traceResolution / radianceProbeResolution),
            (uint)BURT_GI_TRACE_TILE_THREADGROUP_SIZE);
        uint writeTileSize = max(1u, (uint)BURT_GI_TRACE_TILE_THREADGROUP_SIZE / downsampleFactor);

        if (groupThreadId.x < writeTileSize && groupThreadId.y < writeTileSize)
        {
            float3 radianceSum = 0.0;
            float hitDistanceMin = 65504.0;
            [loop]
            for (uint sampleY = 0u; sampleY < downsampleFactor; ++sampleY)
            {
                [loop]
                for (uint sampleX = 0u; sampleX < downsampleFactor; ++sampleX)
                {
                    uint2 sampleCoord = groupThreadId.xy * downsampleFactor + uint2(sampleX, sampleY);
                    radianceSum += BurtGISharedTraceRadiance[sampleCoord.y][sampleCoord.x];
                    hitDistanceMin = min(hitDistanceMin, BurtGISharedTraceHitDistance[sampleCoord.y][sampleCoord.x]);
                }
            }

            uint2 atlasProbeTexelCoord = traceTileCoord * writeTileSize + groupThreadId.xy;
            if (atlasProbeTexelCoord.x < radianceProbeResolution && atlasProbeTexelCoord.y < radianceProbeResolution)
            {
                uint2 atlasCoord = probeAtlasBaseCoord + atlasProbeTexelCoord;
                float invSampleCount = rcp((float)(downsampleFactor * downsampleFactor));
                _BurtGIRadianceCacheClipMapRadianceProbeAtlasTexture[atlasCoord] = float4(radianceSum * invSampleCount, 1.0);
                _BurtGIRadianceCacheClipMapDepthProbeAtlasTexture[atlasCoord] = hitDistanceMin;
            }
        }
    }
}

[numthreads(BURT_GI_TRACE_TILE_THREADGROUP_SIZE, BURT_GI_TRACE_TILE_THREADGROUP_SIZE, 1)]
void FilterProbeRadianceCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint probeTraceIndex = dispatchThreadId.z;
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0])
    {
        return;
    }

    uint2 probeTexelCoord = dispatchThreadId.xy;
    uint radianceProbeResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution);
    if (probeTexelCoord.x >= radianceProbeResolution || probeTexelCoord.y >= radianceProbeResolution)
    {
        return;
    }

    float3 probeWorldCenter = BurtGIGetProbeTraceWorldCenter(probeTraceIndex);
    uint probeIndex = BurtGIGetProbeIndexFromTraceData(probeTraceIndex);
    uint clipmapIndex = min(BurtGIGetClipmapIndexFromTraceData(probeTraceIndex), BurtGIClipmapCount() - 1u);
    uint2 rawBaseCoord = BurtGIProbeAtlasBaseCoord(probeIndex, radianceProbeResolution);

    float centerDepth = _BurtGIRadianceCacheClipMapDepthProbeAtlasReadTexture.Load(int3(rawBaseCoord + probeTexelCoord, 0));
    float3 lighting = _BurtGIRadianceCacheClipMapRadianceProbeAtlasReadTexture.Load(int3(rawBaseCoord + probeTexelCoord, 0)).rgb;
    float totalWeight = 1.0;
    uint3 probeCoordUint;
    if (BurtGIWorldPositionToProbeCoordInClipmap(probeWorldCenter, clipmapIndex, probeCoordUint))
    {
        int3 probeCoord = (int3)probeCoordUint;
        int3 neighborOffsets[6] =
        {
            int3(-1, 0, 0),
            int3(1, 0, 0),
            int3(0, -1, 0),
            int3(0, 1, 0),
            int3(0, 0, -1),
            int3(0, 0, 1)
        };

        float2 probeUV = (float2(probeTexelCoord) + 0.5) / (float)radianceProbeResolution;
        float3 worldConeDirection = BurtGIEquiAreaSphericalMapping(probeUV);
        float occlusionTestOffset = 2.0 * max(_BurtGIRadianceCacheClipMapClipmapParams[clipmapIndex].y, 0.001);
        float spatialFilterMaxRadianceHitAngle = 0.2;

        [unroll]
        for (uint neighborOffsetIndex = 0u; neighborOffsetIndex < 6u; ++neighborOffsetIndex)
        {
            int3 neighborCoord = probeCoord + neighborOffsets[neighborOffsetIndex];
            uint neighborProbeIndex = BurtGIGetProbeIndexFromIndirectionCoord(neighborCoord, clipmapIndex);
            if (neighborProbeIndex == BURT_GI_INVALID_PROBE_INDEX || neighborProbeIndex == probeIndex)
            {
                continue;
            }

            uint2 neighborRawBaseCoord = BurtGIProbeAtlasBaseCoord(neighborProbeIndex, radianceProbeResolution);
            float neighborRadianceDepth = _BurtGIRadianceCacheClipMapDepthProbeAtlasReadTexture.Load(int3(neighborRawBaseCoord + probeTexelCoord, 0));
            float3 neighborWorldPosition = BurtGIProbeCoordToWorldPosition(clipmapIndex, (uint3)neighborCoord) +
                _BurtGIRadianceCacheClipMapProbeWorldOffsetBuffer[neighborProbeIndex].xyz;
            float occlusionWeight = 1.0;

            float3 neighborOcclusionTestPosition = neighborWorldPosition + occlusionTestOffset * worldConeDirection;
            float3 toNeighborOcclusionPosition = neighborOcclusionTestPosition - probeWorldCenter;
            uint2 probeTexelCoordForNeighborOcclusionPosition = min(
                (uint2)(BurtGIInverseEquiAreaSphericalMapping(toNeighborOcclusionPosition) * (float)radianceProbeResolution),
                uint2(radianceProbeResolution - 1u, radianceProbeResolution - 1u));
            float probeDepthForNeighborOcclusionPosition =
                _BurtGIRadianceCacheClipMapDepthProbeAtlasReadTexture.Load(int3(rawBaseCoord + probeTexelCoordForNeighborOcclusionPosition, 0));
            if (probeDepthForNeighborOcclusionPosition * probeDepthForNeighborOcclusionPosition <
                dot(toNeighborOcclusionPosition, toNeighborOcclusionPosition))
            {
                occlusionWeight = 0.0;
            }

            float3 occlusionTestPosition = probeWorldCenter + occlusionTestOffset * worldConeDirection;
            float3 toOcclusionPosition = occlusionTestPosition - neighborWorldPosition;
            uint2 neighborProbeTexelCoordForOcclusionPosition = min(
                (uint2)(BurtGIInverseEquiAreaSphericalMapping(toOcclusionPosition) * (float)radianceProbeResolution),
                uint2(radianceProbeResolution - 1u, radianceProbeResolution - 1u));
            float neighborDepthForOcclusionPosition =
                _BurtGIRadianceCacheClipMapDepthProbeAtlasReadTexture.Load(int3(neighborRawBaseCoord + neighborProbeTexelCoordForOcclusionPosition, 0));
            if (neighborDepthForOcclusionPosition * neighborDepthForOcclusionPosition <
                dot(toOcclusionPosition, toOcclusionPosition))
            {
                occlusionWeight = 0.0;
            }

            if (centerDepth >= 0.0)
            {
                neighborRadianceDepth = min(neighborRadianceDepth, centerDepth);
            }
            float3 neighborHitPosition = neighborWorldPosition + worldConeDirection * neighborRadianceDepth;
            float3 toNeighborHit = neighborHitPosition - probeWorldCenter;
            float toNeighborHitLengthSq = max(dot(toNeighborHit, toNeighborHit), 0.0001);
            float neighborAngle = acos(clamp(dot(toNeighborHit, worldConeDirection) * rsqrt(toNeighborHitLengthSq), -1.0, 1.0));
            float angleWeight = 1.0 - saturate(neighborAngle / spatialFilterMaxRadianceHitAngle);
            float neighborWeight = angleWeight * occlusionWeight;

            lighting += _BurtGIRadianceCacheClipMapRadianceProbeAtlasReadTexture.Load(int3(neighborRawBaseCoord + probeTexelCoord, 0)).rgb * neighborWeight;
            totalWeight += neighborWeight;
        }
    }

    _BurtGIRadianceCacheClipMapRadianceProbeAtlasTexture[rawBaseCoord + probeTexelCoord] =
        float4(lighting / max(totalWeight, 0.0001), 1.0);
}

[numthreads(BURT_GI_TRACE_TILE_THREADGROUP_SIZE, BURT_GI_TRACE_TILE_THREADGROUP_SIZE, 1)]
void CalculateProbeIrradianceCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint probeTraceIndex = dispatchThreadId.z;
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0])
    {
        return;
    }

    uint radianceProbeResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution);
    uint finalIrradianceProbeResolution = max(1u, _BurtGIRadianceCacheClipMapFinalIrradianceProbeResolution);
    uint2 finalProbeTexelCoord = dispatchThreadId.xy;
    if (finalProbeTexelCoord.x >= finalIrradianceProbeResolution || finalProbeTexelCoord.y >= finalIrradianceProbeResolution)
    {
        return;
    }

    uint probeIndex = BurtGIGetProbeIndexFromTraceData(probeTraceIndex);
    uint2 rawBaseCoord = BurtGIProbeAtlasBaseCoord(probeIndex, radianceProbeResolution);
    uint2 finalBaseCoord = BurtGIProbeAtlasBaseCoord(probeIndex, finalIrradianceProbeResolution);
    uint2 finalCoord = finalBaseCoord + finalProbeTexelCoord;
    uint borderSize = max(0u, (max(radianceProbeResolution, _BurtGIRadianceCacheClipMapFinalProbeResolution) - radianceProbeResolution) / 2u);
    uint irradianceProbeResolution = max(1u, finalIrradianceProbeResolution > 2u * borderSize ? finalIrradianceProbeResolution - 2u * borderSize : 1u);
    uint2 probeTexelCoord = BurtGIWrapProbeTexelToRaw(finalProbeTexelCoord, finalIrradianceProbeResolution, irradianceProbeResolution);

    float3 irradianceDirection = BurtGIEquiAreaSphericalMapping((float2(probeTexelCoord) + 0.5) / (float)irradianceProbeResolution);
    float3 irradiance = 0.0;
    float totalWeight = 0.0;
    float skyVisibility = 0.0;
    float skyVisibilityWeight = 0.0;
    float maxTraceDistance = max(_BurtGIScreenProbeTraceParams.w, 1.0);
    uint downsampledProbeResolution = min(8u, radianceProbeResolution);
    uint downsampleFactor = max(1u, radianceProbeResolution / max(downsampledProbeResolution, 1u));

    [unroll(8)]
    for (uint y = 0u; y < 8u; ++y)
    {
        [unroll(8)]
        for (uint x = 0u; x < 8u; ++x)
        {
            if (x >= downsampledProbeResolution || y >= downsampledProbeResolution)
            {
                continue;
            }

            float3 sourceRadiance = 0.0;
            float sourceSkyVisibility = 0.0;
            [loop]
            for (uint yOffset = 0u; yOffset < downsampleFactor; ++yOffset)
            {
                [loop]
                for (uint xOffset = 0u; xOffset < downsampleFactor; ++xOffset)
                {
                    uint2 sourceCoord = min(
                        uint2(x, y) * downsampleFactor + uint2(xOffset, yOffset),
                        uint2(radianceProbeResolution - 1u, radianceProbeResolution - 1u));
                    sourceRadiance += _BurtGIRadianceCacheClipMapRadianceProbeAtlasReadTexture.Load(int3(rawBaseCoord + sourceCoord, 0)).rgb;
                    float depth = _BurtGIRadianceCacheClipMapDepthProbeAtlasReadTexture.Load(int3(rawBaseCoord + sourceCoord, 0));
                    sourceSkyVisibility += depth < maxTraceDistance ? 0.0 : 1.0;
                }
            }

            float normalization = 1.0 / max((float)(downsampleFactor * downsampleFactor), 1.0);
            sourceRadiance *= normalization;
            sourceSkyVisibility *= normalization;

            float3 radianceDirection = BurtGIEquiAreaSphericalMapping((float2(x, y) + 0.5) / (float)downsampledProbeResolution);
            float ndotl = max(dot(irradianceDirection, radianceDirection), 0.0);
            irradiance += sourceRadiance * ndotl;
            skyVisibility += sourceSkyVisibility * ndotl;
            totalWeight += ndotl;
            skyVisibilityWeight += ndotl;
        }
    }

    float3 lowFrequencyIrradiance = irradiance / max(totalWeight, 0.0001);
    _BurtGIRadianceCacheClipMapFinalIrradianceAtlasTexture[finalCoord] = float4(lowFrequencyIrradiance, 1.0);
    _BurtGIRadianceCacheClipMapProbeSkyAOAtlasTexture[finalCoord] = skyVisibility / max(skyVisibilityWeight, 0.0001);
}

[numthreads(BURT_GI_TRACE_TILE_THREADGROUP_SIZE, BURT_GI_TRACE_TILE_THREADGROUP_SIZE, 1)]
void PrepareProbeOcclusionCS(
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint probeTraceIndex = dispatchThreadId.z;
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0])
    {
        return;
    }

    uint finalProbeResolution = max(1u, _BurtGIRadianceCacheClipMapFinalOcclusionProbeResolution);
    uint2 finalProbeTexelCoord = dispatchThreadId.xy;
    if (finalProbeTexelCoord.x >= finalProbeResolution || finalProbeTexelCoord.y >= finalProbeResolution)
    {
        return;
    }

    uint radianceProbeResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution);
    uint probeIndex = BurtGIGetProbeIndexFromTraceData(probeTraceIndex);
    uint2 rawBaseCoord = BurtGIProbeAtlasBaseCoord(probeIndex, radianceProbeResolution);
    uint borderSize = 1u << min(_BurtGIRadianceCacheClipMapFinalRadianceAtlasMaxMip, 8u);
    uint occlusionProbeResolution = min(radianceProbeResolution, max(1u, finalProbeResolution > 2u * borderSize ? finalProbeResolution - 2u * borderSize : 1u));
    uint downsampleFactor = max(1u, radianceProbeResolution / max(occlusionProbeResolution, 1u));

    uint2 occlusionTexelCoord = BurtGIWrapProbeTexelToRaw(finalProbeTexelCoord, finalProbeResolution, occlusionProbeResolution);

    float accumulatedDepth = 0.0;
    float accumulatedDepthSq = 0.0;

    [loop]
    for (uint yOffset = 0u; yOffset < downsampleFactor; ++yOffset)
    {
        [loop]
        for (uint xOffset = 0u; xOffset < downsampleFactor; ++xOffset)
        {
            uint2 rawProbeTexelCoord = occlusionTexelCoord * downsampleFactor + uint2(xOffset, yOffset);
            rawProbeTexelCoord = rawProbeTexelCoord % radianceProbeResolution;
            float depth = _BurtGIRadianceCacheClipMapDepthProbeAtlasReadTexture.Load(int3(rawBaseCoord + rawProbeTexelCoord, 0));
            accumulatedDepth += depth;
            accumulatedDepthSq += depth * depth;
        }
    }

    float normalization = 1.0 / max((float)(downsampleFactor * downsampleFactor), 1.0);
    uint2 finalBaseCoord = BurtGIProbeAtlasBaseCoord(probeIndex, finalProbeResolution);
    _BurtGIRadianceCacheClipMapProbeOcclusionAtlasTexture[finalBaseCoord + finalProbeTexelCoord] =
        float2(accumulatedDepth * normalization, accumulatedDepthSq * normalization);
}

[numthreads(BURT_GI_TRACE_TILE_THREADGROUP_SIZE, BURT_GI_TRACE_TILE_THREADGROUP_SIZE, 1)]
void FixupBorderAndGenerateMipsCS(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID,
    uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint probeTraceIndex = dispatchThreadId.z;
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapProbeTraceAllocatorBuffer[0])
    {
        return;
    }

    uint radianceProbeResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution);
    uint finalProbeResolution = max(radianceProbeResolution, _BurtGIRadianceCacheClipMapFinalProbeResolution);
    uint2 finalProbeTexelCoord = dispatchThreadId.xy;
    if (finalProbeTexelCoord.x >= finalProbeResolution || finalProbeTexelCoord.y >= finalProbeResolution)
    {
        BurtGIFinalRadianceMip0LDS[groupThreadId.y][groupThreadId.x] = 0.0;
        return;
    }

    uint probeIndex = BurtGIGetProbeIndexFromTraceData(probeTraceIndex);
    uint2 finalBaseCoord = BurtGIProbeAtlasBaseCoord(probeIndex, finalProbeResolution);
    uint2 finalAtlasCoord = finalBaseCoord + finalProbeTexelCoord;
    uint2 rawProbeTexelCoord = BurtGIWrapFinalProbeTexelToRaw(finalProbeTexelCoord);
    float3 lighting = _BurtGIRadianceCacheClipMapRadianceProbeAtlasReadTexture.Load(
        int3(BurtGIProbeAtlasBaseCoord(probeIndex, radianceProbeResolution) + rawProbeTexelCoord, 0)).rgb;
    _BurtGIRadianceCacheClipMapFinalRadianceAtlasTexture[finalAtlasCoord] = float4(lighting, 1.0);

    BurtGIFinalRadianceMip0LDS[groupThreadId.y][groupThreadId.x] = lighting;
    if (_BurtGIRadianceCacheClipMapFinalRadianceAtlasMaxMip > 0u)
    {
        GroupMemoryBarrierWithGroupSync();

        uint atlasResolutionInProbes = BurtGIProbeAtlasResolutionInProbes();
        uint2 probeCoord = uint2(probeIndex % atlasResolutionInProbes, probeIndex / atlasResolutionInProbes);
        uint mip1Resolution = max(1u, finalProbeResolution >> 1u);
        uint2 mip1ProbeTexelCoord = groupThreadId.xy + (BURT_GI_TRACE_TILE_THREADGROUP_SIZE / 2u) * groupId.xy;
        if (all(groupThreadId.xy < (BURT_GI_TRACE_TILE_THREADGROUP_SIZE / 2u)) && all(mip1ProbeTexelCoord < mip1Resolution))
        {
            float3 mip1Lighting = 0.0;
            mip1Lighting += BurtGIFinalRadianceMip0LDS[groupThreadId.y * 2u + 0u][groupThreadId.x * 2u + 0u];
            mip1Lighting += BurtGIFinalRadianceMip0LDS[groupThreadId.y * 2u + 0u][groupThreadId.x * 2u + 1u];
            mip1Lighting += BurtGIFinalRadianceMip0LDS[groupThreadId.y * 2u + 1u][groupThreadId.x * 2u + 0u];
            mip1Lighting += BurtGIFinalRadianceMip0LDS[groupThreadId.y * 2u + 1u][groupThreadId.x * 2u + 1u];
            mip1Lighting *= 0.25;
            BurtGIFinalRadianceMip1LDS[groupThreadId.y][groupThreadId.x] = mip1Lighting;
            _BurtGIRadianceCacheClipMapFinalRadianceAtlasMip1Texture[mip1ProbeTexelCoord + mip1Resolution * probeCoord] = float4(mip1Lighting, 1.0);
        }

        if (_BurtGIRadianceCacheClipMapFinalRadianceAtlasMaxMip > 1u)
        {
            GroupMemoryBarrierWithGroupSync();

            uint mip2Resolution = max(1u, finalProbeResolution >> 2u);
            uint2 mip2ProbeTexelCoord = groupThreadId.xy + (BURT_GI_TRACE_TILE_THREADGROUP_SIZE / 4u) * groupId.xy;
            if (all(groupThreadId.xy < (BURT_GI_TRACE_TILE_THREADGROUP_SIZE / 4u)) && all(mip2ProbeTexelCoord < mip2Resolution))
            {
                float3 mip2Lighting = 0.0;
                mip2Lighting += BurtGIFinalRadianceMip1LDS[groupThreadId.y * 2u + 0u][groupThreadId.x * 2u + 0u];
                mip2Lighting += BurtGIFinalRadianceMip1LDS[groupThreadId.y * 2u + 0u][groupThreadId.x * 2u + 1u];
                mip2Lighting += BurtGIFinalRadianceMip1LDS[groupThreadId.y * 2u + 1u][groupThreadId.x * 2u + 0u];
                mip2Lighting += BurtGIFinalRadianceMip1LDS[groupThreadId.y * 2u + 1u][groupThreadId.x * 2u + 1u];
                _BurtGIRadianceCacheClipMapFinalRadianceAtlasMip2Texture[mip2ProbeTexelCoord + mip2Resolution * probeCoord] = float4(mip2Lighting * 0.25, 1.0);
            }
        }
    }
}
