#pragma kernel GenerateTranslucencyVolumeFromScreenGICS
#pragma kernel FilterTranslucencyVolumeSpatialCS

#define BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE 4
#define BURT_GI_CLIPMAP_COUNT 5
#define BURT_GI_TRANSLUCENCY_VOLUME_MAX_RAY_INTENSITY 20.0f

Texture2D<float4> _BurtGIDiffuseIndirectTexture;
Texture2D<float4> _BurtGIBackfaceDiffuseIndirectTexture;
Texture2D<float4> _BurtGIScreenProbeRadianceTexture;
Texture2D<float4> _BurtGIScreenProbeConfidenceTexture;
Texture3D<float4> _BurtGISceneVoxelGeometryReadTexture;
Texture3D<float4> _BurtGISceneVoxelOccupancyMipReadTexture;
Texture3D<float4> _BurtGISceneVoxelLightingReadTexture;
Texture3D<uint> _BurtGISceneVoxelOctreeLeafLowTexture;
Texture3D<uint> _BurtGISceneVoxelOctreeLeafHighTexture;
Texture3D<uint> _BurtGISceneVoxelOctreeParentLowTexture;
Texture3D<uint> _BurtGISceneVoxelOctreeParentHighTexture;
Texture3D<uint> _BurtGISceneVoxelOctreeRootLowTexture;
Texture3D<uint> _BurtGISceneVoxelOctreeRootHighTexture;
float _BurtGISceneVoxelOctreeValid;
Texture3D<float4> _BurtGISceneVoxelClipmap1GeometryReadTexture;
Texture3D<float4> _BurtGISceneVoxelClipmap1OccupancyMipReadTexture;
Texture3D<float4> _BurtGISceneVoxelClipmap1LightingReadTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap1OctreeLeafLowTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap1OctreeLeafHighTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap1OctreeParentLowTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap1OctreeParentHighTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap1OctreeRootLowTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap1OctreeRootHighTexture;
Texture3D<float4> _BurtGISceneVoxelClipmap2GeometryReadTexture;
Texture3D<float4> _BurtGISceneVoxelClipmap2OccupancyMipReadTexture;
Texture3D<float4> _BurtGISceneVoxelClipmap2LightingReadTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap2OctreeLeafLowTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap2OctreeLeafHighTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap2OctreeParentLowTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap2OctreeParentHighTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap2OctreeRootLowTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap2OctreeRootHighTexture;
Texture3D<float4> _BurtGISceneVoxelClipmap3GeometryReadTexture;
Texture3D<float4> _BurtGISceneVoxelClipmap3OccupancyMipReadTexture;
Texture3D<float4> _BurtGISceneVoxelClipmap3LightingReadTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap3OctreeLeafLowTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap3OctreeLeafHighTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap3OctreeParentLowTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap3OctreeParentHighTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap3OctreeRootLowTexture;
Texture3D<uint> _BurtGISceneVoxelClipmap3OctreeRootHighTexture;
Texture3D<float4> _BurtGITranslucencyVolumeHistory0;
Texture3D<float4> _BurtGITranslucencyVolumeHistory1;
Texture3D<float4> _BurtGITranslucencyVolumeRead0;
Texture3D<float4> _BurtGITranslucencyVolumeRead1;

RWTexture3D<float4> _BurtGITranslucencyVolume0;
RWTexture3D<float4> _BurtGITranslucencyVolume1;
RWTexture3D<float4> _BurtGITranslucencyVolumeFilter0;
RWTexture3D<float4> _BurtGITranslucencyVolumeFilter1;

float4 _BurtGITranslucencyVolumeGridSize; // xyz=volume grid size, w=apply scale.
float4 _BurtGITranslucencyVolumeParams0; // x=near, y=far, z=depth fade power, w=screen-probe blend.
float4 _BurtGITranslucencyVolumeTemporalParams; // x=history feedback, y=history valid, z=confidence weight, w=world reprojection.
float4 _BurtGITranslucencyVolumeSpatialFilterParams; // x=sample count, y=sigma, z=enabled, w=confidence weight.
float4 _BurtGITranslucencyVolumeGridZParams; // x=log scale, y=log bias, z=slice scale.
float4 _BurtDeferredCameraWorldPosition;
float4 _BurtGIRadianceCacheClipMapClipmapCenterExtent[BURT_GI_CLIPMAP_COUNT];
float4 _BurtGISceneVoxelCenterExtent;
float4 _BurtGISceneVoxelTraceControls;
float4 _BurtGISceneVoxelClipmapCenterExtent[4];
uint _BurtGISceneVoxelClipmapValidMask;
float4x4 _BurtDeferredInverseViewProjectionMatrix;
float4x4 _BurtGIPreviousViewProjectionMatrix;

#include "BurtGISceneVoxelOctree.hlsl"

float BurtGITranslucencyVolumeLuminance(float3 color)
{
    return dot(color, float3(0.2126f, 0.7152f, 0.0722f));
}

float3 BurtGITranslucencyVolumeClampRayIntensity(float3 radiance)
{
    float maxLighting = max(max(abs(radiance.r), abs(radiance.g)), abs(radiance.b));
    if (maxLighting > BURT_GI_TRANSLUCENCY_VOLUME_MAX_RAY_INTENSITY)
    {
        radiance *= BURT_GI_TRANSLUCENCY_VOLUME_MAX_RAY_INTENSITY / maxLighting;
    }

    return radiance;
}

float2 BurtGITranslucencyVolumeClipToUV(float2 clipXY)
{
    float2 uv = clipXY * 0.5f + 0.5f;
#if UNITY_UV_STARTS_AT_TOP
    uv.y = 1.0f - uv.y;
#endif
    return uv;
}

float2 BurtGITranslucencyVolumeUVToClipXY(float2 uv)
{
#if UNITY_UV_STARTS_AT_TOP
    uv.y = 1.0f - uv.y;
#endif
    return uv * 2.0f - 1.0f;
}

float3 BurtGITranslucencyVolumeClipToWorld(float4 clipPosition)
{
    float4 worldPosition = mul(_BurtDeferredInverseViewProjectionMatrix, clipPosition);
    return worldPosition.xyz / max(worldPosition.w, 0.00001f);
}

float BurtGITranslucencyVolumeLinearDepthFromSlice(float z01, float3 gridSize)
{
    float logValue = z01 * max(gridSize.z, 1.0f) / max(_BurtGITranslucencyVolumeGridZParams.z, 0.00001f);
    float linearDepth = (exp2(logValue) - _BurtGITranslucencyVolumeGridZParams.y) / max(_BurtGITranslucencyVolumeGridZParams.x, 0.00001f);
    return clamp(linearDepth, max(_BurtGITranslucencyVolumeParams0.x, 0.01f), max(_BurtGITranslucencyVolumeParams0.y, _BurtGITranslucencyVolumeParams0.x + 1.0f));
}

float BurtGITranslucencyVolumeNormalizedSliceFromLinearDepth(float linearDepth, float3 gridSize)
{
    return log2(max(linearDepth, 0.00001f) * _BurtGITranslucencyVolumeGridZParams.x + _BurtGITranslucencyVolumeGridZParams.y) *
        _BurtGITranslucencyVolumeGridZParams.z / max(gridSize.z, 1.0f);
}

float3 BurtGITranslucencyVolumeCellWorldPosition(uint3 id, float2 uv, float z01, float3 gridSize)
{
    float2 clipXY = BurtGITranslucencyVolumeUVToClipXY(uv);
#if defined(UNITY_REVERSED_Z)
    float farClipZ = 0.0f;
#else
    float farClipZ = 1.0f;
#endif
    float3 farWorld = BurtGITranslucencyVolumeClipToWorld(float4(clipXY, farClipZ, 1.0f));
    float3 cameraWorld = _BurtDeferredCameraWorldPosition.xyz;
    float3 rayDirection = normalize(farWorld - cameraWorld);
    float linearDepth = BurtGITranslucencyVolumeLinearDepthFromSlice(z01, gridSize);
    return cameraWorld + rayDirection * linearDepth;
}

float3 BurtGITranslucencyVolumeSceneVoxelWorldToUVW(float3 worldPosition)
{
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float extent = max(centerExtent.w, 0.001f);
    return (worldPosition - centerExtent.xyz) / (extent * 2.0f) + 0.5f;
}

bool BurtGITranslucencyVolumeOctreeMaskContains(uint lowMask, uint highMask, uint bitIndex)
{
    uint word = bitIndex < 32u ? lowMask : highMask;
    return ((word >> (bitIndex & 31u)) & 1u) != 0u;
}

bool BurtGITranslucencyVolumeSceneVoxelOctreeMayContain(float3 samplePosition)
{
    if (_BurtGISceneVoxelOctreeValid <= 0.5f)
    {
        return true;
    }

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGITranslucencyVolumeSceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0f) || any(uvw > 1.0f))
    {
        return false;
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    uint3 parentCoord = voxelCoord >> 4u;
    uint3 leafCoord = voxelCoord >> 2u;
    uint rootBit = parentCoord.x + parentCoord.y * 4u + parentCoord.z * 16u;
    if (!BurtGITranslucencyVolumeOctreeMaskContains(
            _BurtGISceneVoxelOctreeRootLowTexture[uint3(0u, 0u, 0u)],
            _BurtGISceneVoxelOctreeRootHighTexture[uint3(0u, 0u, 0u)],
            rootBit))
    {
        return false;
    }

    uint3 parentChild = leafCoord & 3u;
    uint parentBit = parentChild.x + parentChild.y * 4u + parentChild.z * 16u;
    if (!BurtGITranslucencyVolumeOctreeMaskContains(
            _BurtGISceneVoxelOctreeParentLowTexture[parentCoord],
            _BurtGISceneVoxelOctreeParentHighTexture[parentCoord],
            parentBit))
    {
        return false;
    }

    uint3 leafChild = voxelCoord & 3u;
    uint leafBit = leafChild.x + leafChild.y * 4u + leafChild.z * 16u;
    return BurtGITranslucencyVolumeOctreeMaskContains(
        _BurtGISceneVoxelOctreeLeafLowTexture[leafCoord],
        _BurtGISceneVoxelOctreeLeafHighTexture[leafCoord],
        leafBit);
}

bool BurtGITranslucencyVolumeTrySampleSceneVoxelOccupancy(float3 samplePosition, out float occupancy)
{
    occupancy = 0.0f;

    if (!BurtGITranslucencyVolumeSceneVoxelOctreeMayContain(samplePosition))
    {
        return false;
    }

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelOccupancyMipReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1, 1, 1));
    float3 uvw = BurtGITranslucencyVolumeSceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0f) || any(uvw > 1.0f))
    {
        return false;
    }

    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1);
    float4 occupancyMip = _BurtGISceneVoxelOccupancyMipReadTexture.Load(int4((int3)coord, 0));
    occupancy = saturate(max(occupancyMip.x, occupancyMip.y));
    return occupancy > 0.001f;
}

bool BurtGITranslucencyVolumeTrySampleSceneVoxelGeometry(
    float3 samplePosition,
    float3 traceDirection,
    out float occupancy,
    out float normalFacingWeight)
{
    occupancy = 0.0f;
    normalFacingWeight = 0.0f;

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1, 1, 1));
    float3 uvw = BurtGITranslucencyVolumeSceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0f) || any(uvw > 1.0f))
    {
        return false;
    }

    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1);
    float4 geometry = _BurtGISceneVoxelGeometryReadTexture.Load(int4((int3)coord, 0));
    occupancy = saturate(geometry.a);
    if (occupancy <= 0.001f)
    {
        return false;
    }

    float3 normalWS = normalize(geometry.xyz * 2.0f - 1.0f);
    normalFacingWeight = saturate(dot(normalWS, -normalize(traceDirection)) * 0.65f + 0.35f);
    return normalFacingWeight > 0.001f;
}

bool BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHit(
    Texture3D<float4> geometryTexture,
    Texture3D<float4> lightingTexture,
    float4 centerExtent,
    float3 samplePosition,
    float3 traceDirection,
    out float3 radiance,
    out float occupancy,
    out float normalFacingWeight)
{
    radiance = 0.0f;
    occupancy = 0.0f;
    normalFacingWeight = 0.0f;
    uint width;
    uint height;
    uint depth;
    geometryTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1, 1, 1));
    float extent = max(centerExtent.w, 0.001f);
    float3 uvw = (samplePosition - centerExtent.xyz) / (extent * 2.0f) + 0.5f;
    if (any(uvw < 0.0f) || any(uvw > 1.0f))
    {
        return false;
    }

    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1);
    float4 geometry = geometryTexture.Load(int4((int3)coord, 0));
    float4 lighting = lightingTexture.Load(int4((int3)coord, 0));
    occupancy = saturate(geometry.a);
    radiance = max(lighting.rgb, 0.0f);
    if (occupancy <= 0.001f || lighting.a <= 0.001f || dot(radiance, radiance) <= 0.0f)
    {
        return false;
    }

    float3 normalWS = normalize(geometry.xyz * 2.0f - 1.0f);
    normalFacingWeight = saturate(dot(normalWS, -normalize(traceDirection)) * 0.65f + 0.35f);
    return normalFacingWeight > 0.001f;
}

bool BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHitByLevel(
    uint clipmapLevel,
    float3 samplePosition,
    float3 traceDirection,
    out float3 radiance,
    out float occupancy,
    out float normalFacingWeight)
{
    if (clipmapLevel == 1u)
    {
        return BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap1GeometryReadTexture,
            _BurtGISceneVoxelClipmap1LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[1],
            samplePosition,
            traceDirection,
            radiance,
            occupancy,
            normalFacingWeight);
    }

    if (clipmapLevel == 2u)
    {
        return BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap2GeometryReadTexture,
            _BurtGISceneVoxelClipmap2LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[2],
            samplePosition,
            traceDirection,
            radiance,
            occupancy,
            normalFacingWeight);
    }

    if (clipmapLevel == 3u)
    {
        return BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap3GeometryReadTexture,
            _BurtGISceneVoxelClipmap3LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[3],
            samplePosition,
            traceDirection,
            radiance,
            occupancy,
            normalFacingWeight);
    }

    if (!BurtGITranslucencyVolumeTrySampleSceneVoxelGeometry(samplePosition, traceDirection, occupancy, normalFacingWeight))
    {
        radiance = 0.0f;
        return false;
    }

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelLightingReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1, 1, 1));
    float3 uvw = BurtGITranslucencyVolumeSceneVoxelWorldToUVW(samplePosition);
    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1);
    float4 lighting = _BurtGISceneVoxelLightingReadTexture.Load(int4((int3)coord, 0));
    radiance = max(lighting.rgb, 0.0f);
    return lighting.a > 0.001f && dot(radiance, radiance) > 0.0f;
}

bool BurtGITranslucencyVolumeTraceSceneVoxelLite(
    float3 worldPosition,
    float3 traceDirection,
    float z01,
    out float3 voxelRadiance,
    out float voxelConfidence)
{
    voxelRadiance = 0.0f;
    voxelConfidence = 0.0f;

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelLightingReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1, 1, 1));
    float voxelSizeWS = max(_BurtGISceneVoxelCenterExtent.w * 2.0f / max((float)volumeSize.x, 1.0f), 0.05f);
    float maxTraceDistance = lerp(voxelSizeWS * 2.0f, voxelSizeWS * 8.0f, saturate(z01));
    float3 direction = normalize(traceDirection);

    if (_BurtGISceneVoxelOctreeValid > 0.5f || (_BurtGISceneVoxelClipmapValidMask & 14u) != 0u)
    {
        float startDistance = voxelSizeWS * 0.5f;
        float octreeHitDistance;
        uint octreeClipmapLevel;
        if (!BurtGIVoxelOctreeRayTraceClipmaps(
                worldPosition + direction * startDistance,
                direction,
                max(maxTraceDistance - startDistance, 0.0f),
                octreeHitDistance,
                octreeClipmapLevel))
        {
            return false;
        }

        float3 hitPosition = worldPosition + direction * (startDistance + octreeHitDistance);
        float occupancy;
        float normalFacingWeight;
        if (!BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHitByLevel(
                octreeClipmapLevel,
                hitPosition,
                direction,
                voxelRadiance,
                occupancy,
                normalFacingWeight))
        {
            return false;
        }

        voxelConfidence = saturate(occupancy * normalFacingWeight);
        return voxelConfidence > 0.001f && dot(voxelRadiance, voxelRadiance) > 0.0f;
    }

    uint maxTraceSteps = min((uint)max(_BurtGISceneVoxelTraceControls.x, 1.0), 64u);
    [loop]
    for (uint stepIndex = 0u; stepIndex < maxTraceSteps; ++stepIndex)
    {
        float stepT = ((float)stepIndex + 0.5f) * max(_BurtGISceneVoxelTraceControls.y, 0.1f) / max((float)maxTraceSteps, 1.0f);
        if (stepT >= 1.0f)
        {
            break;
        }
        float sampleDistance = lerp(voxelSizeWS * 0.5f, maxTraceDistance, stepT);
        float3 samplePosition = worldPosition + direction * sampleDistance;

        float coarseOccupancy;
        if (!BurtGITranslucencyVolumeTrySampleSceneVoxelOccupancy(samplePosition, coarseOccupancy))
        {
            continue;
        }

        float occupancy;
        float normalFacingWeight;
        if (!BurtGITranslucencyVolumeTrySampleSceneVoxelGeometry(samplePosition, direction, occupancy, normalFacingWeight))
        {
            continue;
        }

        float3 uvw = BurtGITranslucencyVolumeSceneVoxelWorldToUVW(samplePosition);
        if (any(uvw < 0.0f) || any(uvw > 1.0f))
        {
            continue;
        }

        uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1);
        float4 lighting = _BurtGISceneVoxelLightingReadTexture.Load(int4((int3)coord, 0));
        float sampleConfidence = saturate(lighting.a * max(coarseOccupancy, occupancy) * normalFacingWeight * (1.0f - stepT * 0.35f));
        if (sampleConfidence > voxelConfidence && dot(lighting.rgb, lighting.rgb) > 0.0f)
        {
            voxelRadiance = max(lighting.rgb, 0.0f);
            voxelConfidence = sampleConfidence;
        }
    }

    return voxelConfidence > 0.001f;
}

bool BurtGITranslucencyVolumeHistoryUV(uint3 id, float2 uv, float z01, float3 gridSize, out float3 historyUV)
{
    historyUV = ((float3)id + 0.5f) / max(gridSize, 1.0f);
    if (_BurtGITranslucencyVolumeTemporalParams.w < 0.5f)
    {
        return true;
    }

    float3 worldPosition = BurtGITranslucencyVolumeCellWorldPosition(id, uv, z01, gridSize);
    float4 previousClip = mul(_BurtGIPreviousViewProjectionMatrix, float4(worldPosition, 1.0f));
    if (previousClip.w <= 0.00001f)
    {
        return false;
    }

    float3 previousNDC = previousClip.xyz / previousClip.w;
    historyUV.xy = BurtGITranslucencyVolumeClipToUV(previousNDC.xy);
    historyUV.z = BurtGITranslucencyVolumeNormalizedSliceFromLinearDepth(previousClip.w, gridSize);
    return !any(historyUV < 0.0f) && !any(historyUV > 1.0f);
}

float4 BurtGITranslucencyVolumeSampleHistoryTrilinear(Texture3D<float4> historyTexture, float3 historyUV, int3 gridSize)
{
    float3 coord = saturate(historyUV) * (float3)gridSize - 0.5f;
    int3 coord0 = clamp((int3)floor(coord), int3(0, 0, 0), gridSize - 1);
    int3 coord1 = min(coord0 + 1, gridSize - 1);
    float3 t = saturate(coord - (float3)coord0);

    float4 c000 = historyTexture.Load(int4(coord0.x, coord0.y, coord0.z, 0));
    float4 c100 = historyTexture.Load(int4(coord1.x, coord0.y, coord0.z, 0));
    float4 c010 = historyTexture.Load(int4(coord0.x, coord1.y, coord0.z, 0));
    float4 c110 = historyTexture.Load(int4(coord1.x, coord1.y, coord0.z, 0));
    float4 c001 = historyTexture.Load(int4(coord0.x, coord0.y, coord1.z, 0));
    float4 c101 = historyTexture.Load(int4(coord1.x, coord0.y, coord1.z, 0));
    float4 c011 = historyTexture.Load(int4(coord0.x, coord1.y, coord1.z, 0));
    float4 c111 = historyTexture.Load(int4(coord1.x, coord1.y, coord1.z, 0));

    float4 c00 = lerp(c000, c100, t.x);
    float4 c10 = lerp(c010, c110, t.x);
    float4 c01 = lerp(c001, c101, t.x);
    float4 c11 = lerp(c011, c111, t.x);
    float4 c0 = lerp(c00, c10, t.y);
    float4 c1 = lerp(c01, c11, t.y);
    return lerp(c0, c1, t.z);
}

uint2 BurtGITranslucencyVolumePixelFromUV(float2 uv, uint2 textureSize)
{
    return min((uint2)floor(saturate(uv) * (float2)textureSize), textureSize - 1);
}

float4 BurtGITranslucencyVolumeTraceScreenConeLite(
    float2 uv,
    float2 traceDirection,
    float z01,
    uint2 diffuseSize,
    uint2 probeSize)
{
    float2 direction = traceDirection;
    float directionLength = max(length(direction), 0.0001f);
    direction /= directionLength;
    float2 tangent = float2(-direction.y, direction.x);
    float2 diffuseTexel = 1.0f / (float2)diffuseSize;
    float2 probeTexel = 1.0f / (float2)probeSize;
    float coneRadius = lerp(1.5f, 7.0f, saturate(z01));
    float3 radianceSum = 0.0f;
    float confidenceSum = 0.0f;
    float totalWeight = 0.0f;

    [unroll]
    for (int sampleIndex = 0; sampleIndex < 5; sampleIndex++)
    {
        float sampleT = (float)sampleIndex / 4.0f;
        float centered = sampleT - 0.5f;
        float weight = lerp(1.0f, 0.35f, sampleT);
        float2 coneOffset = direction * coneRadius * sampleT + tangent * centered * coneRadius * 0.35f;
        uint2 diffusePixel = BurtGITranslucencyVolumePixelFromUV(uv + coneOffset * diffuseTexel, diffuseSize);
        uint2 probePixel = BurtGITranslucencyVolumePixelFromUV(uv + coneOffset * probeTexel, probeSize);
        float3 diffuseGI = max(_BurtGIDiffuseIndirectTexture.Load(int3(diffusePixel, 0)).rgb, 0.0f);
        float3 backfaceGI = max(_BurtGIBackfaceDiffuseIndirectTexture.Load(int3(diffusePixel, 0)).rgb, 0.0f);
        float4 probeRadiance = _BurtGIScreenProbeRadianceTexture.Load(int3(probePixel, 0));
        float4 probeConfidence = _BurtGIScreenProbeConfidenceTexture.Load(int3(probePixel, 0));
        float sampleConfidence = saturate(max(probeRadiance.a, probeConfidence.r));
        float3 sampleRadiance = lerp(diffuseGI * 0.25f + backfaceGI * 0.75f, max(probeRadiance.rgb, 0.0f) * 0.35f + backfaceGI * 0.65f, sampleConfidence);
        radianceSum += sampleRadiance * weight;
        confidenceSum += sampleConfidence * weight;
        totalWeight += weight;
    }

    float invTotalWeight = rcp(max(totalWeight, 0.00001f));
    return float4(radianceSum * invTotalWeight, saturate(confidenceSum * invTotalWeight));
}

[numthreads(BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE, BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE, BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE)]
void GenerateTranslucencyVolumeFromScreenGICS(uint3 id : SV_DispatchThreadID)
{
    uint3 gridSize = max((uint3)_BurtGITranslucencyVolumeGridSize.xyz, uint3(1, 1, 1));
    if (any(id >= gridSize))
    {
        return;
    }

    uint diffuseWidth;
    uint diffuseHeight;
    _BurtGIDiffuseIndirectTexture.GetDimensions(diffuseWidth, diffuseHeight);
    uint2 diffuseSize = max(uint2(diffuseWidth, diffuseHeight), uint2(1, 1));

    uint probeWidth;
    uint probeHeight;
    _BurtGIScreenProbeRadianceTexture.GetDimensions(probeWidth, probeHeight);
    uint2 probeSize = max(uint2(probeWidth, probeHeight), uint2(1, 1));

    float2 uv = ((float2)id.xy + 0.5f) / (float2)gridSize.xy;
    uint2 diffusePixel = min((uint2)floor(uv * (float2)diffuseSize), diffuseSize - 1);
    uint2 probePixel = min((uint2)floor(uv * (float2)probeSize), probeSize - 1);

    float3 diffuseGI = max(_BurtGIDiffuseIndirectTexture.Load(int3(diffusePixel, 0)).rgb, 0.0f);
    float3 backfaceGI = max(_BurtGIBackfaceDiffuseIndirectTexture.Load(int3(diffusePixel, 0)).rgb, 0.0f);
    float4 probeRadiance = _BurtGIScreenProbeRadianceTexture.Load(int3(probePixel, 0));
    float4 probeConfidence = _BurtGIScreenProbeConfidenceTexture.Load(int3(probePixel, 0));

    float z01 = ((float)id.z + 0.5f) / max((float)gridSize.z, 1.0f);
    float depthFade = pow(saturate(1.0f - z01), max(_BurtGITranslucencyVolumeParams0.z, 0.05f));
    float confidence = saturate(max(max(probeRadiance.a, probeConfidence.r), 0.25f));
    float3 probeGI = max(probeRadiance.rgb, 0.0f);
    float probeBlend = saturate(_BurtGITranslucencyVolumeParams0.w) * confidence;
    float3 dominantDirectionVS = normalize(float3(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f, -1.0f));
    float4 coneTrace = BurtGITranslucencyVolumeTraceScreenConeLite(uv, dominantDirectionVS.xy, z01, diffuseSize, probeSize);
    float3 singleTapGI = lerp(diffuseGI * 0.25f + backfaceGI * 0.75f, probeGI * 0.35f + backfaceGI * 0.65f, probeBlend);
    float3 sourceGI = lerp(singleTapGI, coneTrace.rgb, saturate(0.35f + coneTrace.a * 0.45f));
    confidence = saturate(max(confidence, coneTrace.a * 0.85f));
    float3 worldPosition = BurtGITranslucencyVolumeCellWorldPosition(id, uv, z01, (float3)gridSize);
    float3 viewVectorWS = worldPosition - _BurtDeferredCameraWorldPosition.xyz;
    float3 viewDirectionWS = dot(viewVectorWS, viewVectorWS) > 0.000001f ? normalize(viewVectorWS) : float3(0.0f, 0.0f, 1.0f);
    float3 voxelGI;
    float voxelConfidence;
    if (BurtGITranslucencyVolumeTraceSceneVoxelLite(worldPosition, viewDirectionWS, z01, voxelGI, voxelConfidence))
    {
        float voxelBlend = saturate(voxelConfidence * lerp(0.35f, 0.7f, depthFade));
        sourceGI = lerp(sourceGI, max(sourceGI, voxelGI), voxelBlend);
        confidence = saturate(max(confidence, voxelConfidence));
    }

    float3 ambient = sourceGI * lerp(0.35f, 1.0f, depthFade) * max(_BurtGITranslucencyVolumeGridSize.w, 0.0f);
    float3 directionalCoefficients = dominantDirectionVS * BurtGITranslucencyVolumeLuminance(ambient) * lerp(0.15f, 0.45f, depthFade);
    float historyWeight = saturate(_BurtGITranslucencyVolumeTemporalParams.x) *
        saturate(_BurtGITranslucencyVolumeTemporalParams.y) *
        saturate(lerp(1.0f, confidence, _BurtGITranslucencyVolumeTemporalParams.z));
    if (historyWeight > 0.0001f)
    {
        float3 historyUV;
        if (BurtGITranslucencyVolumeHistoryUV(id, uv, z01, (float3)gridSize, historyUV))
        {
            float4 history0 = BurtGITranslucencyVolumeSampleHistoryTrilinear(_BurtGITranslucencyVolumeHistory0, historyUV, int3(gridSize));
            float4 history1 = BurtGITranslucencyVolumeSampleHistoryTrilinear(_BurtGITranslucencyVolumeHistory1, historyUV, int3(gridSize));
            ambient = lerp(ambient, max(history0.rgb, 0.0f), historyWeight);
            directionalCoefficients = lerp(directionalCoefficients, history1.rgb, historyWeight);
            confidence = saturate(max(confidence, max(history0.a, history1.a) * historyWeight));
        }
    }

    ambient = BurtGITranslucencyVolumeClampRayIntensity(ambient);
    directionalCoefficients = BurtGITranslucencyVolumeClampRayIntensity(directionalCoefficients);
    _BurtGITranslucencyVolume0[id] = float4(ambient, confidence);
    _BurtGITranslucencyVolume1[id] = float4(directionalCoefficients, confidence);
}

float BurtGITranslucencyVolumeGaussianWeight(float distance, float sigma)
{
    float safeSigma = max(sigma, 0.01f);
    return exp(-0.5f * distance * distance / (safeSigma * safeSigma));
}

int3 BurtGITranslucencyVolumeAxisOffset(int axis, int offset)
{
    if (axis == 0)
    {
        return int3(offset, 0, 0);
    }

    if (axis == 1)
    {
        return int3(0, offset, 0);
    }

    return int3(0, 0, offset);
}

void BurtGITranslucencyVolumeAccumulateSpatialSample(
    int3 coord,
    int3 gridMax,
    int3 offset,
    float weight,
    inout float4 sum0,
    inout float4 sum1,
    inout float totalWeight)
{
    int3 sampleCoord = clamp(coord + offset, int3(0, 0, 0), gridMax);
    float4 sample0 = _BurtGITranslucencyVolumeRead0.Load(int4(sampleCoord, 0));
    float4 sample1 = _BurtGITranslucencyVolumeRead1.Load(int4(sampleCoord, 0));
    float confidenceWeight = lerp(1.0f, saturate(max(sample0.a, sample1.a)), saturate(_BurtGITranslucencyVolumeSpatialFilterParams.w));
    float sampleWeight = weight * confidenceWeight;
    sum0 += sample0 * sampleWeight;
    sum1 += sample1 * sampleWeight;
    totalWeight += sampleWeight;
}

[numthreads(BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE, BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE, BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE)]
void FilterTranslucencyVolumeSpatialCS(uint3 id : SV_DispatchThreadID)
{
    uint3 gridSize = max((uint3)_BurtGITranslucencyVolumeGridSize.xyz, uint3(1, 1, 1));
    if (any(id >= gridSize))
    {
        return;
    }

    int3 coord = int3(id);
    int3 gridMax = int3(gridSize) - 1;
    float4 center0 = _BurtGITranslucencyVolumeRead0.Load(int4(coord, 0));
    float4 center1 = _BurtGITranslucencyVolumeRead1.Load(int4(coord, 0));
    if (_BurtGITranslucencyVolumeSpatialFilterParams.z < 0.5f)
    {
        _BurtGITranslucencyVolumeFilter0[id] = center0;
        _BurtGITranslucencyVolumeFilter1[id] = center1;
        return;
    }

    int sampleCount = (int)clamp(_BurtGITranslucencyVolumeSpatialFilterParams.x, 1.0f, 3.0f);
    float sigma = max(_BurtGITranslucencyVolumeSpatialFilterParams.y, 0.01f);
    float4 sum0 = center0;
    float4 sum1 = center1;
    float totalWeight = 1.0f;

    [loop]
    for (int axis = 0; axis < 3; axis++)
    {
        [loop]
        for (int offset = 1; offset <= sampleCount; offset++)
        {
            float weight = BurtGITranslucencyVolumeGaussianWeight((float)offset, sigma);
            int3 axisOffset = BurtGITranslucencyVolumeAxisOffset(axis, offset);
            BurtGITranslucencyVolumeAccumulateSpatialSample(coord, gridMax, axisOffset, weight, sum0, sum1, totalWeight);
            BurtGITranslucencyVolumeAccumulateSpatialSample(coord, gridMax, -axisOffset, weight, sum0, sum1, totalWeight);
        }
    }

    _BurtGITranslucencyVolumeFilter0[id] = max(sum0 / max(totalWeight, 0.00001f), 0.0f);
    _BurtGITranslucencyVolumeFilter1[id] = sum1 / max(totalWeight, 0.00001f);
}
