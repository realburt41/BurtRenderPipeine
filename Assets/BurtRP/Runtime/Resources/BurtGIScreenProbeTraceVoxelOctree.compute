void BurtGIScreenProbeShortRangeAO(uint3 dispatchThreadId)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint2 screenProbeCoord = dispatchThreadId.xy;
    if (screenProbeCoord.x >= screenProbeWidth || screenProbeCoord.y >= screenProbeHeight)
    {
        return;
    }

    float4 encodedNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(screenProbeCoord, 0));
    if (!BurtGIScreenProbeHasValidPlacement(screenProbeCoord) || encodedNormal.a <= 0.5f)
    {
        _BurtGIScreenProbeBentNormalTexture[screenProbeCoord] = float4(0.5, 0.5, 1.0, 0.0);
        return;
    }

    float3 normalWS = BurtGIScreenProbeDecodeNormalWS(encodedNormal);
    if (_BurtGIScreenProbeBentNormalParams.w <= 0.0001)
    {
        _BurtGIScreenProbeBentNormalTexture[screenProbeCoord] = float4(saturate(normalWS * 0.5 + 0.5), 1.0);
        return;
    }

    float currentRawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(screenProbeCoord, 0));
    float3 currentWorldPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(screenProbeCoord, 0)).xyz;
    float3 unoccludedSum = 0.0;
    float3 bentNormal = 0.0;
    float weightSum = 0.0;
    uint temporalIndex = _BurtGIRadianceCacheClipMapFrameIndex & 7u;
    uint2 temporalProbeCoord = screenProbeCoord * traceResolution;

    [loop]
    for (uint y = 0u; y < traceResolution; ++y)
    {
        [loop]
        for (uint x = 0u; x < traceResolution; ++x)
        {
            uint2 atlasCoord = screenProbeCoord * traceResolution + uint2(x, y);
            uint2 traceNoiseCoord = temporalProbeCoord + uint2(x, y);
            float2 blueNoise = BurtGIScreenProbeBlueNoiseVec2(traceNoiseCoord, temporalIndex);
            float2 octUV = (float2((float)x, (float)y) + 0.5 + (blueNoise - 0.5) * 0.65) / (float)traceResolution;
            octUV = saturate(octUV);
            float3 rayDirection = BurtGIEquiAreaSphericalMapping(octUV);
            float hemisphereWeight = saturate(dot(rayDirection, normalWS));
            if (hemisphereWeight <= 0.0001)
            {
                continue;
            }

            float traceHit = saturate(_BurtGIScreenProbeTraceHitTexture[atlasCoord]);
            float3 traceRadiance = max(_BurtGIScreenProbeTraceRadianceTexture[atlasCoord].rgb, 0.0);
            float radianceWeight = saturate(dot(traceRadiance, float3(0.2126, 0.7152, 0.0722)) * 0.5 + 0.5);
            float legacyVisible = saturate(1.0 - traceHit * 0.85) * radianceWeight;
            float viewDistance = max(BurtGILinearEyeDepth(currentRawDepth), 0.01);
            float maxShortRangeTraceDistance = _BurtGIScreenProbeScreenTraceParams1.w > 0.0001
                ? max(0.01, viewDistance * _BurtGIScreenProbeScreenTraceParams1.w)
                : _BurtGIScreenProbeScreenTraceParams.y;
            float shortRangeNormalBias = BurtGIScreenProbeResolveScreenTraceNormalBias(
                viewDistance,
                _BurtGIScreenProbeBentNormalParams1.z,
                0.03);
            float screenTraceVisibility = BurtGIScreenProbeEvaluateHiZScreenTraceVisibility(
                currentWorldPosition + normalWS * shortRangeNormalBias,
                rayDirection,
                blueNoise.x - 0.5,
                maxShortRangeTraceDistance);
            float xrenderTraceVisibility = screenTraceVisibility;
            float visibilityMode = saturate(_BurtGIScreenProbeBentNormalParams.w);
            float visibleWeight = hemisphereWeight * lerp(legacyVisible, xrenderTraceVisibility, visibilityMode);
            unoccludedSum += rayDirection * hemisphereWeight;
            bentNormal += rayDirection * visibleWeight;
            weightSum += hemisphereWeight;
        }
    }

    float normalizeFactor = max(length(unoccludedSum), 0.0001);
    float3 bentNormalAO = bentNormal / normalizeFactor;
    float ao = saturate(length(bentNormalAO));
    if (ao <= 0.0001 || weightSum <= 0.0001)
    {
        bentNormalAO = normalWS;
        ao = 1.0;
    }

    float4 bentNormalOutput = float4(saturate(bentNormalAO * 0.5 + 0.5), ao);
    float2 historyUV;
    float projectedRawDepth;
    if (_BurtGIScreenProbeBentNormalParams.x > 0.5 &&
        BurtGIScreenProbeProjectPreviousPositionWS(currentWorldPosition, historyUV, projectedRawDepth))
    {
        float historyDistanceThreshold = max(_BurtGIScreenProbeBentNormalParams.z, 0.0001);
        float3 historyBentNormalSum = 0.0;
        float historyAOSum = 0.0;
        float historyWeightSum = 0.0;
        float historyMaxWeight = 0.0;
        float spacingPixels = max(_BurtGIScreenProbeBentNormalParams1.x, 1.0);
        uint historyJitterIndex = BurtGIScreenProbePreviousJitterIndex(_BurtGIScreenProbeBentNormalParams1.y);
        float2 historyProbeCoord = BurtGIScreenProbeTileCoordFromScreenUV(
            historyUV,
            historyJitterIndex,
            spacingPixels,
            max(_BurtGIScreenProbeBentNormalParams1.zw, float2(1.0, 1.0)));
        float2 historyBaseCoord = floor(historyProbeCoord);
        float projectedLinearDepth = max(BurtGILinearEyeDepth(projectedRawDepth), 0.0001);
        float historyDepthThreshold = max(_BurtGIScreenProbeScreenTraceParams1.y, 0.0001);

        [unroll]
        for (int historyOffsetY = -1; historyOffsetY <= 1; ++historyOffsetY)
        {
            [unroll]
            for (int historyOffsetX = -1; historyOffsetX <= 1; ++historyOffsetX)
            {
                int2 historyCoordSigned = clamp(
                    (int2)historyBaseCoord + int2(historyOffsetX, historyOffsetY),
                    int2(0, 0),
                    int2((int)screenProbeWidth - 1, (int)screenProbeHeight - 1));
                uint2 historyCoord = (uint2)historyCoordSigned;
                float historyRawDepth = _BurtGIScreenProbeHistoryScreenDepthTexture.Load(int3(historyCoord, 0));
                float4 historyWorldPosition = _BurtGIScreenProbeHistoryWorldPositionTexture.Load(int3(historyCoord, 0));
                float4 historyBentNormal = _BurtGIScreenProbeHistoryBentNormalTexture.Load(int3(historyCoord, 0));

                if (historyWorldPosition.w <= 0.0001 ||
                    BurtGIScreenProbeTraceCompactIsSkyDepth(currentRawDepth) ||
                    BurtGIScreenProbeTraceCompactIsSkyDepth(historyRawDepth) ||
                    historyBentNormal.a <= 0.0001)
                {
                    continue;
                }

                float3 historyBentNormalWS = BurtGIScreenProbeTraceSafeNormalize(historyBentNormal.rgb * 2.0 - 1.0, normalWS);
                float planeDistance = abs(dot(historyWorldPosition.xyz - currentWorldPosition, normalWS));
                float worldDistance = distance(currentWorldPosition, historyWorldPosition.xyz);
                float planeWeight = exp2(-64.0 * (planeDistance / historyDistanceThreshold) * (planeDistance / historyDistanceThreshold));
                float distanceWeight = saturate(1.0 - worldDistance / historyDistanceThreshold);
                float historyLinearDepth = max(BurtGILinearEyeDepth(historyRawDepth), 0.0001);
                float depthWeight = saturate(1.0 - abs(historyLinearDepth - projectedLinearDepth) / (projectedLinearDepth * historyDepthThreshold));
                float hemisphereWeight = saturate(dot(historyBentNormalWS, normalWS) * 0.5 + 0.5);
                float historyWeight = planeWeight * distanceWeight * depthWeight * hemisphereWeight * saturate(historyBentNormal.a);
                historyBentNormalSum += historyBentNormalWS * historyWeight;
                historyAOSum += saturate(historyBentNormal.a) * historyWeight;
                historyWeightSum += historyWeight;
                historyMaxWeight = max(historyMaxWeight, historyWeight);
            }
        }

        if (historyWeightSum > 0.0001)
        {
            float historyBentNormalLength = length(historyBentNormalSum);
            float3 historyBentNormalWS = historyBentNormalLength > 0.0001
                ? historyBentNormalSum / historyBentNormalLength
                : normalWS;
            float historyAO = saturate(historyAOSum / historyWeightSum);
            float historyVisibilityWeight = saturate(historyMaxWeight) * saturate(historyWeightSum / 3.0);
            float historyWeight = saturate(_BurtGIScreenProbeBentNormalParams.y) * historyVisibilityWeight;
            float3 currentBentNormalWS = BurtGIScreenProbeTraceSafeNormalize(bentNormalOutput.rgb * 2.0 - 1.0, normalWS);
            float3 blendedBentNormalWS = BurtGIScreenProbeTraceSafeNormalize(lerp(currentBentNormalWS, historyBentNormalWS, historyWeight), currentBentNormalWS);
            bentNormalOutput.rgb = saturate(blendedBentNormalWS * 0.5 + 0.5);
            bentNormalOutput.a = saturate(lerp(bentNormalOutput.a, historyAO, historyWeight));
        }
    }

    _BurtGIScreenProbeBentNormalTexture[screenProbeCoord] = bentNormalOutput;
}

[numthreads(BURT_GI_SCREEN_PROBE_BENT_NORMAL_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_BENT_NORMAL_THREADGROUP_SIZE, 1)]
void ScreenProbeShortRangeAOCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIScreenProbeShortRangeAO(dispatchThreadId);
}

[numthreads(BURT_GI_SCREEN_PROBE_BENT_NORMAL_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_BENT_NORMAL_THREADGROUP_SIZE, 1)]
void ScreenProbeBentNormalCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIScreenProbeShortRangeAO(dispatchThreadId);
}

void BurtGISampleScreenProbeTraceAtlasComposite(
    uint2 atlasScreenProbeCoord,
    float2 gatherUV,
    uint traceResolution,
    uint gatherResolution,
    out float4 compositeRadiance,
    out float compositeHit);

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_SH3_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_SH3_THREADGROUP_SIZE, 1)]
void ScreenProbeIrradianceSH3CS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint2 screenProbeCoord = dispatchThreadId.xy;
    if (screenProbeCoord.x >= screenProbeWidth || screenProbeCoord.y >= screenProbeHeight)
    {
        return;
    }

    if (!BurtGIScreenProbeHasValidPlacement(screenProbeCoord))
    {
        _BurtGIScreenProbeRadianceSHAmbientTexture[screenProbeCoord] = float4(0.0, 0.0, 0.0, 0.0);

        [unroll]
        for (uint clearTileIndex = 0u; clearTileIndex < 6u; ++clearTileIndex)
        {
            _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(screenProbeCoord.x + clearTileIndex * screenProbeWidth, screenProbeCoord.y)] =
                float4(0.0, 0.0, 0.0, 0.0);
        }

        return;
    }

    float3 sh0 = 0.0;
    float3 sh1 = 0.0;
    float3 sh2 = 0.0;
    float3 sh3 = 0.0;
    float3 sh4 = 0.0;
    float3 sh5 = 0.0;
    float3 sh6 = 0.0;
    float3 sh7 = 0.0;
    float3 sh8 = 0.0;
    float hitSum = 0.0;
    float sampleCount = 0.0;
    uint gatherResolution = BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION;

    [loop]
    for (uint y = 0u; y < gatherResolution; ++y)
    {
        [loop]
        for (uint x = 0u; x < gatherResolution; ++x)
        {
            uint2 gatherTexelCoord = uint2(x, y);
            float2 octUV = (float2(gatherTexelCoord) + 0.5) / (float)gatherResolution;
            float3 direction = BurtGIEquiAreaSphericalMapping(octUV).zxy;
            float4 traceRadiance;
            float hit;
            BurtGISampleScreenProbeTraceAtlasComposite(
                screenProbeCoord,
                octUV,
                traceResolution,
                gatherResolution,
                traceRadiance,
                hit);
            float3 radiance = max(traceRadiance.rgb, 0.0);
            float4 basis0 = BurtGISHBasis3V0(direction);
            float4 basis1 = BurtGISHBasis3V1(direction);
            float basis2 = BurtGISHBasis3V2(direction);

            sh0 += radiance * basis0.x;
            sh1 += radiance * basis0.y;
            sh2 += radiance * basis0.z;
            sh3 += radiance * basis0.w;
            sh4 += radiance * basis1.x;
            sh5 += radiance * basis1.y;
            sh6 += radiance * basis1.z;
            sh7 += radiance * basis1.w;
            sh8 += radiance * basis2;
            hitSum += hit;
            sampleCount += 1.0;
        }
    }

    float normalizeWeight = rcp(max(sampleCount, 1.0));
    float hitConfidence = saturate(hitSum * normalizeWeight);
    float3 traceAmbient = sh0 * normalizeWeight;
    float4 fixupIrradiance = _BurtGIScreenProbeFixupIrradianceTexture.Load(int3(screenProbeCoord, 0));
    float4 fixupConfidence = _BurtGIScreenProbeFixupConfidenceTexture.Load(int3(screenProbeCoord, 0));
    uint2 mip1Size = max(uint2(1u, 1u), (uint2(screenProbeWidth, screenProbeHeight) + 1u) >> 1u);
    uint2 mip2Size = max(uint2(1u, 1u), (uint2(screenProbeWidth, screenProbeHeight) + 3u) >> 2u);
    uint2 mip3Size = max(uint2(1u, 1u), (uint2(screenProbeWidth, screenProbeHeight) + 7u) >> 3u);
    uint2 mip1Coord = min(screenProbeCoord >> 1u, mip1Size - 1u);
    uint2 mip2Coord = min(screenProbeCoord >> 2u, mip2Size - 1u);
    uint2 mip3Coord = min(screenProbeCoord >> 3u, mip3Size - 1u);
    float4 mipIrradiance = _BurtGIScreenProbeMipIrradianceTexture.Load(int3(mip1Coord, 0));
    float4 mipConfidence = _BurtGIScreenProbeMipConfidenceTexture.Load(int3(mip1Coord, 0));
    float4 mip2Irradiance = _BurtGIScreenProbeMip2IrradianceTexture.Load(int3(mip2Coord, 0));
    float4 mip2Confidence = _BurtGIScreenProbeMip2ConfidenceTexture.Load(int3(mip2Coord, 0));
    float4 mip3Irradiance = _BurtGIScreenProbeMip3IrradianceTexture.Load(int3(mip3Coord, 0));
    float4 mip3Confidence = _BurtGIScreenProbeMip3ConfidenceTexture.Load(int3(mip3Coord, 0));
    float confidence = saturate(min(fixupIrradiance.a, fixupConfidence.r));
    float lowFrequencyConfidence = saturate(min(mipIrradiance.a, mipConfidence.r));
    float veryLowFrequencyConfidence = saturate(min(mip2Irradiance.a, mip2Confidence.r));
    float ultraLowFrequencyConfidence = saturate(min(mip3Irradiance.a, mip3Confidence.r));
    float lowFrequencyFill = saturate((0.55 - confidence) * 2.0) * lowFrequencyConfidence;
    float veryLowFrequencyFill = saturate((0.38 - confidence) * 2.6315789) * veryLowFrequencyConfidence;
    float ultraLowFrequencyFill = saturate((0.24 - confidence) * 4.1666665) * ultraLowFrequencyConfidence;
    float3 veryLowFrequency = lerp(max(mip2Irradiance.rgb, 0.0), max(mip3Irradiance.rgb, 0.0), ultraLowFrequencyFill * 0.65);
    float3 lowFrequency = lerp(max(mipIrradiance.rgb, 0.0), veryLowFrequency, veryLowFrequencyFill * 0.75);
    float3 fallbackIrradiance = lerp(max(fixupIrradiance.rgb, 0.0), lowFrequency, lowFrequencyFill * 0.5 + veryLowFrequencyFill * 0.25 + ultraLowFrequencyFill * 0.15);
    float3 ambient = lerp(fallbackIrradiance * BURT_GI_SH0_IRRADIANCE_TO_COEFFICIENT, traceAmbient, hitConfidence * 0.65);
    float ambientConfidence = saturate(max(max(max(max(confidence, hitConfidence), lowFrequencyConfidence * lowFrequencyFill), veryLowFrequencyConfidence * veryLowFrequencyFill), ultraLowFrequencyConfidence * ultraLowFrequencyFill));
    _BurtGIScreenProbeRadianceSHAmbientTexture[screenProbeCoord] = float4(ambient, ambientConfidence);

    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(screenProbeCoord.x + 0u * screenProbeWidth, screenProbeCoord.y)] =
        float4(sh1.r, sh2.r, sh3.r, sh4.r) * normalizeWeight;
    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(screenProbeCoord.x + 1u * screenProbeWidth, screenProbeCoord.y)] =
        float4(sh5.r, sh6.r, sh7.r, sh8.r) * normalizeWeight;
    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(screenProbeCoord.x + 2u * screenProbeWidth, screenProbeCoord.y)] =
        float4(sh1.g, sh2.g, sh3.g, sh4.g) * normalizeWeight;
    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(screenProbeCoord.x + 3u * screenProbeWidth, screenProbeCoord.y)] =
        float4(sh5.g, sh6.g, sh7.g, sh8.g) * normalizeWeight;
    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(screenProbeCoord.x + 4u * screenProbeWidth, screenProbeCoord.y)] =
        float4(sh1.b, sh2.b, sh3.b, sh4.b) * normalizeWeight;
    _BurtGIScreenProbeRadianceSHDirectionalTexture[uint2(screenProbeCoord.x + 5u * screenProbeWidth, screenProbeCoord.y)] =
        float4(sh5.b, sh6.b, sh7.b, sh8.b) * normalizeWeight;
}

void BurtGISampleScreenProbeTraceAtlasComposite(
    uint2 atlasScreenProbeCoord,
    float2 gatherUV,
    uint traceResolution,
    uint gatherResolution,
    out float4 compositeRadiance,
    out float compositeHit)
{
    gatherResolution = max(1u, gatherResolution);
    uint2 targetGatherTexelCoord = min((uint2)floor(saturate(gatherUV) * (float)gatherResolution), gatherResolution - 1u);
    float maxRayIntensity = max(_BurtGIScreenProbeTraceModeParams.z, 0.01f);
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint uniformProbeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight);
    uint screenProbeIndex = atlasScreenProbeCoord.y * screenProbeWidth + atlasScreenProbeCoord.x;
    uint2 sourceScreenProbeCoord = 0u;
    uint2 resolvedAtlasScreenProbeCoord = 0u;
    bool validAtlasProbe = BurtGIResolveScreenProbeSourceAndAtlasCoord(
        screenProbeIndex,
        screenProbeWidth,
        screenProbeHeight,
        maxAdaptiveProbeCount,
        sourceScreenProbeCoord,
        resolvedAtlasScreenProbeCoord);
    if (!validAtlasProbe)
    {
        compositeRadiance = 0.0f;
        compositeHit = 0.0f;
        return;
    }

    bool isAdaptiveProbe = screenProbeIndex >= uniformProbeCount;
    uint maxImportanceTraceResolution = min(64u, max(traceResolution, traceResolution << 1u));
    uint temporalIndex = _BurtGIRadianceCacheClipMapFrameIndex & 7u;
    float2 probeTexelCenter = BurtGIScreenProbeBlueNoiseVec2(sourceScreenProbeCoord, temporalIndex);
    float2 random = BurtGIScreenProbeBlueNoiseVec2(sourceScreenProbeCoord, temporalIndex + 4u);
    float4 radianceSum = 0.0f;
    float hitSum = 0.0f;
    float weightSum = 0.0f;

    [loop]
    for (uint y = 0u; y < traceResolution; ++y)
    {
        [loop]
        for (uint x = 0u; x < traceResolution; ++x)
        {
            uint2 traceTexelCoord = uint2(x, y);
            uint2 traceAtlasCoord = atlasScreenProbeCoord * traceResolution + traceTexelCoord;
            uint2 sourceTraceTexelCoord = traceTexelCoord;
            uint sourceTraceLevel = 0u;
            if (!isAdaptiveProbe)
            {
                uint rayInfo = _BurtGIScreenProbeImportanceRayInfoTexture[traceAtlasCoord];
                BurtGIUnpackScreenProbeImportanceRayInfo(rayInfo, sourceTraceTexelCoord, sourceTraceLevel);
            }

            uint sourceMipSize = max(1u, maxImportanceTraceResolution >> min(sourceTraceLevel, 5u));
            if (sourceTraceTexelCoord.x >= sourceMipSize || sourceTraceTexelCoord.y >= sourceMipSize)
            {
                sourceTraceTexelCoord = traceTexelCoord;
                sourceTraceLevel = 0u;
                sourceMipSize = traceResolution;
            }

            float2 gatherTexelCoord = (float2(sourceTraceTexelCoord) + probeTexelCenter) * (float)gatherResolution / (float)sourceMipSize - 0.5f;
            float2 gatherTexelFrac = frac(gatherTexelCoord);
            int2 quantizedGatherTexelCoordInt =
                (int2)floor(gatherTexelCoord) +
                int2(gatherTexelFrac.x < random.x ? 0 : 1, gatherTexelFrac.y < random.y ? 0 : 1);
            uint2 quantizedGatherTexelCoord = BurtGIOctahedralMapWrapBorder(
                (uint2)(quantizedGatherTexelCoordInt + int2(1, 1)),
                gatherResolution + 2u,
                1u);
            if (!all(quantizedGatherTexelCoord == targetGatherTexelCoord))
            {
                continue;
            }

            float sampleWeight = (float)gatherResolution / (float)sourceMipSize;
            sampleWeight *= sampleWeight;
            float4 sampleRadiance = _BurtGIScreenProbeTraceRadianceTexture[traceAtlasCoord];
            sampleRadiance.rgb = max(sampleRadiance.rgb, 0.0f);

            float maxLighting = max(sampleRadiance.r, max(sampleRadiance.g, sampleRadiance.b));
            if (maxLighting > maxRayIntensity)
            {
                sampleRadiance.rgb *= maxRayIntensity / maxLighting;
            }

            radianceSum.rgb += sampleRadiance.rgb * sampleWeight;
            hitSum += saturate(_BurtGIScreenProbeTraceHitTexture[traceAtlasCoord]) * sampleWeight;
            weightSum += sampleWeight;
        }
    }

    compositeRadiance = float4(radianceSum.rgb, weightSum > 0.0001f ? saturate(hitSum / max(weightSum, 0.0001f)) : 0.0f);
    compositeRadiance.rgb = max(compositeRadiance.rgb, 0.0f);
    compositeHit = compositeRadiance.a;
}

void BurtGIScreenProbeIrradianceOct(uint groupIndex, uint3 groupId, uint3 groupThreadId)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint uniformProbeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight);
    uint atlasProbeHeight = max(screenProbeHeight, BurtGIDivRoundUp(uniformProbeCount + maxAdaptiveProbeCount, screenProbeWidth));
    uint2 atlasScreenProbeCoord = groupId.xy;
    uint2 octTexelCoord = groupThreadId.xy;

    bool validAtlasTexel = atlasScreenProbeCoord.x < screenProbeWidth &&
        atlasScreenProbeCoord.y < atlasProbeHeight &&
        octTexelCoord.x < BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION_WITH_BORDER &&
        octTexelCoord.y < BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION_WITH_BORDER;
    uint2 clampedAtlasScreenProbeCoord = min(atlasScreenProbeCoord, uint2(screenProbeWidth - 1u, atlasProbeHeight - 1u));
    uint2 clampedOctTexelCoord = min(octTexelCoord, uint2(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION_WITH_BORDER - 1u, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION_WITH_BORDER - 1u));
    uint2 atlasCoord = clampedAtlasScreenProbeCoord * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION_WITH_BORDER + clampedOctTexelCoord;
    uint screenProbeIndex = atlasScreenProbeCoord.y * screenProbeWidth + atlasScreenProbeCoord.x;
    uint2 sourceScreenProbeCoord = 0u;
    uint2 resolvedAtlasScreenProbeCoord = 0u;
    bool validAtlasProbe = validAtlasTexel && BurtGIResolveScreenProbeSourceAndAtlasCoord(
        screenProbeIndex,
        screenProbeWidth,
        screenProbeHeight,
        maxAdaptiveProbeCount,
        sourceScreenProbeCoord,
        resolvedAtlasScreenProbeCoord);
    bool hasValidProbe = validAtlasProbe && BurtGIScreenProbeHasValidPlacement(sourceScreenProbeCoord);

    uint2 wrappedOctCoord = BurtGIOctahedralMapWrapBorder(
        octTexelCoord,
        BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION_WITH_BORDER,
        BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_BORDER_SIZE);
    float2 octUV = (float2(wrappedOctCoord) + 0.5) / (float)BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION;
    float3 irradianceDirection = BurtGIEquiAreaSphericalMapping(octUV).zxy;
    uint2 mip1Size = max(uint2(1u, 1u), (uint2(screenProbeWidth, screenProbeHeight) + 1u) >> 1u);
    uint2 mip2Size = max(uint2(1u, 1u), (uint2(screenProbeWidth, screenProbeHeight) + 3u) >> 2u);
    uint2 mip3Size = max(uint2(1u, 1u), (uint2(screenProbeWidth, screenProbeHeight) + 7u) >> 3u);
    uint2 mip1Coord = min(sourceScreenProbeCoord >> 1u, mip1Size - 1u);
    uint2 mip2Coord = min(sourceScreenProbeCoord >> 2u, mip2Size - 1u);
    uint2 mip3Coord = min(sourceScreenProbeCoord >> 3u, mip3Size - 1u);
    float4 fixupIrradiance = _BurtGIScreenProbeFixupIrradianceTexture.Load(int3(sourceScreenProbeCoord, 0));
    float4 fixupConfidence = _BurtGIScreenProbeFixupConfidenceTexture.Load(int3(sourceScreenProbeCoord, 0));
    float4 mipIrradiance = _BurtGIScreenProbeMipIrradianceTexture.Load(int3(mip1Coord, 0));
    float4 mipConfidence = _BurtGIScreenProbeMipConfidenceTexture.Load(int3(mip1Coord, 0));
    float4 mip2Irradiance = _BurtGIScreenProbeMip2IrradianceTexture.Load(int3(mip2Coord, 0));
    float4 mip2Confidence = _BurtGIScreenProbeMip2ConfidenceTexture.Load(int3(mip2Coord, 0));
    float4 mip3Irradiance = _BurtGIScreenProbeMip3IrradianceTexture.Load(int3(mip3Coord, 0));
    float4 mip3Confidence = _BurtGIScreenProbeMip3ConfidenceTexture.Load(int3(mip3Coord, 0));
    float fixupIrradianceConfidence = saturate(min(fixupIrradiance.a, fixupConfidence.r));
    float lowFrequencyConfidence = saturate(min(mipIrradiance.a, mipConfidence.r));
    float veryLowFrequencyConfidence = saturate(min(mip2Irradiance.a, mip2Confidence.r));
    float ultraLowFrequencyConfidence = saturate(min(mip3Irradiance.a, mip3Confidence.r));
    float3 veryLowFrequency = lerp(max(mip2Irradiance.rgb, 0.0), max(mip3Irradiance.rgb, 0.0), ultraLowFrequencyConfidence * 0.65);
    float3 lowFrequency = lerp(max(mipIrradiance.rgb, 0.0), veryLowFrequency, veryLowFrequencyConfidence * 0.75);
    float3 fallbackRadiance = lerp(max(fixupIrradiance.rgb, 0.0), lowFrequency, saturate((1.0 - fixupIrradianceConfidence) * 0.65));
    float fallbackConfidence = saturate(max(max(fixupIrradianceConfidence, lowFrequencyConfidence), max(veryLowFrequencyConfidence, ultraLowFrequencyConfidence)));
    uint2 gatherTexelCoord = groupThreadId.xy;
    bool hasTraceSample =
        gatherTexelCoord.x < BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION &&
        gatherTexelCoord.y < BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION;
    float4 basis0 = 0.0;
    float4 basis1 = 0.0;
    float basis2 = 0.0;
    float3 radiance = 0.0;
    float hit = 0.0;
    float traceConfidence = 0.0;
    float sampleWeight = 0.0;
    if (hasValidProbe && hasTraceSample)
    {
        float2 gatherUV = (float2(gatherTexelCoord) + 0.5) / (float)BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION;
        float4 traceRadiance;
        float3 sampleDirection = BurtGIEquiAreaSphericalMapping(gatherUV).zxy;
        BurtGISampleScreenProbeTraceAtlasComposite(
            atlasScreenProbeCoord,
            gatherUV,
            traceResolution,
            BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_RESOLUTION,
            traceRadiance,
            hit);
        radiance = traceRadiance.rgb;
        float fallbackBlend = saturate((1.0 - hit) * fallbackConfidence);
        radiance = lerp(radiance, max(radiance, fallbackRadiance), fallbackBlend * 0.85);
        // XRender integrates TraceRadiance over every octahedral direction. A sky ray has no geometry hit,
        // but still carries valid radiance and must not disappear from the irradiance integral.
        traceConfidence = max(hit, fallbackConfidence * 0.35);
        sampleWeight = 1.0;
        basis0 = BurtGISHBasis3V0(sampleDirection);
        basis1 = BurtGISHBasis3V1(sampleDirection);
        basis2 = BurtGISHBasis3V2(sampleDirection);
    }

    float3 weightedRadiance = radiance * sampleWeight;
    BurtGIScreenProbeIrradianceOctSharedSH[groupIndex + 0u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT] = float4(weightedRadiance * basis0.x, 0.0);
    BurtGIScreenProbeIrradianceOctSharedSH[groupIndex + 1u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT] = float4(weightedRadiance * basis0.y, 0.0);
    BurtGIScreenProbeIrradianceOctSharedSH[groupIndex + 2u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT] = float4(weightedRadiance * basis0.z, 0.0);
    BurtGIScreenProbeIrradianceOctSharedSH[groupIndex + 3u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT] = float4(weightedRadiance * basis0.w, 0.0);
    BurtGIScreenProbeIrradianceOctSharedSH[groupIndex + 4u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT] = float4(weightedRadiance * basis1.x, 0.0);
    BurtGIScreenProbeIrradianceOctSharedSH[groupIndex + 5u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT] = float4(weightedRadiance * basis1.y, 0.0);
    BurtGIScreenProbeIrradianceOctSharedSH[groupIndex + 6u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT] = float4(weightedRadiance * basis1.z, 0.0);
    BurtGIScreenProbeIrradianceOctSharedSH[groupIndex + 7u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT] = float4(weightedRadiance * basis1.w, 0.0);
    BurtGIScreenProbeIrradianceOctSharedSH[groupIndex + 8u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT] = float4(weightedRadiance * basis2, 0.0);
    BurtGIScreenProbeIrradianceOctSharedHit[groupIndex] = traceConfidence;
    BurtGIScreenProbeIrradianceOctSharedSampleCount[groupIndex] = sampleWeight;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint reductionStride = BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT / 2u; reductionStride > 0u; reductionStride >>= 1u)
    {
        if (groupIndex < reductionStride)
        {
            [unroll]
            for (uint coefficientIndex = 0u; coefficientIndex < BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_SH_COEFFICIENT_COUNT; ++coefficientIndex)
            {
                uint sharedIndex = groupIndex + coefficientIndex * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT;
                BurtGIScreenProbeIrradianceOctSharedSH[sharedIndex] += BurtGIScreenProbeIrradianceOctSharedSH[sharedIndex + reductionStride];
            }

            BurtGIScreenProbeIrradianceOctSharedSampleCount[groupIndex] += BurtGIScreenProbeIrradianceOctSharedSampleCount[groupIndex + reductionStride];
            BurtGIScreenProbeIrradianceOctSharedHit[groupIndex] += BurtGIScreenProbeIrradianceOctSharedHit[groupIndex + reductionStride];
        }

        GroupMemoryBarrierWithGroupSync();
    }

    float normalizeWeight = rcp(max(BurtGIScreenProbeIrradianceOctSharedSampleCount[0], 1.0));
    float3 sh0 = BurtGIScreenProbeIrradianceOctSharedSH[0u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT].rgb * normalizeWeight;
    float3 sh1 = BurtGIScreenProbeIrradianceOctSharedSH[1u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT].rgb * normalizeWeight;
    float3 sh2 = BurtGIScreenProbeIrradianceOctSharedSH[2u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT].rgb * normalizeWeight;
    float3 sh3 = BurtGIScreenProbeIrradianceOctSharedSH[3u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT].rgb * normalizeWeight;
    float3 sh4 = BurtGIScreenProbeIrradianceOctSharedSH[4u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT].rgb * normalizeWeight;
    float3 sh5 = BurtGIScreenProbeIrradianceOctSharedSH[5u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT].rgb * normalizeWeight;
    float3 sh6 = BurtGIScreenProbeIrradianceOctSharedSH[6u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT].rgb * normalizeWeight;
    float3 sh7 = BurtGIScreenProbeIrradianceOctSharedSH[7u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT].rgb * normalizeWeight;
    float3 sh8 = BurtGIScreenProbeIrradianceOctSharedSH[8u * BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT].rgb * normalizeWeight;
    float3 irradiance = BurtGIEvaluateDiffuseTransferSH3(irradianceDirection, sh0, sh1, sh2, sh3, sh4, sh5, sh6, sh7, sh8);
    float confidence = saturate(BurtGIScreenProbeIrradianceOctSharedHit[0] * normalizeWeight);
    if (validAtlasTexel)
    {
        _BurtGIScreenProbeIrradianceOctTexture[atlasCoord] = hasValidProbe
            ? float4(irradiance, confidence)
            : float4(0.0, 0.0, 0.0, 0.0);
    }
}

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, 1)]
void ScreenProbeIrradianceOctCS(uint groupIndex : SV_GroupIndex, uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    BurtGIScreenProbeIrradianceOct(groupIndex, groupId, groupThreadId);
}

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, 1)]
void ScreenProbeIrradianceOctLiteCS(uint groupIndex : SV_GroupIndex, uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    BurtGIScreenProbeIrradianceOct(groupIndex, groupId, groupThreadId);
}

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, 1)]
void ScreenProbeRadianceOctLiteCS(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint uniformProbeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight);
    uint atlasProbeHeight = max(screenProbeHeight, BurtGIDivRoundUp(uniformProbeCount + maxAdaptiveProbeCount, screenProbeWidth));
    uint2 atlasScreenProbeCoord = groupId.xy;
    if (atlasScreenProbeCoord.x >= screenProbeWidth ||
        atlasScreenProbeCoord.y >= atlasProbeHeight)
    {
        return;
    }

    uint screenProbeIndex = atlasScreenProbeCoord.y * screenProbeWidth + atlasScreenProbeCoord.x;
    uint2 sourceScreenProbeCoord;
    uint2 resolvedAtlasScreenProbeCoord;
    bool validAtlasProbe = BurtGIResolveScreenProbeSourceAndAtlasCoord(
        screenProbeIndex,
        screenProbeWidth,
        screenProbeHeight,
        maxAdaptiveProbeCount,
        sourceScreenProbeCoord,
        resolvedAtlasScreenProbeCoord);
    bool hasValidProbe = validAtlasProbe && BurtGIScreenProbeHasValidPlacement(sourceScreenProbeCoord);

    for (uint octY = groupThreadId.y; octY < BURT_GI_SCREEN_PROBE_RADIANCE_OCT_RESOLUTION_WITH_BORDER; octY += BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE)
    {
        for (uint octX = groupThreadId.x; octX < BURT_GI_SCREEN_PROBE_RADIANCE_OCT_RESOLUTION_WITH_BORDER; octX += BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE)
        {
            uint2 octTexelCoord = uint2(octX, octY);
            uint2 atlasCoord = atlasScreenProbeCoord * BURT_GI_SCREEN_PROBE_RADIANCE_OCT_RESOLUTION_WITH_BORDER + octTexelCoord;
            if (!hasValidProbe)
            {
                _BurtGIScreenProbeRadianceOctTexture[atlasCoord] = float4(0.0, 0.0, 0.0, 0.0);
                continue;
            }

            uint2 wrappedOctTexelCoord = BurtGIOctahedralMapWrapBorder(
                octTexelCoord,
                BURT_GI_SCREEN_PROBE_RADIANCE_OCT_RESOLUTION_WITH_BORDER,
                BURT_GI_SCREEN_PROBE_RADIANCE_OCT_BORDER_SIZE);
            float2 gatherUV = (float2(wrappedOctTexelCoord) + 0.5) / (float)BURT_GI_SCREEN_PROBE_RADIANCE_OCT_RESOLUTION;
            float4 traceRadiance;
            float traceHit;
            BurtGISampleScreenProbeTraceAtlasComposite(
                atlasScreenProbeCoord,
                gatherUV,
                traceResolution,
                BURT_GI_SCREEN_PROBE_RADIANCE_OCT_RESOLUTION,
                traceRadiance,
                traceHit);
            float confidence = saturate(max(traceHit, traceRadiance.a));
            _BurtGIScreenProbeRadianceOctTexture[atlasCoord] = float4(max(traceRadiance.rgb, 0.0), confidence);
        }
    }
}

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, 1)]
void ScreenProbeIrradianceOctGenerateMipCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint mipLevel = max(1u, (uint)_BurtGIScreenProbeIrradianceOctMipParams.x);
    uint baseAtlasWidth = max(1u, (uint)_BurtGIScreenProbeIrradianceOctMipParams.y);
    uint baseAtlasHeight = max(1u, (uint)_BurtGIScreenProbeIrradianceOctMipParams.z);
    uint baseProbeSizeWithBorder = max(1u, (uint)_BurtGIScreenProbeIrradianceOctMipParams.w);
    uint mipProbeSize = max(1u, baseProbeSizeWithBorder >> mipLevel);
    uint parentMipProbeSize = max(1u, baseProbeSizeWithBorder >> (mipLevel - 1u));
    uint2 mipAtlasSize = uint2(
        max(1u, baseAtlasWidth >> mipLevel),
        max(1u, baseAtlasHeight >> mipLevel));
    uint2 atlasCoord = dispatchThreadId.xy;

    if (any(atlasCoord >= mipAtlasSize))
    {
        return;
    }

    uint2 atlasProbeCoord = atlasCoord / mipProbeSize;
    uint2 probeTexelCoord = atlasCoord - atlasProbeCoord * mipProbeSize;
    uint2 parentAtlasCoord = atlasProbeCoord * parentMipProbeSize + probeTexelCoord * 2u;
    float4 sample00 = _BurtGIScreenProbeIrradianceOctParentMipTexture.Load(int3(parentAtlasCoord + uint2(0u, 0u), 0));
    float4 sample10 = _BurtGIScreenProbeIrradianceOctParentMipTexture.Load(int3(parentAtlasCoord + uint2(1u, 0u), 0));
    float4 sample01 = _BurtGIScreenProbeIrradianceOctParentMipTexture.Load(int3(parentAtlasCoord + uint2(0u, 1u), 0));
    float4 sample11 = _BurtGIScreenProbeIrradianceOctParentMipTexture.Load(int3(parentAtlasCoord + uint2(1u, 1u), 0));
    float weight00 = saturate(sample00.a);
    float weight10 = saturate(sample10.a);
    float weight01 = saturate(sample01.a);
    float weight11 = saturate(sample11.a);
    float weightSum = weight00 + weight10 + weight01 + weight11;
    float4 mipSample = (sample00 + sample10 + sample01 + sample11) * 0.25;

    if (weightSum > 0.0001)
    {
        mipSample.rgb =
            (sample00.rgb * weight00 +
                sample10.rgb * weight10 +
                sample01.rgb * weight01 +
                sample11.rgb * weight11) / weightSum;
        mipSample.a = saturate(weightSum * 0.25);
    }

    _BurtGIScreenProbeIrradianceOctMipTexture[atlasCoord] = float4(max(mipSample.rgb, 0.0), saturate(mipSample.a));
}

void BurtGIScreenProbeImportanceSamplingTransfer(uint groupIndex, uint3 groupId, uint3 groupThreadId)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint uniformProbeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight);
    uint atlasProbeHeight = max(screenProbeHeight, BurtGIDivRoundUp(uniformProbeCount + maxAdaptiveProbeCount, screenProbeWidth));
    uint2 atlasScreenProbeCoord = groupId.xy;
    if (atlasScreenProbeCoord.x >= screenProbeWidth ||
        atlasScreenProbeCoord.y >= atlasProbeHeight)
    {
        return;
    }

    uint screenProbeIndex = atlasScreenProbeCoord.y * screenProbeWidth + atlasScreenProbeCoord.x;
    uint2 sourceScreenProbeCoord;
    uint2 resolvedAtlasScreenProbeCoord;
    bool validAtlasProbe = BurtGIResolveScreenProbeSourceAndAtlasCoord(
        screenProbeIndex,
        screenProbeWidth,
        screenProbeHeight,
        maxAdaptiveProbeCount,
        sourceScreenProbeCoord,
        resolvedAtlasScreenProbeCoord);
    bool hasValidProbe = validAtlasProbe && BurtGIScreenProbeHasValidPlacement(sourceScreenProbeCoord);
    float3 sourceNormalWS = float3(0.0, 1.0, 0.0);
    float4 sourcePositionData = 0.0;
    if (hasValidProbe)
    {
        sourceNormalWS = BurtGIScreenProbeDecodeNormalWS(_BurtGIScreenProbeWorldNormalTexture.Load(int3(sourceScreenProbeCoord, 0)));
        sourcePositionData = _BurtGIScreenProbeWorldPositionTexture.Load(int3(sourceScreenProbeCoord, 0));
    }
    float3 sourcePositionWS = sourcePositionData.xyz;
    bool sourceHasSphericalVisibility = hasValidProbe && BurtGIScreenProbeHasSphericalVisibility(sourcePositionData.a);
    float sourceRawDepth = hasValidProbe ? _BurtGIScreenProbeScreenDepthTexture.Load(int3(sourceScreenProbeCoord, 0)) : 1.0;
    float sourceSceneDepth = BurtGIScreenProbeTraceCompactIsSkyDepth(sourceRawDepth) ? 0.0 : max(BurtGILinearEyeDepth(sourceRawDepth), 0.0001);
    bool isUniformProbe = screenProbeIndex < uniformProbeCount;
    BurtGIScreenProbeFillImportanceTransferSharedNormals(
        sourceScreenProbeCoord,
        sourcePositionData.a,
        groupIndex,
        groupThreadId,
        hasValidProbe,
        isUniformProbe);
    GroupMemoryBarrierWithGroupSync();
    BurtGIScreenProbeStoreImportanceTransferSH(
        atlasScreenProbeCoord,
        screenProbeWidth,
        groupIndex,
        hasValidProbe,
        sourceHasSphericalVisibility,
        sourcePositionWS,
        sourceSceneDepth);
    GroupMemoryBarrierWithGroupSync();

    for (uint pdfY = groupThreadId.y; pdfY < BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_RESOLUTION_WITH_BORDER; pdfY += BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE)
    {
        for (uint pdfX = groupThreadId.x; pdfX < BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_RESOLUTION_WITH_BORDER; pdfX += BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE)
        {
            uint2 pdfTexelCoord = uint2(pdfX, pdfY);
            uint2 atlasCoord = atlasScreenProbeCoord * BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_RESOLUTION_WITH_BORDER + pdfTexelCoord;
            if (!hasValidProbe)
            {
                _BurtGIScreenProbeImportancePDFTexture[atlasCoord] = 0.0;
                continue;
            }

            uint2 wrappedTexelCoord = BurtGIOctahedralMapWrapBorder(
                pdfTexelCoord,
                BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_RESOLUTION_WITH_BORDER,
                BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_BORDER_SIZE);
            float2 pdfUV = (float2(wrappedTexelCoord) + 0.5) / (float)BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_RESOLUTION;
            float3 sampleDirection = BurtGIEquiAreaSphericalMapping(pdfUV);
            float transferPDF = -1.0;

            if (!BurtGIScreenProbeEvaluateImportanceTransferFromGBuffer(sourcePositionWS, sourceSceneDepth, sampleDirection, sourceHasSphericalVisibility, transferPDF))
            {
                [unroll]
                for (int offsetY = -1; offsetY <= 1; ++offsetY)
                {
                    [unroll]
                    for (int offsetX = -1; offsetX <= 1; ++offsetX)
                    {
                        int2 sampleProbeCoordInt = clamp(
                            (int2)sourceScreenProbeCoord + int2(offsetX, offsetY),
                            int2(0, 0),
                            int2((int)screenProbeWidth - 1, (int)screenProbeHeight - 1));
                        uint2 sampleProbeCoord = (uint2)sampleProbeCoordInt;
                        float3 sampleNormalWS;
                        bool sampleHasSphericalVisibility;
                        float sampleWeight = BurtGIScreenProbeTransferPDFNeighborhoodWeight(
                            sampleProbeCoord,
                            sourcePositionWS,
                            sourceNormalWS,
                            sourceHasSphericalVisibility,
                            sampleHasSphericalVisibility,
                            sampleNormalWS);
                        bool centerSample = offsetX == 0 && offsetY == 0;
                        if (sampleWeight > 0.1 || centerSample)
                        {
                            float samplePDF = sampleHasSphericalVisibility ? 1.0 : saturate(dot(sampleNormalWS, sampleDirection));
                            transferPDF = max(transferPDF, samplePDF);
                        }
                    }
                }
            }

            float centerPDF = sourceHasSphericalVisibility ? 1.0 : saturate(dot(sourceNormalWS, sampleDirection));
            _BurtGIScreenProbeImportancePDFTexture[atlasCoord] = transferPDF >= 0.0
                ? saturate(transferPDF)
                : centerPDF;
        }
    }
}

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, 1)]
void ScreenProbeImportanceSamplingTransferCS(uint groupIndex : SV_GroupIndex, uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    BurtGIScreenProbeImportanceSamplingTransfer(groupIndex, groupId, groupThreadId);
}

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, 1)]
void ScreenProbeImportancePDFLiteCS(uint groupIndex : SV_GroupIndex, uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    BurtGIScreenProbeImportanceSamplingTransfer(groupIndex, groupId, groupThreadId);
}

void BurtGIScreenProbeImportanceLightPDF(uint groupIndex, uint3 groupId, uint3 groupThreadId)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint2 traceAtlasSize = uint2(max(1u, (uint)_BurtGIScreenProbeTraceParams.y), max(1u, (uint)_BurtGIScreenProbeTraceParams.z));
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint uniformProbeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight);
    uint atlasProbeHeight = max(screenProbeHeight, BurtGIDivRoundUp(uniformProbeCount + maxAdaptiveProbeCount, screenProbeWidth));
    uint2 atlasScreenProbeCoord = groupId.xy;
    uint screenProbeIndex = atlasScreenProbeCoord.y * screenProbeWidth + atlasScreenProbeCoord.x;
    uint2 sourceScreenProbeCoord;
    uint2 resolvedAtlasScreenProbeCoord;
    bool validAtlasProbe = BurtGIResolveScreenProbeSourceAndAtlasCoord(
        screenProbeIndex,
        screenProbeWidth,
        screenProbeHeight,
        maxAdaptiveProbeCount,
        sourceScreenProbeCoord,
        resolvedAtlasScreenProbeCoord);
    uint2 traceTexelCoord = groupThreadId.xy;
    float pdf = 0.0;

    if (atlasScreenProbeCoord.x < screenProbeWidth &&
        atlasScreenProbeCoord.y < atlasProbeHeight &&
        traceTexelCoord.x < traceResolution &&
        traceTexelCoord.y < traceResolution &&
        validAtlasProbe &&
        BurtGIScreenProbeHasValidPlacement(sourceScreenProbeCoord))
    {
        if (_BurtGIScreenProbeImportanceLightPDFParams.w <= 0.5)
        {
            pdf = 1.0;
        }
        else
        {
            float currentRawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(sourceScreenProbeCoord, 0));
            float4 currentWorldPositionData = _BurtGIScreenProbeWorldPositionTexture.Load(int3(sourceScreenProbeCoord, 0));
            float3 currentWorldPosition = currentWorldPositionData.xyz;
            float3 currentNormalWS = BurtGIScreenProbeDecodeNormalWS(_BurtGIScreenProbeWorldNormalTexture.Load(int3(sourceScreenProbeCoord, 0)));
            float currentSceneDepth = max(BurtGILinearEyeDepth(currentRawDepth), 0.0001);
            float4 historyRadiance = 0.0;
            float historyGeometryWeight = 0.0;
            if (_BurtGIScreenProbeImportanceLightPDFParams.x > 0.5)
            {
                float2 historyUV;
                float projectedRawDepth;
                if (currentWorldPositionData.a > 0.5 &&
                    !BurtGIScreenProbeTraceCompactIsSkyDepth(currentRawDepth) &&
                    BurtGIScreenProbeProjectPreviousPositionWS(currentWorldPosition, historyUV, projectedRawDepth))
                {
                    float spacingPixels = max(_BurtGIScreenProbeImportanceLightPDFParams1.x, 1.0);
                    uint historyJitterIndex = BurtGIScreenProbePreviousJitterIndex(_BurtGIScreenProbeImportanceLightPDFParams1.y);
                    float2 historyProbeCoord = BurtGIScreenProbeTileCoordFromScreenUV(
                        historyUV,
                        historyJitterIndex,
                        spacingPixels,
                        max(_BurtGIScreenProbeImportanceLightPDFParams1.zw, float2(1.0, 1.0)));
                    int2 historyBaseCoord = (int2)floor(historyProbeCoord);
                    int2 maxHistoryCoord = int2((int)screenProbeWidth - 1, (int)screenProbeHeight - 1);
                    float4 currentPlane = float4(currentNormalWS, dot(currentWorldPosition, currentNormalWS));
                    float4 historyRadianceSum = 0.0;
                    float historyWeightSum = 0.0;

                    [unroll]
                    for (int historyY = 0; historyY < 2; ++historyY)
                    {
                        [unroll]
                        for (int historyX = 0; historyX < 2; ++historyX)
                        {
                            uint2 historyCoord = (uint2)clamp(historyBaseCoord + int2(historyX, historyY), int2(0, 0), maxHistoryCoord);
                            float historyRawDepth = _BurtGIScreenProbeHistoryScreenDepthTexture.Load(int3(historyCoord, 0));
                            float4 historyWorldPosition = _BurtGIScreenProbeHistoryWorldPositionTexture.Load(int3(historyCoord, 0));
                            float4 historyNormalData = _BurtGIScreenProbeHistoryWorldNormalTexture.Load(int3(historyCoord, 0));
                            if (historyWorldPosition.a <= 0.5 ||
                                historyNormalData.a <= 0.5 ||
                                BurtGIScreenProbeTraceCompactIsSkyDepth(historyRawDepth))
                            {
                                continue;
                            }

                            float planeDistance = abs(dot(float4(historyWorldPosition.xyz, -1.0), currentPlane));
                            float relativeDepthDifference = planeDistance / currentSceneDepth;
                            float positionWeight = exp2(-10000.0 * relativeDepthDifference * relativeDepthDifference) > 0.1 ? 1.0 : 0.0;
                            float historyWeight = positionWeight;
                            uint2 historyTraceAtlasCoord = historyCoord * traceResolution + traceTexelCoord;
                            float4 historyTraceRadiance = all(historyTraceAtlasCoord < traceAtlasSize)
                                ? _BurtGIScreenProbeHistoryTraceRadianceTexture.Load(int3(historyTraceAtlasCoord, 0))
                                : _BurtGIScreenProbeHistoryRadianceTexture.Load(int3(historyCoord, 0));
                            historyTraceRadiance.rgb = max(historyTraceRadiance.rgb * max(_BurtGIScreenProbeHistoryParams.x, 0.0), 0.0);
                            historyRadianceSum += historyTraceRadiance * historyWeight;
                            historyWeightSum += historyWeight;
                        }
                    }

                    if (historyWeightSum > 0.0001)
                    {
                        historyRadiance = historyRadianceSum / historyWeightSum;
                        historyGeometryWeight = saturate(historyWeightSum * 0.25);
                    }
                }
            }

            float3 lighting = max(historyRadiance.rgb, 0.0);
            float transparency = 1.0 - historyGeometryWeight;
            if (transparency > 0.0)
            {
                lighting = 1.0;
            }

            pdf = max(dot(lighting, float3(0.2126, 0.7152, 0.0722)), 0.0001);
        }
    }

    BurtGIScreenProbeImportanceLightSharedPDF[groupIndex] = pdf;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (uint reductionStride = BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT >> 1u; reductionStride > 0u; reductionStride >>= 1u)
    {
        if (groupIndex < reductionStride)
        {
            BurtGIScreenProbeImportanceLightSharedPDF[groupIndex] += BurtGIScreenProbeImportanceLightSharedPDF[groupIndex + reductionStride];
        }

        GroupMemoryBarrierWithGroupSync();
    }

    if (atlasScreenProbeCoord.x >= screenProbeWidth ||
        atlasScreenProbeCoord.y >= atlasProbeHeight ||
        traceTexelCoord.x >= traceResolution ||
        traceTexelCoord.y >= traceResolution)
    {
        return;
    }

    uint2 outputCoord = atlasScreenProbeCoord * traceResolution + traceTexelCoord;
    float pdfSum = max(BurtGIScreenProbeImportanceLightSharedPDF[0], 0.0001);
    _BurtGIScreenProbeImportanceLightPDFTexture[outputCoord] = pdf / pdfSum;
}

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, 1)]
void ScreenProbeImportanceSamplingLightCS(uint groupIndex : SV_GroupIndex, uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    BurtGIScreenProbeImportanceLightPDF(groupIndex, groupId, groupThreadId);
}

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, 1)]
void ScreenProbeImportanceLightPDFLiteCS(uint groupIndex : SV_GroupIndex, uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    BurtGIScreenProbeImportanceLightPDF(groupIndex, groupId, groupThreadId);
}

void BurtGIScreenProbeImportanceGenRays(uint groupIndex, uint3 groupId, uint3 groupThreadId)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint uniformProbeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight);
    uint atlasProbeHeight = max(screenProbeHeight, BurtGIDivRoundUp(uniformProbeCount + maxAdaptiveProbeCount, screenProbeWidth));
    uint maxImportanceTraceResolution = min(64u, max(traceResolution, traceResolution << 1u));
    uint uniformLevel = maxImportanceTraceResolution > traceResolution ? 1u : 0u;
    uint threadIndex = groupThreadId.y * traceResolution + groupThreadId.x;
    uint numRaysToTrace = traceResolution * traceResolution;
    uint2 atlasScreenProbeCoord = groupId.xy;
    uint screenProbeIndex = atlasScreenProbeCoord.y * screenProbeWidth + atlasScreenProbeCoord.x;
    uint2 sourceScreenProbeCoord;
    uint2 resolvedAtlasScreenProbeCoord;
    bool validAtlasProbe = BurtGIResolveScreenProbeSourceAndAtlasCoord(
        screenProbeIndex,
        screenProbeWidth,
        screenProbeHeight,
        maxAdaptiveProbeCount,
        sourceScreenProbeCoord,
        resolvedAtlasScreenProbeCoord);
    uint2 traceTexelCoord = groupThreadId.xy;
    bool validAtlasTexel =
        atlasScreenProbeCoord.x < screenProbeWidth &&
        atlasScreenProbeCoord.y < atlasProbeHeight &&
        traceTexelCoord.x < traceResolution &&
        traceTexelCoord.y < traceResolution;
    bool validTexel =
        validAtlasTexel &&
        validAtlasProbe &&
        BurtGIScreenProbeHasValidPlacement(sourceScreenProbeCoord);

    uint2 clampedScreenProbeCoord = min(atlasScreenProbeCoord, uint2(screenProbeWidth - 1u, atlasProbeHeight - 1u));
    uint2 clampedTraceTexelCoord = min(traceTexelCoord, uint2(traceResolution - 1u, traceResolution - 1u));
    uint2 atlasCoord = clampedScreenProbeCoord * traceResolution + clampedTraceTexelCoord;
    if (_BurtGIScreenProbeImportanceGenRaysParams.y <= 0.5)
    {
        if (validTexel)
        {
            _BurtGIScreenProbeImportanceRayInfoTexture[atlasCoord] = BurtGIPackScreenProbeImportanceRayInfo(traceTexelCoord, 0u);
        }
        else if (validAtlasTexel)
        {
            _BurtGIScreenProbeImportanceRayInfoTexture[atlasCoord] = 0u;
        }

        return;
    }

    float brdfPDF = validTexel ? BurtGIScreenProbeLoadImportancePDF(atlasScreenProbeCoord, traceTexelCoord, traceResolution) : 0.0;
    if (validTexel)
    {
        float2 brdfPDFUV = ((float2)traceTexelCoord + 0.5) / (float)traceResolution;
        float3 brdfPDFDirectionWS = BurtGIEquiAreaSphericalMapping(brdfPDFUV);
        bool validSH;
        float shPDF = BurtGIEvaluateImportancePDFSH(atlasScreenProbeCoord, screenProbeWidth, brdfPDFDirectionWS, validSH);
        brdfPDF = validSH ? shPDF : brdfPDF;
    }
    float lightPDF = validTexel ? _BurtGIScreenProbeImportanceLightPDFTexture[atlasCoord] : 0.0;
    float combinedPDF = brdfPDF * lightPDF * (float)(traceResolution * traceResolution);
    float minPDFToTrace = max(_BurtGIScreenProbeImportanceGenRaysParams.x, 0.0001);
    bool brdfNotCulled = brdfPDF >= minPDFToTrace;
    if (brdfNotCulled)
    {
        combinedPDF = max(combinedPDF, minPDFToTrace);
    }

    if (!validTexel && validAtlasTexel)
    {
        _BurtGIScreenProbeImportanceRayInfoTexture[atlasCoord] = 0u;
    }

    BurtGIScreenProbeImportanceRaySharedSort[groupIndex] = BurtGIPackScreenProbeImportanceRaySortInfo(traceTexelCoord, uniformLevel, validTexel ? combinedPDF : 0.0);
    GroupMemoryBarrierWithGroupSync();

    if (threadIndex < numRaysToTrace)
    {
        uint2 rayTexelCoord;
        uint rayLevel;
        float sortKey;
        BurtGIUnpackScreenProbeImportanceRaySortInfo(BurtGIScreenProbeImportanceRaySharedSort[threadIndex], rayTexelCoord, rayLevel, sortKey);

        uint numSmaller = 0u;
        [loop]
        for (uint otherRayIndex = 0u; otherRayIndex < numRaysToTrace; ++otherRayIndex)
        {
            uint2 otherRayTexelCoord;
            uint otherRayLevel;
            float otherSortKey;
            BurtGIUnpackScreenProbeImportanceRaySortInfo(BurtGIScreenProbeImportanceRaySharedSort[otherRayIndex], otherRayTexelCoord, otherRayLevel, otherSortKey);
            if (otherSortKey < sortKey || (otherSortKey == sortKey && otherRayIndex > threadIndex))
            {
                ++numSmaller;
            }
        }

        BurtGIScreenProbeImportanceRaySharedSort[numSmaller + numRaysToTrace] = BurtGIScreenProbeImportanceRaySharedSort[threadIndex];
    }

    if (groupIndex == 0u)
    {
        BurtGIScreenProbeImportanceRaySharedSubdivideCount = 0u;
    }
    GroupMemoryBarrierWithGroupSync();

    if (uniformLevel > 0u && threadIndex < numRaysToTrace)
    {
        uint mergeThreadIndex = threadIndex % 3u;
        uint mergeIndex = threadIndex / 3u;
        uint rayIndexToRefine = max((int)numRaysToTrace - (int)mergeIndex - 1, 0);
        uint rayIndexToMerge2 = mergeIndex * 3u + 2u;

        if (rayIndexToMerge2 < rayIndexToRefine)
        {
            uint2 lowRayTexelCoord;
            uint lowRayLevel;
            float lowPDF;
            BurtGIUnpackScreenProbeImportanceRaySortInfo(BurtGIScreenProbeImportanceRaySharedSort[numRaysToTrace + rayIndexToMerge2], lowRayTexelCoord, lowRayLevel, lowPDF);
            if (lowPDF < minPDFToTrace)
            {
                uint2 originalRayTexelCoord;
                uint originalRayLevel;
                float originalPDF;
                BurtGIUnpackScreenProbeImportanceRaySortInfo(BurtGIScreenProbeImportanceRaySharedSort[numRaysToTrace + rayIndexToRefine], originalRayTexelCoord, originalRayLevel, originalPDF);
                uint2 subdividedTexelCoord = originalRayTexelCoord * 2u + uint2((mergeThreadIndex + 1u) % 2u, (mergeThreadIndex + 1u) / 2u);
                float subdividedPDF = 0.0;
                BurtGIScreenProbeImportanceRaySharedSort[numRaysToTrace + threadIndex] = BurtGIPackScreenProbeImportanceRaySortInfo(subdividedTexelCoord, (uint)max(0, (int)originalRayLevel - 1), subdividedPDF);
                if (mergeThreadIndex == 0u)
                {
                    InterlockedAdd(BurtGIScreenProbeImportanceRaySharedSubdivideCount, 1u);
                }
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();

    if (threadIndex < BurtGIScreenProbeImportanceRaySharedSubdivideCount)
    {
        uint rayIndexToSubdivide = numRaysToTrace - threadIndex - 1u;
        uint2 originalRayTexelCoord;
        uint originalRayLevel;
        float originalPDF;
        BurtGIUnpackScreenProbeImportanceRaySortInfo(BurtGIScreenProbeImportanceRaySharedSort[numRaysToTrace + rayIndexToSubdivide], originalRayTexelCoord, originalRayLevel, originalPDF);
        float subdividedPDF = 0.0;
        BurtGIScreenProbeImportanceRaySharedSort[numRaysToTrace + rayIndexToSubdivide] =
            BurtGIPackScreenProbeImportanceRaySortInfo(originalRayTexelCoord * 2u, (uint)max(0, (int)originalRayLevel - 1), subdividedPDF);
    }
    GroupMemoryBarrierWithGroupSync();

    if (!validTexel)
    {
        return;
    }

    uint2 selectedRayTexelCoord;
    uint selectedRayLevel;
    float selectedPDF;
    BurtGIUnpackScreenProbeImportanceRaySortInfo(BurtGIScreenProbeImportanceRaySharedSort[numRaysToTrace + threadIndex], selectedRayTexelCoord, selectedRayLevel, selectedPDF);
    _BurtGIScreenProbeImportanceRayInfoTexture[atlasCoord] = BurtGIPackScreenProbeImportanceRayInfo(selectedRayTexelCoord, selectedRayLevel);
}

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, 1)]
void ScreenProbeImportanceSamplingGenRaysCS(uint groupIndex : SV_GroupIndex, uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    BurtGIScreenProbeImportanceGenRays(groupIndex, groupId, groupThreadId);
}

[numthreads(BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE, 1)]
void ScreenProbeImportanceGenRaysLiteCS(uint groupIndex : SV_GroupIndex, uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    BurtGIScreenProbeImportanceGenRays(groupIndex, groupId, groupThreadId);
}
