float BurtGILinearEyeDepth(float rawDepth)
{
    return rcp(max(_ZBufferParams.z * rawDepth + _ZBufferParams.w, 0.000001f));
}
groupshared float BurtGIScreenProbeIrradianceOctSharedHit[BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT];
groupshared float BurtGIScreenProbeIrradianceOctSharedSampleCount[BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT];

uint BurtGIDivRoundUp(uint value, uint divisor)
{
    return divisor == 0u ? 0u : (value + divisor - 1u) / divisor;
}

void BurtGIWriteDispatchArgs(uint index, uint workItemCount, uint threadGroupSize)
{
    _BurtGIScreenProbeIndirectArgsBuffer[index] = uint3(
        BurtGIDivRoundUp(max(1u, workItemCount), max(1u, threadGroupSize)),
        1u,
        1u);
}

bool BurtGIScreenProbeTraceCompactIsSkyDepth(float rawDepth)
{
#if defined(UNITY_REVERSED_Z)
    return rawDepth <= 0.00001f;
#else
    return rawDepth >= 0.99999f;
#endif
}

float3 BurtGIScreenProbeTraceEarlySafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001 ? value * rsqrt(lengthSq) : fallback;
}

float3 BurtGIScreenProbeDecodeNormalWS(float4 encodedNormal)
{
    return BurtGIScreenProbeTraceEarlySafeNormalize(encodedNormal.xyz * 2.0 - 1.0, float3(0.0, 1.0, 0.0));
}

float3 BurtGIScreenProbeDecodeGBufferNormalWS(float2 encodedNormal)
{
    float2 f = encodedNormal * 2.0 - 1.0;
    float3 n = float3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = saturate(-n.z);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return BurtGIScreenProbeTraceEarlySafeNormalize(n + 0.000001, float3(0.0, 0.0, 1.0));
}

float2 BurtGIScreenProbeUnpack888UIntToFloat2(uint3 value)
{
    uint hi = value.z >> 4;
    uint lo = value.z & 15u;
    uint2 packed = value.xy | uint2(lo << 8, hi << 8);
    return (float2)packed / 4095.0;
}

float2 BurtGIScreenProbeUnpack888ToFloat2(float3 value)
{
    uint3 quantized = (uint3)(saturate(value) * 255.5);
    return BurtGIScreenProbeUnpack888UIntToFloat2(quantized);
}

float3 BurtGIScreenProbeDecodeGBufferNormalWS888(float3 encodedNormal)
{
    return BurtGIScreenProbeDecodeGBufferNormalWS(BurtGIScreenProbeUnpack888ToFloat2(encodedNormal));
}

float4 BurtGIScreenProbeBuildDeferredClipPosition(float2 screenUV, float rawDepth)
{
    float2 clipXY = screenUV * 2.0 - 1.0;
#if UNITY_UV_STARTS_AT_TOP
    clipXY.y = -clipXY.y;
#endif

#if defined(UNITY_REVERSED_Z)
    float clipZ = rawDepth;
#else
    float clipZ = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, rawDepth);
#endif

    return float4(clipXY, clipZ, 1.0);
}

float3 BurtGIScreenProbeReconstructDeferredPositionWS(float2 screenUV, float rawDepth)
{
    float4 positionWS = mul(_BurtDeferredInverseViewProjectionMatrix, BurtGIScreenProbeBuildDeferredClipPosition(screenUV, rawDepth));
    float safeW = abs(positionWS.w) > 0.00001 ? positionWS.w : (positionWS.w < 0.0 ? -0.00001 : 0.00001);
    return positionWS.xyz / safeW;
}

float BurtGIScreenProbeRawDepthFromClip(float clipZ)
{
#if defined(UNITY_REVERSED_Z)
    return saturate(clipZ);
#else
    return saturate((clipZ - UNITY_NEAR_CLIP_VALUE) / max(1.0 - UNITY_NEAR_CLIP_VALUE, 0.00001));
#endif
}

float2 BurtGIScreenProbeClipToScreenUV(float2 clipXY)
{
    float2 uv = clipXY * 0.5 + 0.5;
#if UNITY_UV_STARTS_AT_TOP
    uv.y = 1.0 - uv.y;
#endif
    return uv;
}

bool BurtGIScreenProbeProjectPositionWS(float3 positionWS, out float2 screenUV, out float rawDepth)
{
    float4 clipPosition = mul(_BurtGIScreenProbeViewProjectionMatrix, float4(positionWS, 1.0));
    if (clipPosition.w <= 0.00001)
    {
        screenUV = 0.0;
        rawDepth = 0.0;
        return false;
    }

    float3 ndc = clipPosition.xyz / clipPosition.w;
    screenUV = BurtGIScreenProbeClipToScreenUV(ndc.xy);
    rawDepth = BurtGIScreenProbeRawDepthFromClip(ndc.z);
    return !any(screenUV < 0.0) && !any(screenUV > 1.0) && !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth);
}

bool BurtGIScreenProbeProjectPreviousPositionWS(float3 positionWS, out float2 screenUV, out float rawDepth)
{
    float4 clipPosition = mul(_BurtGIPreviousViewProjectionMatrix, float4(positionWS, 1.0));
    if (clipPosition.w <= 0.00001)
    {
        screenUV = 0.0;
        rawDepth = 0.0;
        return false;
    }

    float3 ndc = clipPosition.xyz / clipPosition.w;
    screenUV = BurtGIScreenProbeClipToScreenUV(ndc.xy);
    rawDepth = BurtGIScreenProbeRawDepthFromClip(ndc.z);
    return !any(screenUV < 0.0) && !any(screenUV > 1.0) && !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth);
}

float BurtGIScreenProbeComputeHitVignetteFromScreenUV(float2 screenUV)
{
    float2 screenPos = screenUV * 2.0 - 1.0;
    float2 vignette = saturate(abs(screenPos) * 5.0 - 4.0);
    return saturate(1.0 - dot(vignette, vignette));
}

float3 BurtGIScreenProbeSceneVoxelWorldToUVW(float3 worldPosition)
{
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float extent = max(centerExtent.w, 0.001);
    return (worldPosition - centerExtent.xyz) / (extent * 2.0) + 0.5;
}

bool BurtGIScreenProbeOctreeMaskContains(uint lowMask, uint highMask, uint bitIndex)
{
    uint word = bitIndex < 32u ? lowMask : highMask;
    return ((word >> (bitIndex & 31u)) & 1u) != 0u;
}

bool BurtGIScreenProbeSceneVoxelOctreeMayContain(float3 samplePosition)
{
    if (_BurtGISceneVoxelOctreeValid <= 0.5)
    {
        return true;
    }

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGIScreenProbeSceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    uint3 parentCoord = voxelCoord >> 4u;
    uint3 leafCoord = voxelCoord >> 2u;
    uint rootBit = parentCoord.x + parentCoord.y * 4u + parentCoord.z * 16u;
    if (!BurtGIScreenProbeOctreeMaskContains(
            _BurtGISceneVoxelOctreeRootLowTexture[uint3(0u, 0u, 0u)],
            _BurtGISceneVoxelOctreeRootHighTexture[uint3(0u, 0u, 0u)],
            rootBit))
    {
        return false;
    }

    uint3 parentChild = leafCoord & 3u;
    uint parentBit = parentChild.x + parentChild.y * 4u + parentChild.z * 16u;
    if (!BurtGIScreenProbeOctreeMaskContains(
            _BurtGISceneVoxelOctreeParentLowTexture[parentCoord],
            _BurtGISceneVoxelOctreeParentHighTexture[parentCoord],
            parentBit))
    {
        return false;
    }

    uint3 leafChild = voxelCoord & 3u;
    uint leafBit = leafChild.x + leafChild.y * 4u + leafChild.z * 16u;
    return BurtGIScreenProbeOctreeMaskContains(
        _BurtGISceneVoxelOctreeLeafLowTexture[leafCoord],
        _BurtGISceneVoxelOctreeLeafHighTexture[leafCoord],
        leafBit);
}

bool BurtGIScreenProbeTrySampleSceneVoxelOccupancy(float3 samplePosition, float sampleRadius, out float occupancy)
{
    occupancy = 0.0;

    if (!BurtGIScreenProbeSceneVoxelOctreeMayContain(samplePosition))
    {
        return false;
    }

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelOccupancyMipReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGIScreenProbeSceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    float voxelSizeWS = max(_BurtGISceneVoxelCenterExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float mipLevel = clamp(
        floor(log2(max(sampleRadius, voxelSizeWS) / voxelSizeWS)),
        0.0,
        (float)(BURT_GI_SCENE_VOXEL_OCCUPANCY_MIP_COUNT - 1u));
    float4 occupancyMip = _BurtGISceneVoxelOccupancyMipReadTexture.SampleLevel(
        sampler_BurtGISceneVoxelOccupancyMipReadTexture,
        uvw,
        mipLevel);
    occupancy = saturate(max(occupancyMip.x, occupancyMip.y));
    return occupancy > 0.001;
}

uint BurtGIResolveSceneVoxelClipmap(float3 samplePosition)
{
    if (all(abs(samplePosition - _BurtGISceneVoxelCenterExtent.xyz) <= _BurtGISceneVoxelCenterExtent.www))
    {
        return 0u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 2u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[1].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[1].www))
    {
        return 1u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 4u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[2].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[2].www))
    {
        return 2u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 8u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[3].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[3].www))
    {
        return 3u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 16u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[4].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[4].www))
    {
        return 4u;
    }

    if ((_BurtGISceneVoxelClipmapValidMask & 32u) != 0u &&
        all(abs(samplePosition - _BurtGISceneVoxelClipmapCenterExtent[5].xyz) <= _BurtGISceneVoxelClipmapCenterExtent[5].www))
    {
        return 5u;
    }

    return 0u;
}

bool BurtGIScreenProbeTrySampleSceneVoxelGeometry(
    float3 samplePosition,
    float3 traceDirection,
    out float3 normalWS,
    out float occupancy,
    out float normalFacingWeight,
    out uint hitBackface)
{
    normalWS = 0.0;
    occupancy = 0.0;
    normalFacingWeight = 0.0;
    hitBackface = 0u;

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGIScreenProbeSceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 geometry = _BurtGISceneVoxelGeometryReadTexture.Load(int4((int3)coord, 0));
    occupancy = saturate(geometry.a);
    if (occupancy <= 0.001)
    {
        return false;
    }

    float3 decodedNormal = geometry.xyz * 2.0 - 1.0;
    float normalLengthSq = dot(decodedNormal, decodedNormal);
    normalWS = normalLengthSq > 0.0001 ? decodedNormal * rsqrt(normalLengthSq) : float3(0.0, 1.0, 0.0);
    float frontFacing = dot(normalWS, -BurtGIScreenProbeTraceEarlySafeNormalize(traceDirection, float3(0.0, 0.0, 1.0)));
    hitBackface = frontFacing < 0.0 ? 1u : 0u;
    normalFacingWeight = saturate(abs(frontFacing) * 0.85 + 0.15);
    return normalFacingWeight > 0.001;
}

bool BurtGIScreenProbeTrySampleSceneVoxelLighting(
    float3 samplePosition,
    float sampleRadius,
    out float3 radiance,
    out float confidence)
{
    radiance = 0.0;
    confidence = 0.0;

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelLightingReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGIScreenProbeSceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 lighting = _BurtGISceneVoxelLightingReadTexture.Load(int4((int3)coord, 0));
    confidence = saturate(lighting.a);
    radiance = max(lighting.rgb, 0.0);
    if (confidence <= 0.001 || dot(radiance, radiance) <= 0.0)
    {
        return false;
    }

    float voxelSizeWS = max(_BurtGISceneVoxelCenterExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    float footprintWeight = saturate(voxelSizeWS / max(sampleRadius, voxelSizeWS));
    confidence *= lerp(0.5, 1.0, footprintWeight);
    return true;
}

bool BurtGIScreenProbeTrySampleSceneVoxelClipmapHit(
    Texture3D<float4> geometryTexture,
    Texture3D<float4> lightingTexture,
    float4 centerExtent,
    float3 samplePosition,
    float3 traceDirection,
    float sampleRadius,
    out float3 radiance,
    out float confidence,
    out float3 normalWS,
    out float occupancy,
    out float normalFacingWeight,
    out uint hitBackface)
{
    radiance = 0.0;
    confidence = 0.0;
    normalWS = 0.0;
    occupancy = 0.0;
    normalFacingWeight = 0.0;
    hitBackface = 0u;
    uint width;
    uint height;
    uint depth;
    geometryTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float extent = max(centerExtent.w, 0.001);
    float3 uvw = (samplePosition - centerExtent.xyz) / (extent * 2.0) + 0.5;
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return false;
    }

    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 geometry = geometryTexture.Load(int4((int3)coord, 0));
    float4 lighting = lightingTexture.Load(int4((int3)coord, 0));
    occupancy = saturate(geometry.a);
    confidence = saturate(lighting.a);
    radiance = max(lighting.rgb, 0.0);
    if (occupancy <= 0.001 || confidence <= 0.001 || dot(radiance, radiance) <= 0.0)
    {
        return false;
    }

    normalWS = BurtGIScreenProbeTraceEarlySafeNormalize(geometry.xyz * 2.0 - 1.0, float3(0.0, 1.0, 0.0));
    float frontFacing = dot(normalWS, -BurtGIScreenProbeTraceEarlySafeNormalize(traceDirection, float3(0.0, 0.0, 1.0)));
    hitBackface = frontFacing < 0.0 ? 1u : 0u;
    normalFacingWeight = saturate(abs(frontFacing) * 0.85 + 0.15);

    float voxelSizeWS = max(extent * 2.0 / max((float)volumeSize.x, 1.0), 0.001);
    confidence *= lerp(0.5, 1.0, saturate(voxelSizeWS / max(sampleRadius, voxelSizeWS)));
    return normalFacingWeight > 0.001;
}

bool BurtGIScreenProbeTrySampleSceneVoxelClipmapHitByLevel(
    uint clipmapLevel,
    float3 samplePosition,
    float3 traceDirection,
    float sampleRadius,
    out float3 radiance,
    out float confidence,
    out float3 normalWS,
    out float occupancy,
    out float normalFacingWeight,
    out uint hitBackface)
{
    radiance = 0.0;
    confidence = 0.0;
    normalWS = float3(0.0, 1.0, 0.0);
    occupancy = 0.0;
    normalFacingWeight = 0.0;
    hitBackface = 0u;

    if (clipmapLevel == 1u)
    {
        return BurtGIScreenProbeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap1GeometryReadTexture,
            _BurtGISceneVoxelClipmap1LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[1],
            samplePosition,
            traceDirection,
            sampleRadius,
            radiance,
            confidence,
            normalWS,
            occupancy,
            normalFacingWeight,
            hitBackface);
    }

    if (clipmapLevel == 2u)
    {
        return BurtGIScreenProbeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap2GeometryReadTexture,
            _BurtGISceneVoxelClipmap2LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[2],
            samplePosition,
            traceDirection,
            sampleRadius,
            radiance,
            confidence,
            normalWS,
            occupancy,
            normalFacingWeight,
            hitBackface);
    }

    if (clipmapLevel == 3u)
    {
        return BurtGIScreenProbeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap3GeometryReadTexture,
            _BurtGISceneVoxelClipmap3LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[3],
            samplePosition,
            traceDirection,
            sampleRadius,
            radiance,
            confidence,
            normalWS,
            occupancy,
            normalFacingWeight,
            hitBackface);
    }

    if (clipmapLevel == 4u)
    {
        return BurtGIScreenProbeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap4GeometryReadTexture,
            _BurtGISceneVoxelClipmap4LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[4],
            samplePosition,
            traceDirection,
            sampleRadius,
            radiance,
            confidence,
            normalWS,
            occupancy,
            normalFacingWeight,
            hitBackface);
    }

    if (clipmapLevel == 5u)
    {
        return BurtGIScreenProbeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap5GeometryReadTexture,
            _BurtGISceneVoxelClipmap5LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[5],
            samplePosition,
            traceDirection,
            sampleRadius,
            radiance,
            confidence,
            normalWS,
            occupancy,
            normalFacingWeight,
            hitBackface);
    }

    return BurtGIScreenProbeTrySampleSceneVoxelClipmapHit(
        _BurtGISceneVoxelGeometryReadTexture,
        _BurtGISceneVoxelLightingReadTexture,
        _BurtGISceneVoxelCenterExtent,
        samplePosition,
        traceDirection,
        sampleRadius,
        radiance,
        confidence,
        normalWS,
        occupancy,
        normalFacingWeight,
        hitBackface);
}

float3 BurtGIScreenProbeTraceSafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001 ? value * rsqrt(lengthSq) : fallback;
}

uint BurtGIRadianceCacheClipmapCount()
{
    return max(1u, (uint)max(_BurtGIRadianceCacheClipMapParams.x, 1.0f));
}

uint BurtGIRadianceCacheAtlasResolutionInProbes()
{
    return max(1u, (uint)max(_BurtGIRadianceCacheClipMapParams.z, 1.0f));
}

uint BurtGIRadianceCacheClipmapResolution()
{
    return max(1u, (uint)max(_BurtGIRadianceCacheClipMapParams.w, 1.0f));
}

uint BurtGIRadianceCacheProbeResolution()
{
    return max(1u, (uint)max(_BurtGIRadianceCacheClipMapParams.y, 1.0f));
}

uint BurtGIRadianceCacheFinalProbeResolution()
{
    return max(BurtGIRadianceCacheProbeResolution(), (uint)max(_BurtGIRadianceCacheClipMapWorldParams.w, 1.0f));
}

bool BurtGIRadianceCacheIsAvailable()
{
    return _BurtGIRadianceCacheClipMapApplyParams.x > 0.5f &&
        _BurtGIRadianceCacheClipMapParams.x > 0.5f &&
        _BurtGIRadianceCacheClipMapParams.y > 0.5f &&
        _BurtGIRadianceCacheClipMapParams.z > 0.5f &&
        _BurtGIRadianceCacheClipMapParams.w > 0.5f &&
        _BurtGIRadianceCacheClipMapIndirectionSize.x > 0.5f &&
        _BurtGIRadianceCacheClipMapIndirectionSize.y > 0.5f;
}

bool BurtGIRadianceCacheWorldPositionToProbeCoordDithered(float3 worldPosition, float clipmapDitherRandom, out uint clipmapIndex, out float3 probeCoordFloat)
{
    uint clipmapCount = BurtGIRadianceCacheClipmapCount();
    float clipmapResolution = max(_BurtGIRadianceCacheClipMapParams.w, 1.0f);
    float invFadeSize = max(_BurtGIRadianceCacheClipMapWorldParams.z, 0.0001f);

    [unroll]
    for (uint currentClipmapIndex = 0u; currentClipmapIndex < BURT_GI_RADIANCE_CACHE_MAX_CLIPMAPS; ++currentClipmapIndex)
    {
        if (currentClipmapIndex >= clipmapCount)
        {
            continue;
        }

        float4 worldPositionToProbeCoord = _BurtGIRadianceCacheClipMapWorldPositionToProbeCoord[currentClipmapIndex];
        float3 currentProbeCoordFloat = worldPosition * worldPositionToProbeCoord.w + worldPositionToProbeCoord.xyz;
        float3 bottomEdgeFade = saturate((currentProbeCoordFloat - 0.5f) * invFadeSize);
        float3 topEdgeFade = saturate((clipmapResolution - 0.5f - currentProbeCoordFloat) * invFadeSize);
        float edgeFade = min(
            min(bottomEdgeFade.x, min(bottomEdgeFade.y, bottomEdgeFade.z)),
            min(topEdgeFade.x, min(topEdgeFade.y, topEdgeFade.z)));

        if (edgeFade > clipmapDitherRandom)
        {
            clipmapIndex = currentClipmapIndex;
            probeCoordFloat = currentProbeCoordFloat;
            return true;
        }
    }

    clipmapIndex = 0u;
    probeCoordFloat = 0.0f;
    return false;
}

bool BurtGIRadianceCacheTryGetCoverage(
    float3 worldPosition,
    float clipmapDitherRandom,
    out float minTraceDistanceBeforeInterpolation)
{
    minTraceDistanceBeforeInterpolation = 10000000.0f;
    uint clipmapIndex = 0u;
    float3 probeCoordFloat = 0.0f;
    if (!BurtGIRadianceCacheIsAvailable() ||
        !BurtGIRadianceCacheWorldPositionToProbeCoordDithered(worldPosition, clipmapDitherRandom, clipmapIndex, probeCoordFloat))
    {
        return false;
    }

    float cellSize = max(_BurtGIRadianceCacheClipMapClipmapParams[clipmapIndex].x, 0.001f);
    float probeTMin = max(_BurtGIRadianceCacheClipMapClipmapParams[clipmapIndex].y, cellSize);
    minTraceDistanceBeforeInterpolation = probeTMin + cellSize * 1.73205080757f;
    return true;
}

uint BurtGIRadianceCacheProbeIndexFromIndirection(uint clipmapIndex, uint3 probeCoord)
{
    uint clipmapResolution = BurtGIRadianceCacheClipmapResolution();
    uint2 indirectionSize = max((uint2)_BurtGIRadianceCacheClipMapIndirectionSize.xy, uint2(1u, 1u));
    uint2 indirectionCoord = uint2(
        clipmapIndex * clipmapResolution + probeCoord.x,
        probeCoord.y + probeCoord.z * clipmapResolution);

    if (indirectionCoord.x >= indirectionSize.x || indirectionCoord.y >= indirectionSize.y)
    {
        return BURT_GI_RADIANCE_CACHE_INVALID_PROBE_INDEX;
    }

    return _BurtGIRadianceCacheClipMapIndirectionTexture.Load(int3((int2)indirectionCoord, 0));
}

float2 BurtGIRayIntersectSphere(float3 rayOrigin, float3 rayDirection, float4 sphere)
{
    float3 localPosition = rayOrigin - sphere.xyz;
    float a = max(dot(rayDirection, rayDirection), 0.000001f);
    float b = 2.0f * dot(rayDirection, localPosition);
    float c = dot(localPosition, localPosition) - sphere.w * sphere.w;
    float discriminant = b * b - 4.0f * a * c;
    if (discriminant < 0.0f)
    {
        return -1.0f;
    }

    float sqrtDiscriminant = sqrt(discriminant);
    return (-b + float2(-sqrtDiscriminant, sqrtDiscriminant)) / (2.0f * a);
}

float2 BurtGIInverseEquiAreaSphericalMapping(float3 direction)
{
    direction = BurtGIScreenProbeTraceSafeNormalize(
        float3(direction.z, direction.x, direction.y),
        float3(0.0f, 1.0f, 0.0f));
    float3 absDirection = abs(direction);
    float r = sqrt(max(1.0f - absDirection.z, 0.0f));
    float x = min(absDirection.x, absDirection.y) / (max(absDirection.x, absDirection.y) + 1e-8f);
    const float t1 = 0.406758566246788489601959989e-5f;
    const float t2 = 0.636226545274016134946890922156f;
    const float t3 = 0.61572017898280213493197203466e-2f;
    const float t4 = -0.247333733281268944196501420480f;
    const float t5 = 0.881770664775316294736387951347e-1f;
    const float t6 = 0.419038818029165735901852432784e-1f;
    const float t7 = -0.251390972343483509333252996350e-1f;
    float phi = t6 + t7 * x;
    phi = t5 + phi * x;
    phi = t4 + phi * x;
    phi = t3 + phi * x;
    phi = t2 + phi * x;
    phi = t1 + phi * x;
    phi = absDirection.x < absDirection.y ? 1.0f - phi : phi;
    float2 uv = float2(r - phi * r, phi * r);
    uv = direction.z < 0.0f ? 1.0f - uv.yx : uv;
    uv.x = direction.x < 0.0f ? -uv.x : uv.x;
    uv.y = direction.y < 0.0f ? -uv.y : uv.y;
    return saturate(uv * 0.5f + 0.5f);
}

float BurtGIRadianceCacheFinalAtlasMaxMip()
{
    return (float)_BurtGIRadianceCacheClipMapFinalRadianceAtlasMaxMip;
}

float BurtGISampleRadianceCacheProbeOcclusion(uint probeIndex, float3 probeToSampleWS, float sampleDistance)
{
    uint atlasResolutionInProbes = BurtGIRadianceCacheAtlasResolutionInProbes();
    uint maxProbeCount = atlasResolutionInProbes * atlasResolutionInProbes;
    if (probeIndex >= maxProbeCount)
    {
        return 0.0f;
    }

    uint radianceProbeResolution = BurtGIRadianceCacheProbeResolution();
    uint finalRadianceProbeResolution = BurtGIRadianceCacheFinalProbeResolution();
    uint borderSize = max(1u, (finalRadianceProbeResolution - radianceProbeResolution) / 2u);
    uint finalOcclusionProbeResolution = max(1u, _BurtGIRadianceCacheClipMapFinalOcclusionProbeResolution);
    uint occlusionProbeResolution = max(1u, finalOcclusionProbeResolution > 2u * borderSize ? finalOcclusionProbeResolution - 2u * borderSize : 1u);
    float2 probeUV = BurtGIInverseEquiAreaSphericalMapping(BurtGIScreenProbeTraceSafeNormalize(probeToSampleWS, float3(0.0f, 1.0f, 0.0f)));
    float2 probeTexelCoord = probeUV * (float)occlusionProbeResolution + (float)borderSize;
    float2 probeAtlasBaseCoord = (float2)(uint2(probeIndex % atlasResolutionInProbes, probeIndex / atlasResolutionInProbes) * finalOcclusionProbeResolution);
    float2 occlusionAtlasResolution = (float)(atlasResolutionInProbes * finalOcclusionProbeResolution);
    float2 moments = _BurtGIRadianceCacheClipMapProbeOcclusionAtlasTexture.SampleLevel(
        sampler_BurtGIRadianceCacheClipMapProbeOcclusionAtlasTexture,
        (probeAtlasBaseCoord + probeTexelCoord) / max(occlusionAtlasResolution, float2(1.0f, 1.0f)),
        0.0f);

    float meanDepth = max(moments.x, 0.0f);
    if (meanDepth <= 0.0001f || sampleDistance <= meanDepth)
    {
        return 1.0f;
    }

    float variance = max(abs(moments.y - meanDepth * meanDepth), 0.0001f);
    float distanceDelta = sampleDistance - meanDepth;
    float visibility = variance / (variance + distanceDelta * distanceDelta);
    return saturate(visibility * visibility * visibility);
}

float3 BurtGIRadianceCacheProbeWorldPosition(uint clipmapIndex, uint3 probeCoord, uint probeIndex)
{
    float4 probeCoordToWorld = _BurtGIRadianceCacheClipMapProbeCoordToWorldCenter[clipmapIndex];
    float3 probeWorldPosition = probeCoordToWorld.xyz + (float3)probeCoord * probeCoordToWorld.w;
    uint atlasResolutionInProbes = BurtGIRadianceCacheAtlasResolutionInProbes();
    uint maxProbeCount = atlasResolutionInProbes * atlasResolutionInProbes;
    if (probeIndex < maxProbeCount)
    {
        probeWorldPosition += _BurtGIRadianceCacheClipMapProbeWorldOffsetBuffer[probeIndex].xyz;
    }

    return probeWorldPosition;
}

float3 BurtGISampleRadianceCacheProbe(uint probeIndex, float3 sampleDirectionWS, float mipLevel)
{
    uint atlasResolutionInProbes = BurtGIRadianceCacheAtlasResolutionInProbes();
    uint maxProbeCount = atlasResolutionInProbes * atlasResolutionInProbes;
    if (probeIndex >= maxProbeCount)
    {
        return 0.0f;
    }

    uint radianceProbeResolution = BurtGIRadianceCacheProbeResolution();
    uint finalProbeResolution = BurtGIRadianceCacheFinalProbeResolution();
    uint borderSize = (finalProbeResolution - radianceProbeResolution) / 2u;
    float2 probeUV = BurtGIInverseEquiAreaSphericalMapping(sampleDirectionWS);
    float2 probeTexelCoord = probeUV * (float)radianceProbeResolution + (float)borderSize;
    float2 probeAtlasBaseCoord = (float2)(uint2(probeIndex % atlasResolutionInProbes, probeIndex / atlasResolutionInProbes) * finalProbeResolution);
    float2 finalAtlasResolution = (float)(atlasResolutionInProbes * finalProbeResolution);
    float2 probeAtlasUV = (probeAtlasBaseCoord + probeTexelCoord) / max(finalAtlasResolution, float2(1.0f, 1.0f));
    return max(_BurtGIRadianceCacheClipMapFinalRadianceAtlasTexture.SampleLevel(sampler_BurtGIRadianceCacheClipMapFinalRadianceAtlasTexture, probeAtlasUV, mipLevel).rgb, 0.0f);
}

float3 BurtGISampleRadianceCacheProbeWithParallaxCorrection(
    uint3 probeCoord,
    uint clipmapIndex,
    uint probeIndex,
    float3 worldPosition,
    float3 sampleDirectionWS,
    float mipLevel)
{
    float3 unitSampleDirectionWS = BurtGIScreenProbeTraceSafeNormalize(sampleDirectionWS, float3(0.0f, 1.0f, 0.0f));
    float probeTMin = max(_BurtGIRadianceCacheClipMapClipmapParams[clipmapIndex].y, 0.001f);
    float reprojectionRadiusScale = _BurtGIRadianceCacheClipMapApplyParams.y > 0.0f ? _BurtGIRadianceCacheClipMapApplyParams.y : 1.5f;
    float reprojectionRadius = reprojectionRadiusScale * probeTMin;
    float3 probeWorldPosition = BurtGIRadianceCacheProbeWorldPosition(clipmapIndex, probeCoord, probeIndex);
    float2 intersections = BurtGIRayIntersectSphere(worldPosition, unitSampleDirectionWS, float4(probeWorldPosition, reprojectionRadius));

    if (intersections.y > 0.0001f)
    {
        float3 intersectionPosition = worldPosition + unitSampleDirectionWS * intersections.y;
        float3 reprojectedDirection = intersectionPosition - probeWorldPosition;
        float correctionDenominator = reprojectionRadius * dot(reprojectedDirection, unitSampleDirectionWS);
        if (abs(correctionDenominator) > 0.0001f)
        {
            float correctionFactor = max(intersections.y * intersections.y / correctionDenominator, 0.0f);
            return BurtGISampleRadianceCacheProbe(probeIndex, reprojectedDirection, mipLevel) * correctionFactor;
        }
    }

    return BurtGISampleRadianceCacheProbe(probeIndex, unitSampleDirectionWS, mipLevel);
}

bool BurtGISampleRadianceCacheClipMapInterpolated(
    float3 worldPosition,
    float3 sampleDirectionWS,
    float coneHalfAngle,
    float clipmapDitherRandom,
    out float3 radiance,
    out float confidence)
{
    radiance = 0.0f;
    confidence = 0.0f;

    if (!BurtGIRadianceCacheIsAvailable())
    {
        return false;
    }

    uint clipmapIndex = 0u;
    float3 probeCoordFloat = 0.0f;
    if (!BurtGIRadianceCacheWorldPositionToProbeCoordDithered(worldPosition, clipmapDitherRandom, clipmapIndex, probeCoordFloat))
    {
        return false;
    }

    uint clipmapResolution = BurtGIRadianceCacheClipmapResolution();
    float3 cornerProbeCoordFloat = probeCoordFloat - 0.5f + 0.0001f;
    int3 cornerProbeCoord = (int3)floor(cornerProbeCoordFloat);
    float3 lerpAlphas = saturate(frac(cornerProbeCoordFloat));
    float numTexels = sqrt(saturate(1.0f - cos(coneHalfAngle))) * (float)BurtGIRadianceCacheProbeResolution();
    float mipLevel = clamp(log2(max(numTexels, 1.0f)), 0.0f, BurtGIRadianceCacheFinalAtlasMaxMip());

    [unroll]
    for (int z = 0; z < 2; ++z)
    {
        [unroll]
        for (int y = 0; y < 2; ++y)
        {
            [unroll]
            for (int x = 0; x < 2; ++x)
            {
                int3 sampleProbeCoordSigned = clamp(
                    cornerProbeCoord + int3(x, y, z),
                    int3(0, 0, 0),
                    int3((int)clipmapResolution - 1, (int)clipmapResolution - 1, (int)clipmapResolution - 1));
                uint probeIndex = BurtGIRadianceCacheProbeIndexFromIndirection(clipmapIndex, (uint3)sampleProbeCoordSigned);
                if (probeIndex >= BURT_GI_RADIANCE_CACHE_USED_PROBE_INDEX)
                {
                    continue;
                }

                float3 cornerWeight = lerp(1.0f - lerpAlphas, lerpAlphas, float3((float)x, (float)y, (float)z));
                float weight = cornerWeight.x * cornerWeight.y * cornerWeight.z;
                radiance += BurtGISampleRadianceCacheProbeWithParallaxCorrection((uint3)sampleProbeCoordSigned, clipmapIndex, probeIndex, worldPosition, sampleDirectionWS, mipLevel) * weight;
                confidence += weight;
            }
        }
    }

    if (confidence <= 0.0001f)
    {
        return false;
    }

    confidence = saturate(confidence);
    return true;
}

bool BurtGIScreenProbeTrySampleSkyRadiance(float3 directionWS, float roughness, out float3 skyRadiance)
{
    skyRadiance = 0.0;
    if (_BurtSkyReflectionEnabled <= 0.5)
    {
        return false;
    }

    float3 safeDirectionWS = BurtGIScreenProbeTraceSafeNormalize(directionWS, float3(0.0, 1.0, 0.0));
    float2 rotation = _BurtSkyReflectionRotation.xy;
    float2 rotatedXZ = float2(
        safeDirectionWS.x * rotation.x - safeDirectionWS.z * rotation.y,
        safeDirectionWS.x * rotation.y + safeDirectionWS.z * rotation.x);
    float3 sampleDirectionWS = BurtGIScreenProbeTraceSafeNormalize(
        float3(rotatedXZ.x, safeDirectionWS.y, rotatedXZ.y),
        safeDirectionWS);
    float mipLevel = saturate(roughness) * max(_BurtSkyReflectionMaxMip, 0.0);
    float4 encodedSky = _BurtSkyReflectionTexture.SampleLevel(sampler_BurtSkyReflectionTexture, sampleDirectionWS, mipLevel);
    float hdrMultiplier = _BurtSkyReflectionHDR.x * pow(max(abs(encodedSky.a), 0.0001), _BurtSkyReflectionHDR.y);
    skyRadiance = max(encodedSky.rgb * hdrMultiplier, 0.0) *
        max(_BurtSkyReflectionTint.rgb, 0.0) *
        max(_BurtSkyReflectionIntensity, 0.0);

    if (_BurtSkyLowerHemisphereEnabled > 0.5 && safeDirectionWS.y < 0.0)
    {
        skyRadiance = lerp(skyRadiance, max(_BurtSkyLowerHemisphereDiffuseColor.rgb, 0.0), saturate(_BurtSkyLowerHemisphereDiffuseColor.a));
    }

    return dot(skyRadiance, skyRadiance) > 0.000001;
}

bool BurtGIScreenProbeTrySampleLocalSkyProbe(
    float3 rayOriginWS,
    float3 rayDirectionWS,
    float maxTraceDistance,
    out float3 localSkyRadiance,
    out float localSkyHitDistance)
{
    localSkyRadiance = 0.0;
    localSkyHitDistance = maxTraceDistance;
    if (_BurtGILocalSkyProbeParams0.w <= 0.5 ||
        _BurtGILocalSkyProbeParams1.x <= 0.01 ||
        _BurtGILocalSkyProbeParams1.y <= 0.0)
    {
        return false;
    }

    float3 localSkyOriginWS = _BurtGILocalSkyProbeParams0.xyz;
    float3 probeOffsetVector = rayOriginWS - localSkyOriginWS;
    float probeOffsetDistance = length(probeOffsetVector);
    float probeOffsetDistanceMax = _BurtGILocalSkyProbeParams1.x;
    if (probeOffsetDistance >= probeOffsetDistanceMax)
    {
        return false;
    }

    float3 safeRayDirectionWS = BurtGIScreenProbeTraceSafeNormalize(rayDirectionWS, float3(0.0, 1.0, 0.0));
    float traceStep = max(probeOffsetDistanceMax * 2.0 / 50.0, 0.01);
    float maxTraceSteps = min(50.0, ceil(maxTraceDistance / traceStep));
    float3 sampleVector = 0.0;
    float sampledDepth = 0.0;

    [loop]
    for (int traceStepIndex = 50; traceStepIndex > 0; --traceStepIndex)
    {
        if ((float)traceStepIndex > maxTraceSteps)
        {
            continue;
        }

        float3 rayVector = traceStep * (float)traceStepIndex * safeRayDirectionWS;
        float3 candidateVector = BurtGIScreenProbeTraceSafeNormalize(probeOffsetVector + rayVector, safeRayDirectionWS);
        float candidateDepth = _BurtGILocalSkyProbeDepthTexture.SampleLevel(
            sampler_BurtGILocalSkyProbeDepthTexture,
            candidateVector,
            0.0).r;
        if (candidateDepth <= 0.001)
        {
            continue;
        }

        float3 rayEndWS = rayOriginWS + rayVector;
        float3 hitPositionWS = localSkyOriginWS + candidateVector * candidateDepth;
        if (distance(rayEndWS, hitPositionWS) >= traceStep)
        {
            continue;
        }

        sampleVector = candidateVector;
        sampledDepth = candidateDepth;
        localSkyHitDistance = distance(rayOriginWS, hitPositionWS);
        break;
    }

    if (sampledDepth <= 0.001 || sampledDepth >= maxTraceDistance)
    {
        return false;
    }

    float3 localSkyColor = _BurtGILocalSkyProbeColorTexture.SampleLevel(
        sampler_BurtGILocalSkyProbeColorTexture,
        sampleVector,
        0.0).rgb;
    localSkyRadiance = max(localSkyColor, 0.0) * _BurtGILocalSkyProbeParams1.y;
    return true;
}

float3 BurtGIScreenProbeConeLaneDirection(float3 rayDirectionWS, uint laneIndex, float laneAngle)
{
    float3 direction = BurtGIScreenProbeTraceSafeNormalize(rayDirectionWS, float3(0.0, 1.0, 0.0));
    if (laneIndex == 0u || laneAngle <= 0.0001)
    {
        return direction;
    }

    float3 upSeed = abs(direction.y) > 0.92 ? float3(1.0, 0.0, 0.0) : float3(0.0, 1.0, 0.0);
    float3 tangent = BurtGIScreenProbeTraceSafeNormalize(cross(upSeed, direction), float3(1.0, 0.0, 0.0));
    float3 bitangent = BurtGIScreenProbeTraceSafeNormalize(cross(direction, tangent), float3(0.0, 0.0, 1.0));
    float laneSign = laneIndex == 1u ? 1.0 : -1.0;
    float laneTwist = laneIndex == 1u ? 0.35 : -0.35;
    float3 coneOffset = tangent * laneSign + bitangent * laneTwist;
    return BurtGIScreenProbeTraceSafeNormalize(direction + coneOffset * laneAngle, direction);
}

bool BurtGIScreenProbeTrySampleSceneVoxelConeTraceLane(
    float3 rayOriginWS,
    float3 rayDirectionWS,
    float maxTraceDistance,
    float minTraceDistanceBias,
    float coneHalfAngle,
    out float3 tracedRadiance,
    out float tracedConfidence,
    out float tracedHitDistance)
{
    tracedRadiance = 0.0;
    tracedConfidence = 0.0;
    tracedHitDistance = maxTraceDistance;

    uint width;
    uint height;
    uint depth;
    _BurtGISceneVoxelLightingReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float voxelSizeWS = max(_BurtGISceneVoxelCenterExtent.w * 2.0 / max((float)volumeSize.x, 1.0), 0.05);
    float minTraceDistance = max(max(voxelSizeWS * 0.75, 0.1), minTraceDistanceBias);
    float traceDistance = minTraceDistance;
    float traceLimit = max(maxTraceDistance, minTraceDistance + voxelSizeWS);
    float3 direction = BurtGIScreenProbeTraceSafeNormalize(rayDirectionWS, float3(0.0, 1.0, 0.0));

    if (_BurtGISceneVoxelOctreeValid > 0.5 || (_BurtGISceneVoxelClipmapValidMask & 62u) != 0u)
    {
        float octreeHitDistance = 0.0;
        uint octreeClipmapLevel = 0u;
        float octreeTraceDistance = max(maxTraceDistance - minTraceDistance, 0.0);
        if (!BurtGIVoxelOctreeRayTraceClipmaps(
                rayOriginWS + direction * minTraceDistance,
                direction,
                octreeTraceDistance,
                octreeHitDistance,
                octreeClipmapLevel))
        {
            return false;
        }

        float hitDistance = minTraceDistance + octreeHitDistance;
        float3 hitPosition = rayOriginWS + direction * (hitDistance + voxelSizeWS * 0.001);
        float3 hitRadiance = 0.0;
        float hitRadianceConfidence = 0.0;
        float3 hitNormal = float3(0.0, 1.0, 0.0);
        float hitOccupancy = 0.0;
        float hitNormalFacingWeight = 0.0;
        uint hitBackface = 0u;
        if (!BurtGIScreenProbeTrySampleSceneVoxelClipmapHitByLevel(
                octreeClipmapLevel,
                hitPosition,
                direction,
                voxelSizeWS,
                hitRadiance,
                hitRadianceConfidence,
                hitNormal,
                hitOccupancy,
                hitNormalFacingWeight,
                hitBackface))
        {
            return false;
        }

        tracedRadiance = hitRadiance;
        tracedConfidence = saturate(hitRadianceConfidence * hitOccupancy * hitNormalFacingWeight);
        tracedHitDistance = hitDistance;
        return tracedConfidence > 0.001;
    }

    float transparency = 1.0;
    float accumulatedWeight = 0.0;

    uint maxTraceSteps = min((uint)max(_BurtGISceneVoxelTraceControls.x, 1.0), BURT_GI_SCREEN_PROBE_SCENE_VOXEL_MAX_TRACE_STEPS);
    [loop]
    for (uint stepIndex = 0u; stepIndex < maxTraceSteps && traceDistance <= traceLimit; ++stepIndex)
    {
        float stepFraction = saturate((traceDistance - minTraceDistance) / max(traceLimit - minTraceDistance, 0.001));
        float sampleRadius = max(voxelSizeWS, traceDistance * max(coneHalfAngle, 0.08));
        float3 samplePosition = rayOriginWS + direction * traceDistance;

        float coarseOccupancy = 0.0;
        if (!BurtGIScreenProbeTrySampleSceneVoxelOccupancy(samplePosition, sampleRadius, coarseOccupancy))
        {
            traceDistance += max(voxelSizeWS, sampleRadius) * max(_BurtGISceneVoxelTraceControls.y, 0.1);
            continue;
        }

        float3 sampleRadiance = 0.0;
        float sampleConfidence = 0.0;
        float3 sampleNormal = float3(0.0, 1.0, 0.0);
        float sampleOccupancy = 0.0;
        float normalFacingWeight = 0.0;
        uint hitBackface = 0u;
        uint sampleClipmapLevel = BurtGIResolveSceneVoxelClipmap(samplePosition);
        float4 sampleCenterExtent = sampleClipmapLevel == 0u
            ? _BurtGISceneVoxelCenterExtent
            : _BurtGISceneVoxelClipmapCenterExtent[sampleClipmapLevel];
        float hitBiasWS = max(sampleCenterExtent.w / 65536.0, 0.0005);
        float3 hitPosition = samplePosition + direction * hitBiasWS;
        if (BurtGIScreenProbeTrySampleSceneVoxelClipmapHitByLevel(
                sampleClipmapLevel,
                hitPosition,
                direction,
                sampleRadius,
                sampleRadiance,
                sampleConfidence,
                sampleNormal,
                sampleOccupancy,
                normalFacingWeight,
                hitBackface))
        {
            float distanceWeight = 1.0 - stepFraction * 0.4;
            float hitConfidence = saturate(sampleConfidence * max(coarseOccupancy, sampleOccupancy) * normalFacingWeight * distanceWeight);
            float contributionWeight = hitConfidence * transparency;
            tracedRadiance += sampleRadiance * contributionWeight;
            accumulatedWeight += contributionWeight;
            transparency *= 1.0 - hitConfidence * 0.85;
            if (hitConfidence > tracedConfidence)
            {
                tracedConfidence = hitConfidence;
                tracedHitDistance = traceDistance;
            }

            if (transparency < 0.18 || tracedConfidence > 0.78)
            {
                break;
            }
        }

        traceDistance += max(voxelSizeWS, sampleRadius * lerp(0.9, 1.5, stepFraction)) * max(_BurtGISceneVoxelTraceControls.y, 0.1);
    }

    if (accumulatedWeight > 0.0001)
    {
        tracedRadiance /= accumulatedWeight;
        tracedConfidence = saturate(max(tracedConfidence, accumulatedWeight * (1.0 - transparency)));
    }

    return tracedConfidence > 0.001;
}

bool BurtGIScreenProbeTrySampleSceneVoxelConeTrace(
    float3 rayOriginWS,
    float3 rayDirectionWS,
    float maxTraceDistance,
    float minTraceDistanceBias,
    float coneHalfAngle,
    out float3 tracedRadiance,
    out float tracedConfidence,
    out float tracedHitDistance)
{
    tracedRadiance = 0.0;
    tracedConfidence = 0.0;
    tracedHitDistance = maxTraceDistance;

    float3 radianceSum = 0.0;
    float confidenceSum = 0.0;
    float weightSum = 0.0;

    [unroll]
    for (uint laneIndex = 0u; laneIndex < 3u; ++laneIndex)
    {
        float laneWeight = laneIndex == 0u ? 1.0 : 0.55;
        float3 laneDirection = BurtGIScreenProbeConeLaneDirection(rayDirectionWS, laneIndex, coneHalfAngle * 0.85);
        float3 laneRadiance = 0.0;
        float laneConfidence = 0.0;
        float laneHitDistance = maxTraceDistance;
        if (!BurtGIScreenProbeTrySampleSceneVoxelConeTraceLane(
                rayOriginWS,
                laneDirection,
                maxTraceDistance,
                minTraceDistanceBias,
                coneHalfAngle,
                laneRadiance,
                laneConfidence,
                laneHitDistance))
        {
            continue;
        }

        float distanceWeight = 1.0 - saturate(laneHitDistance / max(maxTraceDistance, 0.001)) * 0.28;
        float sampleWeight = laneWeight * laneConfidence * distanceWeight;
        radianceSum += laneRadiance * sampleWeight;
        confidenceSum += laneConfidence * sampleWeight;
        weightSum += sampleWeight;
        if (laneConfidence > tracedConfidence)
        {
            tracedHitDistance = laneHitDistance;
        }

        tracedConfidence = max(tracedConfidence, laneConfidence * laneWeight);
    }

    if (weightSum <= 0.0001)
    {
        return false;
    }

    tracedRadiance = radianceSum / weightSum;
    tracedConfidence = saturate(max(tracedConfidence, confidenceSum / weightSum));
    return tracedConfidence > 0.001;
}

float BurtGIScreenProbeEvaluateHiZScreenTraceVisibility(float3 originWS, float3 rayDirectionWS, float temporalStepOffset, float maxTraceDistanceOverride)
{
    float screenTraceStrength = saturate(_BurtGIScreenProbeScreenTraceParams.x);
    if (screenTraceStrength <= 0.0001)
    {
        return 1.0;
    }

    float2 hiZSize = max(_BurtGIScreenProbeScreenTraceParams.zw, 1.0);
    uint2 hiZSizeUInt = uint2(max(1u, (uint)hiZSize.x), max(1u, (uint)hiZSize.y));
    float maxTraceDistance = maxTraceDistanceOverride > 0.0001
        ? min(max(_BurtGIScreenProbeScreenTraceParams.y, 0.01), maxTraceDistanceOverride)
        : max(_BurtGIScreenProbeScreenTraceParams.y, 0.01);
    uint maxHiZMip = _BurtGIScreenProbeTraceModeParams.x > 0.5f
        ? max(0u, min(12u, (uint)floor(log2(max(hiZSize.x, hiZSize.y)))))
        : 0u;
    float visibility = 1.0;

    uint maxScreenTraceIterations = max(1u, min(16u, (uint)max(_BurtGIScreenProbeScreenTraceParams1.z, 1.0)));
    float relativeDepthThickness = max(_BurtGIScreenProbeScreenTraceParams1.x, 0.0001);

    [loop]
    for (uint stepIndex = 0u; stepIndex < maxScreenTraceIterations; ++stepIndex)
    {
        float stepT = saturate(((float)stepIndex + 0.5 + temporalStepOffset * 0.75) / (float)maxScreenTraceIterations);
        float3 samplePositionWS = originWS + rayDirectionWS * (maxTraceDistance * stepT);
        float2 sampleUV;
        float sampleRawDepth;
        if (!BurtGIScreenProbeProjectPositionWS(samplePositionWS, sampleUV, sampleRawDepth))
        {
            continue;
        }

        float footprintPixels = max(1.0, maxTraceDistance * (0.45 + stepT * 2.25));
        uint mipLevel = min(maxHiZMip, (uint)floor(log2(footprintPixels)));
        uint2 mipSize = uint2(
            max(hiZSizeUInt.x >> mipLevel, 1u),
            max(hiZSizeUInt.y >> mipLevel, 1u));
        uint2 samplePixel = min((uint2)(sampleUV * (float2)mipSize), mipSize - 1u);
        float sceneRawDepth = _BurtHiZDepthTexture.Load(int3(samplePixel, mipLevel));
        if (BurtGIScreenProbeTraceCompactIsSkyDepth(sceneRawDepth))
        {
            continue;
        }

#if defined(UNITY_REVERSED_Z)
        float depthDelta = sceneRawDepth - sampleRawDepth;
#else
        float depthDelta = sampleRawDepth - sceneRawDepth;
#endif
        float thickness = lerp(relativeDepthThickness * 0.05, relativeDepthThickness * 1.25, saturate(stepT)) *
            (1.0 + (float)mipLevel * 0.35);
        float hit = smoothstep(thickness, thickness * 4.0, depthDelta);
        float mipConfidence = 1.0 - saturate((float)mipLevel / max((float)maxHiZMip, 1.0)) * 0.25;
        visibility = min(visibility, 1.0 - hit * mipConfidence);
    }

    return lerp(1.0, visibility, screenTraceStrength);
}

bool BurtGIScreenProbeHasValidPlacement(uint2 screenProbeCoord);

bool BurtGIScreenProbeShouldSkipScreenTraceHit(uint2 screenProbeCoord)
{
    float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(screenProbeCoord, 0));
    uint placementPayload = (uint)round(max(encodedPosition.a, 0.0f));
    return (placementPayload & BURT_GI_SCREEN_PROBE_SKIP_SCREEN_TRACE_FLAG) != 0u;
}

bool BurtGIScreenProbeShouldSkipAdaptivePlacement(float encodedPlacementPayload)
{
    uint placementPayload = (uint)round(max(encodedPlacementPayload, 0.0f));
    return (placementPayload & BURT_GI_SCREEN_PROBE_SKIP_ADAPTIVE_FLAG) != 0u;
}

bool BurtGIScreenProbeHasSphericalVisibility(float encodedPlacementPayload)
{
    uint placementPayload = (uint)round(max(encodedPlacementPayload, 0.0f));
    return (placementPayload & BURT_GI_SCREEN_PROBE_SPHERICAL_VISIBILITY_FLAG) != 0u;
}

float BurtGIScreenProbeHammersley8Y(uint index)
{
    index &= 7u;
    if (index == 1u) return 0.5;
    if (index == 2u) return 0.25;
    if (index == 3u) return 0.75;
    if (index == 4u) return 0.125;
    if (index == 5u) return 0.625;
    if (index == 6u) return 0.375;
    if (index == 7u) return 0.875;
    return 0.0;
}

uint BurtGIScreenProbeCurrentJitterIndex(float encodedJitterIndex)
{
    if (encodedJitterIndex < 0.0)
    {
        return (uint)floor(max(-encodedJitterIndex - 1.0, 0.0)) & 7u;
    }

    return (uint)floor(max(encodedJitterIndex, 0.0)) & 7u;
}

uint BurtGIScreenProbePreviousJitterIndex(float encodedJitterIndex)
{
    uint currentJitterIndex = BurtGIScreenProbeCurrentJitterIndex(encodedJitterIndex);
    return encodedJitterIndex < 0.0 ? currentJitterIndex : ((currentJitterIndex + 7u) & 7u);
}

float2 BurtGIScreenProbeTileJitterPixelsForIndex(uint jitterIndex, float spacingPixels)
{
    jitterIndex &= 7u;
    float2 hammersley = float2((float)jitterIndex * 0.125, BurtGIScreenProbeHammersley8Y(jitterIndex));
    return min(floor(hammersley * spacingPixels), spacingPixels - 1.0);
}

float2 BurtGIScreenProbeTileCoordFromScreenUV(float2 screenUV, uint jitterIndex, float spacingPixels, float2 sourceSize)
{
    float2 jitterPixels = BurtGIScreenProbeTileJitterPixelsForIndex(jitterIndex, spacingPixels);
    float2 screenPixel = screenUV * max(sourceSize, 1.0);
    return (screenPixel - (jitterPixels + 0.5)) / max(spacingPixels, 1.0);
}

float BurtGIEncodeScreenProbePlacementPayload(
    float2 inTileOffset,
    bool screenTraceSkipMaterial,
    bool adaptiveSkipMaterial,
    bool sphericalVisibilityMaterial)
{
    uint2 clampedInTileOffset = min(
        (uint2)floor(max(inTileOffset, 0.0)),
        uint2(BURT_GI_SCREEN_PROBE_IN_TILE_OFFSET_MASK, BURT_GI_SCREEN_PROBE_IN_TILE_OFFSET_MASK));
    uint placementPayload = clampedInTileOffset.x |
        (clampedInTileOffset.y << BURT_GI_SCREEN_PROBE_IN_TILE_OFFSET_BITS) |
        BURT_GI_SCREEN_PROBE_VALID_FLAG;
    placementPayload |= screenTraceSkipMaterial ? BURT_GI_SCREEN_PROBE_SKIP_SCREEN_TRACE_FLAG : 0u;
    placementPayload |= adaptiveSkipMaterial ? BURT_GI_SCREEN_PROBE_SKIP_ADAPTIVE_FLAG : 0u;
    placementPayload |= sphericalVisibilityMaterial ? BURT_GI_SCREEN_PROBE_SPHERICAL_VISIBILITY_FLAG : 0u;
    return (float)placementPayload;
}

uint2 BurtGIPlacementHiZMipSize(uint2 fullSize, uint mipLevel)
{
    uint divisor = 1u << min(mipLevel, 15u);
    return max((fullSize + divisor - 1u) / divisor, uint2(1u, 1u));
}

bool BurtGIPlacementHiZHasSurface(uint2 coord, uint mipLevel, uint2 fullSize)
{
    uint2 mipSize = BurtGIPlacementHiZMipSize(fullSize, mipLevel);
    float rawDepth = _BurtHiZDepthTexture.Load(int3(min(coord, mipSize - 1u), mipLevel));
    return !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth);
}

bool BurtGIScreenProbeLocateValidPixelViaHiZ(uint2 screenProbeCoord, uint2 tileStart, uint spacingPixels, uint2 sourceSize, out uint2 validPixel)
{
    validPixel = tileStart;
    if (_BurtGIScreenProbePlacementParams.x <= 0.5)
    {
        return false;
    }

    uint startMip = min(12u, (uint)floor(log2((float)max(spacingPixels, 1u))));
    uint2 current = min(tileStart >> startMip, BurtGIPlacementHiZMipSize(sourceSize, startMip) - 1u);
    if (!BurtGIPlacementHiZHasSurface(current, startMip, sourceSize))
    {
        return false;
    }

    uint hash = screenProbeCoord.x * 1664525u + screenProbeCoord.y * 1013904223u + 374761393u;
    hash ^= hash >> 13;
    hash *= 1274126177u;
    hash ^= hash >> 16;

    for (int childMip = (int)startMip - 1; childMip >= 0; --childMip)
    {
        uint2 childBase = current << 1u;
        uint2 mipSize = BurtGIPlacementHiZMipSize(sourceSize, (uint)childMip);
        uint childSelector = (hash + (uint)childMip) & 3u;
        bool foundChild = false;

        [unroll]
        for (uint childIndex = 0u; childIndex < 4u; ++childIndex)
        {
            uint selectedChild = (childIndex + childSelector) & 3u;
            uint2 childCoord = min(childBase + uint2(selectedChild & 1u, (selectedChild >> 1u) & 1u), mipSize - 1u);
            if (BurtGIPlacementHiZHasSurface(childCoord, (uint)childMip, sourceSize))
            {
                current = childCoord;
                foundChild = true;
                break;
            }
        }

        if (!foundChild)
        {
            break;
        }
    }

    uint2 tileEnd = min(tileStart + spacingPixels, sourceSize);
    validPixel = clamp(current, tileStart, max(tileEnd, tileStart + 1u) - 1u);
    return !BurtGIScreenProbeTraceCompactIsSkyDepth(_BurtCameraDepthTexture.Load(int3(validPixel, 0)));
}

float BurtGIScreenProbeDecodePackedShadingModel(float packedGBuffer2)
{
    float scaled = saturate(packedGBuffer2) * BURT_GI_GBUFFER_SHADING_MODEL_PACK_COUNT;
    return floor(min(scaled, BURT_GI_GBUFFER_SHADING_MODEL_PACK_COUNT - 0.0001));
}

bool BurtGIScreenProbeIsShadingModel(float shadingModelID, float expected)
{
    return abs(shadingModelID - expected) < 0.5;
}

float2 BurtGIScreenProbeDirection(uint index)
{
    float2 direction = 0.0f;
    if (index == 0u) direction = float2(1.0f, 0.0f);
    if (index == 1u) direction = float2(-1.0f, 0.0f);
    if (index == 2u) direction = float2(0.0f, 1.0f);
    if (index == 3u) direction = float2(0.0f, -1.0f);
    if (index == 4u) direction = float2(1.0f, 1.0f);
    if (index == 5u) direction = float2(-1.0f, 1.0f);
    if (index == 6u) direction = float2(1.0f, -1.0f);
    if (index == 7u) direction = float2(-1.0f, -1.0f);
    return direction * rsqrt(max(dot(direction, direction), 0.0001f));
}

float4 BurtGIScreenProbeLoadFilteredRadiance(uint2 coord, uint2 gridSize)
{
    return _BurtGIScreenProbeFilteredRadianceTexture.Load(int3(min(coord, gridSize - 1u), 0));
}

float4 BurtGIScreenProbeLoadFilteredIrradiance(uint2 coord, uint2 gridSize)
{
    return _BurtGIScreenProbeFilteredIrradianceTexture.Load(int3(min(coord, gridSize - 1u), 0));
}

float4 BurtGIScreenProbeLoadFilteredConfidence(uint2 coord, uint2 gridSize)
{
    return _BurtGIScreenProbeFilteredConfidenceTexture.Load(int3(min(coord, gridSize - 1u), 0));
}

float BurtGISampleScreenProbeTraceHitAverageForCoord(uint2 probeCoord)
{
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint2 traceAtlasSize = max((uint2)_BurtGIScreenProbeTraceParams.yz, uint2(1u, 1u));
    uint sampleResolution = min(traceResolution, 8u);
    float traceHitSum = 0.0f;
    float weightSum = 0.0f;

    [unroll(8)]
    for (uint y = 0u; y < 8u; ++y)
    {
        [unroll(8)]
        for (uint x = 0u; x < 8u; ++x)
        {
            if (x >= sampleResolution || y >= sampleResolution)
            {
                continue;
            }

            uint2 traceTexelCoord = min(uint2(x, y), traceResolution - 1u);
            uint2 traceAtlasCoord = min(probeCoord * traceResolution + traceTexelCoord, traceAtlasSize - 1u);
            traceHitSum += saturate(_BurtGIScreenProbeTraceHitTexture[traceAtlasCoord]);
            weightSum += 1.0f;
        }
    }

    return saturate(traceHitSum / max(weightSum, 0.0001f));
}

void BurtGICompositeScreenProbeTraceAtlasIntoCurrent(
    uint2 probeCoord,
    inout float4 radiance,
    inout float4 irradiance,
    inout float4 confidence)
{
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint2 traceAtlasSize = max((uint2)_BurtGIScreenProbeTraceParams.yz, uint2(1u, 1u));
    uint sampleResolution = min(traceResolution, 8u);
    float maxRayIntensity = max(_BurtGIScreenProbeTraceModeParams.z, 0.01f);
    float traceRadianceScale = max(_BurtGIScreenProbeTraceIntensityParams.x, 0.0f);
    float3 traceRadianceSum = 0.0f;
    float traceHitSum = 0.0f;
    float weightSum = 0.0f;

    [unroll(8)]
    for (uint y = 0u; y < 8u; ++y)
    {
        [unroll(8)]
        for (uint x = 0u; x < 8u; ++x)
        {
            if (x >= sampleResolution || y >= sampleResolution)
            {
                continue;
            }

            uint2 traceTexelCoord = min(uint2(x, y), traceResolution - 1u);
            uint2 traceAtlasCoord = min(probeCoord * traceResolution + traceTexelCoord, traceAtlasSize - 1u);
            float4 traceRadiance = _BurtGIScreenProbeTraceRadianceTexture[traceAtlasCoord];
            traceRadiance.rgb = max(traceRadiance.rgb * traceRadianceScale, 0.0f);
            float maxLighting = max(traceRadiance.r, max(traceRadiance.g, traceRadiance.b));
            if (maxLighting > maxRayIntensity)
            {
                traceRadiance.rgb *= maxRayIntensity / max(maxLighting, 0.0001f);
            }

            traceRadianceSum += traceRadiance.rgb;
            traceHitSum += saturate(max(traceRadiance.a, _BurtGIScreenProbeTraceHitTexture[traceAtlasCoord]));
            weightSum += 1.0f;
        }
    }

    if (weightSum <= 0.0001f)
    {
        return;
    }

    float3 traceAverageRadiance = traceRadianceSum / weightSum;
    float traceSignal = saturate(traceHitSum / weightSum);
    if (traceSignal <= 0.0001f)
    {
        return;
    }

    float currentConfidence = saturate(min(irradiance.a, confidence.r));
    float traceBlend = saturate(traceSignal * lerp(0.72f, 0.38f, currentConfidence));
    float traceIrradianceBlend = traceBlend * 0.68f;
    radiance.rgb = lerp(max(radiance.rgb, 0.0f), traceAverageRadiance, traceBlend);
    irradiance.rgb = lerp(max(irradiance.rgb, 0.0f), traceAverageRadiance, traceIrradianceBlend);
    radiance.a = saturate(max(radiance.a, traceSignal));
    irradiance.a = saturate(max(irradiance.a, traceSignal * 0.86f));
    confidence.r = saturate(max(confidence.r, traceSignal * 0.86f));
    confidence.g = saturate(max(confidence.g, traceSignal));
}

float BurtGIEncodeScreenProbeHitDistanceForFiltering(float hitDistance)
{
    float maxHitDistance = max(_BurtGIScreenProbeParams.y, 0.001f);
    return sqrt(saturate(hitDistance / maxHitDistance)) * (254.0f / 255.0f) + (1.0f / 255.0f);
}

void BurtGICompositeScreenProbeTraceAtlasForFilter(
    uint2 probeCoord,
    inout float4 radiance,
    inout float4 hitDistance)
{
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint2 traceAtlasSize = max((uint2)_BurtGIScreenProbeTraceParams.yz, uint2(1u, 1u));
    uint sampleResolution = min(traceResolution, 8u);
    float maxRayIntensity = max(_BurtGIScreenProbeTraceModeParams.z, 0.01f);
    float traceRadianceScale = max(_BurtGIScreenProbeTraceIntensityParams.x, 0.0f);
    float3 traceRadianceSum = 0.0f;
    float traceHitSum = 0.0f;
    float weightSum = 0.0f;

    [unroll(8)]
    for (uint y = 0u; y < 8u; ++y)
    {
        [unroll(8)]
        for (uint x = 0u; x < 8u; ++x)
        {
            if (x >= sampleResolution || y >= sampleResolution)
            {
                continue;
            }

            uint2 traceTexelCoord = min(uint2(x, y), traceResolution - 1u);
            uint2 traceAtlasCoord = min(probeCoord * traceResolution + traceTexelCoord, traceAtlasSize - 1u);
            float4 traceRadiance = _BurtGIScreenProbeTraceRadianceTexture[traceAtlasCoord];
            traceRadiance.rgb = max(traceRadiance.rgb * traceRadianceScale, 0.0f);
            float maxLighting = max(traceRadiance.r, max(traceRadiance.g, traceRadiance.b));
            if (maxLighting > maxRayIntensity)
            {
                traceRadiance.rgb *= maxRayIntensity / max(maxLighting, 0.0001f);
            }

            float traceHit = saturate(max(traceRadiance.a, _BurtGIScreenProbeTraceHitTexture[traceAtlasCoord]));
            traceRadianceSum += traceRadiance.rgb;
            traceHitSum += traceHit;
            weightSum += 1.0f;
        }
    }

    if (weightSum <= 0.0001f)
    {
        return;
    }

    float3 traceAverageRadiance = traceRadianceSum / weightSum;
    float traceSignal = saturate(traceHitSum / weightSum);
    if (traceSignal <= 0.0001f)
    {
        return;
    }

    float traceBlend = saturate(traceSignal * 0.72f);
    radiance.rgb = lerp(max(radiance.rgb, 0.0f), traceAverageRadiance, traceBlend);
    radiance.a = saturate(max(radiance.a, traceSignal));

    float previousHitDistance = hitDistance.g > 0.0001f
        ? hitDistance.g
        : max(_BurtGIScreenProbeParams.y, 0.001f);
    float traceHitDistance = lerp(previousHitDistance, max(_BurtGIScreenProbeParams.y, 0.001f) * (1.0f - traceSignal), traceBlend);
    hitDistance.r = BurtGIEncodeScreenProbeHitDistanceForFiltering(traceHitDistance);
    hitDistance.g = traceHitDistance;
    hitDistance.b = saturate(max(hitDistance.b, traceSignal));
    hitDistance.a = saturate(max(hitDistance.a, traceSignal));
}

[numthreads(BURT_GI_SCREEN_PROBE_COMPOSITE_TRACES_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_COMPOSITE_TRACES_THREADGROUP_SIZE, 1)]
void ScreenProbeFilterCompositeTraces(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 gridSize = max((uint2)_BurtGIScreenProbeGridParams.xy, uint2(1u, 1u));
    uint2 probeCoord = dispatchThreadId.xy;
    if (any(probeCoord >= gridSize))
    {
        return;
    }

    float rawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(probeCoord, 0));
    if (BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth))
    {
        float maxHitDistance = max(_BurtGIScreenProbeParams.y, 0.001f);
        _BurtGIScreenProbeRadianceWriteTexture[probeCoord] = 0.0f;
        _BurtGIScreenProbeIrradianceWriteTexture[probeCoord] = 0.0f;
        _BurtGIScreenProbeConfidenceWriteTexture[probeCoord] = float4(0.0f, 0.0f, 0.0f, rawDepth);
        _BurtGIScreenProbeHitDistanceWriteTexture[probeCoord] = float4(BurtGIEncodeScreenProbeHitDistanceForFiltering(maxHitDistance), maxHitDistance, 0.0f, 0.0f);
        return;
    }

    float4 radiance = _BurtGIScreenProbeRadianceTexture.Load(int3(probeCoord, 0));
    float4 irradiance = _BurtGIScreenProbeIrradianceTexture.Load(int3(probeCoord, 0));
    float4 confidence = _BurtGIScreenProbeConfidenceTexture.Load(int3(probeCoord, 0));
    float maxProbeHitDistance = max(_BurtGIScreenProbeParams.y, 0.001f);
    float4 hitDistance = float4(BurtGIEncodeScreenProbeHitDistanceForFiltering(maxProbeHitDistance), maxProbeHitDistance, 0.0f, 0.0f);
    BurtGICompositeScreenProbeTraceAtlasIntoCurrent(probeCoord, radiance, irradiance, confidence);
    float4 hitDistanceRadiance = radiance;
    BurtGICompositeScreenProbeTraceAtlasForFilter(probeCoord, hitDistanceRadiance, hitDistance);
    _BurtGIScreenProbeRadianceWriteTexture[probeCoord] = radiance;
    _BurtGIScreenProbeIrradianceWriteTexture[probeCoord] = irradiance;
    _BurtGIScreenProbeConfidenceWriteTexture[probeCoord] = confidence;
    _BurtGIScreenProbeHitDistanceWriteTexture[probeCoord] = hitDistance;
}

float BurtGISampleScreenProbeUseCountHistoryWeight(float2 historyUV)
{
    if (_BurtGIScreenProbeUseCountParams.w <= 0.5f)
    {
        return 1.0f;
    }

    uint2 useCountSize = max((uint2)_BurtGIScreenProbeUseCountParams.xy, uint2(1u, 1u));
    float2 samplePixel = saturate(historyUV) * (float2)useCountSize - 0.5f;
    int2 topLeft = (int2)floor(samplePixel);
    float2 fraction = samplePixel - floor(samplePixel);
    float weights[4] =
    {
        (1.0f - fraction.x) * (1.0f - fraction.y),
        fraction.x * (1.0f - fraction.y),
        (1.0f - fraction.x) * fraction.y,
        fraction.x * fraction.y,
    };
    int2 offsets[4] =
    {
        int2(0, 0),
        int2(1, 0),
        int2(0, 1),
        int2(1, 1),
    };

    float useCount = 0.0f;
    [unroll]
    for (uint i = 0u; i < 4u; ++i)
    {
        int2 tap = clamp(topLeft + offsets[i], int2(0, 0), (int2)useCountSize - 1);
        useCount += weights[i] * (float)_BurtGIScreenProbeUseCountTexture[tap];
    }

    useCount *= BURT_GI_SCREEN_PROBE_USE_COUNT_INV_QUANTIZATION;
    return saturate(1.0f - abs(useCount - 1.0f));
}

bool BurtGIResolveScreenProbeHistoryUV(uint2 probeCoord, uint2 gridSize, float3 positionWS, out float2 historyUV, out float projectedRawDepth)
{
    if (!BurtGIScreenProbeProjectPreviousPositionWS(positionWS, historyUV, projectedRawDepth))
    {
        return false;
    }

    uint2 velocitySize = max((uint2)_BurtGIScreenProbeUseCountParams.xy, uint2(1u, 1u));
    uint2 velocityCoord = min((uint2)floor(saturate((float2(probeCoord) + 0.5f) / (float2)gridSize) * (float2)velocitySize), velocitySize - 1u);
    float4 sceneVelocity = _BurtGIScreenProbeSceneVelocityTexture.Load(int3(velocityCoord, 0));
    if (sceneVelocity.w > 0.5f)
    {
        float2 velocityHistoryUV = saturate((float2(probeCoord) + 0.5f) / (float2)gridSize) - sceneVelocity.xy;
        if (any(velocityHistoryUV < 0.0f) || any(velocityHistoryUV > 1.0f))
        {
            return false;
        }

        historyUV = velocityHistoryUV;
    }

    return true;
}

void BurtGIApplyScreenProbeTemporal(
    uint2 probeCoord,
    uint2 gridSize,
    inout float4 radiance,
    inout float4 irradiance,
    inout float4 confidence,
    out float numFramesAccumulatedNormalized)
{
    numFramesAccumulatedNormalized = 0.0f;
    float rawDepth = confidence.a;
    if (_BurtGIScreenProbeTemporalParams.y < 0.5f ||
        _BurtGIScreenProbeTemporalParams.w < 0.5f ||
        BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth) ||
        confidence.r <= 0.0001f)
    {
        return;
    }

    float4 positionData = _BurtGIScreenProbeWorldPositionTexture.Load(int3(probeCoord, 0));
    float4 normalData = _BurtGIScreenProbeWorldNormalTexture.Load(int3(probeCoord, 0));
    if (positionData.a <= 0.5f || normalData.a <= 0.5f)
    {
        return;
    }

    float3 positionWS = positionData.xyz;
    float3 normalWS = BurtGIScreenProbeDecodeNormalWS(normalData);
    float2 historyUV;
    float projectedRawDepth;
    if (!BurtGIResolveScreenProbeHistoryUV(probeCoord, gridSize, positionWS, historyUV, projectedRawDepth))
    {
        return;
    }

    float2 historyProbeCoordFloat = saturate(historyUV) * (float2)gridSize - 0.5f;
    int2 historyBaseCoord = (int2)floor(historyProbeCoordFloat);
    int2 maxHistoryCoord = int2((int)gridSize.x - 1, (int)gridSize.y - 1);
    float4 scenePlane = float4(normalWS, dot(positionWS, normalWS));
    float currentTraceHit = BurtGISampleScreenProbeTraceHitAverageForCoord(probeCoord);
    uint2 centerHistoryCoord = (uint2)clamp((int2)round(historyProbeCoordFloat), int2(0, 0), maxHistoryCoord);
    float historyTraceHit = 0.0f;
    uint historyTraceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));

    [unroll]
    for (uint historyHitY = 0u; historyHitY < 2u; ++historyHitY)
    {
        [unroll]
        for (uint historyHitX = 0u; historyHitX < 2u; ++historyHitX)
        {
            uint2 hitTexel = min(uint2(historyHitX, historyHitY), historyTraceResolution - 1u);
            uint2 historyTraceCoord = centerHistoryCoord * historyTraceResolution + hitTexel;
            historyTraceHit += saturate(_BurtGIScreenProbeHistoryTraceHitTexture.Load(int3(historyTraceCoord, 0)));
        }
    }

    historyTraceHit *= 0.25f;
    float traceHitValidity = lerp(0.55f, 1.0f, saturate(1.0f - abs(currentTraceHit - historyTraceHit) * 1.35f));
    float projectedLinearDepth = max(BurtGILinearEyeDepth(projectedRawDepth), 0.0001f);
    float currentLinearDepth = max(BurtGILinearEyeDepth(rawDepth), 0.0001f);
    float depthRejectScale = max(_BurtGIScreenProbeReprojectionParams.x * _BurtGIScreenProbeReprojectionParams.y, 0.0001f);
    float historyNormalCosThreshold = clamp(_BurtGIScreenProbeReprojectionParams.w, -1.0f, 1.0f);
    float historyExposureCorrection = max(_BurtGIScreenProbeHistoryParams.x, 0.0f);
    float4 totalHistoryRadiance = 0.0f;
    float4 totalHistoryIrradiance = 0.0f;
    float3 totalHistoryConfidence = 0.0f;
    float totalHistoryWeight = 0.0f;

    [unroll]
    for (int y = 0; y < 2; ++y)
    {
        [unroll]
        for (int x = 0; x < 2; ++x)
        {
            uint2 historyCoord = (uint2)clamp(historyBaseCoord + int2(x, y), int2(0, 0), maxHistoryCoord);
            float4 neighborConfidence = _BurtGIScreenProbeHistoryConfidenceTexture.Load(int3(historyCoord, 0));
            if (neighborConfidence.r <= 0.0001f)
            {
                continue;
            }

            float4 neighborWorldPosition = _BurtGIScreenProbeHistoryWorldPositionTexture.Load(int3(historyCoord, 0));
            float neighborRawDepth = _BurtGIScreenProbeHistoryScreenDepthTexture.Load(int3(historyCoord, 0));
            if (neighborWorldPosition.a <= 0.0001f || BurtGIScreenProbeTraceCompactIsSkyDepth(neighborRawDepth))
            {
                continue;
            }

            float planeDistance = abs(dot(float4(neighborWorldPosition.xyz, -1.0f), scenePlane));
            float relativeDepthDifference = planeDistance / currentLinearDepth;
            float planeWeight = exp2(-10000.0f * relativeDepthDifference * relativeDepthDifference) > 0.1f ? 1.0f : 0.0f;
            float neighborLinearDepth = BurtGILinearEyeDepth(neighborRawDepth);
            float neighborDepthValidity = saturate(1.0f - depthRejectScale * abs(neighborLinearDepth - projectedLinearDepth) / projectedLinearDepth);
            float4 neighborNormalData = _BurtGIScreenProbeHistoryWorldNormalTexture.Load(int3(historyCoord, 0));
            float3 neighborNormalWS = BurtGIScreenProbeDecodeNormalWS(neighborNormalData);
            float normalWeight = neighborNormalData.a > 0.5f && dot(normalWS, neighborNormalWS) >= historyNormalCosThreshold ? 1.0f : 0.0f;
            float neighborWeight = planeWeight * neighborDepthValidity * normalWeight * saturate(neighborConfidence.r * 2.0f);
            float4 neighborRadiance = _BurtGIScreenProbeHistoryRadianceTexture.Load(int3(historyCoord, 0));
            float4 neighborIrradiance = _BurtGIScreenProbeHistoryIrradianceTexture.Load(int3(historyCoord, 0));
            neighborRadiance.rgb = max(neighborRadiance.rgb * historyExposureCorrection, 0.0f);
            neighborIrradiance.rgb = max(neighborIrradiance.rgb * historyExposureCorrection, 0.0f);
            totalHistoryRadiance += neighborRadiance * neighborWeight;
            totalHistoryIrradiance += neighborIrradiance * neighborWeight;
            totalHistoryConfidence += neighborConfidence.rgb * neighborWeight;
            totalHistoryWeight += neighborWeight;
        }
    }

    if (totalHistoryWeight <= 0.0001f)
    {
        return;
    }

    float invHistoryWeight = rcp(totalHistoryWeight);
    float4 historyRadiance = totalHistoryRadiance * invHistoryWeight;
    float4 historyIrradiance = totalHistoryIrradiance * invHistoryWeight;
    float3 historyConfidence = totalHistoryConfidence * invHistoryWeight;
    float confidenceValidity = saturate(min(historyConfidence.r, confidence.r) * 2.0f);
    float historyVisibility = confidenceValidity * traceHitValidity * saturate(totalHistoryWeight);
    historyVisibility = min(historyVisibility, BurtGISampleScreenProbeUseCountHistoryWeight(historyUV));
    float maxFramesAccumulated = max(_BurtGIScreenProbeReprojectionParams.z, 1.0f);
    float previousNumFramesAccumulated = _BurtGIScreenProbeHistoryNumFramesAccumulatedTexture.Load(int3(centerHistoryCoord, 0)) * maxFramesAccumulated;
    float maxFramesFromVisibility = min(maxFramesAccumulated, historyVisibility / max(1.0f - historyVisibility, 0.0001f));
    float newNumFramesAccumulated = min(min(previousNumFramesAccumulated + 1.0f, maxFramesAccumulated), maxFramesFromVisibility);
    float historyWeight = min(newNumFramesAccumulated / (1.0f + newNumFramesAccumulated), saturate(_BurtGIScreenProbeTemporalParams.x));

    numFramesAccumulatedNormalized = saturate(newNumFramesAccumulated / maxFramesAccumulated);
    radiance = lerp(radiance, historyRadiance, historyWeight);
    irradiance = lerp(irradiance, historyIrradiance, historyWeight);
    confidence.rgb = lerp(confidence.rgb, historyConfidence, historyWeight);
    confidence.a = rawDepth;
}

[numthreads(BURT_GI_SCREEN_PROBE_TEMPORAL_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_TEMPORAL_THREADGROUP_SIZE, 1)]
void ScreenProbeFilterTemporalCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 gridSize = max((uint2)_BurtGIScreenProbeGridParams.xy, uint2(1u, 1u));
    uint2 probeCoord = dispatchThreadId.xy;
    if (any(probeCoord >= gridSize))
    {
        return;
    }

    float4 radiance = _BurtGIScreenProbeRadianceTexture.Load(int3(probeCoord, 0));
    float4 irradiance = _BurtGIScreenProbeIrradianceTexture.Load(int3(probeCoord, 0));
    float4 confidence = _BurtGIScreenProbeConfidenceTexture.Load(int3(probeCoord, 0));
    float numFramesAccumulated = 0.0f;
    BurtGIApplyScreenProbeTemporal(probeCoord, gridSize, radiance, irradiance, confidence, numFramesAccumulated);

    _BurtGIScreenProbeTemporalRadianceWriteTexture[probeCoord] = radiance;
    _BurtGIScreenProbeTemporalIrradianceWriteTexture[probeCoord] = irradiance;
    _BurtGIScreenProbeTemporalConfidenceWriteTexture[probeCoord] = confidence;
    _BurtGIScreenProbeNumFramesAccumulatedWriteTexture[probeCoord] = numFramesAccumulated;
}

[numthreads(BURT_GI_SCREEN_PROBE_TEMPORAL_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_TEMPORAL_THREADGROUP_SIZE, 1)]
void ScreenProbeReprojectionCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 gridSize = max((uint2)_BurtGIScreenProbeGridParams.xy, uint2(1u, 1u));
    uint2 probeCoord = dispatchThreadId.xy;
    if (any(probeCoord >= gridSize))
    {
        return;
    }

    float4 radiance = _BurtGIScreenProbeRadianceTexture.Load(int3(probeCoord, 0));
    float4 irradiance = _BurtGIScreenProbeIrradianceTexture.Load(int3(probeCoord, 0));
    float4 confidence = _BurtGIScreenProbeConfidenceTexture.Load(int3(probeCoord, 0));
    float numFramesAccumulated = 0.0f;
    BurtGIApplyScreenProbeTemporal(probeCoord, gridSize, radiance, irradiance, confidence, numFramesAccumulated);

    _BurtGIScreenProbeTemporalRadianceWriteTexture[probeCoord] = radiance;
    _BurtGIScreenProbeTemporalIrradianceWriteTexture[probeCoord] = irradiance;
    _BurtGIScreenProbeTemporalConfidenceWriteTexture[probeCoord] = confidence;
    _BurtGIScreenProbeNumFramesAccumulatedWriteTexture[probeCoord] = numFramesAccumulated;
}

float BurtGIDecodeScreenProbeHitDistanceForFiltering(float encodedHitDistance, float hitValid)
{
    if (hitValid <= 0.0001f || encodedHitDistance <= (1.0f / 255.0f))
    {
        return -1.0f;
    }

    float normalizedDistance = saturate((encodedHitDistance - (1.0f / 255.0f)) * (255.0f / 254.0f));
    return normalizedDistance * normalizedDistance * max(_BurtGIScreenProbeParams.y, 0.001f);
}

void BurtGIComputeScreenProbeSpatialFilter(
    uint2 probeCoord,
    uint2 gridSize,
    out float4 probeRadiance,
    out float4 probeIrradiance,
    out float4 probeConfidence)
{
    probeRadiance = _BurtGIScreenProbeTemporalRadianceTexture.Load(int3(probeCoord, 0));
    probeIrradiance = _BurtGIScreenProbeTemporalIrradianceTexture.Load(int3(probeCoord, 0));
    probeConfidence = _BurtGIScreenProbeTemporalConfidenceTexture.Load(int3(probeCoord, 0));
    float4 probeHitDistance = _BurtGIScreenProbeHitDistanceTexture.Load(int3(probeCoord, 0));
    float spatialPasses = _BurtGIScreenProbeFilterParams.x;
    if (spatialPasses <= 0.0001f)
    {
        return;
    }

    float centerTraceHit = BurtGISampleScreenProbeTraceHitAverageForCoord(probeCoord);
    float centerRawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(probeCoord, 0));
    float centerSceneDepth = BurtGILinearEyeDepth(centerRawDepth);
    float4 centerWorldPositionData = _BurtGIScreenProbeWorldPositionTexture.Load(int3(probeCoord, 0));
    float3 centerWorldPosition = centerWorldPositionData.xyz;
    float3 centerNormalWS = BurtGIScreenProbeDecodeNormalWS(_BurtGIScreenProbeWorldNormalTexture.Load(int3(probeCoord, 0)));
    float centerHitDistance = BurtGIDecodeScreenProbeHitDistanceForFiltering(probeHitDistance.r, probeHitDistance.z);
    uint halfKernel = max(1u, (uint)round(max(_BurtGIScreenProbeFilterParams.y, 1.0f)));
    float4 radianceSum = probeRadiance;
    float4 irradianceSum = probeIrradiance;
    float4 confidenceSum = probeConfidence;
    float weightSum = 1.0f;

    [unroll(4)]
    for (uint i = 0u; i < 4u; ++i)
    {
        int2 neighborOffset = (int2)round(BurtGIScreenProbeDirection(i) * (float)halfKernel);
        int2 neighborCoordSigned = (int2)probeCoord + neighborOffset;
        if (any(neighborCoordSigned < int2(0, 0)) || any(neighborCoordSigned >= (int2)gridSize))
        {
            continue;
        }

        uint2 neighborCoord = (uint2)neighborCoordSigned;
        float4 neighborRadiance = _BurtGIScreenProbeTemporalRadianceTexture.Load(int3(neighborCoord, 0));
        float4 neighborIrradiance = _BurtGIScreenProbeTemporalIrradianceTexture.Load(int3(neighborCoord, 0));
        float4 neighborConfidence = _BurtGIScreenProbeTemporalConfidenceTexture.Load(int3(neighborCoord, 0));
        float4 neighborHitDistance = _BurtGIScreenProbeHitDistanceTexture.Load(int3(neighborCoord, 0));
        float neighborRawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(neighborCoord, 0));
        float neighborSceneDepth = BurtGILinearEyeDepth(neighborRawDepth);
        float relativeDepthDifference = abs(neighborSceneDepth - centerSceneDepth) / max(centerSceneDepth, 0.0001f);
        float positionWeight = (!BurtGIScreenProbeTraceCompactIsSkyDepth(neighborRawDepth) && centerWorldPositionData.a > 0.5f)
            ? exp2(-max(_BurtGIScreenProbeSpatialFilterParams.y, 0.001f) * relativeDepthDifference * relativeDepthDifference)
            : 0.0f;
        float neighborHitDistanceForFiltering = BurtGIDecodeScreenProbeHitDistanceForFiltering(neighborHitDistance.r, neighborHitDistance.z);
        float angleWeight = 1.0f;
        if (positionWeight > 0.0f && neighborHitDistanceForFiltering >= 0.0f)
        {
            if (centerHitDistance >= 0.0f)
            {
                neighborHitDistanceForFiltering = min(neighborHitDistanceForFiltering, centerHitDistance);
            }

            float3 neighborWorldPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(neighborCoord, 0)).xyz;
            float3 neighborHitPosition = neighborWorldPosition + centerNormalWS * neighborHitDistanceForFiltering;
            float3 toNeighborHit = neighborHitPosition - centerWorldPosition;
            float toNeighborHitLength = length(toNeighborHit);
            float neighborAngle = toNeighborHitLength > 0.0001f
                ? acos(saturate(dot(toNeighborHit / toNeighborHitLength, centerNormalWS)))
                : 0.0f;
            angleWeight = 1.0f - saturate(neighborAngle / max(_BurtGIScreenProbeSpatialFilterParams.x, 0.001f));
        }

        float neighborTraceHit = BurtGISampleScreenProbeTraceHitAverageForCoord(neighborCoord);
        float traceHitWeight = lerp(
            1.0f,
            1.0f - smoothstep(0.18f, 0.65f, abs(neighborTraceHit - centerTraceHit)),
            saturate(max(centerTraceHit, neighborTraceHit)));
        float filterWeight = positionWeight * angleWeight * traceHitWeight;
        radianceSum += neighborRadiance * filterWeight;
        irradianceSum += neighborIrradiance * filterWeight;
        confidenceSum += neighborConfidence * filterWeight;
        weightSum += filterWeight;
    }

    probeRadiance = radianceSum / max(weightSum, 0.0001f);
    probeIrradiance = irradianceSum / max(weightSum, 0.0001f);
    probeConfidence = confidenceSum / max(weightSum, 0.0001f);
    probeRadiance.rgb = max(probeRadiance.rgb, 0.0f);
    probeRadiance.a = saturate(probeRadiance.a);
    probeIrradiance.rgb = max(probeIrradiance.rgb, 0.0f);
    probeIrradiance.a = saturate(probeIrradiance.a);
    probeConfidence.rgb = saturate(probeConfidence.rgb);
}

[numthreads(BURT_GI_SCREEN_PROBE_SPATIAL_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_SPATIAL_THREADGROUP_SIZE, 1)]
void ScreenProbeFilterSpatialCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 gridSize = max((uint2)_BurtGIScreenProbeGridParams.xy, uint2(1u, 1u));
    uint2 probeCoord = dispatchThreadId.xy;
    if (any(probeCoord >= gridSize))
    {
        return;
    }

    float4 radiance;
    float4 irradiance;
    float4 confidence;
    BurtGIComputeScreenProbeSpatialFilter(probeCoord, gridSize, radiance, irradiance, confidence);
    _BurtGIScreenProbeFilteredRadianceWriteTexture[probeCoord] = radiance;
    _BurtGIScreenProbeFilteredIrradianceWriteTexture[probeCoord] = irradiance;
    _BurtGIScreenProbeFilteredConfidenceWriteTexture[probeCoord] = confidence;
}

void BurtGIComputeScreenProbeFixup(
    uint2 probeCoord,
    uint2 gridSize,
    out float4 probeRadiance,
    out float4 probeIrradiance,
    out float4 probeConfidence)
{
    probeRadiance = BurtGIScreenProbeLoadFilteredRadiance(probeCoord, gridSize);
    probeIrradiance = BurtGIScreenProbeLoadFilteredIrradiance(probeCoord, gridSize);
    probeConfidence = BurtGIScreenProbeLoadFilteredConfidence(probeCoord, gridSize);
    if (_BurtGIScreenProbeFilterParams.z <= 0.5f)
    {
        return;
    }

    float centerConfidence = saturate(min(probeIrradiance.a, probeConfidence.r));
    float centerEdge = saturate(probeConfidence.b);
    float4 centerHitDistance = _BurtGIScreenProbeHitDistanceTexture.Load(int3(min(probeCoord, gridSize - 1u), 0));
    float centerTraceHit = BurtGISampleScreenProbeTraceHitAverageForCoord(probeCoord);
    float fixupNeed = saturate((0.62f - centerConfidence) * 2.0f + centerEdge * 0.22f);
    if (fixupNeed <= 0.0001f)
    {
        return;
    }

    float centerWeight = lerp(2.0f, 4.0f, centerConfidence);
    float4 radianceSum = probeRadiance * centerWeight;
    float4 irradianceSum = probeIrradiance * centerWeight;
    float4 confidenceSum = probeConfidence * centerWeight;
    float weightSum = centerWeight;

    [unroll(8)]
    for (uint i = 0u; i < 8u; ++i)
    {
        int2 neighborOffset = (int2)round(BurtGIScreenProbeDirection(i));
        int2 neighborCoordSigned = (int2)probeCoord + neighborOffset;
        if (any(neighborCoordSigned < int2(0, 0)) || any(neighborCoordSigned >= (int2)gridSize))
        {
            continue;
        }

        uint2 neighborCoord = (uint2)neighborCoordSigned;
        float4 neighborRadiance = BurtGIScreenProbeLoadFilteredRadiance(neighborCoord, gridSize);
        float4 neighborIrradiance = BurtGIScreenProbeLoadFilteredIrradiance(neighborCoord, gridSize);
        float4 neighborConfidence = BurtGIScreenProbeLoadFilteredConfidence(neighborCoord, gridSize);
        float4 neighborHitDistance = _BurtGIScreenProbeHitDistanceTexture.Load(int3(neighborCoord, 0));
        float neighborConfidenceScalar = saturate(min(neighborIrradiance.a, neighborConfidence.r));
        float confidenceGain = saturate((neighborConfidenceScalar - centerConfidence) * 2.5f + neighborConfidenceScalar);
        float edgeDelta = abs(neighborConfidence.b - centerEdge);
        float edgeWeight = 1.0f - smoothstep(0.35f, 0.95f, edgeDelta);
        float hitDistanceDelta = abs(neighborHitDistance.r - centerHitDistance.r);
        float hitDistanceWeight = 1.0f - smoothstep(0.08f, 0.48f, hitDistanceDelta);
        float neighborTraceHit = BurtGISampleScreenProbeTraceHitAverageForCoord(neighborCoord);
        float traceHitWeight = lerp(
            1.0f,
            1.0f - smoothstep(0.18f, 0.68f, abs(neighborTraceHit - centerTraceHit)),
            saturate(max(centerTraceHit, neighborTraceHit)));
        float traceConfidenceGain = lerp(0.76f, 1.12f, saturate(neighborTraceHit));
        float ringWeight = i < 4u ? 1.0f : 0.7f;
        float filterWeight = ringWeight * confidenceGain * traceConfidenceGain * traceHitWeight * lerp(edgeWeight * hitDistanceWeight, hitDistanceWeight, fixupNeed * 0.35f);
        radianceSum += neighborRadiance * filterWeight;
        irradianceSum += neighborIrradiance * filterWeight;
        confidenceSum += neighborConfidence * filterWeight;
        weightSum += filterWeight;
    }

    float4 fixedRadiance = radianceSum / max(weightSum, 0.0001f);
    float4 fixedIrradiance = irradianceSum / max(weightSum, 0.0001f);
    float4 fixedConfidence = confidenceSum / max(weightSum, 0.0001f);
    float fixupApply = fixupNeed * saturate((weightSum - centerWeight) * 0.35f);
    probeRadiance = lerp(probeRadiance, fixedRadiance, fixupApply);
    probeIrradiance = lerp(probeIrradiance, fixedIrradiance, fixupApply);
    probeConfidence.rgb = saturate(lerp(probeConfidence.rgb, fixedConfidence.rgb, fixupApply));
    probeConfidence.a = fixedConfidence.a;
    probeRadiance.rgb = max(probeRadiance.rgb, 0.0f);
    probeRadiance.a = saturate(probeRadiance.a);
    probeIrradiance.rgb = max(probeIrradiance.rgb, 0.0f);
    probeIrradiance.a = saturate(probeIrradiance.a);
}

[numthreads(BURT_GI_SCREEN_PROBE_FIXUP_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_FIXUP_THREADGROUP_SIZE, 1)]
void ScreenProbeFilterFixupBordersCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 gridSize = max((uint2)_BurtGIScreenProbeGridParams.xy, uint2(1u, 1u));
    uint2 probeCoord = dispatchThreadId.xy;
    if (any(probeCoord >= gridSize))
    {
        return;
    }

    float4 radiance;
    float4 irradiance;
    float4 confidence;
    BurtGIComputeScreenProbeFixup(probeCoord, gridSize, radiance, irradiance, confidence);
    _BurtGIScreenProbeFixupRadianceWriteTexture[probeCoord] = radiance;
    _BurtGIScreenProbeFixupIrradianceWriteTexture[probeCoord] = irradiance;
    _BurtGIScreenProbeFixupConfidenceWriteTexture[probeCoord] = confidence;
}

struct BurtGIScreenProbeMipOutput
{
    float4 Radiance;
    float4 Irradiance;
    float4 Confidence;
};

float BurtGIScreenProbeMipLuminance(float3 value)
{
    return dot(value, float3(0.2126, 0.7152, 0.0722));
}

float BurtGIScreenProbeMipSampleWeight(float4 radiance, float4 irradiance, float4 confidence)
{
    float signalConfidence = saturate(max(confidence.r, max(radiance.a, irradiance.a)));
    float hitConfidence = saturate(max(confidence.g, signalConfidence));
    float edgePenalty = saturate(confidence.b);
    return max(0.035f, signalConfidence * lerp(1.0f, 0.55f, edgePenalty) * lerp(0.72f, 1.0f, hitConfidence));
}

float4 BurtGIScreenProbeMipLoadRadiance(uint2 coord, uint2 size)
{
    return _BurtGIScreenProbeFixupRadianceTexture.Load(int3(min(coord, size - 1u), 0));
}

float4 BurtGIScreenProbeMipLoadIrradiance(uint2 coord, uint2 size)
{
    return _BurtGIScreenProbeFixupIrradianceTexture.Load(int3(min(coord, size - 1u), 0));
}

float4 BurtGIScreenProbeMipLoadConfidence(uint2 coord, uint2 size)
{
    return _BurtGIScreenProbeFixupConfidenceTexture.Load(int3(min(coord, size - 1u), 0));
}

BurtGIScreenProbeMipOutput BurtGIComputeScreenProbeMip(uint2 childCoord, uint2 parentSize)
{
    uint2 parentBasePixel = childCoord * 2u;
    uint2 parentPixel00 = min(parentBasePixel, parentSize - 1u);
    uint2 parentPixel10 = min(parentBasePixel + uint2(1u, 0u), parentSize - 1u);
    uint2 parentPixel01 = min(parentBasePixel + uint2(0u, 1u), parentSize - 1u);
    uint2 parentPixel11 = min(parentBasePixel + uint2(1u, 1u), parentSize - 1u);

    float4 radiance00 = BurtGIScreenProbeMipLoadRadiance(parentPixel00, parentSize);
    float4 radiance10 = BurtGIScreenProbeMipLoadRadiance(parentPixel10, parentSize);
    float4 radiance01 = BurtGIScreenProbeMipLoadRadiance(parentPixel01, parentSize);
    float4 radiance11 = BurtGIScreenProbeMipLoadRadiance(parentPixel11, parentSize);
    float4 irradiance00 = BurtGIScreenProbeMipLoadIrradiance(parentPixel00, parentSize);
    float4 irradiance10 = BurtGIScreenProbeMipLoadIrradiance(parentPixel10, parentSize);
    float4 irradiance01 = BurtGIScreenProbeMipLoadIrradiance(parentPixel01, parentSize);
    float4 irradiance11 = BurtGIScreenProbeMipLoadIrradiance(parentPixel11, parentSize);
    float4 confidence00 = BurtGIScreenProbeMipLoadConfidence(parentPixel00, parentSize);
    float4 confidence10 = BurtGIScreenProbeMipLoadConfidence(parentPixel10, parentSize);
    float4 confidence01 = BurtGIScreenProbeMipLoadConfidence(parentPixel01, parentSize);
    float4 confidence11 = BurtGIScreenProbeMipLoadConfidence(parentPixel11, parentSize);

    float4 radianceBox = (radiance00 + radiance10 + radiance01 + radiance11) * 0.25f;
    float4 irradianceBox = (irradiance00 + irradiance10 + irradiance01 + irradiance11) * 0.25f;
    float4 confidenceBox = (confidence00 + confidence10 + confidence01 + confidence11) * 0.25f;

    float weight00 = BurtGIScreenProbeMipSampleWeight(radiance00, irradiance00, confidence00);
    float weight10 = BurtGIScreenProbeMipSampleWeight(radiance10, irradiance10, confidence10);
    float weight01 = BurtGIScreenProbeMipSampleWeight(radiance01, irradiance01, confidence01);
    float weight11 = BurtGIScreenProbeMipSampleWeight(radiance11, irradiance11, confidence11);
    float weightSum = weight00 + weight10 + weight01 + weight11;

    BurtGIScreenProbeMipOutput output;
    output.Radiance = radianceBox;
    output.Irradiance = irradianceBox;
    output.Confidence = confidenceBox;
    if (weightSum > 0.0001f)
    {
        float invWeightSum = rcp(weightSum);
        float3 weightedRadiance =
            (radiance00.rgb * weight00 +
                radiance10.rgb * weight10 +
                radiance01.rgb * weight01 +
                radiance11.rgb * weight11) * invWeightSum;
        float3 weightedIrradiance =
            (irradiance00.rgb * weight00 +
                irradiance10.rgb * weight10 +
                irradiance01.rgb * weight01 +
                irradiance11.rgb * weight11) * invWeightSum;
        float weightedConfidence =
            (saturate(min(irradiance00.a, confidence00.r)) * weight00 +
                saturate(min(irradiance10.a, confidence10.r)) * weight10 +
                saturate(min(irradiance01.a, confidence01.r)) * weight01 +
                saturate(min(irradiance11.a, confidence11.r)) * weight11) * invWeightSum;
        float weightedHit =
            (saturate(confidence00.g) * weight00 +
                saturate(confidence10.g) * weight10 +
                saturate(confidence01.g) * weight01 +
                saturate(confidence11.g) * weight11) * invWeightSum;
        float weightedEdge =
            (saturate(confidence00.b) * weight00 +
                saturate(confidence10.b) * weight10 +
                saturate(confidence01.b) * weight01 +
                saturate(confidence11.b) * weight11) * invWeightSum;

        float radianceMean = BurtGIScreenProbeMipLuminance(weightedRadiance);
        float irradianceMean = BurtGIScreenProbeMipLuminance(weightedIrradiance);
        float radianceVariance =
            abs(BurtGIScreenProbeMipLuminance(radiance00.rgb) - radianceMean) * weight00 +
            abs(BurtGIScreenProbeMipLuminance(radiance10.rgb) - radianceMean) * weight10 +
            abs(BurtGIScreenProbeMipLuminance(radiance01.rgb) - radianceMean) * weight01 +
            abs(BurtGIScreenProbeMipLuminance(radiance11.rgb) - radianceMean) * weight11;
        float irradianceVariance =
            abs(BurtGIScreenProbeMipLuminance(irradiance00.rgb) - irradianceMean) * weight00 +
            abs(BurtGIScreenProbeMipLuminance(irradiance10.rgb) - irradianceMean) * weight10 +
            abs(BurtGIScreenProbeMipLuminance(irradiance01.rgb) - irradianceMean) * weight01 +
            abs(BurtGIScreenProbeMipLuminance(irradiance11.rgb) - irradianceMean) * weight11;
        float varianceScale = max(max(radianceMean, irradianceMean), 0.035f) * weightSum;
        float lowFrequencyStability = saturate(1.0f - (radianceVariance + irradianceVariance) / max(varianceScale * 3.0f, 0.0001f));
        float boxBlend = saturate((0.42f - weightedConfidence) * 1.5f + weightedEdge * 0.18f);

        output.Radiance.rgb = lerp(weightedRadiance, max(radianceBox.rgb, 0.0f), boxBlend * 0.35f);
        output.Irradiance.rgb = lerp(weightedIrradiance, max(irradianceBox.rgb, 0.0f), boxBlend * 0.35f);
        output.Radiance.a = saturate(max(radianceBox.a, weightedConfidence * lowFrequencyStability));
        output.Irradiance.a = saturate(max(irradianceBox.a, weightedConfidence * lowFrequencyStability));
        output.Confidence.r = saturate(max(confidenceBox.r, weightedConfidence * lerp(0.72f, 1.0f, lowFrequencyStability)));
        output.Confidence.g = saturate(max(confidenceBox.g, weightedHit));
        output.Confidence.b = saturate(lerp(weightedEdge, confidenceBox.b, 0.35f));
    }

    output.Radiance.rgb = max(output.Radiance.rgb, 0.0f);
    output.Radiance.a = saturate(output.Radiance.a);
    output.Irradiance.rgb = max(output.Irradiance.rgb, 0.0f);
    output.Irradiance.a = saturate(output.Irradiance.a);
    output.Confidence.rgb = saturate(output.Confidence.rgb);
    return output;
}

[numthreads(BURT_GI_SCREEN_PROBE_FILTER_MIP_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_FILTER_MIP_THREADGROUP_SIZE, 1)]
void ScreenProbeFilterGenerateMipCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 childSize = max((uint2)_BurtGIScreenProbeFilterGenerateMipParams.xy, uint2(1u, 1u));
    uint2 childCoord = dispatchThreadId.xy;
    if (any(childCoord >= childSize))
    {
        return;
    }

    uint2 parentSize = max((uint2)_BurtGIScreenProbeGridParams.xy, uint2(1u, 1u));
    BurtGIScreenProbeMipOutput output = BurtGIComputeScreenProbeMip(childCoord, parentSize);
    _BurtGIScreenProbeMipRadianceWriteTexture[childCoord] = output.Radiance;
    _BurtGIScreenProbeMipIrradianceWriteTexture[childCoord] = output.Irradiance;
    _BurtGIScreenProbeMipConfidenceWriteTexture[childCoord] = output.Confidence;
}

[numthreads(BURT_GI_SCREEN_PROBE_PLACEMENT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_PLACEMENT_THREADGROUP_SIZE, 1)]
void ScreenProbePlacementUniformCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 screenProbeGridSize = max((uint2)_BurtGIScreenProbeGridParams.xy, uint2(1u, 1u));
    uint2 screenProbeCoord = dispatchThreadId.xy;
    if (any(screenProbeCoord >= screenProbeGridSize))
    {
        return;
    }

    uint sourceWidth;
    uint sourceHeight;
    _BurtCameraDepthTexture.GetDimensions(sourceWidth, sourceHeight);
    uint2 sourceSize = max(uint2(sourceWidth, sourceHeight), uint2(1u, 1u));
    float spacingPixelsFloat = max(_BurtGIScreenProbePlacementParams.z, 1.0);
    uint spacingPixels = max(1u, (uint)ceil(spacingPixelsFloat));
    uint jitterIndex = BurtGIScreenProbeCurrentJitterIndex(_BurtGIScreenProbePlacementParams.y);
    float2 jitterPixels = BurtGIScreenProbeTileJitterPixelsForIndex(jitterIndex, spacingPixelsFloat);
    uint2 tileStart = min((uint2)floor((float2)screenProbeCoord * spacingPixelsFloat), sourceSize - 1u);
    uint2 sourcePixel = min(tileStart + min((uint2)floor(jitterPixels), uint2(spacingPixels - 1u, spacingPixels - 1u)), sourceSize - 1u);
    float rawDepth = _BurtCameraDepthTexture.Load(int3(sourcePixel, 0));
    float2 inTileOffset = jitterPixels;

    if (BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth))
    {
        uint2 fallbackPixel;
        if (!BurtGIScreenProbeLocateValidPixelViaHiZ(screenProbeCoord, tileStart, spacingPixels, sourceSize, fallbackPixel))
        {
            _BurtGIScreenProbeScreenDepthWriteTexture[screenProbeCoord] = rawDepth;
            _BurtGIScreenProbeWorldNormalWriteTexture[screenProbeCoord] = float4(0.5, 0.5, 1.0, 0.0);
            _BurtGIScreenProbeWorldPositionWriteTexture[screenProbeCoord] = 0.0;
            return;
        }

        sourcePixel = fallbackPixel;
        rawDepth = _BurtCameraDepthTexture.Load(int3(sourcePixel, 0));
        inTileOffset = (float2)(sourcePixel - tileStart);
    }

    float2 sourceUV = ((float2)sourcePixel + 0.5) / (float2)sourceSize;
    float3 normalWS = BurtGIScreenProbeDecodeGBufferNormalWS888(_BurtGBuffer0.Load(int3(sourcePixel, 0)).rgb);
    float3 positionWS = BurtGIScreenProbeReconstructDeferredPositionWS(sourceUV, rawDepth);
    float shadingModelID = BurtGIScreenProbeDecodePackedShadingModel(_BurtGBuffer2.Load(int3(sourcePixel, 0)).r);
    bool isSubsurfaceMaterial = BurtGIScreenProbeIsShadingModel(shadingModelID, BURT_GI_SHADING_MODEL_SUBSURFACE);
    bool isFoliageMaterial = BurtGIScreenProbeIsShadingModel(shadingModelID, BURT_GI_SHADING_MODEL_FOLIAGE);
    bool isFurMaterial = BurtGIScreenProbeIsShadingModel(shadingModelID, BURT_GI_SHADING_MODEL_FUR);
    bool isHairMaterial = BurtGIScreenProbeIsShadingModel(shadingModelID, BURT_GI_SHADING_MODEL_HAIR);
    bool screenTraceSkipMaterial = isSubsurfaceMaterial || isFoliageMaterial || isFurMaterial;
    bool adaptiveSkipMaterial = isFoliageMaterial || isHairMaterial;
    bool sphericalVisibilityMaterial = isSubsurfaceMaterial || isFoliageMaterial || isHairMaterial;
    float placementPayload = BurtGIEncodeScreenProbePlacementPayload(
        inTileOffset,
        screenTraceSkipMaterial,
        adaptiveSkipMaterial,
        sphericalVisibilityMaterial);

    _BurtGIScreenProbeScreenDepthWriteTexture[screenProbeCoord] = rawDepth;
    _BurtGIScreenProbeWorldNormalWriteTexture[screenProbeCoord] = float4(saturate(normalWS * 0.5 + 0.5), 1.0);
    _BurtGIScreenProbeWorldPositionWriteTexture[screenProbeCoord] = float4(positionWS, placementPayload);
}

float BurtGIScreenProbeResolveScreenTraceNormalBias(float linearDepth, float sourceWidth, float fallbackBias)
{
    float tanHalfHorizontalFov = max(_BurtGIScreenProbeTraceModeParams.w, 0.0);
    float pixelWorldSize = max(linearDepth, 0.0) * (2.0 * tanHalfHorizontalFov) / max(sourceWidth, 1.0);
    return clamp(
        pixelWorldSize * 2.0,
        max(fallbackBias * 0.25, 0.001),
        max(fallbackBias, max(linearDepth, 0.0) * 0.01));
}

bool BurtGIScreenProbeTryHiZScreenTraceRadiance(
    float3 originWS,
    float3 rayDirectionWS,
    uint2 sourceProbeCoord,
    uint2 traceTexelCoord,
    uint2 screenProbeGridSize,
    float maxTraceDistanceWS,
    float sourceSceneDepth,
    float directionalEnergy,
    out float3 screenTraceRadiance,
    out float screenTraceConfidence,
    out float screenTraceDistance)
{
    screenTraceRadiance = 0.0;
    screenTraceConfidence = 0.0;
    screenTraceDistance = maxTraceDistanceWS;

    float screenTraceStrength = saturate(_BurtGIScreenProbeScreenTraceParams.x);
    if (screenTraceStrength <= 0.0001)
    {
        return false;
    }

    float2 hiZSize = max(_BurtGIScreenProbeScreenTraceParams.zw, 1.0);
    uint2 hiZSizeUInt = uint2(max(1u, (uint)hiZSize.x), max(1u, (uint)hiZSize.y));
    uint maxHiZMip = _BurtGIScreenProbeTraceModeParams.x > 0.5f
        ? max(0u, min(12u, (uint)floor(log2(max(hiZSize.x, hiZSize.y)))))
        : 0u;
    float maxTraceDistance = min(max(maxTraceDistanceWS, 0.01), max(_BurtGIScreenProbeScreenTraceParams.y, 0.01));
    float maxScreenTraceDepthScale = max(_BurtGIScreenProbeScreenTraceParams1.w, 0.0);
    if (sourceSceneDepth > 0.0001 && maxScreenTraceDepthScale > 0.0001)
    {
        maxTraceDistance = min(maxTraceDistance, max(0.01, sourceSceneDepth * maxScreenTraceDepthScale));
    }
    screenTraceDistance = maxTraceDistance;

    float2 originScreenUV;
    float originRawDepth;
    if (!BurtGIScreenProbeProjectPositionWS(originWS, originScreenUV, originRawDepth))
    {
        return false;
    }

    uint temporalHash = _BurtGIRadianceCacheClipMapFrameIndex +
        sourceProbeCoord.x * 17u +
        sourceProbeCoord.y * 131u +
        traceTexelCoord.x * 37u +
        traceTexelCoord.y * 73u;
    float temporalStepOffset = (float)(temporalHash & 7u) * 0.125;
    float bestHit = 0.0;

    uint maxScreenTraceIterations = max(1u, min(16u, (uint)max(_BurtGIScreenProbeScreenTraceParams1.z, 1.0)));
    float relativeDepthThickness = max(_BurtGIScreenProbeScreenTraceParams1.x, 0.0001);

    [loop]
    for (uint stepIndex = 0u; stepIndex < maxScreenTraceIterations; ++stepIndex)
    {
        float stepT = saturate(((float)stepIndex + 0.35 + temporalStepOffset) / (float)maxScreenTraceIterations);
        float sampleDistance = maxTraceDistance * stepT;
        float3 samplePositionWS = originWS + rayDirectionWS * sampleDistance;
        float2 sampleUV;
        float sampleRawDepth;
        if (!BurtGIScreenProbeProjectPositionWS(samplePositionWS, sampleUV, sampleRawDepth))
        {
            continue;
        }

        float footprintPixels = max(1.0, sampleDistance * (0.65 + stepT * 1.85));
        uint mipLevel = min(maxHiZMip, (uint)floor(log2(footprintPixels)));
        uint2 mipSize = uint2(
            max(hiZSizeUInt.x >> mipLevel, 1u),
            max(hiZSizeUInt.y >> mipLevel, 1u));
        uint2 samplePixel = min((uint2)(sampleUV * (float2)mipSize), mipSize - 1u);
        float sceneRawDepth = _BurtHiZDepthTexture.Load(int3(samplePixel, mipLevel));
        if (BurtGIScreenProbeTraceCompactIsSkyDepth(sceneRawDepth))
        {
            continue;
        }

#if defined(UNITY_REVERSED_Z)
        float depthDelta = sceneRawDepth - sampleRawDepth;
#else
        float depthDelta = sampleRawDepth - sceneRawDepth;
#endif
        float thickness = lerp(relativeDepthThickness * 0.06, relativeDepthThickness * 1.8, saturate(stepT)) *
            (1.0 + (float)mipLevel * 0.45) *
            max(_BurtGIScreenProbeTraceModeParams.y, 0.001f);
        float hit = smoothstep(thickness, thickness * 3.0, depthDelta);
        if (hit <= bestHit)
        {
            continue;
        }

        uint2 hitProbeCoord = min((uint2)(sampleUV * (float2)screenProbeGridSize), screenProbeGridSize - 1u);
        if (all(hitProbeCoord == sourceProbeCoord) || !BurtGIScreenProbeHasValidPlacement(hitProbeCoord))
        {
            continue;
        }

        if (BurtGIScreenProbeShouldSkipScreenTraceHit(hitProbeCoord))
        {
            continue;
        }

        float hitVignette = BurtGIScreenProbeComputeHitVignetteFromScreenUV(sampleUV);
        float2 hitHistoryUV;
        float hitHistoryRawDepth;
        bool hitHistoryValid = BurtGIScreenProbeProjectPreviousPositionWS(samplePositionWS, hitHistoryUV, hitHistoryRawDepth);
        hitVignette = hitHistoryValid
            ? min(hitVignette, BurtGIScreenProbeComputeHitVignetteFromScreenUV(hitHistoryUV))
            : 0.0;
        uint vignetteHash = temporalHash * 1664525u + 1013904223u + stepIndex * 374761393u;
        float vignetteNoise = (float)(vignetteHash & 1023u) * (1.0 / 1024.0);
        if (hitVignette < vignetteNoise)
        {
            continue;
        }

        float historyDepthThickness = max(_BurtGIScreenProbeScreenTraceParams1.y, 0.0001);
        if (!hitHistoryValid)
        {
            continue;
        }

        float spacingPixels = max(_BurtGIScreenProbeScreenTraceParams2.x, 1.0);
        uint historyJitterIndex = BurtGIScreenProbePreviousJitterIndex(_BurtGIScreenProbeScreenTraceParams2.y);
        float2 historyProbeCoord = BurtGIScreenProbeTileCoordFromScreenUV(
            hitHistoryUV,
            historyJitterIndex,
            spacingPixels,
            max(_BurtGIScreenProbeScreenTraceParams2.zw, float2(1.0, 1.0)));
        uint2 historyDepthCoord = (uint2)clamp(
            (int2)floor(historyProbeCoord),
            int2(0, 0),
            int2((int)screenProbeGridSize.x - 1, (int)screenProbeGridSize.y - 1));
        float historyProbeRawDepth = _BurtGIScreenProbeHistoryScreenDepthTexture.Load(int3(historyDepthCoord, 0));
        if (BurtGIScreenProbeTraceCompactIsSkyDepth(historyProbeRawDepth) ||
            abs(historyProbeRawDepth - hitHistoryRawDepth) >= historyDepthThickness * lerp(0.5, 2.0, vignetteNoise))
        {
            continue;
        }

        uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
        uint2 traceAtlasSize = uint2(max(1u, (uint)_BurtGIScreenProbeTraceParams.y), max(1u, (uint)_BurtGIScreenProbeTraceParams.z));
        uint2 historyTraceAtlasCoord = historyDepthCoord * traceResolution + traceTexelCoord;
        float4 historyTraceRadiance = all(historyTraceAtlasCoord < traceAtlasSize)
            ? _BurtGIScreenProbeHistoryTraceRadianceTexture.Load(int3(historyTraceAtlasCoord, 0))
            : 0.0;
        float4 historyProbeRadiance = _BurtGIScreenProbeHistoryRadianceTexture.Load(int3(historyDepthCoord, 0));
        float historyTraceLuma = dot(max(historyTraceRadiance.rgb, 0.0), float3(0.2126, 0.7152, 0.0722));
        float historyProbeLuma = dot(max(historyProbeRadiance.rgb, 0.0), float3(0.2126, 0.7152, 0.0722));
        float historyRadianceValid = (historyTraceLuma + historyProbeLuma) > 0.0001 ? 1.0 : 0.0;
        float3 historyScreenTraceRadiance = historyTraceLuma > 0.0001
            ? historyTraceRadiance.rgb
            : historyProbeRadiance.rgb;

        float4 hitNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(hitProbeCoord, 0));
        float3 hitNormalWS = BurtGIScreenProbeDecodeNormalWS(hitNormal);
        float facingWeight = saturate(dot(hitNormalWS, -rayDirectionWS) * 0.5 + 0.5);
        float4 hitRadiance = _BurtGIScreenProbeRadianceTexture.Load(int3(hitProbeCoord, 0));
        float4 hitIrradiance = _BurtGIScreenProbeIrradianceTexture.Load(int3(hitProbeCoord, 0));
        float4 hitConfidence = _BurtGIScreenProbeConfidenceTexture.Load(int3(hitProbeCoord, 0));
        float hitEnergy = saturate(max(hitRadiance.a, hitConfidence.g));
        float hitProbeConfidence = saturate(min(hitIrradiance.a, hitConfidence.r));
        float mipConfidence = 1.0 - saturate((float)mipLevel / max((float)maxHiZMip, 1.0)) * 0.3;
        float candidateConfidence = saturate(hit * facingWeight * hitEnergy * hitProbeConfidence * mipConfidence * (1.0 - stepT * 0.25));
        if (candidateConfidence > screenTraceConfidence)
        {
            bestHit = hit;
            float3 currentScreenTraceRadiance = max(hitRadiance.rgb, hitIrradiance.rgb * 0.65);
            screenTraceRadiance = lerp(currentScreenTraceRadiance, max(historyScreenTraceRadiance, 0.0), historyRadianceValid) * directionalEnergy;
            screenTraceConfidence = candidateConfidence * screenTraceStrength;
            screenTraceDistance = sampleDistance;
        }
    }

    return screenTraceConfidence > 0.001;
}

uint BurtGIEncodeScreenProbeTraceTexel(uint screenProbeIndex, uint2 traceTexelCoord)
{
    return (screenProbeIndex & 0xfffffu) | ((traceTexelCoord.x & 0x1fu) << 20) | ((traceTexelCoord.y & 0x1fu) << 25);
}

void BurtGIDecodeScreenProbeTraceTexel(uint traceTexelData, out uint screenProbeIndex, out uint2 traceTexelCoord)
{
    screenProbeIndex = traceTexelData & 0xfffffu;
    traceTexelCoord.x = (traceTexelData >> 20) & 0x1fu;
    traceTexelCoord.y = (traceTexelData >> 25) & 0x1fu;
}

uint BurtGIPackScreenProbeImportanceRayInfo(uint2 texelCoord, uint level)
{
    return (texelCoord.x & 0x3fu) | ((texelCoord.y & 0x3fu) << 6) | ((level & 0xfu) << 12);
}

void BurtGIUnpackScreenProbeImportanceRayInfo(uint rayInfo, out uint2 texelCoord, out uint level)
{
    texelCoord.x = rayInfo & 0x3fu;
    texelCoord.y = (rayInfo >> 6) & 0x3fu;
    level = (rayInfo >> 12) & 0xfu;
}

uint2 BurtGIPackScreenProbeImportanceRaySortInfo(uint2 texelCoord, uint level, float pdf)
{
    return uint2((texelCoord.x & 0xffu) | ((texelCoord.y & 0xffu) << 8) | ((level & 0xffu) << 16), asuint(pdf));
}

void BurtGIUnpackScreenProbeImportanceRaySortInfo(uint2 sortInfo, out uint2 texelCoord, out uint level, out float pdf)
{
    texelCoord.x = sortInfo.x & 0xffu;
    texelCoord.y = (sortInfo.x >> 8) & 0xffu;
    level = (sortInfo.x >> 16) & 0xffu;
    pdf = asfloat(sortInfo.y);
}

uint BurtGIPackScreenProbeAdaptiveProbeData(uint2 adaptiveFineProbeCoord, uint adaptiveLevel)
{
    return (adaptiveFineProbeCoord.x & 0x3fffu) | ((adaptiveFineProbeCoord.y & 0x3fffu) << 14) | ((adaptiveLevel & 0xfu) << 28);
}

void BurtGIUnpackScreenProbeAdaptiveProbeData(uint packedProbeData, out uint2 adaptiveFineProbeCoord, out uint adaptiveLevel)
{
    adaptiveFineProbeCoord.x = packedProbeData & 0x3fffu;
    adaptiveFineProbeCoord.y = (packedProbeData >> 14) & 0x3fffu;
    adaptiveLevel = (packedProbeData >> 28) & 0xfu;
}

uint2 BurtGIAdaptiveFineProbeCoordToBaseCoord(uint2 adaptiveFineProbeCoord, uint adaptiveLevel, uint2 screenProbeGridSize)
{
    uint adaptiveSubGridSize = 1u << min(adaptiveLevel, 13u);
    return min(adaptiveFineProbeCoord / max(1u, adaptiveSubGridSize), screenProbeGridSize - 1u);
}

uint BurtGIGetScreenProbeUniformCount(uint screenProbeWidth, uint screenProbeHeight)
{
    return max(1u, screenProbeWidth * screenProbeHeight);
}

uint BurtGIGetScreenProbeAdaptiveCount(uint maxAdaptiveProbeCount)
{
    return min(_BurtGIScreenProbeAdaptiveProbeNumBuffer[0], maxAdaptiveProbeCount);
}

bool BurtGIResolveScreenProbeSourceAndAtlasCoord(
    uint screenProbeIndex,
    uint screenProbeWidth,
    uint screenProbeHeight,
    uint maxAdaptiveProbeCount,
    out uint2 sourceScreenProbeCoord,
    out uint2 atlasScreenProbeCoord)
{
    uint uniformProbeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight);
    atlasScreenProbeCoord = uint2(screenProbeIndex % screenProbeWidth, screenProbeIndex / screenProbeWidth);
    if (screenProbeIndex < uniformProbeCount)
    {
        sourceScreenProbeCoord = atlasScreenProbeCoord;
        return sourceScreenProbeCoord.y < screenProbeHeight;
    }

    uint adaptiveProbeIndex = screenProbeIndex - uniformProbeCount;
    if (adaptiveProbeIndex >= BurtGIGetScreenProbeAdaptiveCount(maxAdaptiveProbeCount))
    {
        sourceScreenProbeCoord = uint2(0u, 0u);
        return false;
    }

    uint adaptiveLevel;
    uint2 adaptiveFineProbeCoord;
    BurtGIUnpackScreenProbeAdaptiveProbeData(
        _BurtGIScreenProbeAdaptiveProbeDataBuffer[adaptiveProbeIndex],
        adaptiveFineProbeCoord,
        adaptiveLevel);
    sourceScreenProbeCoord = BurtGIAdaptiveFineProbeCoordToBaseCoord(
        adaptiveFineProbeCoord,
        adaptiveLevel,
        uint2(screenProbeWidth, screenProbeHeight));
    return sourceScreenProbeCoord.x < screenProbeWidth && sourceScreenProbeCoord.y < screenProbeHeight;
}

float3 BurtGIOctahedralDirectionFromUV(float2 octUV)
{
    float2 f = octUV * 2.0 - 1.0;
    float3 n = float3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    if (n.z < 0.0)
    {
        float2 signNotZero = float2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
        n.xy = (1.0 - abs(n.yx)) * signNotZero;
    }

    return BurtGIScreenProbeTraceSafeNormalize(n, float3(0.0f, 0.0f, 1.0f));
}

float3 BurtGIEquiAreaSphericalMapping(float2 uv)
{
    uv = 2.0 * uv - 1.0;
    float d = 1.0 - (abs(uv.x) + abs(uv.y));
    float r = 1.0 - abs(d);
    float phi = r == 0.0 ? 0.0 : 0.7853981633974483 * ((abs(uv.y) - abs(uv.x)) / r + 1.0);
    float f = r * sqrt(max(2.0 - r * r, 0.0));
    return BurtGIScreenProbeTraceSafeNormalize(float3(
        f * sign(uv.y) * abs(sin(phi)),
        sign(d) * (1.0 - r * r),
        f * sign(uv.x) * abs(cos(phi))),
        float3(0.0f, 1.0f, 0.0f));
}

uint2 BurtGIOctahedralMapWrapBorder(uint2 texelCoord, uint resolution, uint borderSize)
{
    if (texelCoord.x < borderSize)
    {
        texelCoord.x = borderSize - 1u + borderSize - texelCoord.x;
        texelCoord.y = resolution - 1u - texelCoord.y;
    }

    if (texelCoord.x >= resolution - borderSize)
    {
        texelCoord.x = (resolution - borderSize) - (texelCoord.x - (resolution - borderSize - 1u));
        texelCoord.y = resolution - 1u - texelCoord.y;
    }

    if (texelCoord.y < borderSize)
    {
        texelCoord.y = borderSize - 1u + borderSize - texelCoord.y;
        texelCoord.x = resolution - 1u - texelCoord.x;
    }

    if (texelCoord.y >= resolution - borderSize)
    {
        texelCoord.y = (resolution - borderSize) - (texelCoord.y - (resolution - borderSize - 1u));
        texelCoord.x = resolution - 1u - texelCoord.x;
    }

    return texelCoord - borderSize;
}

float4 BurtGISHBasis3V0(float3 direction)
{
    return float4(
        0.28209479,
        -0.48860251 * direction.y,
        0.48860251 * direction.z,
        -0.48860251 * direction.x);
}

float4 BurtGISHBasis3V1(float3 direction)
{
    return float4(
        1.09254843 * direction.x * direction.y,
        -1.09254843 * direction.y * direction.z,
        0.31539157 * (3.0 * direction.z * direction.z - 1.0),
        -1.09254843 * direction.x * direction.z);
}

float BurtGISHBasis3V2(float3 direction)
{
    return 0.54627422 * (direction.x * direction.x - direction.y * direction.y);
}

void BurtGIWriteImportancePDFSH(uint baseIndex, float4 sh0, float4 sh1, float sh2)
{
    _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 0u] = sh0.x;
    _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 1u] = sh0.y;
    _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 2u] = sh0.z;
    _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 3u] = sh0.w;
    _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 4u] = sh1.x;
    _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 5u] = sh1.y;
    _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 6u] = sh1.z;
    _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 7u] = sh1.w;
    _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 8u] = sh2;
}

void BurtGIImportancePDFSHSetZero(uint index)
{
    BurtGIScreenProbeImportanceTransferSharedSH0[index] = 0.0;
    BurtGIScreenProbeImportanceTransferSharedSH1[index] = 0.0;
    BurtGIScreenProbeImportanceTransferSharedSH2[index] = 0.0;
    BurtGIScreenProbeImportanceTransferSharedSHWeight[index] = 0.0;
}

void BurtGIImportancePDFSHSetDiffuseTransfer(uint index, float3 normalWS, float weight)
{
    float3 shNormal = normalWS.zxy;
    float4 sh0 = BurtGISHBasis3V0(shNormal);
    float4 sh1 = BurtGISHBasis3V1(shNormal);
    float sh2 = BurtGISHBasis3V2(shNormal);
    const float pi = 3.14159265;
    sh0 *= float4(pi, 2.0943951, 2.0943951, 2.0943951);
    sh1 *= 0.78539816;
    sh2 *= 0.78539816;
    BurtGIScreenProbeImportanceTransferSharedSH0[index] = sh0 * weight;
    BurtGIScreenProbeImportanceTransferSharedSH1[index] = sh1 * weight;
    BurtGIScreenProbeImportanceTransferSharedSH2[index] = sh2 * weight;
    BurtGIScreenProbeImportanceTransferSharedSHWeight[index] = weight;
}

float BurtGIEvaluateImportancePDFSH(uint2 atlasScreenProbeCoord, uint screenProbeWidth, float3 directionWS, out bool validSH)
{
    uint baseIndex = (atlasScreenProbeCoord.y * screenProbeWidth + atlasScreenProbeCoord.x) * BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_SH_COEFFICIENT_COUNT;
    float4 sh0 = float4(
        _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 0u],
        _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 1u],
        _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 2u],
        _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 3u]);
    float4 sh1 = float4(
        _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 4u],
        _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 5u],
        _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 6u],
        _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 7u]);
    float sh2 = _BurtGIScreenProbeImportancePDFSHBuffer[baseIndex + 8u];
    validSH = sh0.x > 0.0001;
    float3 shDirection = directionWS.zxy;
    return max(
        dot(sh0, BurtGISHBasis3V0(shDirection)) +
        dot(sh1, BurtGISHBasis3V1(shDirection)) +
        sh2 * BurtGISHBasis3V2(shDirection),
        0.0);
}

float3 BurtGIEvaluateDiffuseTransferSH3(
    float3 direction,
    float3 sh0,
    float3 sh1,
    float3 sh2,
    float3 sh3,
    float3 sh4,
    float3 sh5,
    float3 sh6,
    float3 sh7,
    float3 sh8)
{
    float4 basis0 = BurtGISHBasis3V0(direction) * float4(1.0, 0.66666667, 0.66666667, 0.66666667);
    float4 basis1 = BurtGISHBasis3V1(direction) * 0.25;
    float basis2 = BurtGISHBasis3V2(direction) * 0.25;
    float3 irradiance = 0.0;
    irradiance.r = dot(float4(sh0.r, sh1.r, sh2.r, sh3.r), basis0) + dot(float4(sh4.r, sh5.r, sh6.r, sh7.r), basis1) + sh8.r * basis2;
    irradiance.g = dot(float4(sh0.g, sh1.g, sh2.g, sh3.g), basis0) + dot(float4(sh4.g, sh5.g, sh6.g, sh7.g), basis1) + sh8.g * basis2;
    irradiance.b = dot(float4(sh0.b, sh1.b, sh2.b, sh3.b), basis0) + dot(float4(sh4.b, sh5.b, sh6.b, sh7.b), basis1) + sh8.b * basis2;
    return max(irradiance * 12.5663706, 0.0);
}

bool BurtGIScreenProbeHasValidPlacement(uint2 screenProbeCoord)
{
    float rawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(screenProbeCoord, 0));
    float4 encodedNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(screenProbeCoord, 0));
    float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(screenProbeCoord, 0));
    return encodedNormal.a > 0.5f &&
        encodedPosition.a > 0.5f &&
        !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth);
}

uint2 BurtGIScreenProbeDecodePlacementSourcePixel(uint2 screenProbeCoord, float placementPayload, float spacingPixels, uint jitterIndex, uint2 sourceSize);

[numthreads(BURT_GI_SCREEN_PROBE_PLACEMENT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_PLACEMENT_THREADGROUP_SIZE, 1)]
void ScreenProbePlacementDebugCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint screenProbeIndex = dispatchThreadId.y * screenProbeWidth + dispatchThreadId.x;
    uint2 sourceScreenProbeCoord;
    uint2 atlasScreenProbeCoord;
    if (!BurtGIResolveScreenProbeSourceAndAtlasCoord(
        screenProbeIndex,
        screenProbeWidth,
        screenProbeHeight,
        maxAdaptiveProbeCount,
        sourceScreenProbeCoord,
        atlasScreenProbeCoord))
    {
        return;
    }

    if (!BurtGIScreenProbeHasValidPlacement(sourceScreenProbeCoord))
    {
        return;
    }

    uint debugWidth;
    uint debugHeight;
    _RW_ScreenProbePlacementDebug.GetDimensions(debugWidth, debugHeight);
    uint2 debugSize = max(uint2(debugWidth, debugHeight), uint2(1u, 1u));
    float spacingPixels = max(_BurtGIScreenProbePlacementParams.z, 1.0f);
    uint jitterIndex = BurtGIScreenProbeCurrentJitterIndex(_BurtGIScreenProbePlacementParams.y);
    float placementPayload = _BurtGIScreenProbeWorldPositionTexture.Load(int3(sourceScreenProbeCoord, 0)).a;
    uint2 screenCoord = BurtGIScreenProbeDecodePlacementSourcePixel(
        sourceScreenProbeCoord,
        placementPayload,
        spacingPixels,
        jitterIndex,
        debugSize);
    float4 color = screenProbeIndex < BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight)
        ? float4(1.0f, 0.0f, 0.0f, 1.0f)
        : float4(0.0f, 1.0f, 0.0f, 1.0f);

    [unroll]
    for (int y = -1; y <= 1; ++y)
    {
        [unroll]
        for (int x = -1; x <= 1; ++x)
        {
            int2 writeCoord = int2(screenCoord) + int2(x, y);
            if (writeCoord.x >= 0 &&
                writeCoord.y >= 0 &&
                writeCoord.x < (int)debugSize.x &&
                writeCoord.y < (int)debugSize.y)
            {
                _RW_ScreenProbePlacementDebug[(uint2)writeCoord] = color;
            }
        }
    }
}

[numthreads(BURT_GI_SCREEN_PROBE_TRACE_VISUALIZE_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_TRACE_VISUALIZE_THREADGROUP_SIZE, 1)]
void ScreenProbeTraceVisualizeCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint2 traceTexelCoord = dispatchThreadId.xy;
    if (traceTexelCoord.x >= traceResolution || traceTexelCoord.y >= traceResolution)
    {
        return;
    }

    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint2 queryScreenProbeCoord = uint2(screenProbeWidth / 2u, screenProbeHeight / 2u);
    if (_BurtGIScreenProbeTraceVisualizeParams.z > 0.5f)
    {
        queryScreenProbeCoord = min(
            (uint2)floor(max(_BurtGIScreenProbeTraceVisualizeParams.xy, 0.0f)),
            uint2(screenProbeWidth - 1u, screenProbeHeight - 1u));
    }

    uint screenProbeIndex = queryScreenProbeCoord.y * screenProbeWidth + queryScreenProbeCoord.x;
    uint2 sourceScreenProbeCoord;
    uint2 atlasScreenProbeCoord;
    if (!BurtGIResolveScreenProbeSourceAndAtlasCoord(
        screenProbeIndex,
        screenProbeWidth,
        screenProbeHeight,
        maxAdaptiveProbeCount,
        sourceScreenProbeCoord,
        atlasScreenProbeCoord))
    {
        return;
    }

    uint2 traceAtlasSize = max((uint2)_BurtGIScreenProbeTraceParams.yz, uint2(1u, 1u));
    uint2 traceAtlasCoord = atlasScreenProbeCoord * traceResolution + traceTexelCoord;
    if (any(traceAtlasCoord >= traceAtlasSize))
    {
        return;
    }

    float3 probeWorldPosition = 0.0f;
    if (BurtGIScreenProbeHasValidPlacement(sourceScreenProbeCoord))
    {
        probeWorldPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(sourceScreenProbeCoord, 0)).xyz;
    }

    float2 octUV = ((float2)traceTexelCoord + 0.5f) / (float)traceResolution;
    float3 traceDirection = BurtGIEquiAreaSphericalMapping(octUV);
    float4 traceRadiance = _BurtGIScreenProbeTraceRadianceTexture[traceAtlasCoord];
    float traceHit = saturate(max(traceRadiance.a, _BurtGIScreenProbeTraceHitTexture[traceAtlasCoord]));
    float traceHitDistance = max(_BurtGIScreenProbeTraceParams.w, 0.001f) * traceHit;
    float3 visualizeRadiance = sqrt(max(traceRadiance.rgb, 0.0f));
    if (traceHit <= 0.001f)
    {
        traceHitDistance = 0.0f;
        visualizeRadiance = 0.3f.xxx;
    }
    else if (traceHitDistance < 0.01f)
    {
        traceHitDistance = 0.1f;
        visualizeRadiance = float3(1.0f, 0.0f, 1.0f);
    }

    uint traceIndex = traceTexelCoord.y * traceResolution + traceTexelCoord.x;
    uint outputIndex = traceIndex * BURT_GI_SCREEN_PROBE_TRACE_VISUALIZE_DATA_STRIDE;
    _RW_XGIScreenProbeTraceVisualize_TracesData[outputIndex + 0u] = float4(probeWorldPosition, 0.0f);
    _RW_XGIScreenProbeTraceVisualize_TracesData[outputIndex + 1u] = float4(traceDirection * traceHitDistance, 0.0f);
    _RW_XGIScreenProbeTraceVisualize_TracesData[outputIndex + 2u] = float4(visualizeRadiance, 0.0f);
}

bool BurtGIResolveScreenProbeTraceSourcePlacement(
    uint screenProbeIndex,
    uint screenProbeWidth,
    uint screenProbeHeight,
    uint maxAdaptiveProbeCount,
    uint2 sourceScreenProbeCoord,
    out float3 sourcePositionWS,
    out float3 sourceNormalWS)
{
    sourcePositionWS = 0.0;
    sourceNormalWS = float3(0.0, 1.0, 0.0);

    uint uniformProbeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight);
    if (screenProbeIndex < uniformProbeCount)
    {
        if (!BurtGIScreenProbeHasValidPlacement(sourceScreenProbeCoord))
        {
            return false;
        }

        float4 encodedNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(sourceScreenProbeCoord, 0));
        float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(sourceScreenProbeCoord, 0));
        sourcePositionWS = encodedPosition.xyz;
        sourceNormalWS = BurtGIScreenProbeDecodeNormalWS(encodedNormal);
        return true;
    }

    uint adaptiveProbeIndex = screenProbeIndex - uniformProbeCount;
    if (adaptiveProbeIndex >= BurtGIGetScreenProbeAdaptiveCount(maxAdaptiveProbeCount))
    {
        return false;
    }

    uint adaptiveLevel;
    uint2 adaptiveFineProbeCoord;
    BurtGIUnpackScreenProbeAdaptiveProbeData(
        _BurtGIScreenProbeAdaptiveProbeDataBuffer[adaptiveProbeIndex],
        adaptiveFineProbeCoord,
        adaptiveLevel);

    uint adaptiveSubGridSize = 1u << min(adaptiveLevel, 13u);
    uint2 baseProbeCoord = min(
        adaptiveFineProbeCoord / max(1u, adaptiveSubGridSize),
        uint2(screenProbeWidth - 1u, screenProbeHeight - 1u));
    uint2 adaptiveCellCoord = adaptiveFineProbeCoord - baseProbeCoord * adaptiveSubGridSize;
    float2 adaptiveCellUV = (float2(adaptiveCellCoord) + 0.5f) / (float)max(1u, adaptiveSubGridSize);
    float2 bilinearUV = saturate(adaptiveCellUV);
    float4 bilinearWeights = float4(
        (1.0 - bilinearUV.x) * (1.0 - bilinearUV.y),
        bilinearUV.x * (1.0 - bilinearUV.y),
        (1.0 - bilinearUV.x) * bilinearUV.y,
        bilinearUV.x * bilinearUV.y);

    uint2 rightProbeCoord = uint2(min(baseProbeCoord.x + 1u, screenProbeWidth - 1u), baseProbeCoord.y);
    uint2 downProbeCoord = uint2(baseProbeCoord.x, min(baseProbeCoord.y + 1u, screenProbeHeight - 1u));
    uint2 rightDownProbeCoord = uint2(rightProbeCoord.x, downProbeCoord.y);
    float rawDepth00 = _BurtGIScreenProbeScreenDepthTexture.Load(int3(baseProbeCoord, 0));
    float rawDepth10 = _BurtGIScreenProbeScreenDepthTexture.Load(int3(rightProbeCoord, 0));
    float rawDepth01 = _BurtGIScreenProbeScreenDepthTexture.Load(int3(downProbeCoord, 0));
    float rawDepth11 = _BurtGIScreenProbeScreenDepthTexture.Load(int3(rightDownProbeCoord, 0));
    float4 encodedNormal00 = _BurtGIScreenProbeWorldNormalTexture.Load(int3(baseProbeCoord, 0));
    float4 encodedNormal10 = _BurtGIScreenProbeWorldNormalTexture.Load(int3(rightProbeCoord, 0));
    float4 encodedNormal01 = _BurtGIScreenProbeWorldNormalTexture.Load(int3(downProbeCoord, 0));
    float4 encodedNormal11 = _BurtGIScreenProbeWorldNormalTexture.Load(int3(rightDownProbeCoord, 0));
    float4 encodedPosition00 = _BurtGIScreenProbeWorldPositionTexture.Load(int3(baseProbeCoord, 0));
    float4 encodedPosition10 = _BurtGIScreenProbeWorldPositionTexture.Load(int3(rightProbeCoord, 0));
    float4 encodedPosition01 = _BurtGIScreenProbeWorldPositionTexture.Load(int3(downProbeCoord, 0));
    float4 encodedPosition11 = _BurtGIScreenProbeWorldPositionTexture.Load(int3(rightDownProbeCoord, 0));
    bool valid00 = encodedNormal00.a > 0.5f && encodedPosition00.a > 0.5f && !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth00);
    bool valid10 = encodedNormal10.a > 0.5f && encodedPosition10.a > 0.5f && !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth10);
    bool valid01 = encodedNormal01.a > 0.5f && encodedPosition01.a > 0.5f && !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth01);
    bool valid11 = encodedNormal11.a > 0.5f && encodedPosition11.a > 0.5f && !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth11);
    float4 validWeights = bilinearWeights * float4(valid00 ? 1.0 : 0.0, valid10 ? 1.0 : 0.0, valid01 ? 1.0 : 0.0, valid11 ? 1.0 : 0.0);
    float validWeightSum = dot(validWeights, float4(1.0, 1.0, 1.0, 1.0));
    if (validWeightSum <= 0.0001f)
    {
        return false;
    }

    float invValidWeightSum = rcp(validWeightSum);
    float3 normal00 = valid00 ? BurtGIScreenProbeDecodeNormalWS(encodedNormal00) : sourceNormalWS;
    float3 normal10 = valid10 ? BurtGIScreenProbeDecodeNormalWS(encodedNormal10) : normal00;
    float3 normal01 = valid01 ? BurtGIScreenProbeDecodeNormalWS(encodedNormal01) : normal00;
    float3 normal11 = valid11 ? BurtGIScreenProbeDecodeNormalWS(encodedNormal11) : normal00;
    sourcePositionWS =
        (encodedPosition00.xyz * validWeights.x +
            encodedPosition10.xyz * validWeights.y +
            encodedPosition01.xyz * validWeights.z +
            encodedPosition11.xyz * validWeights.w) * invValidWeightSum;
    sourceNormalWS = BurtGIScreenProbeTraceSafeNormalize(
        normal00 * validWeights.x +
        normal10 * validWeights.y +
        normal01 * validWeights.z +
        normal11 * validWeights.w,
        normal00);
    return true;
}

float BurtGIScreenProbeTransferPDFNeighborhoodWeight(
    uint2 sampleProbeCoord,
    float3 sourcePositionWS,
    float3 sourceNormalWS,
    bool sourceHasSphericalVisibility,
    out bool sampleHasSphericalVisibility,
    out float3 sampleNormalWS)
{
    sampleNormalWS = sourceNormalWS;
    sampleHasSphericalVisibility = false;
    if (!BurtGIScreenProbeHasValidPlacement(sampleProbeCoord))
    {
        return 0.0;
    }

    float4 encodedNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(sampleProbeCoord, 0));
    float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(sampleProbeCoord, 0));
    sampleNormalWS = BurtGIScreenProbeDecodeNormalWS(encodedNormal);
    sampleHasSphericalVisibility = BurtGIScreenProbeHasSphericalVisibility(encodedPosition.a);
    float3 samplePositionWS = encodedPosition.xyz;
    float sampleDistance = max(distance(sourcePositionWS, samplePositionWS), 0.05);
    float planeDistance = abs(dot(sourcePositionWS - samplePositionWS, sampleNormalWS));
    float relativePlaneDistance = planeDistance / sampleDistance;
    float planeWeight = exp2(-32.0 * relativePlaneDistance * relativePlaneDistance);
    float normalWeight = (sourceHasSphericalVisibility || sampleHasSphericalVisibility)
        ? 1.0
        : saturate(dot(sourceNormalWS, sampleNormalWS) * 0.5 + 0.5);
    return planeWeight * normalWeight;
}

float BurtGIScreenProbeLoadImportancePDF(uint2 screenProbeCoord, uint2 traceTexelCoord, uint traceResolution)
{
    float2 normalizedTraceTexel = (float2(traceTexelCoord) + 0.5) / max(1.0, (float)traceResolution);
    uint2 innerPDFTexelCoord = min(
        (uint2)(normalizedTraceTexel * (float)BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_RESOLUTION),
        BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_RESOLUTION - 1u);
    uint2 pdfTexelCoord = innerPDFTexelCoord + BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_BORDER_SIZE;
    uint2 pdfAtlasCoord = screenProbeCoord * BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_RESOLUTION_WITH_BORDER + pdfTexelCoord;
    return saturate(_BurtGIScreenProbeImportancePDFReadTexture[pdfAtlasCoord]);
}

uint2 BurtGIScreenProbeDecodePlacementSourcePixel(uint2 screenProbeCoord, float placementPayload, float spacingPixels, uint jitterIndex, uint2 sourceSize)
{
    float2 inTileOffset = BurtGIScreenProbeTileJitterPixelsForIndex(jitterIndex, spacingPixels);
    uint packedPlacement = (uint)round(max(placementPayload, 0.0));
    if ((packedPlacement & BURT_GI_SCREEN_PROBE_VALID_FLAG) != 0u)
    {
        inTileOffset = float2(
            packedPlacement & BURT_GI_SCREEN_PROBE_IN_TILE_OFFSET_MASK,
            (packedPlacement >> BURT_GI_SCREEN_PROBE_IN_TILE_OFFSET_BITS) & BURT_GI_SCREEN_PROBE_IN_TILE_OFFSET_MASK);
    }

    uint2 tileStart = min((uint2)floor((float2)screenProbeCoord * spacingPixels), sourceSize - 1u);
    uint maxInTileOffset = (uint)max(spacingPixels - 1.0, 0.0);
    uint2 inTilePixel = min((uint2)floor(max(inTileOffset, 0.0)), uint2(maxInTileOffset, maxInTileOffset));
    return min(tileStart + inTilePixel, sourceSize - 1u);
}

void BurtGIScreenProbeFillImportanceTransferSharedNormals(
    uint2 sourceScreenProbeCoord,
    float placementPayload,
    uint groupIndex,
    uint3 groupThreadId,
    bool hasValidProbe,
    bool isUniformProbe)
{
    float spacingPixels = max(_BurtGIScreenProbeImportancePDFParams.x, 1.0);
    uint jitterIndex = BurtGIScreenProbeCurrentJitterIndex(_BurtGIScreenProbeImportancePDFParams.y);
    uint2 sourceSize = max((uint2)_BurtGIScreenProbeImportancePDFParams.zw, uint2(1u, 1u));
    float valid = (hasValidProbe && isUniformProbe) ? 1.0 : 0.0;
    float3 normalWS = float3(0.0, 1.0, 0.0);
    float3 positionWS = 0.0;
    float centerWeight = 0.0;

    if (valid > 0.5)
    {
        uint2 centerPixel = BurtGIScreenProbeDecodePlacementSourcePixel(sourceScreenProbeCoord, placementPayload, spacingPixels, jitterIndex, sourceSize);
        bool centerSample = all(groupThreadId.xy == uint2(
            BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE / 2u,
            BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE / 2u));
        centerWeight = centerSample ? 1.0 : 0.0;
        float2 threadOffset = (float2)groupThreadId.xy / (float)BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREADGROUP_SIZE * spacingPixels * 2.0 - 1.0;
        if (centerSample)
        {
            threadOffset = 0.0;
        }

        int2 samplePixel = clamp(
            (int2)floor((float2)centerPixel + 0.5 + threadOffset),
            int2(0, 0),
            int2((int)sourceSize.x - 1, (int)sourceSize.y - 1));
        float rawDepth = _BurtCameraDepthTexture.Load(int3(samplePixel, 0));
        if (BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth))
        {
            valid = 0.0;
        }
        else
        {
            normalWS = BurtGIScreenProbeDecodeGBufferNormalWS888(_BurtGBuffer0.Load(int3(samplePixel, 0)).rgb);
            float2 screenUV = ((float2)samplePixel + 0.5) / (float2)sourceSize;
            positionWS = BurtGIScreenProbeReconstructDeferredPositionWS(screenUV, rawDepth);
        }
    }

    BurtGIScreenProbeImportanceTransferSharedPlaneWS[groupIndex] = float4(normalWS, dot(normalWS, positionWS));
    BurtGIScreenProbeImportanceTransferSharedValid[groupIndex] = valid;
    BurtGIScreenProbeImportanceTransferSharedCenter[groupIndex] = centerWeight;
    if (valid > 0.5)
    {
        BurtGIImportancePDFSHSetDiffuseTransfer(groupIndex, normalWS, 1.0);
    }
    else
    {
        BurtGIImportancePDFSHSetZero(groupIndex);
    }
}

bool BurtGIScreenProbeEvaluateImportanceTransferFromGBuffer(float3 sourcePositionWS, float sourceSceneDepth, float3 sampleDirection, bool sourceHasSphericalVisibility, out float transferPDF)
{
    transferPDF = -1.0;
    if (sourceHasSphericalVisibility)
    {
        transferPDF = 1.0;
        return true;
    }

    [unroll]
    for (uint sampleIndex = 0u; sampleIndex < BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT; ++sampleIndex)
    {
        if (BurtGIScreenProbeImportanceTransferSharedValid[sampleIndex] > 0.5)
        {
            float4 pixelPlane = BurtGIScreenProbeImportanceTransferSharedPlaneWS[sampleIndex];
            float planeDistance = abs(dot(float4(sourcePositionWS, -1.0), pixelPlane));
            float relativeDepthDifference = planeDistance / max(sourceSceneDepth, 0.0001);
            float depthWeight = exp2(-10000.0 * relativeDepthDifference * relativeDepthDifference);
            if (depthWeight > 0.1 || BurtGIScreenProbeImportanceTransferSharedCenter[sampleIndex] > 0.5)
            {
                transferPDF = max(transferPDF, saturate(dot(pixelPlane.xyz, sampleDirection)));
            }
        }
    }

    return transferPDF >= 0.0;
}

void BurtGIScreenProbeStoreImportanceTransferSH(
    uint2 atlasScreenProbeCoord,
    uint screenProbeWidth,
    uint groupIndex,
    bool hasValidProbe,
    bool sourceHasSphericalVisibility,
    float3 sourcePositionWS,
    float sourceSceneDepth)
{
    uint baseIndex = (atlasScreenProbeCoord.y * screenProbeWidth + atlasScreenProbeCoord.x) * BURT_GI_SCREEN_PROBE_IMPORTANCE_PDF_SH_COEFFICIENT_COUNT;
    if (!hasValidProbe)
    {
        BurtGIImportancePDFSHSetZero(groupIndex);
    }
    else if (sourceHasSphericalVisibility)
    {
        if (groupIndex == 0u)
        {
            BurtGIScreenProbeImportanceTransferSharedSH0[groupIndex] = float4(1.0, 0.0, 0.0, 0.0);
            BurtGIScreenProbeImportanceTransferSharedSH1[groupIndex] = 0.0;
            BurtGIScreenProbeImportanceTransferSharedSH2[groupIndex] = 0.0;
            BurtGIScreenProbeImportanceTransferSharedSHWeight[groupIndex] = 1.0;
        }
        else
        {
            BurtGIImportancePDFSHSetZero(groupIndex);
        }
    }
    else if (BurtGIScreenProbeImportanceTransferSharedValid[groupIndex] > 0.5)
    {
        float4 pixelPlane = BurtGIScreenProbeImportanceTransferSharedPlaneWS[groupIndex];
        float planeDistance = abs(dot(float4(sourcePositionWS, -1.0), pixelPlane));
        float relativeDepthDifference = planeDistance / max(sourceSceneDepth, 0.0001);
        float depthWeight = exp2(-10000.0 * relativeDepthDifference * relativeDepthDifference);
        if (depthWeight > 0.1 || BurtGIScreenProbeImportanceTransferSharedCenter[groupIndex] > 0.5)
        {
            BurtGIImportancePDFSHSetDiffuseTransfer(groupIndex, pixelPlane.xyz, 1.0);
        }
        else
        {
            BurtGIImportancePDFSHSetZero(groupIndex);
        }
    }
    else
    {
        BurtGIImportancePDFSHSetZero(groupIndex);
    }

    GroupMemoryBarrierWithGroupSync();
    for (uint reductionStride = BURT_GI_SCREEN_PROBE_IRRADIANCE_OCT_THREAD_COUNT >> 1u; reductionStride > 0u; reductionStride >>= 1u)
    {
        if (groupIndex < reductionStride)
        {
            uint otherIndex = groupIndex + reductionStride;
            BurtGIScreenProbeImportanceTransferSharedSH0[groupIndex] += BurtGIScreenProbeImportanceTransferSharedSH0[otherIndex];
            BurtGIScreenProbeImportanceTransferSharedSH1[groupIndex] += BurtGIScreenProbeImportanceTransferSharedSH1[otherIndex];
            BurtGIScreenProbeImportanceTransferSharedSH2[groupIndex] += BurtGIScreenProbeImportanceTransferSharedSH2[otherIndex];
            BurtGIScreenProbeImportanceTransferSharedSHWeight[groupIndex] += BurtGIScreenProbeImportanceTransferSharedSHWeight[otherIndex];
        }

        GroupMemoryBarrierWithGroupSync();
    }

    if (groupIndex == 0u)
    {
        float invWeight = rcp(max(BurtGIScreenProbeImportanceTransferSharedSHWeight[0], 0.0001));
        BurtGIWriteImportancePDFSH(
            baseIndex,
            BurtGIScreenProbeImportanceTransferSharedSH0[0] * invWeight,
            BurtGIScreenProbeImportanceTransferSharedSH1[0] * invWeight,
            BurtGIScreenProbeImportanceTransferSharedSH2[0] * invWeight);
    }
}

float3 BurtGIScreenProbeTraceGridStepDirection(float3 rayDirection, float3 sourceNormal)
{
    float2 gridDirection = rayDirection.xy;
    if (dot(gridDirection, gridDirection) < 0.0001f)
    {
        gridDirection = sourceNormal.xy;
    }

    if (dot(gridDirection, gridDirection) < 0.0001f)
    {
        gridDirection = float2(1.0f, 0.0f);
    }

    gridDirection /= max(0.0001f, max(abs(gridDirection.x), abs(gridDirection.y)));
    return float3(gridDirection, rayDirection.z);
}

void BurtGIScreenProbeEvaluateSceneTraceCandidate(
    uint2 sourceProbeCoord,
    uint2 sampleProbeCoord,
    float3 sourcePositionWS,
    float3 sourceNormalWS,
    float3 rayDirection,
    float directionalEnergy,
    uint sourceTraceLevel,
    float coneRadiusScale,
    float maxTraceDistance,
    inout float bestSceneTraceHit,
    inout float bestSceneTraceConfidence,
    inout float bestSceneTraceDistance,
    inout float3 bestSceneTraceRadiance)
{
    if (all(sampleProbeCoord == sourceProbeCoord) ||
        !BurtGIScreenProbeHasValidPlacement(sampleProbeCoord))
    {
        return;
    }

    float4 samplePosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(sampleProbeCoord, 0));
    float4 sampleNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(sampleProbeCoord, 0));
    float3 toSample = samplePosition.xyz - sourcePositionWS;
    float sampleDistance = length(toSample);
    if (sampleDistance <= 0.0001f)
    {
        return;
    }

    float rayDistance = dot(toSample, rayDirection);
    if (sampleDistance > maxTraceDistance || rayDistance > maxTraceDistance)
    {
        return;
    }

    float forwardWeight = saturate((rayDistance / max(sampleDistance, 0.0001f) - 0.05f) * 1.0526316f);
    if (forwardWeight <= 0.0f)
    {
        return;
    }

    float3 closestRayPosition = sourcePositionWS + rayDirection * max(rayDistance, 0.0f);
    float rayLineDistance = length(samplePosition.xyz - closestRayPosition);
    float rayConeRadius = max(0.08f, 0.075f * rayDistance * coneRadiusScale + 0.25f * (float)sourceTraceLevel);
    float rayLineWeight = saturate(1.0f - rayLineDistance / rayConeRadius);
    float3 sampleNormalWS = BurtGIScreenProbeDecodeNormalWS(sampleNormal);
    float facingWeight = saturate(dot(sampleNormalWS, -rayDirection) * 0.5f + 0.5f);
    float normalContinuityWeight = saturate(1.0f - dot(sampleNormalWS, sourceNormalWS) * 0.35f);
    float4 sampleRadiance = _BurtGIScreenProbeRadianceTexture.Load(int3(sampleProbeCoord, 0));
    float4 sampleIrradiance = _BurtGIScreenProbeIrradianceTexture.Load(int3(sampleProbeCoord, 0));
    float4 sampleConfidence = _BurtGIScreenProbeConfidenceTexture.Load(int3(sampleProbeCoord, 0));
    float sampleHitRatio = saturate(max(sampleRadiance.a, sampleConfidence.g));
    float sampleConfidenceValue = saturate(min(sampleIrradiance.a, sampleConfidence.r));
    float distanceWeight = rcp(1.0f + sampleDistance * 0.15f);
    float candidateTraceHit = saturate(forwardWeight * rayLineWeight * facingWeight * normalContinuityWeight * sampleHitRatio * sampleConfidenceValue * distanceWeight);
    if (candidateTraceHit > bestSceneTraceHit)
    {
        bestSceneTraceHit = candidateTraceHit;
        bestSceneTraceConfidence = sampleConfidenceValue;
        bestSceneTraceDistance = sampleDistance;
        bestSceneTraceRadiance = max(sampleRadiance.rgb, sampleIrradiance.rgb * 0.65f) * directionalEnergy;
    }
}

uint BurtGIRadianceCacheHashGridCellCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.y);
}

uint BurtGIRadianceCacheHashGridTileCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.x);
}

uint BurtGIRadianceCacheHashGridCellsPerTile()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams1.z);
}

uint BurtGIRadianceCacheHashGridBucketCount()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.z);
}

uint BurtGIRadianceCacheHashGridTilesPerBucket()
{
    return max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.w);
}

uint BurtGIRadianceCacheHashGridHash(uint3 value)
{
    uint h = value.x * 0x8da6b343u;
    h ^= value.y * 0xd8163841u;
    h ^= value.z * 0xcb1ab31fu;
    h ^= h >> 16;
    h *= 0x7feb352du;
    h ^= h >> 15;
    h *= 0x846ca68bu;
    h ^= h >> 16;
    return h;
}

float BurtGIScreenProbeInterleavedGradientNoise(uint2 coord, uint temporalIndex)
{
    uint hash = BurtGIRadianceCacheHashGridHash(uint3(coord.x, coord.y, temporalIndex));
    return (float)(hash & 0x00ffffffu) * (1.0 / 16777216.0);
}

float2 BurtGIScreenProbeBlueNoiseVec2(uint2 coord, uint temporalIndex)
{
    return float2(
        BurtGIScreenProbeInterleavedGradientNoise(coord, temporalIndex),
        BurtGIScreenProbeInterleavedGradientNoise(coord ^ uint2(0x9e37u, 0x7f4au), temporalIndex + 17u));
}

uint BurtGIRadianceCacheHashGridTileHash(float3 worldPosition, float3 rayDirection)
{
    float cellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    float tileCellRatio = max(1.0, _BurtGIRadianceCacheHashGridParams0.y);
    float tileSize = cellSize * tileCellRatio;
    int3 signedTileCoord = (int3)floor(worldPosition / tileSize);
    int3 signedDirectionCoord = (int3)floor(0.5 + (0.5 * rayDirection + 0.5) * 4.0);
    uint3 tileKey = uint3((uint)signedTileCoord.x, (uint)signedTileCoord.y, (uint)signedTileCoord.z);
    uint3 directionKey = uint3((uint)signedDirectionCoord.x, (uint)signedDirectionCoord.y, (uint)signedDirectionCoord.z);
    uint hash = BurtGIRadianceCacheHashGridHash(tileKey ^ (directionKey * 0x9e3779b9u));
    return hash == 0xffffffffu ? 0xfffffffeu : max(1u, hash);
}

uint2 BurtGIRadianceCacheHashGridLocalCellCoordMip0(float3 worldPosition, float3 rayDirection)
{
    float cellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    uint tileCellRatio = max(1u, (uint)_BurtGIRadianceCacheHashGridParams0.y);
    float tileSize = cellSize * (float)tileCellRatio;
    int3 signedTileCoord = (int3)floor(worldPosition / tileSize);
    int3 signedCellCoord = (int3)floor(worldPosition / cellSize) - signedTileCoord * (int)tileCellRatio;
    uint3 maxCellCoord = uint3(tileCellRatio - 1u, tileCellRatio - 1u, tileCellRatio - 1u);
    uint3 cellCoord = min(uint3((uint)signedCellCoord.x, (uint)signedCellCoord.y, (uint)signedCellCoord.z), maxCellCoord);
    float3 absDirection = abs(rayDirection);
    float maxDirection = max(max(absDirection.x, absDirection.y), absDirection.z);
    uint2 cellOffsetMip0 = absDirection.x == maxDirection
        ? uint2(cellCoord.y, cellCoord.z)
        : (absDirection.y == maxDirection ? uint2(cellCoord.x, cellCoord.z) : uint2(cellCoord.x, cellCoord.y));
    return min(cellOffsetMip0, uint2(tileCellRatio - 1u, tileCellRatio - 1u));
}

uint BurtGIRadianceCacheHashGridMipLocalCellIndex(uint2 cellCoordMip0, uint mipLevel)
{
    if (mipLevel == 0u)
    {
        return BURT_GI_HASH_GRID_TILE_MIP0_OFFSET + cellCoordMip0.x + cellCoordMip0.y * 8u;
    }

    if (mipLevel == 1u)
    {
        uint2 mipCoord = min(cellCoordMip0 >> 1u, uint2(3u, 3u));
        return BURT_GI_HASH_GRID_TILE_MIP1_OFFSET + mipCoord.x + mipCoord.y * 4u;
    }

    if (mipLevel == 2u)
    {
        uint2 mipCoord = min(cellCoordMip0 >> 2u, uint2(1u, 1u));
        return BURT_GI_HASH_GRID_TILE_MIP2_OFFSET + mipCoord.x + mipCoord.y * 2u;
    }

    return BURT_GI_HASH_GRID_TILE_MIP3_OFFSET;
}

uint BurtGIRadianceCacheHashGridLocalCell(float3 worldPosition, float3 rayDirection)
{
    return BurtGIRadianceCacheHashGridMipLocalCellIndex(
        BurtGIRadianceCacheHashGridLocalCellCoordMip0(worldPosition, rayDirection),
        0u);
}

bool BurtGIRadianceCacheHashGridFindTile(uint tileHash, out uint tileIndex)
{
    uint bucketIndex = BurtGIRadianceCacheHashGridHash(uint3(tileHash, tileHash >> 7, tileHash >> 17)) % BurtGIRadianceCacheHashGridBucketCount();
    uint tilesPerBucket = BurtGIRadianceCacheHashGridTilesPerBucket();
    tileIndex = 0xffffffffu;

    [loop]
    for (uint bucketOffset = 0u; bucketOffset < tilesPerBucket; ++bucketOffset)
    {
        uint candidateTileIndex = bucketIndex * tilesPerBucket + bucketOffset;
        if (candidateTileIndex >= BurtGIRadianceCacheHashGridTileCount())
        {
            break;
        }

        uint4 tileValue = _BurtGIRadianceCacheHashGridTileBuffer[candidateTileIndex];
        if (tileValue.x == 0xffffffffu)
        {
            break;
        }

        if (tileValue.x == tileHash)
        {
            tileIndex = candidateTileIndex;
            return true;
        }
    }

    return false;
}

uint BurtGIRadianceCacheHashGridCellIndexFromTile(uint tileIndex, uint localCellIndex)
{
    return min(tileIndex * BurtGIRadianceCacheHashGridCellsPerTile() + localCellIndex, BurtGIRadianceCacheHashGridCellCount() - 1u);
}

float4 BurtGIRadianceCacheHashGridUnpackRadiance(uint4 packedValue)
{
    uint2 packedRadiance = packedValue.xy;
    float3 radiance = float3(
        (float)(packedRadiance.x & 0xffffu),
        (float)((packedRadiance.x >> 16) & 0xffffu),
        (float)(packedRadiance.y & 0xffffu)) / 65535.0 * 8.0;
    float sampleWeight = (float)((packedRadiance.y >> 16) & 0xffffu) / 65535.0;
    return float4(radiance, sampleWeight);
}

uint BurtGIRadianceCacheHashGridFrameDelta(uint frameIndex, uint lastUpdateFrame)
{
    if (lastUpdateFrame == 0xffffffffu)
    {
        return BURT_GI_HASH_GRID_TILE_DECAY_MAX;
    }

    return frameIndex >= lastUpdateFrame
        ? frameIndex - lastUpdateFrame
        : (0xffffffffu - lastUpdateFrame) + frameIndex + 1u;
}

float BurtGIRadianceCacheHashGridAgeConfidenceScale(uint4 packedValue)
{
    uint frameDelta = BurtGIRadianceCacheHashGridFrameDelta(_BurtGIRadianceCacheClipMapFrameIndex, packedValue.z);
    return 1.0 - saturate((float)frameDelta / (float)BURT_GI_HASH_GRID_TILE_DECAY_MAX);
}

float4 BurtGIRadianceCacheHashGridFilteredRadiance(uint tileIndex, uint2 localCellCoordMip0, out uint selectedMipLevel)
{
    selectedMipLevel = 0u;
    uint mip0Index = BurtGIRadianceCacheHashGridCellIndexFromTile(
        tileIndex,
        BurtGIRadianceCacheHashGridMipLocalCellIndex(localCellCoordMip0, 0u));
    uint4 mip0PackedValue = _BurtGIRadianceCacheHashGridValueBuffer[mip0Index];
    float4 filteredRadiance = BurtGIRadianceCacheHashGridUnpackRadiance(mip0PackedValue);
    filteredRadiance.a *= BurtGIRadianceCacheHashGridAgeConfidenceScale(mip0PackedValue);
    bool hasFilteredRadiance = filteredRadiance.a > 0.0001 && dot(filteredRadiance.rgb, filteredRadiance.rgb) > 0.0;

    [unroll]
    for (uint mipLevel = 1u; mipLevel < 4u; ++mipLevel)
    {
        uint mipIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(
            tileIndex,
            BurtGIRadianceCacheHashGridMipLocalCellIndex(localCellCoordMip0, mipLevel));
        uint4 mipPackedValue = _BurtGIRadianceCacheHashGridValueBuffer[mipIndex];
        float4 mipRadiance = BurtGIRadianceCacheHashGridUnpackRadiance(mipPackedValue);
        mipRadiance.a *= BurtGIRadianceCacheHashGridAgeConfidenceScale(mipPackedValue);
        bool hasMipRadiance = mipRadiance.a > 0.0001 && dot(mipRadiance.rgb, mipRadiance.rgb) > 0.0;
        bool preferMip = hasMipRadiance &&
            (!hasFilteredRadiance ||
                (filteredRadiance.a < BURT_GI_HASH_GRID_FILTER_CONFIDENCE && mipRadiance.a >= filteredRadiance.a));
        if (preferMip)
        {
            filteredRadiance = mipRadiance;
            hasFilteredRadiance = true;
            selectedMipLevel = mipLevel;
        }
    }

    return filteredRadiance;
}

bool BurtGIRadianceCacheHashGridTraceLite(
    float3 rayOriginWS,
    float3 rayDirectionWS,
    float maxTraceDistance,
    out float3 cachedRadiance,
    out float cachedConfidence)
{
    cachedRadiance = 0.0;
    cachedConfidence = 0.0;

    float traceDistance = max(maxTraceDistance, 1.0);
    uint maxSteps = 50u;
    float cellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    float minStepDistance = max(0.05, min(cellSize * 0.125, traceDistance / 64.0));
    float maxStepDistance = max(minStepDistance, min(cellSize * 0.5, traceDistance / 8.0));
    float sampleDistance = 0.0;

    [loop]
    for (uint stepIndex = 0u; stepIndex < maxSteps && sampleDistance <= traceDistance; ++stepIndex)
    {
        float3 samplePositionWS = rayOriginWS + rayDirectionWS * sampleDistance;
        float cameraDistance = distance(_BurtDeferredCameraWorldPosition.xyz, samplePositionWS);
        float logarithmicStep = exp2(floor(log2(max(cameraDistance / max(cellSize, 0.001), 1.0)))) * minStepDistance;
        float stepDistance = clamp(logarithmicStep, minStepDistance, maxStepDistance);
        uint tileHash = BurtGIRadianceCacheHashGridTileHash(samplePositionWS, rayDirectionWS);
        uint tileIndex;
        if (!BurtGIRadianceCacheHashGridFindTile(tileHash, tileIndex))
        {
            sampleDistance += stepDistance;
            continue;
        }

        uint selectedMipLevel;
        float4 cellRadiance = BurtGIRadianceCacheHashGridFilteredRadiance(
            tileIndex,
            BurtGIRadianceCacheHashGridLocalCellCoordMip0(samplePositionWS, rayDirectionWS),
            selectedMipLevel);
        if (cellRadiance.a > 0.0001 && dot(cellRadiance.rgb, cellRadiance.rgb) > 0.0)
        {
            cachedRadiance = cellRadiance.rgb;
            float mipConfidenceScale = 1.0 - min(0.3, (float)selectedMipLevel * 0.1);
            float stepT = saturate(sampleDistance / traceDistance);
            cachedConfidence = saturate(cellRadiance.a * mipConfidenceScale * (1.0 - stepT * 0.35));
            return true;
        }

        sampleDistance += stepDistance;
    }

    return false;
}

void BurtGIScreenProbeAdaptivePlacement(uint3 dispatchThreadId)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.y);
    uint tileCapacity = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.z);
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint adaptiveSubGridSize = max(1u, (uint)_BurtGIScreenProbeAdaptivePlacementParams.z);
    uint adaptiveLevel = min(15u, max(1u, (uint)_BurtGIScreenProbeAdaptivePlacementParams.w));
    uint2 adaptiveFineGridSize = uint2(screenProbeWidth, screenProbeHeight) * adaptiveSubGridSize;
    uint2 adaptiveFineProbeCoord = dispatchThreadId.xy;
    if (adaptiveFineProbeCoord.x >= adaptiveFineGridSize.x || adaptiveFineProbeCoord.y >= adaptiveFineGridSize.y)
    {
        return;
    }

    uint previousSubGridSize = adaptiveSubGridSize >> 1u;
    if (previousSubGridSize > 1u &&
        (adaptiveFineProbeCoord.x % previousSubGridSize) == 0u &&
        (adaptiveFineProbeCoord.y % previousSubGridSize) == 0u)
    {
        return;
    }

    uint2 screenProbeCoord = min(adaptiveFineProbeCoord / adaptiveSubGridSize, uint2(screenProbeWidth - 1u, screenProbeHeight - 1u));
    uint2 adaptiveCellCoord = adaptiveFineProbeCoord - screenProbeCoord * adaptiveSubGridSize;
    if (adaptiveCellCoord.x == 0u && adaptiveCellCoord.y == 0u)
    {
        return;
    }

    if (screenProbeCoord.x >= screenProbeWidth || screenProbeCoord.y >= screenProbeHeight)
    {
        return;
    }

    float rawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(screenProbeCoord, 0));
    float4 encodedNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(screenProbeCoord, 0));
    float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(screenProbeCoord, 0));
    bool validPlacement = encodedNormal.a > 0.5f &&
        encodedPosition.a > 0.5f &&
        !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth);
    if (!validPlacement)
    {
        return;
    }

    if (BurtGIScreenProbeShouldSkipAdaptivePlacement(encodedPosition.a))
    {
        return;
    }

    uint2 rightProbeCoord = uint2(min(screenProbeCoord.x + 1u, screenProbeWidth - 1u), screenProbeCoord.y);
    uint2 downProbeCoord = uint2(screenProbeCoord.x, min(screenProbeCoord.y + 1u, screenProbeHeight - 1u));
    uint2 rightDownProbeCoord = uint2(rightProbeCoord.x, downProbeCoord.y);
    float rightDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(rightProbeCoord, 0));
    float downDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(downProbeCoord, 0));
    float rightDownDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(rightDownProbeCoord, 0));
    float4 rightNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(rightProbeCoord, 0));
    float4 downNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(downProbeCoord, 0));
    float4 rightDownNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(rightDownProbeCoord, 0));
    float4 rightPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(rightProbeCoord, 0));
    float4 downPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(downProbeCoord, 0));
    float4 rightDownPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(rightDownProbeCoord, 0));
    float3 normalWS = BurtGIScreenProbeDecodeNormalWS(encodedNormal);
    bool rightValid = rightNormal.a > 0.5f &&
        rightPosition.a > 0.5f &&
        !BurtGIScreenProbeTraceCompactIsSkyDepth(rightDepth);
    bool downValid = downNormal.a > 0.5f &&
        downPosition.a > 0.5f &&
        !BurtGIScreenProbeTraceCompactIsSkyDepth(downDepth);
    bool rightDownValid = rightDownNormal.a > 0.5f &&
        rightDownPosition.a > 0.5f &&
        !BurtGIScreenProbeTraceCompactIsSkyDepth(rightDownDepth);
    rightValid = rightValid && !BurtGIScreenProbeShouldSkipAdaptivePlacement(rightPosition.a);
    downValid = downValid && !BurtGIScreenProbeShouldSkipAdaptivePlacement(downPosition.a);
    rightDownValid = rightDownValid && !BurtGIScreenProbeShouldSkipAdaptivePlacement(rightDownPosition.a);
    float3 rightNormalWS = rightValid ? BurtGIScreenProbeDecodeNormalWS(rightNormal) : normalWS;
    float3 downNormalWS = downValid ? BurtGIScreenProbeDecodeNormalWS(downNormal) : normalWS;
    float3 rightDownNormalWS = rightDownValid ? BurtGIScreenProbeDecodeNormalWS(rightDownNormal) : normalWS;
    float2 adaptiveCellUV = (float2(adaptiveCellCoord) + 0.5f) / (float)adaptiveSubGridSize;
    float2 bilinearUV = saturate(adaptiveCellUV);
    float4 bilinearWeights = float4(
        (1.0 - bilinearUV.x) * (1.0 - bilinearUV.y),
        bilinearUV.x * (1.0 - bilinearUV.y),
        (1.0 - bilinearUV.x) * bilinearUV.y,
        bilinearUV.x * bilinearUV.y);
    float4 validWeights = bilinearWeights * float4(1.0, rightValid ? 1.0 : 0.0, downValid ? 1.0 : 0.0, rightDownValid ? 1.0 : 0.0);
    float validWeightSum = dot(validWeights, float4(1.0, 1.0, 1.0, 1.0));
    float invValidWeightSum = rcp(max(validWeightSum, 0.0001));
    float3 interpolatedNormalWS = BurtGIScreenProbeTraceSafeNormalize(
        normalWS * validWeights.x +
        rightNormalWS * validWeights.y +
        downNormalWS * validWeights.z +
        rightDownNormalWS * validWeights.w,
        normalWS);
    float3 interpolatedPositionWS =
        (encodedPosition.xyz * validWeights.x +
            rightPosition.xyz * validWeights.y +
            downPosition.xyz * validWeights.z +
            rightDownPosition.xyz * validWeights.w) * invValidWeightSum;
    float interpolatedDepth =
        (rawDepth * validWeights.x +
            rightDepth * validWeights.y +
            downDepth * validWeights.z +
            rightDownDepth * validWeights.w) * invValidWeightSum;
    float normalEdge = max(
        max(1.0 - saturate(dot(interpolatedNormalWS, rightNormalWS)), 1.0 - saturate(dot(interpolatedNormalWS, downNormalWS))),
        max(1.0 - saturate(dot(interpolatedNormalWS, normalWS)), 1.0 - saturate(dot(interpolatedNormalWS, rightDownNormalWS))));
    float depthEdge = max(
        max(abs(rawDepth - interpolatedDepth), rightValid ? abs(rightDepth - interpolatedDepth) : 0.0),
        max(downValid ? abs(downDepth - interpolatedDepth) : 0.0, rightDownValid ? abs(rightDownDepth - interpolatedDepth) : 0.0)) * 32.0;
    float positionEdge = max(
        max(distance(encodedPosition.xyz, interpolatedPositionWS), rightValid ? distance(rightPosition.xyz, interpolatedPositionWS) : 0.0),
        max(downValid ? distance(downPosition.xyz, interpolatedPositionWS) : 0.0, rightDownValid ? distance(rightDownPosition.xyz, interpolatedPositionWS) : 0.0)) * 0.05;
    float invalidCornerEdge = saturate(1.0 - validWeightSum) * 0.75;
    float adaptiveEdgeScore = max(max(depthEdge, max(normalEdge, positionEdge)), invalidCornerEdge);
    float centerBias = 1.0f - saturate(distance(adaptiveCellUV, float2(0.5f, 0.5f)) * 1.41421356f);
    float layerWeight = rcp(1.0f + (float)adaptiveLevel * 0.18f);
    float candidateScore = adaptiveEdgeScore * lerp(0.75f, 1.15f, centerBias) * layerWeight;
    float normalReject00 = 1.0 - step(0.92, dot(normalWS, interpolatedNormalWS));
    float normalReject10 = rightValid ? 1.0 - step(0.92, dot(rightNormalWS, interpolatedNormalWS)) : 1.0;
    float normalReject01 = downValid ? 1.0 - step(0.92, dot(downNormalWS, interpolatedNormalWS)) : 1.0;
    float normalReject11 = rightDownValid ? 1.0 - step(0.92, dot(rightDownNormalWS, interpolatedNormalWS)) : 1.0;
    float depthReject00 = step(0.08, abs(rawDepth - interpolatedDepth) * 32.0);
    float depthReject10 = rightValid ? step(0.08, abs(rightDepth - interpolatedDepth) * 32.0) : 1.0;
    float depthReject01 = downValid ? step(0.08, abs(downDepth - interpolatedDepth) * 32.0) : 1.0;
    float depthReject11 = rightDownValid ? step(0.08, abs(rightDownDepth - interpolatedDepth) * 32.0) : 1.0;
    float positionReject00 = step(0.08, distance(encodedPosition.xyz, interpolatedPositionWS) * 0.05);
    float positionReject10 = rightValid ? step(0.08, distance(rightPosition.xyz, interpolatedPositionWS) * 0.05) : 1.0;
    float positionReject01 = downValid ? step(0.08, distance(downPosition.xyz, interpolatedPositionWS) * 0.05) : 1.0;
    float positionReject11 = rightDownValid ? step(0.08, distance(rightDownPosition.xyz, interpolatedPositionWS) * 0.05) : 1.0;
    float4 acceptedWeights = validWeights * (1.0 - saturate(float4(
        max(max(normalReject00, depthReject00), positionReject00),
        max(max(normalReject10, depthReject10), positionReject10),
        max(max(normalReject01, depthReject01), positionReject01),
        max(max(normalReject11, depthReject11), positionReject11))));
    float acceptedWeightSum = dot(acceptedWeights, float4(1.0, 1.0, 1.0, 1.0));

    bool highEdgeCandidate = candidateScore > 0.08f;
    bool interpolationRejectCandidate = acceptedWeightSum < 0.999f;
    bool sparseCoverageCandidate = adaptiveLevel == 1u &&
        (((screenProbeCoord.x ^ screenProbeCoord.y ^ adaptiveCellCoord.x ^ adaptiveCellCoord.y) & 3u) == 0u);
    if (!highEdgeCandidate && !interpolationRejectCandidate && !sparseCoverageCandidate)
    {
        return;
    }

    uint adaptiveProbeIndex;
    InterlockedAdd(_BurtGIScreenProbeAdaptiveProbeNumBuffer[0], 1u, adaptiveProbeIndex);
    if (adaptiveProbeIndex >= maxAdaptiveProbeCount || adaptiveProbeIndex > 65515u)
    {
        return;
    }

    _BurtGIScreenProbeAdaptiveProbeDataBuffer[adaptiveProbeIndex] = BurtGIPackScreenProbeAdaptiveProbeData(adaptiveFineProbeCoord, adaptiveLevel);

    uint adaptiveSlot;
    InterlockedAdd(_BurtGIScreenProbeAdaptiveProbeHeaderTexture[screenProbeCoord], 1u, adaptiveSlot);
    if (adaptiveSlot >= tileCapacity)
    {
        return;
    }

    _BurtGIScreenProbeAdaptiveProbeIndicesTexture[uint2(screenProbeCoord.x * tileCapacity + adaptiveSlot, screenProbeCoord.y)] = adaptiveProbeIndex;
}

[numthreads(8, 8, 1)]
void ScreenProbePlacementAdaptiveCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIScreenProbeAdaptivePlacement(dispatchThreadId);
}

[numthreads(8, 8, 1)]
void ScreenProbeAdaptivePlacementLiteCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIScreenProbeAdaptivePlacement(dispatchThreadId);
}

[numthreads(1, 1, 1)]
void ScreenProbeIndirectArgsSetupCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint probeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight) + BurtGIGetScreenProbeAdaptiveCount(maxAdaptiveProbeCount);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeIndirectArgsParams.x));
    uint gatherResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeIndirectArgsParams.y));
    uint gatherResolutionWithBorder = max(1u, min(64u, (uint)_BurtGIScreenProbeIndirectArgsParams.z));
    uint lightSampleResolutionXY = max(1u, min(8u, (uint)_BurtGIScreenProbeIndirectArgsParams.w));
    uint threadGroupSize = max(1u, _BurtGIScreenProbeTraceCompactGroupSize);

    BurtGIWriteDispatchArgs(0u, probeCount, 1u);
    BurtGIWriteDispatchArgs(1u, probeCount, threadGroupSize);
    BurtGIWriteDispatchArgs(2u, probeCount * traceResolution * traceResolution, threadGroupSize);
    BurtGIWriteDispatchArgs(3u, probeCount * gatherResolution * gatherResolution, threadGroupSize);
    BurtGIWriteDispatchArgs(4u, probeCount * gatherResolutionWithBorder * gatherResolutionWithBorder, threadGroupSize);
    BurtGIWriteDispatchArgs(5u, probeCount * lightSampleResolutionXY * lightSampleResolutionXY, threadGroupSize);
}

[numthreads(BURT_GI_SCREEN_PROBE_USE_COUNT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_USE_COUNT_THREADGROUP_SIZE, 1)]
void ScreenProbeClearUseCountCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 useCountSize = max(uint2(1u, 1u), uint2((uint)_BurtGIScreenProbeUseCountParams.x, (uint)_BurtGIScreenProbeUseCountParams.y));
    uint2 pixelCoord = dispatchThreadId.xy;
    if (any(pixelCoord >= useCountSize))
    {
        return;
    }

    _BurtGIScreenProbeUseCountTexture[pixelCoord] = 0u;
}

[numthreads(BURT_GI_SCREEN_PROBE_USE_COUNT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_USE_COUNT_THREADGROUP_SIZE, 1)]
void ScreenProbeSceneVelocityCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 useCountSize = max(uint2(1u, 1u), uint2((uint)_BurtGIScreenProbeUseCountParams.x, (uint)_BurtGIScreenProbeUseCountParams.y));
    uint2 pixelCoord = dispatchThreadId.xy;
    if (any(pixelCoord >= useCountSize))
    {
        return;
    }

    float2 screenUV = ((float2)pixelCoord + 0.5) / (float2)useCountSize;
    float rawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(pixelCoord, 0));
    float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(pixelCoord, 0));
    float2 historyUV = screenUV;
    float projectedRawDepth;
    bool valid = encodedPosition.a > 0.5 &&
        !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth) &&
        BurtGIScreenProbeProjectPreviousPositionWS(encodedPosition.xyz, historyUV, projectedRawDepth);

    float2 velocity = valid ? screenUV - historyUV : 0.0;
    _BurtGIScreenProbeSceneVelocityOutputTexture[pixelCoord] = float4(velocity, 0.0, valid ? 1.0 : 0.0);
}

void BurtGIScreenProbeUseCountScatter(uint3 dispatchThreadId)
{
    uint2 useCountSize = max(uint2(1u, 1u), uint2((uint)_BurtGIScreenProbeUseCountParams.x, (uint)_BurtGIScreenProbeUseCountParams.y));
    uint2 pixelCoord = dispatchThreadId.xy;
    if (any(pixelCoord >= useCountSize))
    {
        return;
    }

    float2 screenUV = ((float2)pixelCoord + 0.5) / (float2)useCountSize;
    float4 sceneVelocity = _BurtGIScreenProbeSceneVelocityTexture.Load(int3(pixelCoord, 0));
    float2 historyUV = screenUV - sceneVelocity.xy;
    float projectedRawDepth;
    if (sceneVelocity.w <= 0.5)
    {
        float rawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(pixelCoord, 0));
        float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(pixelCoord, 0));
        if (encodedPosition.a <= 0.5f ||
            BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth) ||
            !BurtGIScreenProbeProjectPreviousPositionWS(encodedPosition.xyz, historyUV, projectedRawDepth))
        {
            return;
        }
    }

    if (any(historyUV < 0.0) || any(historyUV > 1.0))
    {
        return;
    }

    float2 historyPixel = historyUV * (float2)useCountSize - 0.5f;
    float2 topLeft = floor(historyPixel);
    float2 bilinear = historyPixel - topLeft;
    float4 weights = float4(
        (1.0f - bilinear.x) * (1.0f - bilinear.y),
        bilinear.x * (1.0f - bilinear.y),
        (1.0f - bilinear.x) * bilinear.y,
        bilinear.x * bilinear.y);

    [unroll]
    for (uint tapIndex = 0u; tapIndex < 4u; ++tapIndex)
    {
        int2 tapOffset = int2((int)(tapIndex & 1u), (int)(tapIndex >> 1u));
        int2 tapCoordInt = (int2)topLeft + tapOffset;
        if (any(tapCoordInt < 0) || any(tapCoordInt >= (int2)useCountSize))
        {
            continue;
        }

        uint addValue = (uint)round(weights[tapIndex] * BURT_GI_SCREEN_PROBE_USE_COUNT_QUANTIZATION);
        if (addValue == 0u)
        {
            continue;
        }

#if defined(SHADER_API_METAL)
        // Metal has no typed-UAV atomics here; match XRender and leave the count at 0.
#else
        uint2 tapCoord = (uint2)tapCoordInt;
        uint ignored;
        InterlockedAdd(_BurtGIScreenProbeUseCountTexture[tapCoord], addValue, ignored);
#endif
    }
}

[numthreads(BURT_GI_SCREEN_PROBE_USE_COUNT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_USE_COUNT_THREADGROUP_SIZE, 1)]
void XGIScreenProbeUseCountScatterCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIScreenProbeUseCountScatter(dispatchThreadId);
}

[numthreads(BURT_GI_SCREEN_PROBE_USE_COUNT_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_USE_COUNT_THREADGROUP_SIZE, 1)]
void ScreenProbeUseCountScatterCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIScreenProbeUseCountScatter(dispatchThreadId);
}

[numthreads(BURT_GI_SCREEN_PROBE_TRACE_COMPACT_THREADGROUP_SIZE, 1, 1)]
void ScreenProbeTraceCompactCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint traceTexelsPerProbe = traceResolution * traceResolution;
    uint probeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight) + BurtGIGetScreenProbeAdaptiveCount(maxAdaptiveProbeCount);
    uint totalTraceTexelCount = min(
        max(1u, (uint)_BurtGIScreenProbeTraceCompactParams.x),
        probeCount * traceTexelsPerProbe);
    uint linearTraceTexelIndex = dispatchThreadId.x;
    if (linearTraceTexelIndex >= totalTraceTexelCount)
    {
        return;
    }

    uint screenProbeIndex = linearTraceTexelIndex / traceTexelsPerProbe;
    if (screenProbeIndex >= 0x100000u)
    {
        return;
    }

    uint localTraceTexelIndex = linearTraceTexelIndex - screenProbeIndex * traceTexelsPerProbe;
    uint2 traceTexelCoord = uint2(localTraceTexelIndex % traceResolution, localTraceTexelIndex / traceResolution);
    uint2 screenProbeCoord;
    uint2 atlasScreenProbeCoord;
    if (!BurtGIResolveScreenProbeSourceAndAtlasCoord(screenProbeIndex, screenProbeWidth, screenProbeHeight, maxAdaptiveProbeCount, screenProbeCoord, atlasScreenProbeCoord))
    {
        return;
    }

    float rawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(screenProbeCoord, 0));
    float4 encodedNormal = _BurtGIScreenProbeWorldNormalTexture.Load(int3(screenProbeCoord, 0));
    float4 encodedPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3(screenProbeCoord, 0));
    bool validPlacement = encodedNormal.a > 0.5f &&
        encodedPosition.a > 0.5f &&
        !BurtGIScreenProbeTraceCompactIsSkyDepth(rawDepth);
    if (!validPlacement)
    {
        return;
    }

    float maxTraceDistance = max(_BurtGIScreenProbeTraceParams.w, 0.5);
    float compactTracingEndDistance = max(_BurtGIScreenProbeTraceCompactParams.y, maxTraceDistance);
    float sceneDepth = max(BurtGILinearEyeDepth(rawDepth), 0.0);
    bool forceFullTrace = _BurtGIScreenProbeTraceCompactParams.w > 0.5f;
    if (!forceFullTrace && sceneDepth > compactTracingEndDistance)
    {
        return;
    }

    uint writeIndex;
    InterlockedAdd(_BurtGIScreenProbeTraceCompactTexelCountBuffer[0], 1u, writeIndex);
    if (writeIndex < totalTraceTexelCount)
    {
        _BurtGIScreenProbeTraceCompactTexelDataBuffer[writeIndex] =
            BurtGIEncodeScreenProbeTraceTexel(screenProbeIndex, traceTexelCoord);
    }
}

[numthreads(1, 1, 1)]
void ScreenProbeTraceGenArgsCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint threadCount = _BurtGIScreenProbeTraceCompactTexelCountBuffer[0];
    uint groupSize = max(1u, _BurtGIScreenProbeTraceCompactGroupSize);
    if (threadCount == 0u)
    {
        _BurtGIScreenProbeTraceCompactIndirectArgsBuffer[0] = uint3(0u, 1u, 1u);
        _BurtGIScreenProbeTraceCompactThreadCountXBuffer[0] = 0u;
        return;
    }

    uint groupCountX = BurtGIDivRoundUp(threadCount, groupSize);
    _BurtGIScreenProbeTraceCompactIndirectArgsBuffer[0] = uint3(groupCountX, 1u, 1u);
    _BurtGIScreenProbeTraceCompactThreadCountXBuffer[0] = groupCountX * groupSize;
}

void BurtGIScreenProbeTraceClear(uint3 dispatchThreadId)
{
    uint2 atlasSize = max(
        uint2(1u, 1u),
        uint2((uint)_BurtGIScreenProbeTraceParams.y, (uint)_BurtGIScreenProbeTraceParams.z));
    uint2 atlasCoord = dispatchThreadId.xy;
    if (any(atlasCoord >= atlasSize))
    {
        return;
    }

    _BurtGIScreenProbeTraceRadianceTexture[atlasCoord] = float4(0.0, 0.0, 0.0, 0.0);
    _BurtGIScreenProbeTraceHitTexture[atlasCoord] = 0.0;
}

[numthreads(BURT_GI_SCREEN_PROBE_TRACE_ATLAS_CLEAR_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_TRACE_ATLAS_CLEAR_THREADGROUP_SIZE, 1)]
void ScreenProbeTraceClearCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIScreenProbeTraceClear(dispatchThreadId);
}

[numthreads(BURT_GI_SCREEN_PROBE_TRACE_ATLAS_CLEAR_THREADGROUP_SIZE, BURT_GI_SCREEN_PROBE_TRACE_ATLAS_CLEAR_THREADGROUP_SIZE, 1)]
void ScreenProbeTraceAtlasClearCS(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    BurtGIScreenProbeTraceClear(dispatchThreadId);
}

#define BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCREEN 1u
#define BURT_GI_SCREEN_PROBE_TRACE_STAGE_HASH_GRID 2u
#define BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCENE_VOXEL 4u
#define BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCREEN_GRID 8u
#define BURT_GI_SCREEN_PROBE_TRACE_STAGE_CLIPMAP 16u
#define BURT_GI_SCREEN_PROBE_TRACE_STAGE_LOCAL_SKY 32u
#define BURT_GI_SCREEN_PROBE_TRACE_STAGE_SKY_CUBEMAP 64u
#define BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCENE (BURT_GI_SCREEN_PROBE_TRACE_STAGE_HASH_GRID | BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCENE_VOXEL | BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCREEN_GRID | BURT_GI_SCREEN_PROBE_TRACE_STAGE_CLIPMAP)
#define BURT_GI_SCREEN_PROBE_TRACE_STAGE_SKY (BURT_GI_SCREEN_PROBE_TRACE_STAGE_LOCAL_SKY | BURT_GI_SCREEN_PROBE_TRACE_STAGE_SKY_CUBEMAP)
#define BURT_GI_SCREEN_PROBE_TRACE_STAGE_ALL (BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCREEN | BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCENE | BURT_GI_SCREEN_PROBE_TRACE_STAGE_SKY)

void BurtGIScreenProbeTraceAtlasFromCompactStage(uint3 dispatchThreadId, uint traceStageMask)
{
    traceStageMask &= _BurtGIScreenProbeTraceStageMask;
    if (traceStageMask == 0u)
    {
        return;
    }

    uint dispatchThreadIndex = dispatchThreadId.y * _BurtGIScreenProbeTraceCompactThreadCountXBuffer[0] + dispatchThreadId.x;
    if (dispatchThreadIndex >= _BurtGIScreenProbeTraceCompactTexelCountBuffer[0])
    {
        return;
    }

    uint screenProbeIndex;
    uint2 traceTexelCoord;
    BurtGIDecodeScreenProbeTraceTexel(
        _BurtGIScreenProbeTraceCompactTexelDataBuffer[dispatchThreadIndex],
        screenProbeIndex,
        traceTexelCoord);

    uint screenProbeWidth = max(1u, (uint)_BurtGIScreenProbeGridParams.x);
    uint screenProbeHeight = max(1u, (uint)_BurtGIScreenProbeGridParams.y);
    uint maxAdaptiveProbeCount = max(1u, (uint)_BurtGIScreenProbeAdaptiveParams.w);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint2 atlasSize = max(
        uint2(1u, 1u),
        uint2((uint)_BurtGIScreenProbeTraceParams.y, (uint)_BurtGIScreenProbeTraceParams.z));
    uint2 screenProbeCoord;
    uint2 atlasScreenProbeCoord;
    if (!BurtGIResolveScreenProbeSourceAndAtlasCoord(screenProbeIndex, screenProbeWidth, screenProbeHeight, maxAdaptiveProbeCount, screenProbeCoord, atlasScreenProbeCoord) ||
        traceTexelCoord.x >= traceResolution ||
        traceTexelCoord.y >= traceResolution)
    {
        return;
    }

    uint uniformProbeCount = BurtGIGetScreenProbeUniformCount(screenProbeWidth, screenProbeHeight);
    bool isAdaptiveProbe = screenProbeIndex >= uniformProbeCount;
    uint2 atlasCoord = atlasScreenProbeCoord * traceResolution + traceTexelCoord;
    if (any(atlasCoord >= atlasSize))
    {
        return;
    }

    uint2 sourceTraceTexelCoord = traceTexelCoord;
    uint sourceTraceLevel = 0u;
    if (!isAdaptiveProbe)
    {
        uint rayInfo = _BurtGIScreenProbeImportanceRayInfoReadTexture[atlasCoord];
        BurtGIUnpackScreenProbeImportanceRayInfo(rayInfo, sourceTraceTexelCoord, sourceTraceLevel);
    }
    uint maxImportanceTraceResolution = min(64u, max(traceResolution, traceResolution << 1u));
    uint sourceMipSize = max(1u, maxImportanceTraceResolution >> min(sourceTraceLevel, 5u));
    if (sourceTraceTexelCoord.x >= sourceMipSize || sourceTraceTexelCoord.y >= sourceMipSize)
    {
        sourceTraceTexelCoord = traceTexelCoord;
        sourceTraceLevel = 0u;
        sourceMipSize = traceResolution;
    }

    float2 octUV = (float2((float)sourceTraceTexelCoord.x, (float)sourceTraceTexelCoord.y) + 0.5) / (float)sourceMipSize;
    float3 rayDirection = BurtGIEquiAreaSphericalMapping(octUV);
    uint2 importanceTraceTexelCoord = min((uint2)((float2(sourceTraceTexelCoord) + 0.5) * ((float)traceResolution / (float)sourceMipSize)), traceResolution - 1u);
    uint2 importancePDFProbeCoord = isAdaptiveProbe ? atlasScreenProbeCoord : screenProbeCoord;
    float importancePDF = BurtGIScreenProbeLoadImportancePDF(importancePDFProbeCoord, importanceTraceTexelCoord, traceResolution);
    float rayLevelWeight = rcp(1.0f + (float)sourceTraceLevel);
    float importanceEnergyWeight = lerp(0.85f, 1.15f, importancePDF) * lerp(1.0f, 0.85f, saturate((float)sourceTraceLevel * 0.25f));
    float importanceConfidenceWeight = lerp(0.8f, 1.1f, importancePDF) * lerp(1.0f, rayLevelWeight, 0.25f);
    float4 probeRadiance = _BurtGIScreenProbeRadianceTexture.Load(int3(screenProbeCoord, 0));
    float4 probeIrradiance = _BurtGIScreenProbeIrradianceTexture.Load(int3(screenProbeCoord, 0));
    float4 probeConfidence = _BurtGIScreenProbeConfidenceTexture.Load(int3(screenProbeCoord, 0));
    float4 probeHitDistance = _BurtGIScreenProbeHitDistanceTexture.Load(int3(screenProbeCoord, 0));
    float confidence = saturate(min(probeIrradiance.a, probeConfidence.r) * importanceConfidenceWeight);
    float hitRatio = saturate(max(probeRadiance.a, probeConfidence.g) * lerp(0.9f, 1.05f, importancePDF));
    float directionalEnergy = lerp(0.72, 1.18, saturate(rayDirection.z * 0.5 + 0.5)) * importanceEnergyWeight;
    float edgeDamping = lerp(1.0, 0.55, saturate(probeConfidence.b));
    float3 traceRadiance = max(probeRadiance.rgb, probeIrradiance.rgb * 0.65) * directionalEnergy * edgeDamping;
    float sceneTraceHit = 0.0f;
    if ((traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCREEN) == 0u)
    {
        float4 currentTraceRadiance = _BurtGIScreenProbeTraceRadianceTexture[atlasCoord];
        float currentTraceHit = saturate(_BurtGIScreenProbeTraceHitTexture[atlasCoord]);
        traceRadiance = max(currentTraceRadiance.rgb, 0.0f);
        hitRatio = saturate(max(hitRatio, currentTraceRadiance.a));
        confidence = max(confidence, currentTraceHit);
        sceneTraceHit = currentTraceHit;
    }

    float3 sourcePositionWS = 0.0;
    float3 sourceNormalWS = float3(0.0, 1.0, 0.0);
    bool hasSourcePlacement = BurtGIResolveScreenProbeTraceSourcePlacement(
        screenProbeIndex,
        screenProbeWidth,
        screenProbeHeight,
        maxAdaptiveProbeCount,
        screenProbeCoord,
        sourcePositionWS,
        sourceNormalWS);

    if (hasSourcePlacement)
    {
#if !defined(BURT_GI_SCREEN_PROBE_TRACE_VOXEL_OCTREE_STANDALONE)
        float3 screenTraceRadiance = 0.0;
        float screenTraceConfidence = 0.0;
#endif
        float sourceRawDepth = _BurtGIScreenProbeScreenDepthTexture.Load(int3(screenProbeCoord, 0));
        float sourceSceneDepth = BurtGIScreenProbeTraceCompactIsSkyDepth(sourceRawDepth) ? 0.0 : BurtGILinearEyeDepth(sourceRawDepth);
#if !defined(BURT_GI_SCREEN_PROBE_TRACE_VOXEL_OCTREE_STANDALONE)
        float screenTraceMaxDistance = min(max(0.01f, _BurtGIScreenProbeTraceParams.w), max(_BurtGIScreenProbeScreenTraceParams.y, 0.01f));
        if (sourceSceneDepth > 0.0001f && _BurtGIScreenProbeScreenTraceParams1.w > 0.0001f)
        {
            screenTraceMaxDistance = min(screenTraceMaxDistance, max(0.01f, sourceSceneDepth * _BurtGIScreenProbeScreenTraceParams1.w));
        }
        float screenTraceDistance = screenTraceMaxDistance;
#endif
        bool sourceBackfaceSkipMaterial = BurtGIScreenProbeShouldSkipScreenTraceHit(screenProbeCoord);
        bool backfaceSourceRay = dot(rayDirection, sourceNormalWS) < 0.0f;
        bool skipBackfaceSourceScreenTrace = backfaceSourceRay && sourceBackfaceSkipMaterial;
        float3 traceBiasNormalWS = skipBackfaceSourceScreenTrace ? -sourceNormalWS : sourceNormalWS;
        float screenTraceNormalBias = BurtGIScreenProbeResolveScreenTraceNormalBias(
            sourceSceneDepth,
            _BurtGIScreenProbeScreenTraceParams2.z,
            0.05f);
        float3 traceOriginWS = sourcePositionWS + traceBiasNormalWS * screenTraceNormalBias + rayDirection * screenTraceNormalBias;
#if !defined(BURT_GI_SCREEN_PROBE_TRACE_VOXEL_OCTREE_STANDALONE)
        if ((traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCREEN) != 0u &&
            !skipBackfaceSourceScreenTrace &&
            BurtGIScreenProbeTryHiZScreenTraceRadiance(
                traceOriginWS,
                BurtGIScreenProbeTraceSafeNormalize(rayDirection, traceBiasNormalWS),
                screenProbeCoord,
                traceTexelCoord,
                uint2(screenProbeWidth, screenProbeHeight),
                max(1.0f, _BurtGIScreenProbeTraceParams.w),
                sourceSceneDepth,
                directionalEnergy,
                screenTraceRadiance,
                screenTraceConfidence,
                screenTraceDistance))
        {
            float screenTraceDistanceWeight = 1.0f - saturate(screenTraceDistance / max(screenTraceMaxDistance, 0.01f)) * 0.2f;
            float screenTraceWeight = saturate(screenTraceConfidence * screenTraceDistanceWeight);
            traceRadiance = lerp(traceRadiance, screenTraceRadiance, screenTraceWeight);
            hitRatio = max(hitRatio, screenTraceWeight);
            confidence = max(confidence, screenTraceConfidence);
            sceneTraceHit = max(sceneTraceHit, screenTraceWeight);
        }
#endif

#if !defined(BURT_GI_SCREEN_PROBE_TRACE_VOXEL_OCTREE_STANDALONE)
        float3 hashGridRadiance = 0.0;
        float hashGridConfidence = 0.0;
        if ((traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_HASH_GRID) != 0u &&
            BurtGIRadianceCacheHashGridTraceLite(
                traceOriginWS,
                BurtGIScreenProbeTraceSafeNormalize(rayDirection, traceBiasNormalWS),
                max(1.0f, _BurtGIScreenProbeTraceParams.w),
                hashGridRadiance,
                hashGridConfidence))
        {
            traceRadiance = lerp(traceRadiance, hashGridRadiance * directionalEnergy, hashGridConfidence);
            hitRatio = max(hitRatio, hashGridConfidence);
            confidence = max(confidence, hashGridConfidence);
            sceneTraceHit = max(sceneTraceHit, hashGridConfidence);
        }
#endif

        float clipMapMinTraceDistanceBeforeInterpolation = max(1.0f, _BurtGIScreenProbeTraceParams.w);
        bool clipMapCoverageValid = false;
#if !defined(BURT_GI_SCREEN_PROBE_TRACE_VOXEL_OCTREE_STANDALONE)
        float3 clipMapRadiance = 0.0f;
        float clipMapConfidence = 0.0f;
        float clipMapConeHalfAngle = lerp(0.04f, 0.22f, saturate((float)sourceTraceLevel * 0.2f + importancePDF * 0.2f));
        float clipMapDither = frac(
            dot((float2)traceTexelCoord + (float)(_BurtGIRadianceCacheClipMapFrameIndex & 1023u), float2(0.06711056f, 0.00583715f)) +
            dot((float2)screenProbeCoord, float2(0.75487767f, 0.56984029f)));
        clipMapCoverageValid = (traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_CLIPMAP) != 0u &&
            BurtGIRadianceCacheTryGetCoverage(
                traceOriginWS,
                clipMapDither,
                clipMapMinTraceDistanceBeforeInterpolation);
#endif

        float3 sceneVoxelRadiance = 0.0;
        float sceneVoxelConfidence = 0.0;
        float sceneVoxelMaxTraceDistance = max(1.0f, _BurtGIScreenProbeTraceParams.w);
        if (clipMapCoverageValid)
        {
            sceneVoxelMaxTraceDistance = min(
                sceneVoxelMaxTraceDistance,
                max(1.0f, clipMapMinTraceDistanceBeforeInterpolation + BURT_GI_RADIANCE_CACHE_COVERAGE_TRACE_OFFSET));
        }

        float sceneVoxelHitDistance = sceneVoxelMaxTraceDistance;
        float voxelTraceConeHalfAngle = lerp(0.08f, 0.28f, saturate((float)sourceTraceLevel * 0.25f + importancePDF * 0.25f));
        float voxelTraceMinDistanceBias = max(0.0f, saturate(probeHitDistance.a) * voxelTraceConeHalfAngle * 0.5f);
        if ((traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCENE_VOXEL) != 0u &&
            BurtGIScreenProbeTrySampleSceneVoxelConeTrace(
                traceOriginWS,
                BurtGIScreenProbeTraceSafeNormalize(rayDirection, traceBiasNormalWS),
                sceneVoxelMaxTraceDistance,
                voxelTraceMinDistanceBias,
                voxelTraceConeHalfAngle,
                sceneVoxelRadiance,
                sceneVoxelConfidence,
                sceneVoxelHitDistance))
        {
            float voxelDistanceWeight = 1.0f - saturate(sceneVoxelHitDistance / max(sceneVoxelMaxTraceDistance, 0.001f)) * 0.25f;
            float voxelTraceWeight = saturate(sceneVoxelConfidence * voxelDistanceWeight);
            traceRadiance = lerp(traceRadiance, sceneVoxelRadiance * directionalEnergy, voxelTraceWeight);
            hitRatio = max(hitRatio, voxelTraceWeight);
            confidence = max(confidence, sceneVoxelConfidence);
            sceneTraceHit = max(sceneTraceHit, voxelTraceWeight);
        }

        float sceneTraceMaxDistance = max(1.0f, _BurtGIScreenProbeTraceParams.w);
        if (clipMapCoverageValid)
        {
            sceneTraceMaxDistance = min(
                sceneTraceMaxDistance,
                max(1.0f, clipMapMinTraceDistanceBeforeInterpolation + BURT_GI_RADIANCE_CACHE_COVERAGE_TRACE_OFFSET));
        }

        float3 gridStepDirection = BurtGIScreenProbeTraceGridStepDirection(rayDirection, sourceNormalWS);
        uint maxTraceSteps = max(2u, min(12u, (uint)ceil(sceneTraceMaxDistance)));
        float bestSceneTraceHit = 0.0f;
        float bestSceneTraceConfidence = 0.0f;
        float bestSceneTraceDistance = sceneTraceMaxDistance;
        float3 bestSceneTraceRadiance = 0.0f;

        if ((traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_SCREEN_GRID) != 0u)
        {
            [loop]
            for (uint stepIndex = 1u; stepIndex <= maxTraceSteps; ++stepIndex)
            {
                float2 sampleProbeCoordF = float2(screenProbeCoord) + gridStepDirection.xy * (float)stepIndex;
                int2 centerProbeCoordI = int2(round(sampleProbeCoordF));
                if (centerProbeCoordI.x < -1 ||
                    centerProbeCoordI.y < -1 ||
                    centerProbeCoordI.x > (int)screenProbeWidth ||
                    centerProbeCoordI.y > (int)screenProbeHeight)
                {
                    break;
                }

                [unroll]
                for (int neighborY = -1; neighborY <= 1; ++neighborY)
                {
                    [unroll]
                    for (int neighborX = -1; neighborX <= 1; ++neighborX)
                    {
                        int2 sampleProbeCoordI = centerProbeCoordI + int2(neighborX, neighborY);
                        if (sampleProbeCoordI.x < 0 ||
                            sampleProbeCoordI.y < 0 ||
                            sampleProbeCoordI.x >= (int)screenProbeWidth ||
                            sampleProbeCoordI.y >= (int)screenProbeHeight)
                        {
                            continue;
                        }

                        BurtGIScreenProbeEvaluateSceneTraceCandidate(
                            screenProbeCoord,
                            (uint2)sampleProbeCoordI,
                            sourcePositionWS,
                            sourceNormalWS,
                            rayDirection,
                            directionalEnergy,
                            sourceTraceLevel,
                            1.0f,
                            sceneTraceMaxDistance,
                            bestSceneTraceHit,
                            bestSceneTraceConfidence,
                            bestSceneTraceDistance,
                            bestSceneTraceRadiance);
                    }
                }

                float2 coneTangent = normalize(float2(-gridStepDirection.y, gridStepDirection.x) + float2(0.0001f, 0.0001f));
                float coneLaneOffset = max(1.0f, (float)stepIndex * 0.35f + (float)sourceTraceLevel * 0.5f);
                [unroll]
                for (int coneLane = -1; coneLane <= 1; coneLane += 2)
                {
                    int2 coneProbeCoordI = int2(round(sampleProbeCoordF + coneTangent * (float)coneLane * coneLaneOffset));
                    if (coneProbeCoordI.x < 0 ||
                        coneProbeCoordI.y < 0 ||
                        coneProbeCoordI.x >= (int)screenProbeWidth ||
                        coneProbeCoordI.y >= (int)screenProbeHeight)
                    {
                        continue;
                    }

                    BurtGIScreenProbeEvaluateSceneTraceCandidate(
                        screenProbeCoord,
                        (uint2)coneProbeCoordI,
                        sourcePositionWS,
                        sourceNormalWS,
                        rayDirection,
                        directionalEnergy,
                        sourceTraceLevel,
                        1.6f,
                        sceneTraceMaxDistance,
                        bestSceneTraceHit,
                        bestSceneTraceConfidence,
                        bestSceneTraceDistance,
                        bestSceneTraceRadiance);
                }

                if (bestSceneTraceHit > 0.65f)
                {
                    break;
                }
            }
        }

        if (bestSceneTraceHit > 0.001f)
        {
            float sceneTraceDistanceWeight = 1.0f - saturate(bestSceneTraceDistance / max(sceneTraceMaxDistance, 0.001f)) * 0.22f;
            float sceneTraceWeight = saturate(bestSceneTraceHit * sceneTraceDistanceWeight);
            sceneTraceHit = max(sceneTraceHit, sceneTraceWeight);
            traceRadiance = lerp(traceRadiance, bestSceneTraceRadiance, sceneTraceWeight);
            hitRatio = max(hitRatio, sceneTraceWeight);
            confidence = max(confidence, bestSceneTraceConfidence * sceneTraceWeight);
        }

#if !defined(BURT_GI_SCREEN_PROBE_TRACE_VOXEL_OCTREE_STANDALONE)
        if ((traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_CLIPMAP) != 0u &&
            clipMapCoverageValid &&
            BurtGISampleRadianceCacheClipMapInterpolated(
                traceOriginWS,
                BurtGIScreenProbeTraceSafeNormalize(rayDirection, traceBiasNormalWS),
                clipMapConeHalfAngle,
                clipMapDither,
                clipMapRadiance,
                clipMapConfidence))
        {
            float remainingTransparency = saturate(1.0f - sceneTraceHit);
            float clipMapWeight = saturate(clipMapConfidence * 0.85f * remainingTransparency);
            traceRadiance = lerp(traceRadiance, clipMapRadiance * directionalEnergy, clipMapWeight);
            hitRatio = max(hitRatio, clipMapWeight);
            confidence = max(confidence, clipMapConfidence * max(clipMapWeight, 0.001f));
            sceneTraceHit = saturate(sceneTraceHit + clipMapWeight);
        }
#endif

#if !defined(BURT_GI_SCREEN_PROBE_TRACE_VOXEL_OCTREE_STANDALONE)
        bool localSkySkyLeakApplied = false;
        if ((traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_LOCAL_SKY) != 0u &&
            sceneTraceHit < 0.65f)
        {
            float3 localSkyRadiance;
            float localSkyHitDistance;
            if (BurtGIScreenProbeTrySampleLocalSkyProbe(
                    traceOriginWS,
                    rayDirection,
                    max(1.0f, _BurtGIScreenProbeTraceParams.w),
                    localSkyRadiance,
                    localSkyHitDistance))
            {
                if (_BurtGIScreenProbeSkyLeakParams.x > 0.0001f)
                {
                    float3 skyLeakRadiance;
                    if (BurtGIScreenProbeTrySampleSkyRadiance(
                            rayDirection,
                            saturate(_BurtGIScreenProbeSkyLeakParams.z),
                            skyLeakRadiance))
                    {
                        float skyLeakAmount = saturate(_BurtGIScreenProbeSkyLeakParams.x * localSkyHitDistance * _BurtGIScreenProbeSkyLeakParams.y);
                        localSkyRadiance += skyLeakRadiance * skyLeakAmount;
                        localSkySkyLeakApplied = true;
                    }
                }

                float localSkyDistanceWeight = 1.0f - saturate(localSkyHitDistance / max(1.0f, _BurtGIScreenProbeTraceParams.w)) * 0.2f;
                float localSkyWeight = saturate((1.0f - sceneTraceHit) * localSkyDistanceWeight);
                traceRadiance = lerp(traceRadiance, localSkyRadiance * directionalEnergy, localSkyWeight);
                hitRatio = max(hitRatio, localSkyWeight);
                confidence = max(confidence, localSkyWeight * 0.75f);
                sceneTraceHit = max(sceneTraceHit, localSkyWeight);
            }
        }

        // Match XRender's transparent-ray fallback: sky contributes radiance but is not a geometry hit.
        if ((traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_SKY_CUBEMAP) != 0u &&
            sceneTraceHit < 0.65f &&
            _BurtGIScreenProbeSkyLeakParams.w > 0.5f)
        {
            float3 skyRadiance;
            float skyRoughness = saturate(0.18f + (float)sourceTraceLevel * 0.22f + importancePDF * 0.16f);
            if (BurtGIScreenProbeTrySampleSkyRadiance(rayDirection, skyRoughness, skyRadiance))
            {
                float skyWeight = saturate((1.0f - sceneTraceHit) * (0.42f + 0.38f * importancePDF));
                traceRadiance = lerp(traceRadiance, skyRadiance * directionalEnergy, skyWeight);
                confidence = max(confidence, skyWeight * 0.35f);
            }
        }

        if ((traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_SKY_CUBEMAP) != 0u &&
            sceneTraceHit > 0.001f &&
            !localSkySkyLeakApplied &&
            _BurtGIScreenProbeSkyLeakParams.x > 0.0001f)
        {
            float3 skyLeakRadiance;
            if (BurtGIScreenProbeTrySampleSkyRadiance(
                    rayDirection,
                    saturate(_BurtGIScreenProbeSkyLeakParams.z),
                    skyLeakRadiance))
            {
                float traceHitDistance = min(screenTraceDistance, min(sceneVoxelHitDistance, bestSceneTraceDistance));
                float skyLeakAmount = saturate(_BurtGIScreenProbeSkyLeakParams.x * traceHitDistance * _BurtGIScreenProbeSkyLeakParams.y);
                traceRadiance += skyLeakRadiance * directionalEnergy * skyLeakAmount;
                confidence = max(confidence, skyLeakAmount * 0.35f);
            }
        }
#endif
    }

    traceRadiance = max(traceRadiance, float3(0.0, 0.0, 0.0));
    if ((traceStageMask & BURT_GI_SCREEN_PROBE_TRACE_STAGE_SKY) != 0u)
    {
        traceRadiance *= max(_BurtGIScreenProbeTraceIntensityParams.x, 0.0f);
        float maxRayIntensity = max(_BurtGIScreenProbeTraceModeParams.z, 0.01f);
        float maxTraceRadiance = max(traceRadiance.r, max(traceRadiance.g, traceRadiance.b));
        if (maxTraceRadiance > maxRayIntensity)
        {
            traceRadiance *= maxRayIntensity / maxTraceRadiance;
        }
    }

    _BurtGIScreenProbeTraceRadianceTexture[atlasCoord] = float4(traceRadiance, hitRatio);
    _BurtGIScreenProbeTraceHitTexture[atlasCoord] = saturate(max(sceneTraceHit, confidence * hitRatio) * importanceConfidenceWeight);
}

