float4 _BurtGITranslucencyVolumeGridSize; // xyz=volume grid size, w=apply scale.
float4 _BurtGITranslucencyVolumeParams0; // x=near, y=far, z=depth fade power, w=screen-probe blend.
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
float4 _BurtGITranslucencyVolumeTemporalParams; // x=history feedback, y=history valid, z=confidence weight, w=world reprojection.
float4 _BurtGITranslucencyVolumeSpatialFilterParams; // x=sample count, y=sigma, z=enabled, w=confidence weight.
float4 _BurtGITranslucencyVolumeSpatialFilterDirection; // xyz=separable filter axis.
#endif
float4 _BurtGITranslucencyVolumeGridZParams; // x=log scale, y=log bias, z=slice scale.
float4 _BurtGITranslucencyVolumeHiZParams; // x=HiZ visibility enabled, y=depth-buffer center offset, z=accepted depth offset threshold.
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
float4 _BurtGITranslucencyVolumeExposureParams; // x=history exposure correction.
#endif
float4 _BurtGITranslucencyVolumeJitterParams; // xyz=current froxel jitter offset.
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
float4 _BurtGITranslucencyVolumePreviousJitterParams; // xyz=previous froxel jitter offset.
#endif
float4 _BurtGITranslucencyVolumeTraceParams; // x=max ray intensity, y=max trace distance, z=step factor, w=voxel trace start distance scale.
float4 _BurtGITranslucencyVolumeTraceAtlasParams; // x=oct trace resolution, y=temporal direction frame.
float4 _ZBufferParams;
float4 _BurtDeferredCameraWorldPosition;
float4x4 _BurtDeferredInverseViewProjectionMatrix;
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
float4x4 _BurtGIPreviousViewProjectionMatrix;
#endif

float BurtGITranslucencyVolumeLuminance(float3 color)
{
    return dot(color, float3(0.2126f, 0.7152f, 0.0722f));
}

float4 BurtGITranslucencyVolumeSHBasis2(float3 direction)
{
    return float4(
        0.28209479177387814f,
        -0.4886025119029199f * direction.y,
        0.4886025119029199f * direction.z,
        -0.4886025119029199f * direction.x);
}

float3 BurtGITranslucencyVolumeClampRayIntensity(float3 radiance)
{
    float maxLighting = max(max(abs(radiance.r), abs(radiance.g)), abs(radiance.b));
    float maxRayIntensity = max(_BurtGITranslucencyVolumeTraceParams.x, 0.1f);
    if (maxLighting > maxRayIntensity)
    {
        radiance *= maxRayIntensity / maxLighting;
    }

    return radiance;
}

float3 BurtGITranslucencyVolumeSafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001f ? value * rsqrt(lengthSq) : fallback;
}

float3 BurtGITranslucencyVolumeEquiAreaSphericalMapping(float2 uv)
{
    uv = 2.0f * uv - 1.0f;
    float d = 1.0f - (abs(uv.x) + abs(uv.y));
    float r = 1.0f - abs(d);
    float phi = r == 0.0f ? 0.0f : 0.7853981633974483f * ((abs(uv.y) - abs(uv.x)) / r + 1.0f);
    float f = r * sqrt(max(2.0f - r * r, 0.0f));
    return BurtGITranslucencyVolumeSafeNormalize(float3(
        f * sign(uv.y) * abs(sin(phi)),
        sign(d) * (1.0f - r * r),
        f * sign(uv.x) * abs(cos(phi))),
        float3(0.0f, 1.0f, 0.0f));
}

float2 BurtGITranslucencyVolumeClipToUV(float2 clipXY)
{
    float2 uv = clipXY * 0.5f + 0.5f;
#if UNITY_UV_STARTS_AT_TOP
    uv.y = 1.0f - uv.y;
#endif
    return uv;
}

float2 BurtGITranslucencyVolumeUVToClipXY(float2 uv)
{
#if UNITY_UV_STARTS_AT_TOP
    uv.y = 1.0f - uv.y;
#endif
    return uv * 2.0f - 1.0f;
}

float3 BurtGITranslucencyVolumeClipToWorld(float4 clipPosition)
{
    float4 worldPosition = mul(_BurtDeferredInverseViewProjectionMatrix, clipPosition);
    return worldPosition.xyz / max(worldPosition.w, 0.00001f);
}

float BurtGITranslucencyVolumeLinearDepthFromSlice(float z01, float3 gridSize)
{
    float logValue = z01 * max(gridSize.z, 1.0f) / max(_BurtGITranslucencyVolumeGridZParams.z, 0.00001f);
    float linearDepth = (exp2(logValue) - _BurtGITranslucencyVolumeGridZParams.y) / max(_BurtGITranslucencyVolumeGridZParams.x, 0.00001f);
    return clamp(linearDepth, max(_BurtGITranslucencyVolumeParams0.x, 0.01f), max(_BurtGITranslucencyVolumeParams0.y, _BurtGITranslucencyVolumeParams0.x + 1.0f));
}

float BurtGITranslucencyVolumeNormalizedSliceFromLinearDepth(float linearDepth, float3 gridSize)
{
    return log2(max(linearDepth, 0.00001f) * _BurtGITranslucencyVolumeGridZParams.x + _BurtGITranslucencyVolumeGridZParams.y) *
        _BurtGITranslucencyVolumeGridZParams.z / max(gridSize.z, 1.0f);
}

bool BurtGITranslucencyVolumeIsSkyDepth(float rawDepth)
{
#if defined(UNITY_REVERSED_Z)
    return rawDepth <= 0.00001f;
#else
    return rawDepth >= 0.99999f;
#endif
}

float BurtGITranslucencyVolumeLinearEyeDepth(float rawDepth)
{
    return rcp(max(_ZBufferParams.z * rawDepth + _ZBufferParams.w, 0.000001f));
}

float BurtGITranslucencyVolumeRawDepthFromLinearDepth(float linearDepth)
{
    float denominator = abs(_ZBufferParams.z) > 0.000001f
        ? _ZBufferParams.z
        : (_ZBufferParams.z < 0.0f ? -0.000001f : 0.000001f);
    return saturate((rcp(max(linearDepth, 0.000001f)) - _ZBufferParams.w) / denominator);
}

bool BurtGITranslucencyVolumeIsFroxelVisible(uint3 id, float2 uv, float3 gridSize)
{
    if (_BurtGITranslucencyVolumeHiZParams.x < 0.5f)
    {
        return true;
    }

    uint hiZWidth = 1u;
    uint hiZHeight = 1u;
    _BurtHiZDepthTexture.GetDimensions(hiZWidth, hiZHeight);
    uint2 hiZSize = max(uint2(hiZWidth, hiZHeight), uint2(1u, 1u));
    uint2 hiZPixel = min((uint2)floor(saturate(uv) * (float2)hiZSize), hiZSize - 1u);
    float sceneRawDepth = _BurtHiZDepthTexture.Load(int3(hiZPixel, 0));
    if (BurtGITranslucencyVolumeIsSkyDepth(sceneRawDepth))
    {
        return true;
    }

    float froxelMinZ01 = max((float)id.z - 1.0f, 0.0f) / max(gridSize.z, 1.0f);
    float froxelMinDepth = BurtGITranslucencyVolumeLinearDepthFromSlice(froxelMinZ01, gridSize);
    float froxelMinRawDepth = BurtGITranslucencyVolumeRawDepthFromLinearDepth(froxelMinDepth);
#if defined(UNITY_REVERSED_Z)
    return froxelMinRawDepth >= sceneRawDepth - 0.00001f;
#else
    return froxelMinRawDepth <= sceneRawDepth + 0.00001f;
#endif
}

void BurtGITranslucencyVolumeApplyDepthConstraintToJitter(uint3 id, float2 uv, float3 gridSize, inout float3 jitterOffset)
{
    if (_BurtGITranslucencyVolumeHiZParams.x < 0.5f)
    {
        return;
    }

    uint hiZWidth = 1u;
    uint hiZHeight = 1u;
    _BurtHiZDepthTexture.GetDimensions(hiZWidth, hiZHeight);
    uint2 hiZSize = max(uint2(hiZWidth, hiZHeight), uint2(1u, 1u));
    uint2 hiZPixel = min((uint2)floor(saturate(uv) * (float2)hiZSize), hiZSize - 1u);
    float sceneRawDepth = _BurtHiZDepthTexture.Load(int3(hiZPixel, 0));
    if (BurtGITranslucencyVolumeIsSkyDepth(sceneRawDepth))
    {
        return;
    }

    float sceneDepth = BurtGITranslucencyVolumeLinearEyeDepth(sceneRawDepth);
    float sceneSlice = BurtGITranslucencyVolumeNormalizedSliceFromLinearDepth(sceneDepth, gridSize) * max(gridSize.z, 1.0f);
    float gridCenterOffsetFromDepthBuffer = _BurtGITranslucencyVolumeHiZParams.y;
    if (gridCenterOffsetFromDepthBuffer < 0.0f)
    {
        return;
    }

    float maxAcceptedDepthOffsetInSlices = max(_BurtGITranslucencyVolumeHiZParams.z, 0.0f);
    float targetSlice = sceneSlice - gridCenterOffsetFromDepthBuffer;
    float currentSlice = (float)id.z + jitterOffset.z;
    float depthToSampleGridOffset = targetSlice - currentSlice;
    if (depthToSampleGridOffset < 0.0f && -depthToSampleGridOffset < maxAcceptedDepthOffsetInSlices)
    {
        jitterOffset.z = clamp(jitterOffset.z + depthToSampleGridOffset, 0.0001f, 0.9999f);
    }
}

float3 BurtGITranslucencyVolumeCellWorldPosition(uint3 id, float2 uv, float z01, float3 gridSize)
{
    float2 clipXY = BurtGITranslucencyVolumeUVToClipXY(uv);
#if defined(UNITY_REVERSED_Z)
    float farClipZ = 0.0f;
#else
    float farClipZ = 1.0f;
#endif
    float3 farWorld = BurtGITranslucencyVolumeClipToWorld(float4(clipXY, farClipZ, 1.0f));
    float3 cameraWorld = _BurtDeferredCameraWorldPosition.xyz;
    float3 rayDirection = BurtGITranslucencyVolumeSafeNormalize(farWorld - cameraWorld, float3(0.0f, 0.0f, 1.0f));
    float linearDepth = BurtGITranslucencyVolumeLinearDepthFromSlice(z01, gridSize);
    return cameraWorld + rayDirection * linearDepth;
}

#if 0
float3 BurtGITranslucencyVolumeSceneVoxelWorldToUVW(float3 worldPosition)
{
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float extent = max(centerExtent.w, 0.001f);
    return (worldPosition - centerExtent.xyz) / (extent * 2.0f) + 0.5f;
}

bool BurtGITranslucencyVolumeOctreeMaskContains(uint lowMask, uint highMask, uint bitIndex)
{
    uint word = bitIndex < 32u ? lowMask : highMask;
    return ((word >> (bitIndex & 31u)) & 1u) != 0u;
}

bool BurtGITranslucencyVolumeSceneVoxelOctreeMayContain(float3 samplePosition)
{
    if (_BurtGISceneVoxelOctreeValid <= 0.5f)
    {
        return true;
    }

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGITranslucencyVolumeSceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0f) || any(uvw > 1.0f))
    {
        return false;
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    uint3 parentCoord = voxelCoord >> 4u;
    uint3 leafCoord = voxelCoord >> 2u;
    uint rootBit = parentCoord.x + parentCoord.y * 4u + parentCoord.z * 16u;
    if (!BurtGITranslucencyVolumeOctreeMaskContains(
            _BurtGISceneVoxelOctreeRootLowTexture[uint3(0u, 0u, 0u)],
            _BurtGISceneVoxelOctreeRootHighTexture[uint3(0u, 0u, 0u)],
            rootBit))
    {
        return false;
    }

    uint3 parentChild = leafCoord & 3u;
    uint parentBit = parentChild.x + parentChild.y * 4u + parentChild.z * 16u;
    if (!BurtGITranslucencyVolumeOctreeMaskContains(
            _BurtGISceneVoxelOctreeParentLowTexture[parentCoord],
            _BurtGISceneVoxelOctreeParentHighTexture[parentCoord],
            parentBit))
    {
        return false;
    }

    uint3 leafChild = voxelCoord & 3u;
    uint leafBit = leafChild.x + leafChild.y * 4u + leafChild.z * 16u;
    return BurtGITranslucencyVolumeOctreeMaskContains(
        _BurtGISceneVoxelOctreeLeafLowTexture[leafCoord],
        _BurtGISceneVoxelOctreeLeafHighTexture[leafCoord],
        leafBit);
}

uint BurtGITranslucencyVolumeTrySampleSceneVoxelOccupancy(float3 samplePosition, inout float occupancy)
{
    occupancy = 0.0f;

    if (!BurtGITranslucencyVolumeSceneVoxelOctreeMayContain(samplePosition))
    {
        return 0u;
    }

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelOccupancyMipReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1, 1, 1));
    float3 uvw = BurtGITranslucencyVolumeSceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0f) || any(uvw > 1.0f))
    {
        return 0u;
    }

    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1);
    float4 occupancyMip = _BurtGISceneVoxelOccupancyMipReadTexture.Load(int4((int3)coord, 0));
    occupancy = saturate(max(occupancyMip.x, occupancyMip.y));
    return occupancy > 0.001f ? 1u : 0u;
}

uint BurtGITranslucencyVolumeTrySampleSceneVoxelGeometry(
    float3 samplePosition,
    float3 traceDirection,
    inout float occupancy,
    inout float normalFacingWeight)
{
    occupancy = 0.0f;
    normalFacingWeight = 0.0f;

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelGeometryReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1, 1, 1));
    float3 uvw = BurtGITranslucencyVolumeSceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0f) || any(uvw > 1.0f))
    {
        return 0u;
    }

    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1);
    float4 geometry = _BurtGISceneVoxelGeometryReadTexture.Load(int4((int3)coord, 0));
    occupancy = saturate(geometry.a);
    if (occupancy <= 0.001f)
    {
        return 0u;
    }

    float3 normalWS = BurtGITranslucencyVolumeSafeNormalize(geometry.xyz * 2.0f - 1.0f, float3(0.0f, 1.0f, 0.0f));
    float3 directionWS = BurtGITranslucencyVolumeSafeNormalize(traceDirection, float3(0.0f, 0.0f, 1.0f));
    normalFacingWeight = saturate(dot(normalWS, -directionWS) * 0.65f + 0.35f);
    return normalFacingWeight > 0.001f ? 1u : 0u;
}

uint BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHit(
    Texture3D<float4> geometryTexture,
    Texture3D<float4> lightingTexture,
    float4 centerExtent,
    float3 samplePosition,
    float3 traceDirection,
    inout float3 radiance,
    inout float occupancy,
    inout float normalFacingWeight)
{
    radiance = 0.0f;
    occupancy = 0.0f;
    normalFacingWeight = 0.0f;
    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    geometryTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1, 1, 1));
    float extent = max(centerExtent.w, 0.001f);
    float3 uvw = (samplePosition - centerExtent.xyz) / (extent * 2.0f) + 0.5f;
    if (any(uvw < 0.0f) || any(uvw > 1.0f))
    {
        return 0u;
    }

    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1);
    float4 geometry = geometryTexture.Load(int4((int3)coord, 0));
    float4 lighting = lightingTexture.Load(int4((int3)coord, 0));
    occupancy = saturate(geometry.a);
    radiance = max(lighting.rgb, 0.0f);
    if (occupancy <= 0.001f || lighting.a <= 0.001f || dot(radiance, radiance) <= 0.0f)
    {
        return 0u;
    }

    float3 normalWS = BurtGITranslucencyVolumeSafeNormalize(geometry.xyz * 2.0f - 1.0f, float3(0.0f, 1.0f, 0.0f));
    float3 directionWS = BurtGITranslucencyVolumeSafeNormalize(traceDirection, float3(0.0f, 0.0f, 1.0f));
    normalFacingWeight = saturate(dot(normalWS, -directionWS) * 0.65f + 0.35f);
    return normalFacingWeight > 0.001f ? 1u : 0u;
}

BurtGITranslucencyVolumeVoxelHitSample BurtGITranslucencyVolumeMakeVoxelHitSample(
    uint sampled,
    float3 radiance,
    float occupancy,
    float normalFacingWeight)
{
    BurtGITranslucencyVolumeVoxelHitSample result = (BurtGITranslucencyVolumeVoxelHitSample)0;
    result.Sampled = sampled;
    result.Radiance = radiance;
    result.Occupancy = occupancy;
    result.NormalFacingWeight = normalFacingWeight;
    result.HitDistance = 0.0f;
    return result;
}

BurtGITranslucencyVolumeVoxelHitSample BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHitByLevel(
    uint clipmapLevel,
    float3 samplePosition,
    float3 traceDirection)
{
    if (clipmapLevel == 1u)
    {
        float3 clipmapRadiance = 0.0f;
        float clipmapOccupancy = 0.0f;
        float clipmapNormalFacingWeight = 0.0f;
        uint sampled = BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap1GeometryReadTexture,
            _BurtGISceneVoxelClipmap1LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[1],
            samplePosition,
            traceDirection,
            clipmapRadiance,
            clipmapOccupancy,
            clipmapNormalFacingWeight);
        return BurtGITranslucencyVolumeMakeVoxelHitSample(
            sampled,
            sampled != 0u ? clipmapRadiance : 0.0f,
            sampled != 0u ? clipmapOccupancy : 0.0f,
            sampled != 0u ? clipmapNormalFacingWeight : 0.0f);
    }

    if (clipmapLevel == 2u)
    {
        float3 clipmapRadiance = 0.0f;
        float clipmapOccupancy = 0.0f;
        float clipmapNormalFacingWeight = 0.0f;
        uint sampled = BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap2GeometryReadTexture,
            _BurtGISceneVoxelClipmap2LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[2],
            samplePosition,
            traceDirection,
            clipmapRadiance,
            clipmapOccupancy,
            clipmapNormalFacingWeight);
        return BurtGITranslucencyVolumeMakeVoxelHitSample(
            sampled,
            sampled != 0u ? clipmapRadiance : 0.0f,
            sampled != 0u ? clipmapOccupancy : 0.0f,
            sampled != 0u ? clipmapNormalFacingWeight : 0.0f);
    }

    if (clipmapLevel == 3u)
    {
        float3 clipmapRadiance = 0.0f;
        float clipmapOccupancy = 0.0f;
        float clipmapNormalFacingWeight = 0.0f;
        uint sampled = BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap3GeometryReadTexture,
            _BurtGISceneVoxelClipmap3LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[3],
            samplePosition,
            traceDirection,
            clipmapRadiance,
            clipmapOccupancy,
            clipmapNormalFacingWeight);
        return BurtGITranslucencyVolumeMakeVoxelHitSample(
            sampled,
            sampled != 0u ? clipmapRadiance : 0.0f,
            sampled != 0u ? clipmapOccupancy : 0.0f,
            sampled != 0u ? clipmapNormalFacingWeight : 0.0f);
    }

    if (clipmapLevel == 4u)
    {
        float3 clipmapRadiance = 0.0f;
        float clipmapOccupancy = 0.0f;
        float clipmapNormalFacingWeight = 0.0f;
        uint sampled = BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap4GeometryReadTexture,
            _BurtGISceneVoxelClipmap4LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[4],
            samplePosition,
            traceDirection,
            clipmapRadiance,
            clipmapOccupancy,
            clipmapNormalFacingWeight);
        return BurtGITranslucencyVolumeMakeVoxelHitSample(
            sampled,
            sampled != 0u ? clipmapRadiance : 0.0f,
            sampled != 0u ? clipmapOccupancy : 0.0f,
            sampled != 0u ? clipmapNormalFacingWeight : 0.0f);
    }

    if (clipmapLevel == 5u)
    {
        float3 clipmapRadiance = 0.0f;
        float clipmapOccupancy = 0.0f;
        float clipmapNormalFacingWeight = 0.0f;
        uint sampled = BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHit(
            _BurtGISceneVoxelClipmap5GeometryReadTexture,
            _BurtGISceneVoxelClipmap5LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[5],
            samplePosition,
            traceDirection,
            clipmapRadiance,
            clipmapOccupancy,
            clipmapNormalFacingWeight);
        return BurtGITranslucencyVolumeMakeVoxelHitSample(
            sampled,
            sampled != 0u ? clipmapRadiance : 0.0f,
            sampled != 0u ? clipmapOccupancy : 0.0f,
            sampled != 0u ? clipmapNormalFacingWeight : 0.0f);
    }

    float fallbackOccupancy = 0.0f;
    float fallbackNormalFacingWeight = 0.0f;
    uint fallbackSampled = BurtGITranslucencyVolumeTrySampleSceneVoxelGeometry(
        samplePosition,
        traceDirection,
        fallbackOccupancy,
        fallbackNormalFacingWeight);
    if (fallbackSampled == 0u)
    {
        return BurtGITranslucencyVolumeMakeVoxelHitSample(0u, 0.0f, 0.0f, 0.0f);
    }

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelLightingReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1, 1, 1));
    float3 uvw = BurtGITranslucencyVolumeSceneVoxelWorldToUVW(samplePosition);
    uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1);
    float4 lighting = _BurtGISceneVoxelLightingReadTexture.Load(int4((int3)coord, 0));
    float3 fallbackRadiance = max(lighting.rgb, 0.0f);
    uint sampled = lighting.a > 0.001f && dot(fallbackRadiance, fallbackRadiance) > 0.0f ? 1u : 0u;
    return BurtGITranslucencyVolumeMakeVoxelHitSample(
        sampled,
        sampled != 0u ? fallbackRadiance : 0.0f,
        sampled != 0u ? fallbackOccupancy : 0.0f,
        sampled != 0u ? fallbackNormalFacingWeight : 0.0f);
}

BurtGITranslucencyVolumeVoxelHitSample BurtGITranslucencyVolumeTraceSceneVoxelLite(
    float3 worldPosition,
    float3 traceDirection,
    float z01)
{
    float3 voxelRadiance = 0.0f;
    float voxelConfidence = 0.0f;

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelLightingReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1, 1, 1));
    float voxelSizeWS = max(_BurtGISceneVoxelCenterExtent.w * 2.0f / max((float)volumeSize.x, 1.0f), 0.05f);
    float maxTraceDistance = max(_BurtGITranslucencyVolumeTraceParams.y, voxelSizeWS);
    float traceStepFactor = max(_BurtGITranslucencyVolumeTraceParams.z, 0.1f);
    float voxelTraceStartDistanceScale = max(_BurtGITranslucencyVolumeTraceParams.w, 0.0f);
    float3 direction = BurtGITranslucencyVolumeSafeNormalize(traceDirection, float3(0.0f, 0.0f, 1.0f));

    if (_BurtGISceneVoxelOctreeValid > 0.5f || (_BurtGISceneVoxelClipmapValidMask & 62u) != 0u)
    {
        float startDistance = voxelSizeWS * 0.5f * voxelTraceStartDistanceScale;
        float octreeHitDistance = 0.0f;
        uint octreeClipmapLevel = 0u;
        if (!BurtGIVoxelOctreeRayTraceClipmaps(
                worldPosition + direction * startDistance,
                direction,
                max(maxTraceDistance - startDistance, 0.0f),
                octreeHitDistance,
                octreeClipmapLevel))
        {
            return BurtGITranslucencyVolumeMakeVoxelHitSample(0u, 0.0f, 0.0f, 0.0f);
        }

        float resolvedHitDistance = startDistance + octreeHitDistance;
        float3 hitPosition = worldPosition + direction * resolvedHitDistance;
        BurtGITranslucencyVolumeVoxelHitSample hitSample = BurtGITranslucencyVolumeTrySampleSceneVoxelClipmapHitByLevel(
            octreeClipmapLevel,
            hitPosition,
            direction);
        if (hitSample.Sampled == 0u)
        {
            return BurtGITranslucencyVolumeMakeVoxelHitSample(0u, 0.0f, 0.0f, 0.0f);
        }

        voxelRadiance = hitSample.Radiance;
        voxelConfidence = saturate(hitSample.Occupancy * hitSample.NormalFacingWeight);
        uint sampled = voxelConfidence > 0.001f && dot(voxelRadiance, voxelRadiance) > 0.0f ? 1u : 0u;
        BurtGITranslucencyVolumeVoxelHitSample result = BurtGITranslucencyVolumeMakeVoxelHitSample(sampled, voxelRadiance, voxelConfidence, 1.0f);
        result.HitDistance = sampled != 0u ? resolvedHitDistance : 0.0f;
        return result;
    }

    float bestHitDistance = 0.0f;
    uint maxTraceSteps = min((uint)max(_BurtGISceneVoxelTraceControls.x, 1.0), 64u);
    [loop]
    for (uint stepIndex = 0u; stepIndex < maxTraceSteps; ++stepIndex)
    {
        float stepT = ((float)stepIndex + 0.5f) * traceStepFactor / max((float)maxTraceSteps, 1.0f);
        if (stepT >= 1.0f)
        {
            break;
        }
        float sampleDistance = lerp(voxelSizeWS * 0.5f * voxelTraceStartDistanceScale, maxTraceDistance, stepT);
        float3 samplePosition = worldPosition + direction * sampleDistance;

        float coarseOccupancy = 0.0f;
        uint coarseOccupancySampled = BurtGITranslucencyVolumeTrySampleSceneVoxelOccupancy(samplePosition, coarseOccupancy);
        if (coarseOccupancySampled == 0u)
        {
            continue;
        }

        float occupancy = 0.0f;
        float normalFacingWeight = 0.0f;
        uint geometrySampled = BurtGITranslucencyVolumeTrySampleSceneVoxelGeometry(
            samplePosition,
            direction,
            occupancy,
            normalFacingWeight);
        if (geometrySampled == 0u)
        {
            continue;
        }

        float3 uvw = BurtGITranslucencyVolumeSceneVoxelWorldToUVW(samplePosition);
        if (any(uvw < 0.0f) || any(uvw > 1.0f))
        {
            continue;
        }

        uint3 coord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1);
        float4 lighting = _BurtGISceneVoxelLightingReadTexture.Load(int4((int3)coord, 0));
        float sampleConfidence = saturate(lighting.a * max(coarseOccupancy, occupancy) * normalFacingWeight * (1.0f - stepT * 0.35f));
        if (sampleConfidence > voxelConfidence && dot(lighting.rgb, lighting.rgb) > 0.0f)
        {
            voxelRadiance = max(lighting.rgb, 0.0f);
            voxelConfidence = sampleConfidence;
            bestHitDistance = sampleDistance;
        }
    }

    uint sampled = voxelConfidence > 0.001f ? 1u : 0u;
    BurtGITranslucencyVolumeVoxelHitSample result = BurtGITranslucencyVolumeMakeVoxelHitSample(sampled, voxelRadiance, voxelConfidence, 1.0f);
    result.HitDistance = sampled != 0u ? bestHitDistance : 0.0f;
    return result;
}
#endif

bool BurtGITranslucencyVolumeHistoryUV(uint3 id, float2 uv, float z01, float3 gridSize, out float3 historyUV)
{
    historyUV = ((float3)id + 0.5f) / max(gridSize, 1.0f);
    if (_BurtGITranslucencyVolumeTemporalParams.w < 0.5f)
    {
        return true;
    }

    float3 worldPosition = BurtGITranslucencyVolumeCellWorldPosition(id, uv, z01, gridSize);
    float4 previousClip = mul(_BurtGIPreviousViewProjectionMatrix, float4(worldPosition, 1.0f));
    if (previousClip.w <= 0.00001f)
    {
        return false;
    }

    float3 previousNDC = previousClip.xyz / previousClip.w;
    historyUV.xy = BurtGITranslucencyVolumeClipToUV(previousNDC.xy);
    historyUV.z = BurtGITranslucencyVolumeNormalizedSliceFromLinearDepth(previousClip.w, gridSize);
    historyUV += (0.5f - clamp(_BurtGITranslucencyVolumePreviousJitterParams.xyz, 0.0001f, 0.9999f)) / max(gridSize, 1.0f);
    return !any(historyUV < 0.0f) && !any(historyUV > 1.0f);
}

float4 BurtGITranslucencyVolumeSampleHistoryTrilinear(Texture3D<float4> historyTexture, float3 historyUV, int3 gridSize)
{
    float3 coord = saturate(historyUV) * (float3)gridSize - 0.5f;
    int3 coord0 = clamp((int3)floor(coord), int3(0, 0, 0), gridSize - 1);
    int3 coord1 = min(coord0 + 1, gridSize - 1);
    float3 t = saturate(coord - (float3)coord0);

    float4 c000 = historyTexture.Load(int4(coord0.x, coord0.y, coord0.z, 0));
    float4 c100 = historyTexture.Load(int4(coord1.x, coord0.y, coord0.z, 0));
    float4 c010 = historyTexture.Load(int4(coord0.x, coord1.y, coord0.z, 0));
    float4 c110 = historyTexture.Load(int4(coord1.x, coord1.y, coord0.z, 0));
    float4 c001 = historyTexture.Load(int4(coord0.x, coord0.y, coord1.z, 0));
    float4 c101 = historyTexture.Load(int4(coord1.x, coord0.y, coord1.z, 0));
    float4 c011 = historyTexture.Load(int4(coord0.x, coord1.y, coord1.z, 0));
    float4 c111 = historyTexture.Load(int4(coord1.x, coord1.y, coord1.z, 0));

    float4 c00 = lerp(c000, c100, t.x);
    float4 c10 = lerp(c010, c110, t.x);
    float4 c01 = lerp(c001, c101, t.x);
    float4 c11 = lerp(c011, c111, t.x);
    float4 c0 = lerp(c00, c10, t.y);
    float4 c1 = lerp(c01, c11, t.y);
    return lerp(c0, c1, t.z);
}

uint2 BurtGITranslucencyVolumePixelFromUV(float2 uv, uint2 textureSize)
{
    return min((uint2)floor(saturate(uv) * (float2)textureSize), textureSize - 1);
}

float4 BurtGITranslucencyVolumeTraceScreenConeLite(
    float2 uv,
    float2 traceDirection,
    float z01,
    uint2 diffuseSize,
    uint2 probeSize)
{
    float2 direction = traceDirection;
    float directionLength = max(length(direction), 0.0001f);
    direction /= directionLength;
    float2 tangent = float2(-direction.y, direction.x);
    float2 diffuseTexel = 1.0f / (float2)diffuseSize;
    float2 probeTexel = 1.0f / (float2)probeSize;
    float coneRadius = lerp(1.5f, 7.0f, saturate(z01));
    float3 radianceSum = 0.0f;
    float confidenceSum = 0.0f;
    float totalWeight = 0.0f;

    [unroll]
    for (int sampleIndex = 0; sampleIndex < 5; sampleIndex++)
    {
        float sampleT = (float)sampleIndex / 4.0f;
        float centered = sampleT - 0.5f;
        float weight = lerp(1.0f, 0.35f, sampleT);
        float2 coneOffset = direction * coneRadius * sampleT + tangent * centered * coneRadius * 0.35f;
        uint2 diffusePixel = BurtGITranslucencyVolumePixelFromUV(uv + coneOffset * diffuseTexel, diffuseSize);
        uint2 probePixel = BurtGITranslucencyVolumePixelFromUV(uv + coneOffset * probeTexel, probeSize);
        float3 diffuseGI = max(_BurtGIDiffuseIndirectTexture.Load(int3(diffusePixel, 0)).rgb, 0.0f);
        float3 backfaceGI = max(_BurtGIBackfaceDiffuseIndirectTexture.Load(int3(diffusePixel, 0)).rgb, 0.0f);
        float4 probeRadiance = _BurtGIScreenProbeRadianceTexture.Load(int3(probePixel, 0));
        float4 probeConfidence = _BurtGIScreenProbeConfidenceTexture.Load(int3(probePixel, 0));
        float sampleConfidence = saturate(max(probeRadiance.a, probeConfidence.r));
        float3 sampleRadiance = lerp(diffuseGI * 0.25f + backfaceGI * 0.75f, max(probeRadiance.rgb, 0.0f) * 0.35f + backfaceGI * 0.65f, sampleConfidence);
        radianceSum += sampleRadiance * weight;
        confidenceSum += sampleConfidence * weight;
        totalWeight += weight;
    }

    float invTotalWeight = rcp(max(totalWeight, 0.00001f));
    return float4(radianceSum * invTotalWeight, saturate(confidenceSum * invTotalWeight));
}

void BurtGITranslucencyVolumeIntegrate(uint3 id)
{
    uint3 gridSize = max((uint3)_BurtGITranslucencyVolumeGridSize.xyz, uint3(1, 1, 1));
    if (any(id >= gridSize))
    {
        return;
    }

    uint diffuseWidth = 1u;
    uint diffuseHeight = 1u;
    _BurtGIDiffuseIndirectTexture.GetDimensions(diffuseWidth, diffuseHeight);
    uint2 diffuseSize = max(uint2(diffuseWidth, diffuseHeight), uint2(1, 1));

    uint probeWidth = 1u;
    uint probeHeight = 1u;
    _BurtGIScreenProbeRadianceTexture.GetDimensions(probeWidth, probeHeight);
    uint2 probeSize = max(uint2(probeWidth, probeHeight), uint2(1, 1));

    float3 jitterOffset = clamp(_BurtGITranslucencyVolumeJitterParams.xyz, 0.0001f, 0.9999f);
    float2 uv = ((float2)id.xy + jitterOffset.xy) / (float2)gridSize.xy;
    BurtGITranslucencyVolumeApplyDepthConstraintToJitter(id, uv, (float3)gridSize, jitterOffset);
    float z01 = ((float)id.z + jitterOffset.z) / max((float)gridSize.z, 1.0f);
    if (!BurtGITranslucencyVolumeIsFroxelVisible(id, uv, (float3)gridSize))
    {
        float3 historyUV = 0.0f;
        if (_BurtGITranslucencyVolumeTemporalParams.y > 0.5f &&
            BurtGITranslucencyVolumeHistoryUV(id, uv, z01, (float3)gridSize, historyUV))
        {
            float4 history0 = BurtGITranslucencyVolumeSampleHistoryTrilinear(_BurtGITranslucencyVolumeHistory0, historyUV, int3(gridSize));
            float4 history1 = BurtGITranslucencyVolumeSampleHistoryTrilinear(_BurtGITranslucencyVolumeHistory1, historyUV, int3(gridSize));
            float historyExposureCorrection = max(_BurtGITranslucencyVolumeExposureParams.x, 0.0f);
            _BurtGITranslucencyVolume0[id] = float4(BurtGITranslucencyVolumeClampRayIntensity(max(history0.rgb * historyExposureCorrection, 0.0f)), saturate(history0.a));
            _BurtGITranslucencyVolume1[id] = float4(BurtGITranslucencyVolumeClampRayIntensity(history1.rgb * historyExposureCorrection), saturate(history1.a));
            return;
        }

        _BurtGITranslucencyVolume0[id] = 0.0f;
        _BurtGITranslucencyVolume1[id] = 0.0f;
        return;
    }

    uint2 diffusePixel = min((uint2)floor(uv * (float2)diffuseSize), diffuseSize - 1);
    uint2 probePixel = min((uint2)floor(uv * (float2)probeSize), probeSize - 1);

    float3 diffuseGI = max(_BurtGIDiffuseIndirectTexture.Load(int3(diffusePixel, 0)).rgb, 0.0f);
    float3 backfaceGI = max(_BurtGIBackfaceDiffuseIndirectTexture.Load(int3(diffusePixel, 0)).rgb, 0.0f);
    float4 probeRadiance = _BurtGIScreenProbeRadianceTexture.Load(int3(probePixel, 0));
    float4 probeConfidence = _BurtGIScreenProbeConfidenceTexture.Load(int3(probePixel, 0));

    float depthFade = pow(saturate(1.0f - z01), max(_BurtGITranslucencyVolumeParams0.z, 0.05f));
    float confidence = saturate(max(max(probeRadiance.a, probeConfidence.r), 0.25f));
    float3 probeGI = max(probeRadiance.rgb, 0.0f);
    float probeBlend = saturate(_BurtGITranslucencyVolumeParams0.w) * confidence;
    float3 dominantDirectionVS = normalize(float3(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f, -1.0f));
    float4 coneTrace = BurtGITranslucencyVolumeTraceScreenConeLite(uv, dominantDirectionVS.xy, z01, diffuseSize, probeSize);
    float3 singleTapGI = lerp(diffuseGI * 0.25f + backfaceGI * 0.75f, probeGI * 0.35f + backfaceGI * 0.65f, probeBlend);
    float3 sourceGI = lerp(singleTapGI, coneTrace.rgb, saturate(0.35f + coneTrace.a * 0.45f));
    confidence = saturate(max(confidence, coneTrace.a * 0.85f));
    float3 voxelRadianceSum = 0.0f;
    float voxelConfidenceSum = 0.0f;
    float voxelWeightSum = 0.0f;
    float voxelMaxConfidence = 0.0f;
    float4 traceSHR = 0.0f;
    float4 traceSHG = 0.0f;
    float4 traceSHB = 0.0f;
    uint traceOctResolution = (uint)clamp(round(_BurtGITranslucencyVolumeTraceAtlasParams.x), 1.0f, 8.0f);
    float3 worldPosition = BurtGITranslucencyVolumeCellWorldPosition(id, uv, z01, (float3)gridSize);
    float3 dominantDirectionWS = BurtGITranslucencyVolumeSafeNormalize(worldPosition - _BurtDeferredCameraWorldPosition.xyz, float3(0.0f, 0.0f, 1.0f));

    [loop]
    for (uint traceY = 0u; traceY < 8u; ++traceY)
    {
        if (traceY >= traceOctResolution)
        {
            break;
        }

        [loop]
        for (uint traceX = 0u; traceX < 8u; ++traceX)
        {
            if (traceX >= traceOctResolution)
            {
                break;
            }

            uint3 traceAtlasCoord = uint3(id.x * traceOctResolution + traceX, id.y * traceOctResolution + traceY, id.z);
            float4 atlasTrace = _BurtGITranslucencyVolumeTraceReadRadiance.Load(int4((int3)traceAtlasCoord, 0));
            float atlasOccupancy = saturate(atlasTrace.a);
            if (atlasOccupancy <= 0.001f || dot(atlasTrace.rgb, atlasTrace.rgb) <= 0.0f)
            {
                continue;
            }

            float voxelWeight = atlasOccupancy;
            float3 atlasRadiance = max(atlasTrace.rgb, 0.0f) * voxelWeight;
            float2 traceUV = (float2(traceX, traceY) + 0.5f) / max((float)traceOctResolution, 1.0f);
            float3 traceDirectionWS = BurtGITranslucencyVolumeEquiAreaSphericalMapping(clamp(traceUV, 0.0001f, 0.9999f));
            float4 traceBasis = BurtGITranslucencyVolumeSHBasis2(traceDirectionWS);
            traceSHR += traceBasis * atlasRadiance.r;
            traceSHG += traceBasis * atlasRadiance.g;
            traceSHB += traceBasis * atlasRadiance.b;
            voxelRadianceSum += atlasRadiance;
            voxelConfidenceSum += atlasOccupancy;
            voxelWeightSum += voxelWeight;
            voxelMaxConfidence = max(voxelMaxConfidence, atlasOccupancy);
        }
    }

    float3 ambient = 0.0f;
    float3 directionalCoefficients = 0.0f;
    if (voxelWeightSum > 0.0001f)
    {
        float normalizeFactor = 3.14159265358979323846f / max((float)(traceOctResolution * traceOctResolution), 1.0f);
        traceSHR *= normalizeFactor;
        traceSHG *= normalizeFactor;
        traceSHB *= normalizeFactor;
        ambient = float3(traceSHR.x, traceSHG.x, traceSHB.x) * max(_BurtGITranslucencyVolumeGridSize.w, 0.0f);
        float3 normalizedAmbientColor = ambient / max(dot(ambient, float3(1.0f, 1.0f, 1.0f)), 0.00001f);
        float3 coefficient0 = float3(traceSHR.y, traceSHG.y, traceSHB.y) * max(_BurtGITranslucencyVolumeGridSize.w, 0.0f);
        float3 coefficient1 = float3(traceSHR.z, traceSHG.z, traceSHB.z) * max(_BurtGITranslucencyVolumeGridSize.w, 0.0f);
        float3 coefficient2 = float3(traceSHR.w, traceSHG.w, traceSHB.w) * max(_BurtGITranslucencyVolumeGridSize.w, 0.0f);
        directionalCoefficients = float3(
            dot(coefficient0, normalizedAmbientColor),
            dot(coefficient1, normalizedAmbientColor),
            dot(coefficient2, normalizedAmbientColor));
        confidence = saturate(max(confidence, saturate(max(voxelMaxConfidence, voxelConfidenceSum / max((float)(traceOctResolution * traceOctResolution), 1.0f)))));
    }
    else
    {
        if (voxelWeightSum > 0.0001f)
        {
            float3 voxelRadiance = voxelRadianceSum / voxelWeightSum;
            float voxelConfidence = saturate(max(voxelMaxConfidence, voxelConfidenceSum / max(1.0f + (float)(traceOctResolution * traceOctResolution), 1.0f)));
            float voxelBlend = saturate(voxelConfidence * lerp(0.35f, 0.7f, depthFade));
            sourceGI = lerp(sourceGI, max(sourceGI, voxelRadiance), voxelBlend);
            confidence = saturate(max(confidence, voxelConfidence));
        }

        ambient = sourceGI * lerp(0.35f, 1.0f, depthFade) * max(_BurtGITranslucencyVolumeGridSize.w, 0.0f);
        float3 dominantDirectionSH = BurtGITranslucencyVolumeSHBasis2(dominantDirectionWS).yzw;
        directionalCoefficients = dominantDirectionSH * BurtGITranslucencyVolumeLuminance(ambient) * lerp(0.15f, 0.45f, depthFade);
    }

    float historyWeight = saturate(_BurtGITranslucencyVolumeTemporalParams.x) *
        saturate(_BurtGITranslucencyVolumeTemporalParams.y) *
        saturate(lerp(1.0f, confidence, _BurtGITranslucencyVolumeTemporalParams.z));
    if (historyWeight > 0.0001f)
    {
        float3 historyUV = 0.0f;
        if (BurtGITranslucencyVolumeHistoryUV(id, uv, z01, (float3)gridSize, historyUV))
        {
            float4 history0 = BurtGITranslucencyVolumeSampleHistoryTrilinear(_BurtGITranslucencyVolumeHistory0, historyUV, int3(gridSize));
            float4 history1 = BurtGITranslucencyVolumeSampleHistoryTrilinear(_BurtGITranslucencyVolumeHistory1, historyUV, int3(gridSize));
            float historyExposureCorrection = max(_BurtGITranslucencyVolumeExposureParams.x, 0.0f);
            ambient = lerp(ambient, max(history0.rgb * historyExposureCorrection, 0.0f), historyWeight);
            directionalCoefficients = lerp(directionalCoefficients, history1.rgb * historyExposureCorrection, historyWeight);
            confidence = saturate(max(confidence, max(history0.a, history1.a) * historyWeight));
        }
    }

    ambient = BurtGITranslucencyVolumeClampRayIntensity(ambient);
    directionalCoefficients = BurtGITranslucencyVolumeClampRayIntensity(directionalCoefficients);
    _BurtGITranslucencyVolume0[id] = float4(ambient, confidence);
    _BurtGITranslucencyVolume1[id] = float4(directionalCoefficients, confidence);
}

[numthreads(BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE, BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE, BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE)]
void TranslucencyVolumeIntegratesCS(uint3 id : SV_DispatchThreadID)
{
    BurtGITranslucencyVolumeIntegrate(id);
}
