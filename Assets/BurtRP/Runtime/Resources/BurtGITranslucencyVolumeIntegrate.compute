#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
Texture3D<float4> _BurtGITranslucencyVolumeHistory0;
Texture3D<float4> _BurtGITranslucencyVolumeHistory1;
Texture3D<float4> _BurtGITranslucencyVolumeTraceReadRadiance;
