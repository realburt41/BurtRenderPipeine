#pragma kernel TranslucencyVolumeSpatialFilterCS
#pragma kernel FilterTranslucencyVolumeSpatialCS

#define BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE 4
#define BURT_GI_TRANSLUCENCY_VOLUME_TRACE_FILTER_THREADGROUP_SIZE 8
#define BURT_GI_CLIPMAP_COUNT 6

#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
#endif
float _BurtGISceneVoxelOctreeValid;
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
Texture3D<float4> _BurtGITranslucencyVolumeRead0;
Texture3D<float4> _BurtGITranslucencyVolumeRead1;
#endif

#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
RWTexture3D<float4> _BurtGITranslucencyVolumeFilter0;
RWTexture3D<float4> _BurtGITranslucencyVolumeFilter1;
#endif
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
#endif

float4 _BurtGITranslucencyVolumeGridSize; // xyz=volume grid size, w=apply scale.
float4 _BurtGITranslucencyVolumeParams0; // x=near, y=far, z=depth fade power, w=screen-probe blend.
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
float4 _BurtGITranslucencyVolumeTemporalParams; // x=history feedback, y=history valid, z=confidence weight, w=world reprojection.
float4 _BurtGITranslucencyVolumeSpatialFilterParams; // x=sample count, y=sigma, z=enabled, w=confidence weight.
float4 _BurtGITranslucencyVolumeSpatialFilterDirection; // xyz=separable filter axis.
#endif
float4 _BurtGITranslucencyVolumeGridZParams; // x=log scale, y=log bias, z=slice scale.
float4 _BurtGITranslucencyVolumeHiZParams; // x=HiZ visibility enabled, y=depth-buffer center offset, z=accepted depth offset threshold.
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
float4 _BurtGITranslucencyVolumeExposureParams; // x=history exposure correction.
#endif
float4 _BurtGITranslucencyVolumeJitterParams; // xyz=current froxel jitter offset.
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
float4 _BurtGITranslucencyVolumePreviousJitterParams; // xyz=previous froxel jitter offset.
#endif
float4 _BurtGITranslucencyVolumeTraceParams; // x=max ray intensity, y=max trace distance, z=step factor, w=voxel trace start distance scale.
float4 _BurtGITranslucencyVolumeTraceAtlasParams; // x=oct trace resolution, y=temporal direction frame.
float4 _ZBufferParams;
float4 _BurtDeferredCameraWorldPosition;
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
float4 _BurtGIRadianceCacheClipMapClipmapCenterExtent[BURT_GI_CLIPMAP_COUNT];
#endif
float4 _BurtGISceneVoxelCenterExtent;
float4 _BurtGISceneVoxelTraceControls;
float4 _BurtGISceneVoxelClipmapCenterExtent[6];
uint _BurtGISceneVoxelClipmapValidMask;
float4x4 _BurtDeferredInverseViewProjectionMatrix;
#if !defined(BURT_GI_TRANSLUCENCY_VOLUME_TRACE_VOXEL_OCTREE_STANDALONE)
float4x4 _BurtGIPreviousViewProjectionMatrix;
#endif

float BurtGITranslucencyVolumeGaussianWeight(float distance, float sigma)
{
    float safeSigma = max(sigma, 0.01f);
    return exp(-0.5f * distance * distance / (safeSigma * safeSigma));
}

void BurtGITranslucencyVolumeAccumulateSpatialSample(
    int3 coord,
    int3 gridMax,
    int3 offset,
    float weight,
    inout float4 sum0,
    inout float4 sum1,
    inout float totalWeight)
{
    int3 sampleCoord = clamp(coord + offset, int3(0, 0, 0), gridMax);
    float4 sample0 = _BurtGITranslucencyVolumeRead0.Load(int4(sampleCoord, 0));
    float4 sample1 = _BurtGITranslucencyVolumeRead1.Load(int4(sampleCoord, 0));
    float confidenceWeight = lerp(1.0f, saturate(max(sample0.a, sample1.a)), saturate(_BurtGITranslucencyVolumeSpatialFilterParams.w));
    float sampleWeight = weight * confidenceWeight;
    sum0 += sample0 * sampleWeight;
    sum1 += sample1 * sampleWeight;
    totalWeight += sampleWeight;
}

void BurtGITranslucencyVolumeSpatialFilter(uint3 id)
{
    uint3 gridSize = max((uint3)_BurtGITranslucencyVolumeGridSize.xyz, uint3(1, 1, 1));
    if (any(id >= gridSize))
    {
        return;
    }

    int3 coord = int3(id);
    int3 gridMax = int3(gridSize) - 1;
    float4 center0 = _BurtGITranslucencyVolumeRead0.Load(int4(coord, 0));
    float4 center1 = _BurtGITranslucencyVolumeRead1.Load(int4(coord, 0));
    if (_BurtGITranslucencyVolumeSpatialFilterParams.z < 0.5f)
    {
        _BurtGITranslucencyVolumeFilter0[id] = center0;
        _BurtGITranslucencyVolumeFilter1[id] = center1;
        return;
    }

    int sampleCount = (int)clamp(_BurtGITranslucencyVolumeSpatialFilterParams.x, 1.0f, 5.0f);
    float sigma = max(_BurtGITranslucencyVolumeSpatialFilterParams.y, 0.01f);
    float centerWeight = BurtGITranslucencyVolumeGaussianWeight(0.0f, sigma);
    float4 sum0 = center0 * centerWeight;
    float4 sum1 = center1 * centerWeight;
    float totalWeight = centerWeight;
    int3 filterDirection = (int3)round(_BurtGITranslucencyVolumeSpatialFilterDirection.xyz);
    if (all(filterDirection == int3(0, 0, 0)))
    {
        filterDirection = int3(1, 0, 0);
    }

    [loop]
    for (int offset = 1; offset <= sampleCount; offset++)
    {
        float weight = BurtGITranslucencyVolumeGaussianWeight((float)offset, sigma);
        int3 axisOffset = filterDirection * offset;
        BurtGITranslucencyVolumeAccumulateSpatialSample(coord, gridMax, axisOffset, weight, sum0, sum1, totalWeight);
        BurtGITranslucencyVolumeAccumulateSpatialSample(coord, gridMax, -axisOffset, weight, sum0, sum1, totalWeight);
    }

    _BurtGITranslucencyVolumeFilter0[id] = max(sum0 / max(totalWeight, 0.00001f), 0.0f);
    _BurtGITranslucencyVolumeFilter1[id] = sum1 / max(totalWeight, 0.00001f);
}

[numthreads(BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE, BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE, BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE)]
void TranslucencyVolumeSpatialFilterCS(uint3 id : SV_DispatchThreadID)
{
    BurtGITranslucencyVolumeSpatialFilter(id);
}

[numthreads(BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE, BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE, BURT_GI_TRANSLUCENCY_VOLUME_THREADGROUP_SIZE)]
void FilterTranslucencyVolumeSpatialCS(uint3 id : SV_DispatchThreadID)
{
    BurtGITranslucencyVolumeSpatialFilter(id);
}
