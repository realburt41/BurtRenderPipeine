void BurtGIUnpackTraceTileInfo(uint2 packedTraceTile, out uint2 tileCoord, out uint tileLevel, out uint probeTraceIndex)
{
    tileCoord = uint2(packedTraceTile.x & 0xffu, (packedTraceTile.x >> 8) & 0xffu);
    tileLevel = (packedTraceTile.x >> 16) & 0xffu;
    probeTraceIndex = packedTraceTile.y;
}
uint BurtGIClipmapCount()
{
    return max(1u, min((uint)_BurtGIRadianceCacheClipMapParams.z, (uint)BURT_GI_CLIPMAP_COUNT));
}
uint2 BurtGIScreenProbeGridSize()
{
    return max(uint2(1u, 1u), (uint2)_BurtGIScreenProbeGridParams.xy);
}
uint BurtGIProbeAtlasResolutionInProbes()
{
    return max(1u, (uint)_BurtGIRadianceCacheClipMapParams.x);
}
uint2 BurtGIProbeAtlasBaseCoord(uint probeIndex, uint probeResolution)
{
    uint atlasResolutionInProbes = BurtGIProbeAtlasResolutionInProbes();
    uint2 probeCoord = uint2(probeIndex % atlasResolutionInProbes, probeIndex / atlasResolutionInProbes);
    return probeCoord * probeResolution;
}
uint BurtGIGetProbeIndexFromTraceDataRead(uint probeTraceIndex)
{
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapMaxProbeCount)
    {
        return 0u;
    }

    return asuint(_BurtGIRadianceCacheClipMapProbeTraceDataReadBuffer[probeTraceIndex].w) & 0x00ffffffu;
}
uint BurtGIGetClipmapIndexFromTraceDataRead(uint probeTraceIndex)
{
    if (probeTraceIndex >= _BurtGIRadianceCacheClipMapMaxProbeCount)
    {
        return 0u;
    }

    return (asuint(_BurtGIRadianceCacheClipMapProbeTraceDataReadBuffer[probeTraceIndex].w) >> 24) & 0xffu;
}
float3 BurtGIGetProbeTraceWorldCenterRead(uint probeTraceIndex)
{
    float4 probeTraceData = _BurtGIRadianceCacheClipMapProbeTraceDataReadBuffer[probeTraceIndex];
    uint probeIndex = BurtGIGetProbeIndexFromTraceDataRead(probeTraceIndex);
    float3 probeWorldOffset = probeIndex < _BurtGIRadianceCacheClipMapMaxProbeCount
        ? _BurtGIRadianceCacheClipMapProbeWorldOffsetReadBuffer[probeIndex].xyz
        : 0.0;
    return probeTraceData.xyz + probeWorldOffset;
}
float3 BurtGITraceEarlySafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001 ? value * rsqrt(lengthSq) : fallback;
}
float3 BurtGIEquiAreaSphericalMapping(float2 uv)
{
    uv = 2.0 * uv - 1.0;
    float d = 1.0 - (abs(uv.x) + abs(uv.y));
    float r = 1.0 - abs(d);
    float phi = r == 0.0 ? 0.0 : 0.7853981633974483 * ((abs(uv.y) - abs(uv.x)) / r + 1.0);
    float f = r * sqrt(max(2.0 - r * r, 0.0));
    return BurtGITraceEarlySafeNormalize(float3(
        f * sign(uv.y) * abs(sin(phi)),
        sign(d) * (1.0 - r * r),
        f * sign(uv.x) * abs(cos(phi))),
        float3(0.0, 1.0, 0.0));
}
float3 BurtGISafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > 0.000001 ? value * rsqrt(lengthSq) : fallback;
}
bool BurtGIRadianceCacheTrySampleSkyRadiance(float3 directionWS, float roughness, out float3 skyRadiance)
{
    skyRadiance = 0.0;
    if (_BurtSkyReflectionEnabled <= 0.5)
    {
        return false;
    }

    float3 safeDirectionWS = BurtGISafeNormalize(directionWS, float3(0.0, 1.0, 0.0));
    float2 rotation = _BurtSkyReflectionRotation.xy;
    float2 rotatedXZ = float2(
        safeDirectionWS.x * rotation.x - safeDirectionWS.z * rotation.y,
        safeDirectionWS.x * rotation.y + safeDirectionWS.z * rotation.x);
    float3 sampleDirectionWS = BurtGISafeNormalize(
        float3(rotatedXZ.x, safeDirectionWS.y, rotatedXZ.y),
        safeDirectionWS);
    float mipLevel = saturate(roughness) * max(_BurtSkyReflectionMaxMip, 0.0);
    float4 encodedSky = _BurtSkyReflectionTexture.SampleLevel(sampler_BurtSkyReflectionTexture, sampleDirectionWS, mipLevel);
    float hdrMultiplier = _BurtSkyReflectionHDR.x * pow(max(abs(encodedSky.a), 0.0001), _BurtSkyReflectionHDR.y);
    skyRadiance = max(encodedSky.rgb * hdrMultiplier, 0.0) *
        max(_BurtSkyReflectionTint.rgb, 0.0) *
        max(_BurtSkyReflectionIntensity, 0.0);

    if (_BurtSkyLowerHemisphereEnabled > 0.5 && safeDirectionWS.y < 0.0)
    {
        skyRadiance = lerp(skyRadiance, max(_BurtSkyLowerHemisphereDiffuseColor.rgb, 0.0), saturate(_BurtSkyLowerHemisphereDiffuseColor.a));
    }

    return dot(skyRadiance, skyRadiance) > 0.000001;
}
float3 BurtGIRadianceCacheResolveSkyRadiance(float3 directionWS, float roughness)
{
    float3 skyRadiance = max(_BurtGIRadianceCacheClipMapSkyRadiance.rgb, 0.0);
    if (_BurtGIRadianceCacheClipMapSkyRadiance.w > 0.5)
    {
        float3 sampledSkyRadiance = 0.0;
        if (BurtGIRadianceCacheTrySampleSkyRadiance(directionWS, roughness, sampledSkyRadiance))
        {
            skyRadiance = sampledSkyRadiance;
        }
    }

    return skyRadiance;
}
void BurtGIUnpackScreenProbeImportanceRayInfo(uint rayInfo, out uint2 texelCoord, out uint level)
{
    texelCoord.x = rayInfo & 0x3fu;
    texelCoord.y = (rayInfo >> 6) & 0x3fu;
    level = (rayInfo >> 12) & 0xfu;
}
void BurtGISampleScreenProbeImportanceTraceByDirection(
    uint2 traceProbeCoord,
    float3 direction,
    uint traceResolution,
    uint2 traceAtlasSize,
    out float4 traceRadiance,
    out float traceHit)
{
    uint maxImportanceTraceResolution = min(64u, max(traceResolution, traceResolution << 1u));
    float bestDirectionDot = -2.0;
    uint2 bestTraceAtlasCoord = min(traceProbeCoord * traceResolution, traceAtlasSize - 1u);

    [loop]
    for (uint y = 0u; y < traceResolution; ++y)
    {
        [loop]
        for (uint x = 0u; x < traceResolution; ++x)
        {
            uint2 traceTexelCoord = uint2(x, y);
            uint2 traceAtlasCoord = min(traceProbeCoord * traceResolution + traceTexelCoord, traceAtlasSize - 1u);
            uint2 sourceTraceTexelCoord = traceTexelCoord;
            uint sourceTraceLevel = 0u;
            BurtGIUnpackScreenProbeImportanceRayInfo(
                _BurtGIScreenProbeImportanceRayInfoTexture.Load(int3((int)traceAtlasCoord.x, (int)traceAtlasCoord.y, 0)),
                sourceTraceTexelCoord,
                sourceTraceLevel);

            uint sourceMipSize = max(1u, maxImportanceTraceResolution >> min(sourceTraceLevel, 5u));
            if (sourceTraceTexelCoord.x >= sourceMipSize || sourceTraceTexelCoord.y >= sourceMipSize)
            {
                sourceTraceTexelCoord = traceTexelCoord;
                sourceMipSize = traceResolution;
            }

            float3 sourceDirection = BurtGIEquiAreaSphericalMapping((float2(sourceTraceTexelCoord) + 0.5) / (float)sourceMipSize);
            float directionDot = dot(sourceDirection, direction);
            if (directionDot > bestDirectionDot)
            {
                bestDirectionDot = directionDot;
                bestTraceAtlasCoord = traceAtlasCoord;
            }
        }
    }

    traceRadiance = _BurtGIScreenProbeTraceRadianceTexture.Load(int3((int)bestTraceAtlasCoord.x, (int)bestTraceAtlasCoord.y, 0));
    traceHit = _BurtGIScreenProbeTraceHitTexture.Load(int3((int)bestTraceAtlasCoord.x, (int)bestTraceAtlasCoord.y, 0));
}
float3 BurtGISampleRawScreenGI(uint probeIndex, float3 direction, float3 probeWorldCenter, out float hitDistance)
{
    float skyTraceEnabled = _BurtGIRadianceCacheClipMapSkyRadiance.w > 0.5 ? 1.0 : 0.0;
    float3 skyRadiance = BurtGIRadianceCacheResolveSkyRadiance(direction, 0.18);

    if (_BurtGIRadianceCacheClipMapUseIrradianceField != 0u)
    {
        hitDistance = max(_BurtGIScreenProbeTraceParams.w, 1.0);
        return skyRadiance * skyTraceEnabled;
    }

    uint2 screenProbeGridSize = BurtGIScreenProbeGridSize();
    uint2 screenProbeCoord = uint2(probeIndex % screenProbeGridSize.x, (probeIndex / screenProbeGridSize.x) % screenProbeGridSize.y);
    float2 sourceUV = (float2(screenProbeCoord) + 0.5) / (float2)screenProbeGridSize;

    uint rawWidth = 1u;
    uint rawHeight = 1u;
    _BurtScreenSpaceGlobalIlluminationRawTexture.GetDimensions(rawWidth, rawHeight);
    uint2 rawSize = max(uint2(rawWidth, rawHeight), uint2(1u, 1u));
    uint2 rawCoord = min((uint2)(saturate(sourceUV) * (float2)rawSize), rawSize - 1u);

    float4 rawGI = _BurtScreenSpaceGlobalIlluminationRawTexture.Load(int3((int)rawCoord.x, (int)rawCoord.y, 0));
    float4 screenProbeWorldPosition = _BurtGIScreenProbeWorldPositionTexture.Load(int3((int)screenProbeCoord.x, (int)screenProbeCoord.y, 0));
    float validSurface = screenProbeWorldPosition.w > 0.0 ? 1.0 : 0.0;
    float maxTraceDistance = max(_BurtGIScreenProbeTraceParams.w, 1.0);
    hitDistance = validSurface > 0.0 ? distance(probeWorldCenter, screenProbeWorldPosition.xyz) : maxTraceDistance;

    float upFactor = saturate(direction.y * 0.5 + 0.5);
    float3 analyticSkyFallback = lerp(float3(0.015, 0.018, 0.022), float3(0.08, 0.09, 0.11), upFactor);
    float3 skyFallback = lerp(analyticSkyFallback, skyRadiance, skyTraceEnabled);
    float directionalEnergy = lerp(0.72, 1.18, saturate(direction.z * 0.5 + 0.5));
    float3 fallbackRadiance = max(lerp(skyFallback, rawGI.rgb, validSurface), 0.0) * directionalEnergy;

    uint traceWidth = 1u;
    uint traceHeight = 1u;
    _BurtGIScreenProbeTraceRadianceTexture.GetDimensions(traceWidth, traceHeight);
    uint traceResolution = max(1u, min(32u, (uint)_BurtGIScreenProbeTraceParams.x));
    uint2 traceAtlasSize = max(uint2(traceWidth, traceHeight), uint2(1u, 1u));
    uint2 traceProbeCapacity = max(traceAtlasSize / traceResolution, uint2(1u, 1u));
    uint2 traceProbeCoord = min(screenProbeCoord, traceProbeCapacity - 1u);
    float4 traceRadiance = 0.0;
    float traceHit = 0.0;
    BurtGISampleScreenProbeImportanceTraceByDirection(traceProbeCoord, direction, traceResolution, traceAtlasSize, traceRadiance, traceHit);
    traceHit = saturate(traceHit);
    float traceConfidence = saturate(max(traceRadiance.a, traceHit) * traceHit);
    float traceDistance = maxTraceDistance * lerp(1.0, 0.35, traceConfidence);
    hitDistance = min(hitDistance, traceDistance);

    return lerp(fallbackRadiance, max(traceRadiance.rgb, 0.0), traceConfidence);
}
