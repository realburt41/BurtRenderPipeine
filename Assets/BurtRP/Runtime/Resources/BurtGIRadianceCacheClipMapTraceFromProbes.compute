        mipLevel);
    float occupancy = saturate(max(occupancyMip.x, occupancyMip.y));
    return BurtGIMakeSceneVoxelOccupancySample(occupancy > 0.001 ? 1u : 0u, occupancy);
}
BurtGISceneVoxelRadianceSample BurtGITrySampleSceneVoxelRadianceResource(
    Texture3D<float4> radianceTexture,
    Texture3D<float4> lightingTexture,
    float4 centerExtent,
    float3 samplePosition,
    float sampleRadius)
{
    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    radianceTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = (samplePosition - centerExtent.xyz) / max(centerExtent.w * 2.0, 0.001) + 0.5;
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return BurtGIMakeSceneVoxelRadianceSample(0u, 0.0, 0.0);
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 voxelRadiance = radianceTexture.Load(int4((int3)voxelCoord, 0));
    float4 voxelLighting = lightingTexture.Load(int4((int3)voxelCoord, 0));
    if (voxelLighting.a > 0.001 && dot(voxelLighting.rgb, voxelLighting.rgb) > 0.0)
    {
        voxelRadiance = voxelLighting;
    }

    float confidence = saturate(voxelRadiance.a);
    if (confidence <= 0.001 || dot(voxelRadiance.rgb, voxelRadiance.rgb) <= 0.0)
    {
        return BurtGIMakeSceneVoxelRadianceSample(0u, 0.0, 0.0);
    }

    float voxelSizeWS = max(centerExtent.w * 2.0 / (float)max(volumeSize.x, 1u), 0.001);
    confidence *= lerp(0.5, 1.0, saturate(voxelSizeWS / max(voxelSizeWS, sampleRadius)));
    return BurtGIMakeSceneVoxelRadianceSample(1u, max(voxelRadiance.rgb, 0.0), confidence);
}
BurtGISceneVoxelRadianceSample BurtGITrySampleSceneVoxelRadiance(
    float3 samplePosition,
