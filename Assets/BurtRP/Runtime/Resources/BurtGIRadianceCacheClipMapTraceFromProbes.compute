            _BurtGISceneVoxelClipmap1LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[1],
            samplePosition,
            sampleRadius);
    }

    if (clipmapLevel == 2u)
    {
        return BurtGITrySampleSceneVoxelRadianceResource(
            _BurtGISceneVoxelClipmap2RadianceReadTexture,
            _BurtGISceneVoxelClipmap2LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[2],
            samplePosition,
            sampleRadius);
    }

    if (clipmapLevel == 3u)
    {
        return BurtGITrySampleSceneVoxelRadianceResource(
            _BurtGISceneVoxelClipmap3RadianceReadTexture,
            _BurtGISceneVoxelClipmap3LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[3],
            samplePosition,
            sampleRadius);
    }

    if (clipmapLevel == 4u)
    {
        return BurtGITrySampleSceneVoxelRadianceResource(
            _BurtGISceneVoxelClipmap4RadianceReadTexture,
            _BurtGISceneVoxelClipmap4LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[4],
            samplePosition,
            sampleRadius);
    }

    if (clipmapLevel == 5u)
    {
        return BurtGITrySampleSceneVoxelRadianceResource(
            _BurtGISceneVoxelClipmap5RadianceReadTexture,
            _BurtGISceneVoxelClipmap5LightingReadTexture,
            _BurtGISceneVoxelClipmapCenterExtent[5],
            samplePosition,
            sampleRadius);
    }

    uint width = 1u;
    uint height = 1u;
    uint depth = 1u;
    _BurtGISceneVoxelRadianceReadTexture.GetDimensions(width, height, depth);
    uint3 volumeSize = max(uint3(width, height, depth), uint3(1u, 1u, 1u));
    float3 uvw = BurtGISceneVoxelWorldToUVW(samplePosition);
    if (any(uvw < 0.0) || any(uvw > 1.0))
    {
        return BurtGIMakeSceneVoxelRadianceSample(0u, 0.0, 0.0);
    }

    uint3 voxelCoord = min((uint3)(uvw * (float3)volumeSize), volumeSize - 1u);
    float4 voxelRadiance = _BurtGISceneVoxelRadianceReadTexture.Load(int4((int)voxelCoord.x, (int)voxelCoord.y, (int)voxelCoord.z, 0));
    float4 voxelLighting = _BurtGISceneVoxelLightingReadTexture.Load(int4((int)voxelCoord.x, (int)voxelCoord.y, (int)voxelCoord.z, 0));
    if (voxelLighting.a > 0.001 && dot(voxelLighting.rgb, voxelLighting.rgb) > 0.0)
    {
        voxelRadiance = voxelLighting;
    }

    float confidence = saturate(voxelRadiance.a);
    if (confidence <= 0.001 || dot(voxelRadiance.rgb, voxelRadiance.rgb) <= 0.0)
    {
        return BurtGIMakeSceneVoxelRadianceSample(0u, 0.0, 0.0);
    }

    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float voxelSizeWS = max(centerExtent.w * 2.0 / (float)max(volumeSize.x, 1u), 0.001);
    float footprintWeight = saturate(voxelSizeWS / max(voxelSizeWS, sampleRadius));
    confidence *= lerp(0.5, 1.0, footprintWeight);
    return BurtGIMakeSceneVoxelRadianceSample(1u, max(voxelRadiance.rgb, 0.0), confidence);
}
bool BurtGITrySampleSceneVoxelConeTrace(
    float3 probeWorldCenter,
    float3 direction,
    float coneHalfAngle,
    float minSampleRadius,
    float minTraceDistance,
    float maxTraceDistance,
    float stepFactor,
    out float3 radiance,
    out float hitDistance,
    out float confidence)
{
    radiance = 0.0;
    hitDistance = maxTraceDistance;
    confidence = 0.0;

    if (maxTraceDistance <= minTraceDistance)
    {
        return false;
    }

    float3 accumulatedRadiance = 0.0;
    float accumulatedWeight = 0.0;
    float nearestHitDistance = maxTraceDistance;
    float4 centerExtent = _BurtGISceneVoxelCenterExtent;
    float voxelSizeWS = max(centerExtent.w / 32.0, 0.001);
    float tanConeHalfAngle = min(tan(coneHalfAngle), 8.0);
    float traceRange = max(maxTraceDistance - minTraceDistance, 0.001);
    float traceDistance = minTraceDistance;

    uint maxTraceSteps = min((uint)max(_BurtGISceneVoxelTraceControls.x, 1.0), 64u);
    [loop]
    for (uint stepIndex = 0u; stepIndex < maxTraceSteps; ++stepIndex)
    {
        if (traceDistance >= maxTraceDistance)
        {
            break;
        }

        float sampleRadius = max(minSampleRadius, traceDistance * tanConeHalfAngle);
        float stepLength = max(voxelSizeWS, sampleRadius * max(stepFactor * max(_BurtGISceneVoxelTraceControls.y, 0.1), 0.25));
        float sampleDistance = min(traceDistance + stepLength * 0.5, maxTraceDistance);
        float stepFraction = saturate((sampleDistance - minTraceDistance) / traceRange);
        float3 samplePosition = probeWorldCenter + direction * sampleDistance;

        BurtGISceneVoxelOccupancySample coarseOccupancySample = BurtGITrySampleSceneVoxelOccupancyMip(
            samplePosition,
            sampleRadius);
        if (coarseOccupancySample.Sampled == 0u)
        {
            traceDistance += max(stepLength, voxelSizeWS * 2.0);
            continue;
        }

        uint sampleClipmapLevel = BurtGIResolveSceneVoxelClipmap(samplePosition);
        float4 sampleCenterExtent = sampleClipmapLevel == 0u
            ? _BurtGISceneVoxelCenterExtent
            : _BurtGISceneVoxelClipmapCenterExtent[sampleClipmapLevel];
        float hitBiasWS = max(sampleCenterExtent.w / 65536.0, 0.0005);
        float3 hitPosition = samplePosition + direction * hitBiasWS;
        BurtGISceneVoxelRadianceSample radianceSample = BurtGITrySampleSceneVoxelRadiance(
            hitPosition,
            sampleRadius);
        if (radianceSample.Sampled != 0u)
        {
            BurtGISceneVoxelGeometrySample geometrySample = BurtGITrySampleSceneVoxelGeometry(
                hitPosition,
                direction);
            if (geometrySample.Sampled == 0u)
            {
                traceDistance += stepLength;
                continue;
            }

            float sampleConfidence = radianceSample.Confidence * saturate(
                max(coarseOccupancySample.Occupancy, geometrySample.Occupancy) * geometrySample.NormalFacingWeight);
            float nearWeight = lerp(1.0, 0.4, stepFraction);
            float sampleWeight = sampleConfidence * nearWeight;
            accumulatedRadiance += radianceSample.Radiance * sampleWeight;
            accumulatedWeight += sampleWeight;
            nearestHitDistance = min(nearestHitDistance, sampleDistance);
            if (sampleConfidence > 0.02)
            {
                radiance = max(radianceSample.Radiance, 0.0);
                hitDistance = sampleDistance;
                confidence = saturate(sampleConfidence);
                return confidence > 0.001;
            }
        }

        traceDistance += stepLength;
    }

    if (accumulatedWeight <= 0.001)
    {
        return false;
    }

    radiance = max(accumulatedRadiance / accumulatedWeight, 0.0);
    hitDistance = nearestHitDistance;
    confidence = saturate(accumulatedWeight * 0.35);
    return confidence > 0.001;
}
bool BurtGITrySampleRadianceCacheHashGridSceneCache(
    float3 probeWorldCenter,
    float3 direction,
    float coneHalfAngle,
    float minSampleRadius,
    float minTraceDistance,
    float maxTraceDistance,
    float stepFactor,
    out float3 radiance,
    out float hitDistance,
    out float confidence)
{
    radiance = 0.0;
    hitDistance = maxTraceDistance;
    confidence = 0.0;

    if (maxTraceDistance <= minTraceDistance)
    {
        return false;
    }

    float3 accumulatedRadiance = 0.0;
    float accumulatedWeight = 0.0;
    float nearestHitDistance = maxTraceDistance;
    float hashGridCellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
    float tanConeHalfAngle = min(tan(coneHalfAngle), 8.0);
    float traceRange = max(maxTraceDistance - minTraceDistance, 0.001);
    float traceDistance = minTraceDistance;

    [loop]
    for (uint stepIndex = 0u; stepIndex < 8u; ++stepIndex)
    {
        if (traceDistance >= maxTraceDistance)
        {
            break;
        }

        float sampleRadius = max(minSampleRadius, traceDistance * tanConeHalfAngle);
        float stepLength = max(hashGridCellSize * 0.5, sampleRadius * max(stepFactor, 0.25));
        float sampleDistance = min(traceDistance + stepLength * 0.5, maxTraceDistance);
        float stepFraction = saturate((sampleDistance - minTraceDistance) / traceRange);
        float3 samplePosition = probeWorldCenter + direction * sampleDistance;
        uint tileHash = BurtGIRadianceCacheHashGridTileHash(samplePosition, direction);
        uint tileIndex = 0xffffffffu;
        if (!BurtGIRadianceCacheHashGridFindTileRead(tileHash, tileIndex))
        {
            traceDistance += stepLength;
            continue;
        }

        uint localCellIndex = BurtGIRadianceCacheHashGridLocalCell(samplePosition, direction);
        uint cellIndex = BurtGIRadianceCacheHashGridCellIndexFromTile(tileIndex, localCellIndex);
        uint4 packedValue = _BurtGIRadianceCacheHashGridValueReadBuffer[cellIndex];
        float4 cachedRadiance = BurtGIRadianceCacheHashGridUnpackRadiance(packedValue);
        float cachedConfidence = saturate(cachedRadiance.a * BurtGIRadianceCacheHashGridAgeConfidenceScale(packedValue));
        if (cachedConfidence <= 0.001 || dot(cachedRadiance.rgb, cachedRadiance.rgb) <= 0.0)
        {
            traceDistance += stepLength;
            continue;
        }

        float nearWeight = lerp(1.0, 0.45, stepFraction);
        float footprintWeight = saturate(hashGridCellSize / max(hashGridCellSize, sampleRadius));
        float sampleWeight = cachedConfidence * nearWeight * lerp(0.5, 1.0, footprintWeight);
        accumulatedRadiance += cachedRadiance.rgb * sampleWeight;
        accumulatedWeight += sampleWeight;
        nearestHitDistance = min(nearestHitDistance, sampleDistance);
        traceDistance += stepLength;
    }

    if (accumulatedWeight <= 0.001)
    {
        return false;
    }

    radiance = max(accumulatedRadiance / accumulatedWeight, 0.0);
    hitDistance = nearestHitDistance;
    confidence = saturate(accumulatedWeight * 0.3);
    return confidence > 0.001;
}
[numthreads(BURT_GI_TRACE_TILE_THREADGROUP_SIZE, BURT_GI_TRACE_TILE_THREADGROUP_SIZE, 1)]
void TraceFromProbesCS(
    uint3 groupId : SV_GroupID,
    uint2 groupThreadId : SV_GroupThreadID)
{
    uint traceTileIndex = groupId.y * max(1u, _BurtGIRadianceCacheClipMapTraceTileGroupStride) + groupId.x;
    bool validTraceTile = traceTileIndex < _BurtGIRadianceCacheClipMapProbeTraceTileAllocatorReadBuffer[0];

    uint2 traceTileCoord = 0u;
    uint traceTileLevel = 0u;
    uint probeTraceIndex = 0u;
    if (validTraceTile)
    {
        BurtGIUnpackTraceTileInfo(_BurtGIRadianceCacheClipMapSortedProbeTraceTileDataReadBuffer[traceTileIndex], traceTileCoord, traceTileLevel, probeTraceIndex);
    }
    validTraceTile = validTraceTile && probeTraceIndex < _BurtGIRadianceCacheClipMapProbeTraceAllocatorReadBuffer[0];

    uint radianceProbeResolution = max(1u, _BurtGIRadianceCacheClipMapRadianceProbeResolution);
    uint traceResolution = max(1u, max(1u, radianceProbeResolution / 2u) << min(traceTileLevel, 4u));

    uint2 probeTexelCoord = traceTileCoord * BURT_GI_TRACE_TILE_THREADGROUP_SIZE + groupThreadId.xy;
    bool validTraceTexel = validTraceTile && probeTexelCoord.x < traceResolution && probeTexelCoord.y < traceResolution;

    BurtGISharedTraceRadiance[groupThreadId.y][groupThreadId.x] = 0.0;
    BurtGISharedTraceHitDistance[groupThreadId.y][groupThreadId.x] = 65504.0;

    float3 probeWorldCenter = BurtGIGetProbeTraceWorldCenterRead(probeTraceIndex);
    uint probeIndex = BurtGIGetProbeIndexFromTraceDataRead(probeTraceIndex);

    if (validTraceTexel)
    {
        float2 probeUV = (float2(probeTexelCoord) + 0.5) / (float)traceResolution;
        float3 direction = BurtGIEquiAreaSphericalMapping(probeUV);

        float hitDistance = 0.0;
        float3 radiance = BurtGISampleRawScreenGI(probeIndex, direction, probeWorldCenter, hitDistance);
        uint clipmapIndex = min(BurtGIGetClipmapIndexFromTraceDataRead(probeTraceIndex), BurtGIClipmapCount() - 1u);
        float clipmapProbeSpacing = max(_BurtGIRadianceCacheClipMapProbeCoordToWorldCenter[clipmapIndex].w, 0.001);
        float hashGridCellSize = max(0.001, _BurtGIRadianceCacheHashGridParams0.x);
        float coneHalfAngle = acos(1.0 - rcp(max(1.0, (float)(traceResolution * traceResolution))));
        float minSampleRadius = max(0.05, min(clipmapProbeSpacing * 0.5, hashGridCellSize * 0.5));
        float probeTMin = max(_BurtGIRadianceCacheClipMapClipmapParams[clipmapIndex].y, 0.001);
        float minTraceDistance = max(0.0001, probeTMin);
        float maxTraceDistance = max(_BurtGIScreenProbeTraceParams.w, minTraceDistance + clipmapProbeSpacing);
        float3 sceneCacheRadiance = 0.0;
        float sceneCacheHitDistance = maxTraceDistance;
        float sceneCacheConfidence = 0.0;
        float3 sceneVoxelRadiance = 0.0;
        float sceneVoxelHitDistance = maxTraceDistance;
        float sceneVoxelConfidence = 0.0;
        if (BurtGITrySampleSceneVoxelConeTrace(
                probeWorldCenter,
                direction,
                coneHalfAngle,
                minSampleRadius,
                minTraceDistance,
                maxTraceDistance,
                1.0,
                sceneVoxelRadiance,
                sceneVoxelHitDistance,
                sceneVoxelConfidence))
        {
            float sceneVoxelBlend = saturate(sceneVoxelConfidence * 0.85);
            radiance = lerp(radiance, sceneVoxelRadiance, sceneVoxelBlend);
            hitDistance = lerp(hitDistance, min(hitDistance, sceneVoxelHitDistance), sceneVoxelBlend);
        }

        if (BurtGITrySampleRadianceCacheHashGridSceneCache(
                probeWorldCenter,
                direction,
                coneHalfAngle,
                minSampleRadius,
                minTraceDistance,
                maxTraceDistance,
                1.0,
                sceneCacheRadiance,
                sceneCacheHitDistance,
                sceneCacheConfidence))
        {
            float sceneCacheBlend = saturate(sceneCacheConfidence * 0.75 * (1.0 - saturate(sceneVoxelConfidence)));
            radiance = lerp(radiance, sceneCacheRadiance, sceneCacheBlend);
            hitDistance = lerp(hitDistance, min(hitDistance, sceneCacheHitDistance), sceneCacheBlend);
        }

        float skyTraceEnabled = _BurtGIRadianceCacheClipMapSkyRadiance.w > 0.5 ? 1.0 : 0.0;
        float sceneTraceConfidence = saturate(max(sceneVoxelConfidence, sceneCacheConfidence));
        float skyMissWeight = skyTraceEnabled * saturate(1.0 - sceneTraceConfidence);
        float3 skyRadiance = BurtGIRadianceCacheResolveSkyRadiance(direction, 0.18);
        radiance = lerp(radiance, max(radiance, skyRadiance), skyMissWeight * 0.5);
        hitDistance = lerp(hitDistance, maxTraceDistance, skyMissWeight);

        BurtGISharedTraceRadiance[groupThreadId.y][groupThreadId.x] = radiance;
        BurtGISharedTraceHitDistance[groupThreadId.y][groupThreadId.x] = min(hitDistance, 65504.0);
    }

    GroupMemoryBarrierWithGroupSync();

    uint2 probeAtlasBaseCoord = BurtGIProbeAtlasBaseCoord(probeIndex, radianceProbeResolution);
    if (!validTraceTile)
    {
        return;
    }

    if (traceResolution < radianceProbeResolution)
    {
        if (!validTraceTexel)
        {
            return;
        }

        uint upsampleFactor = max(1u, radianceProbeResolution / traceResolution);
        uint2 atlasProbeTexelBaseCoord = probeTexelCoord * upsampleFactor;
        [loop]
        for (uint writeY = 0u; writeY < upsampleFactor; ++writeY)
        {
            [loop]
            for (uint writeX = 0u; writeX < upsampleFactor; ++writeX)
            {
                uint2 atlasProbeTexelCoord = atlasProbeTexelBaseCoord + uint2(writeX, writeY);
                if (atlasProbeTexelCoord.x < radianceProbeResolution && atlasProbeTexelCoord.y < radianceProbeResolution)
                {
                    uint2 atlasCoord = probeAtlasBaseCoord + atlasProbeTexelCoord;
                    _BurtGIRadianceCacheClipMapRadianceProbeAtlasTexture[atlasCoord] = float4(BurtGISharedTraceRadiance[groupThreadId.y][groupThreadId.x], 1.0);
                    _BurtGIRadianceCacheClipMapDepthProbeAtlasTexture[atlasCoord] = BurtGISharedTraceHitDistance[groupThreadId.y][groupThreadId.x];
                }
            }
        }
    }
    else
    {
        uint downsampleFactor = min(
            max(1u, traceResolution / radianceProbeResolution),
            (uint)BURT_GI_TRACE_TILE_THREADGROUP_SIZE);
        uint writeTileSize = max(1u, (uint)BURT_GI_TRACE_TILE_THREADGROUP_SIZE / downsampleFactor);

        if (groupThreadId.x < writeTileSize && groupThreadId.y < writeTileSize)
        {
            float3 radianceSum = 0.0;
            float hitDistanceMin = 65504.0;
            [loop]
            for (uint sampleY = 0u; sampleY < downsampleFactor; ++sampleY)
            {
                [loop]
                for (uint sampleX = 0u; sampleX < downsampleFactor; ++sampleX)
                {
                    uint2 sampleCoord = groupThreadId.xy * downsampleFactor + uint2(sampleX, sampleY);
                    radianceSum += BurtGISharedTraceRadiance[sampleCoord.y][sampleCoord.x];
                    hitDistanceMin = min(hitDistanceMin, BurtGISharedTraceHitDistance[sampleCoord.y][sampleCoord.x]);
                }
            }

            uint2 atlasProbeTexelCoord = traceTileCoord * writeTileSize + groupThreadId.xy;
            if (atlasProbeTexelCoord.x < radianceProbeResolution && atlasProbeTexelCoord.y < radianceProbeResolution)
            {
                uint2 atlasCoord = probeAtlasBaseCoord + atlasProbeTexelCoord;
                float invSampleCount = rcp((float)(downsampleFactor * downsampleFactor));
                _BurtGIRadianceCacheClipMapRadianceProbeAtlasTexture[atlasCoord] = float4(radianceSum * invSampleCount, 1.0);
                _BurtGIRadianceCacheClipMapDepthProbeAtlasTexture[atlasCoord] = hitDistanceMin;
            }
        }
    }
}
